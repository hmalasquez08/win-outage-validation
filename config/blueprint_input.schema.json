{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blueprint input using approved capabilities only",
  "type": "object",
  "required": ["status", "approved_sources", "capabilities", "sonata_contract", "evidence_manifest"],
  "properties": {
    "status": {"type": "string"},
    "approved_sources": {"type": "array", "items": {"type": "string"}},
    "capabilities": {"type": "array"},
    "sonata_contract": {"type": "string"},
    "evidence_manifest": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
