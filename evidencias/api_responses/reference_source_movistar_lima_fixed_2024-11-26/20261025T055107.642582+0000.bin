<!--Color megamenu-->
<script>
    
    var lista_megamenu = $(".navbar-nav .nav-item .nav-link")
    lista_megamenu.splice(5, 1)
    lista_megamenu.hover(
        function () {
            elemento_principal = this
		    $.each(lista_megamenu, function (indice, elemento) {
			    if (elemento_principal == elemento ) {
                    $(elemento_principal).css("color", "#00BCE4")
			    }
                else {
				    $(elemento).css("color", "#B6B7B7")
			    }
		    })
        },
        function () {
            elemento_principal = this
            $.each(lista_megamenu, function (indice, elemento) {
                if (elemento_principal == elemento) {
                    $(elemento_principal).css("color", "#333333")
                }
                else {
                    $(elemento).css("color", "#333333")
                }
                
		    })
        }  
    )
    
    $(".nav-item .nav-link").mouseenter(function(){
             $(".bg-menu").show();
            $(".nav-item .content-menu").mouseleave(function(){
              $(".bg-menu").hide();
            });
        });
        $(".nav-item .nav-link").mouseleave(function(){
            setTimeout(function(){
					if (!$('.nav-item:hover').length) {
						$(".bg-menu").hide();
					}
				}, 100);
        });
//    if(( $(".nav-item:hover .content-menu").css("display").length > 0)) {
//      console.log("asd")
//} 
    
</script>



