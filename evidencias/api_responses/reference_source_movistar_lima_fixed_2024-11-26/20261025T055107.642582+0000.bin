  <script>
    function lcw() {
      return {

        // ── BURBUJAS Y AVATAR DENTRO DEL CHAT ────────────────────────────────
        webChatContainerProps: {
          webChatStyles: {
            bubbleMaxWidth: 400,  // Ancho máximo de burbujas de texto e IA generativa
            bubbleMinWidth: 40,   // Ancho mínimo de burbujas
          },

          // ── AVATAR DEL BOT (imagen al lado de cada mensaje de Telia) ─────────
          renderingMiddlewareProps: {
            avatarStyleProps: {
              backgroundImage:    "url('https://sociedadtelecom.pe/chatbot/chatbot-telia.png')",
              backgroundSize:     "cover",
              backgroundPosition: "center center",
              backgroundRepeat:   "no-repeat",
              backgroundColor:    "transparent"
            },
            avatarTextStyleProps: {
              display: "none"   // Oculta las iniciales "TE"
            }
          }
        },

        // ── TAMAÑO DE LA VENTANA DEL CHAT ────────────────────────────────────
        styleProps: {
          generalStyles: {
            width:  "520px",  // Ancho de la ventana del chat
            height: "640px"   // Alto de la ventana del chat
          }
        },

        // ── BOTÓN FLOTANTE CON ÍCONO DE TELIA Y BURBUJA DE MENSAJES ──────────
        chatButtonProps: {
          controlProps: {
            hideChatTextContainer:  true,   // Oculta el texto, solo muestra la imagen
            hideNotificationBubble: false   // Muestra la burbuja roja de mensajes no leídos
          },
          styleProps: {

            // Contenedor del botón flotante
            generalStyleProps: {
              height:          "110px",
              width:           "95px",
              backgroundColor: "transparent",
              borderStyle:     "none",
              borderRadius:    "0",
              boxShadow:       "none",
              padding:         "10px 5px 0px 5px",
              outline:         "none",
              overflow:        "visible",  // Permite que la burbuja no se corte
              bottom:          "20px",     // Distancia desde abajo
              right:           "20px",     // Distancia desde la derecha

              "&:hover": {
                backgroundColor: "transparent",
                boxShadow:       "none",
                opacity:         "0.88",
                transform:       "scale(1.04)"
              },
              "&:focus": {
                outline:         "none",
                boxShadow:       "none",
                backgroundColor: "transparent"
              },
              "&:focus-visible": {
                outline:   "none",
                boxShadow: "none"
              }
            },

            // Imagen del ícono de Telia en el botón flotante
            iconStyleProps: {
              width:               "100%",
              height:              "100%",
              cursor:              "pointer",
              backgroundImage:     "url(https://sociedadtelecom.pe/chatbot/chatbot-telia.png)",
              backgroundSize:      "contain",
              backgroundPosition:  "center center",
              backgroundRepeat:    "no-repeat",
              backgroundColor:     "transparent",
              borderStyle:         "none",
              borderRadius:        "0",
              margin:              "0px"
            },

            // ── BURBUJA ROJA DE MENSAJES NO LEÍDOS ───────────────────────────
            // Para ajustar su posición si necesitas moverla:
            //   top: "8px"   → más abajo    | top: "2px"  → más arriba
            //   right: "5px" → más a la izq | right: "0px" → más a la derecha
            notificationBubbleStyleProps: {
              backgroundColor: "#d9342b",  // Color rojo
              color:           "#ffffff",  // Número en blanco
              fontSize:        "11px",
              fontWeight:      "bold",
              borderRadius:    "50%",
              width:           "20px",     // Tamaño de la burbuja
              height:          "20px",
              minWidth:        "20px",
              display:         "flex",
              alignItems:      "center",
              justifyContent:  "center",
              position:        "absolute",
              top:             "24px",      // ← Sube/baja la burbuja
              right:           "4px"       // ← Acerca/aleja la burbuja del borde derecho
            }
          }
        }
      };
    }
