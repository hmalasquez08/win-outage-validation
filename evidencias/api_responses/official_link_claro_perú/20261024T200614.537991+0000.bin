                  font-size: 29px;
                  font-weight: 700;
                  font-family: "AMX Black";
                  letter-spacing: -1px;
                  font-style: normal;
                  line-height: 1.1;

                  @media screen and (min-width: 992px) {
                    font-size: 34px;
                  }

