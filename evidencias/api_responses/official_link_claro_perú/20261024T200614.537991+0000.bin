    }

    .contentForm .formBC__footer button {
      border-radius: 32px;
      background: #F4F6F9;
      color: #91979E;
      border-color: transparent;
      text-align: center;
      font-family: Roboto;
      font-size: 16px;
      font-weight: 700;
      line-height: normal;
      width: 208px;
      height: 46px;
      cursor: pointer;
      pointer-events: none;
    }

    .contentForm .formBC__footer .btnenviarform {
      margin-top: 12px;
      display: flex;
      align-items: center;
      justify-content: start;
      gap: 20px;
    }

    .contentForm .formBC__footer .btnenviarform .spinner {
      display: flex;
      width: 33px;
      height: auto;
      animation: rotar 1.3s linear infinite;
      display: none;
    }

    @keyframes rotar {
      0% {
        transform: rotate(0deg);
      }

      100% {
        transform: rotate(360deg);
      }
    }

    .contentForm .formBC__footer .btnenviarform .spinner.active {
      display: flex;
    }

    .formularioFullClaro .contentForm .formBC__footer .btnenviarform {
