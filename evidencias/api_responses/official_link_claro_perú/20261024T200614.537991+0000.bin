    .contentForm form fieldset.c01peColsTwo50 .contentSelect {
      position: relative;
    }

    .contentForm form fieldset.c01peColsTwo50 .contentSelect::before {
      position: absolute;
      content: "";
      background-image: url(https://static.claro.com.pe/img/arrow-bottom.svg);
      background-repeat: no-repeat;
      width: 10px;
      background-repeat: no-repeat;
      height: 6px;
      background-size: 100%;
