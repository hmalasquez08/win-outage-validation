r-box;box-sizing:border-box;width:calc(100% - 72px);padding-left:32px}.c62_v2 .c62_v2TextInner h2,.c62_v2 .c62_v2TextInner .h2{font-size:28px;font-size:1.75rem;text-align:left}.c62_v2 .c62_v2TextInner p{font-size:18px;font-size:1.125rem;text-align:left}.c62_v2 .c62_v2TextBtn{position:absolute;position:relative;transform:none;top:initial;left:initial;bottom:initial;width:200px;margin-top:0}.c62_v2 .c62_v2TextBtn [class*="btni"]{max-width:200px}}</style><style>
