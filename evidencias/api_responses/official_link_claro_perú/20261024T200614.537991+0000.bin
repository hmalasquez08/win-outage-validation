    function fixSlick() {
      try {
        $(".js-c09SliderFull").slick("unslick");
      } catch (e) { }

      $(".js-c09SliderFull").slick({ autoplay: !1, autoplaySpeed: 7e3, speed: 600, slidesToShow: 3, slidesToScroll: 3, dots: true, arrows: true, responsive: [{ breakpoint: 960, settings: { slidesToShow: 2, slidesToScroll: 2 } }, { breakpoint: 640, settings: { slidesToShow: 1, slidesToScroll: 1 } }] });

    }
    async function cargar_json(url) {

      const equipos = await $.ajax({
        url: url,
        dataType: 'json',
        success: function (data) {
          //console.log("cargar_json success", data.data)
          var content = '';
          let equipos = data.data;
          return equipos;
        },
        error: function (jqXHR, textStatus, errorThrown) {
          console.log("error call", jqXHR, textStatus, errorThrown)
          return [];
        }
      });

      return equipos.data;
    }

    function createCard(tabId, item) {
      const cardWrap = document.createElement('div');
      cardWrap.className = 'c09BodyCardWrap';

      const cardLink = document.createElement('a');
      cardLink.className = 'cardShopEv';
      cardLink.href = item.calltoaction_url;
      cardLink.target = '_self'


      cardWrap.appendChild(cardLink);

      if (item.discount && item.discount > 0) {
        const discountLabel = document.createElement('span');
        const descuentonew = Math.round((item.price_list - item.discount) / item.price_list * 100);
        if (!descuentonew == 0) {
          discountLabel.className = 'cardShopEvLabel';
          discountLabel.textContent = descuentonew + '% de descuento';
          cardLink.appendChild(discountLabel);
        }
      }


      const cardContent = document.createElement('div');
      cardContent.className = 'cardShopEvCont';

      cardLink.appendChild(cardContent);

      const title = document.createElement('h3');
      title.className = 'cardShopEvTitle';
      title.textContent = item.title_product.replace('s(', 's (').replace('o(', 'o (');

      // const spanTitle = document.createElement('span');
      // spanTitle.textContent = item.title_plan;

      // title.appendChild(spanTitle);
      cardContent.appendChild(title);

      const picture = document.createElement('picture');
      picture.className = 'cardShopEvImg';

      const sourceWebp = document.createElement('source');
      sourceWebp.type = 'image/webp';
      sourceWebp.srcset = item.image;

      const sourcePng = document.createElement('source');
      sourcePng.type = 'image/png';
      sourcePng.srcset = item.image;

      picture.appendChild(sourceWebp);
      picture.appendChild(sourcePng);

      const img = document.createElement('img');
      img.className = 'lazyload';
      img.setAttribute('data-src', item.image);
      img.width = '220';
      img.height = '240';
      img.alt = '';

      picture.appendChild(img);

      cardContent.appendChild(picture);

      const priceDiv = document.createElement('div');
      priceDiv.className = 'cardShopEvPrice';

      const currentPrice = document.createElement('p');
      currentPrice.className = 'currentPrice';
      if (item.discount == 0) {
        currentPrice.innerHTML = 'Ahora desde <strong>S/ ' + item.price_list.toLocaleString("es-PE") + '</strong>';
      } else {
        currentPrice.innerHTML = 'Ahora desde <strong>S/ ' + item.discount.toLocaleString("es-PE") + '</strong>';
      }
      priceDiv.appendChild(currentPrice);
      if (item.price_list > item.discount && item.discount !== 0) {
        const prevPrice = document.createElement('p');
        prevPrice.className = 'prevPrice';
        prevPrice.innerHTML = 'Antes: <strong>S/ ' + item.price_list.toLocaleString("es-PE") + '</strong>';
        priceDiv.appendChild(prevPrice);
      }

      const planPrice = document.createElement('p');
      planPrice.className = 'planPrice';
      planPrice.innerHTML = item.title_plan;

      priceDiv.appendChild(planPrice);

      cardContent.appendChild(priceDiv);

      const fakeButton = document.createElement('a');
      fakeButton.href = item.calltoaction_url;
      fakeButton.className = 'fakeBtn btni bcoRojo';
      fakeButton.target = '_self';

      const buttonText = document.createElement('span');
      buttonText.textContent = item.calltoaction_name;

      fakeButton.appendChild(buttonText);

      cardContent.appendChild(fakeButton);

      $("#" + tabId).append(cardWrap);
    }

    function createTabSection(number) {
      if (document.getElementById("tab-" + number + "3e9f4b55-a83f-4732-9028-6d4264e640a1")) {
        //console.log("Tab already exists!");
        return;
      }

      let tabDiv = document.createElement("div");

      tabDiv.classList.add("sliderTabsView", "active");
      tabDiv.id = "tab-" + number + "3e9f4b55-a83f-4732-9028-6d4264e640a1";

      let sliderDiv = document.createElement("div");
      sliderDiv.classList.add("js-c09SliderFull");
      sliderDiv.id = "sliderFullTab" + number;

      let bodyLinkDiv = document.createElement("div");
      bodyLinkDiv.classList.add("c09BodyLink");

      let anchor = document.createElement("a");
      anchor.classList.add("iconTextLink");
      anchor.target = "_self"
      anchor.href = "https://tienda.claro.com.pe/?utm_campaign=performance_tienda&utm_source=medios_propios&utm_medium=claro_pe&utm_content=home-tienda_widget_equipos&utm_term=tienda_virtual-portabilidad%2Brenovacion&cu=cp1788879238";
      anchor.innerHTML = 'Ver todos los equipos <i class="ico-arrow-right-circle"></i>';

      bodyLinkDiv.appendChild(anchor);
      tabDiv.appendChild(sliderDiv);
      tabDiv.appendChild(bodyLinkDiv);
      $("#sliderTabsMenu3e9f4b55-a83f-4732-9028-6d4264e640a1").after(tabDiv);
    }


    function applySlick() {
      try {
        $(".js-c09SliderFull").slick("unslick");
      } catch (e) { }

      $(".js-c09SliderFull").slick({ autoplay: !1, autoplaySpeed: 7e3, speed: 600, slidesToShow: 3, slidesToScroll: 3, dots: true, arrows: true, responsive: [{ breakpoint: 960, settings: { slidesToShow: 2, slidesToScroll: 2 } }, { breakpoint: 640, settings: { slidesToShow: 1, slidesToScroll: 1 } }] });

      let s = $("#sliderTabsMenu3e9f4b55-a83f-4732-9028-6d4264e640a1")
      s.find(".stmElement").removeClass("active"), s.find('.stmElement[data-tab="tab-' + 1 + '3e9f4b55-a83f-4732-9028-6d4264e640a1"]').addClass("active"), s.parent().find(".sliderTabsView").removeClass("active"), s.parent().find(".sliderTabsView#tab-" + 1 + "3e9f4b55-a83f-4732-9028-6d4264e640a1").addClass("active"), s.parent().find(".sliderTabsView .slick-slider").slick("setPosition")
      s.parent().find(".sliderTabsView").removeClass("active"), s.parent().find("#tab-" + 1 + "3e9f4b55-a83f-4732-9028-6d4264e640a1").addClass("active")
    }

    $(document).ready(async () => {
      const loading = document.querySelector('.contentLoading.dos');
      const itemsSection1 = await cargar_json('https://py-xml-tienda-942960982676.southamerica-east1.run.app?apikey=d377dc6f-10e8-44ba-9100-1f1cf355ddec&grupo=156');
      const itemsSection2 = await cargar_json('https://py-xml-tienda-942960982676.southamerica-east1.run.app/?apikey=d377dc6f-10e8-44ba-9100-1f1cf355ddec&grupo=156');
      const itemsSection3 = await cargar_json('https://py-xml-tienda-942960982676.southamerica-east1.run.app?apikey=d377dc6f-10e8-44ba-9100-1f1cf355ddec&grupo=162');
      const hayEquipos =
        (itemsSection1 && itemsSection1.length > 0) ||
        (itemsSection2 && itemsSection2.length > 0) ||
        (itemsSection3 && itemsSection3.length > 0);

      createTabSection(1);
      createTabSection(2);
      createTabSection(3);

      $("#sliderFullTab1").html("");

      itemsSection1.forEach(item => {
        createCard("sliderFullTab1", item);
        loading.style.display = "none";
      });


      itemsSection2.forEach(item => {
        createCard("sliderFullTab2", item);
        loading.style.display = "none";
      });


      itemsSection3.forEach(item => {
        createCard("sliderFullTab3", item);
        loading.style.display = "none";
      });


      applySlick();

      $('.sliderTabsMenu').on('afterChange', function (event, slick, currentSlide) {
        //console.log('Slide changed to:', currentSlide);
        fixSlick()
        // Your custom function here
      });




      const listTabs = document.querySelectorAll(".c09 .sliderTabsMenu .stmElement");
      const listSlider = document.querySelectorAll(".c09 .sliderTabsView");

      listTabs.forEach(tab => {
        tab.addEventListener("click", () => {

          // Buscar el slider activo
          const activeSlider = document.querySelector(".c09 .sliderTabsView.active");

          if (!activeSlider) return;

          const slickTrack = activeSlider.querySelector(".slick-track");
          const hasItems = slickTrack && slickTrack.children.length > 0;

          if (!hasItems) {
            listSlider.forEach(el => el.classList.remove("active"));
            $('.c09 .vacio').addClass('active');
          } else {
            $('.c09 .vacio').removeClass('active');
          }

        });
      });

      function checkActiveSliderMobile() {
        // Solo mobile
        if (window.innerWidth > 639) return;

        const activeSlider = document.querySelector(".c09 .sliderTabsView.active");
        if (!activeSlider) return;

        const slickTrack = activeSlider.querySelector(".slick-track");
        const hasItems = slickTrack && slickTrack.children.length > 0;

        if (!hasItems) {
          setTimeout(() => {
            // validar otra vez por si cambió el estado
            if (!activeSlider.classList.contains("active")) return;

            listSlider.forEach(el => el.classList.remove("active"));
            document.querySelector('.c09 .vacio')?.classList.add("active");
          }, 500);
        } else {
          document.querySelector('.c09 .vacio')?.classList.remove("active");
        }
      }

      const observer = new MutationObserver(() => {
        checkActiveSliderMobile();
      });

      listSlider.forEach(slider => {
        observer.observe(slider, {
          attributes: true,
          attributeFilter: ["class"]
        });
      });






      $("div[data-tab='tab-13e9f4b55-a83f-4732-9028-6d4264e640a1']").click()
    });


    (function () {
      let wasMobile = window.innerWidth < 640;

      window.addEventListener('resize', () => {
        const isMobile = window.innerWidth < 640;
        if (isMobile !== wasMobile) {
          console.log('Cambio de resolución detectado. Recargando página...');
          location.reload();
        }

        wasMobile = isMobile;
      });
    })();

