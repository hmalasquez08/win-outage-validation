    .custom-select {
      position: relative;
      width: 100%;
      cursor: pointer;
    }

    .selected-option {
      background: white;
      height: 40px;
      padding: 7px 16px;
      border: #BBB 1px solid;
      background-color: #fff;
      border-radius: 12px;
      display: flex;
      align-items: center;
    }

    .custom-options {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 5;
      background: white;
      border-radius: 12px;
      overflow: hidden;
    }

    .custom-options li {
      padding: 10px;
      padding: 5px 15px !important;
    }

    .custom-options li.selected {
      font-weight: 700;
    }

    .custom-options li:hover {
      background-color: #578FEC;
      color: #fff;
    }

    .custom-select.open .custom-options {
      display: block;
    }
