    (function () {
      // const SC_PRODUCTS_V2_API_URL = 'http://localhost:8010/';
      const SC_PRODUCTS_V2_API_URL = 'https://py-xml-tienda-942960982676.southamerica-east1.run.app/';
      const SC_PRODUCTS_V2_API_KEY = 'd377dc6f-10e8-44ba-9100-1f1cf355ddec';
      const SC_PRODUCTS_V2_LOADING_ICON_URL = 'https://www.claro.com.pe/portal/pe/recursos_tema/assets/img/loading.gif';

      const SC_PRODUCTS_V2_TAB_CONFIG = [
        { name: 'Productos destacados', params: { category2: 'destacados_varios', items: '10' } },
        { name: 'Casa inteligente', params: { line: 'accesorios', category2: 'casa_inteligente', items: '10' } },
        { name: 'Electrohogar', params: { line: 'accesorios', category2: 'electro_hogar', items: '10' } },
        { name: 'Audio', params: { line: 'accesorios', category2: 'audio', items: '10' } },
      ];
      const SC_PRODUCTS_V2_MAX_ITEMS = 6;
      const SC_PRODUCTS_V2_MOBILE_PREVIEW_ITEMS = 3;
      const SC_PRODUCTS_V2_MASONRY_BREAKPOINT = 1200;
      const SC_PRODUCTS_V2_MASONRY_BREAKPOINT_2COL = 1024;
      // Size tier patterns for masonry distribution; balanced so each
      // column ends at the same total height with greedy bin-packing.
      // 3-col: [s,m,l,l,m,s] → greedy gives 704|704|704 with 180/340/500
      // 2-col: [s,m,m,l,l,s] → greedy gives 948|948 with 180/300/420
      const SC_PRODUCTS_V2_SIZE_TIERS_3COL = ['small', 'medium', 'large', 'large', 'medium', 'small'];
      const SC_PRODUCTS_V2_SIZE_TIERS_2COL = ['small', 'medium', 'medium', 'large', 'large', 'small'];
      var scProductsV2LastFlatHtml = '';
      var scProductsV2LastItems = null;
      var scProductsV2Expanded = false;
      var scProductsV2VerMasWrap = document.querySelector(".sc_products_v2__vermas-wrap");

      function scProductsV2Esc(str) {
        var d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
      }

      function scProductsV2GetColumnCount() {
        if (window.innerWidth >= SC_PRODUCTS_V2_MASONRY_BREAKPOINT) return 3;
        if (window.innerWidth >= SC_PRODUCTS_V2_MASONRY_BREAKPOINT_2COL) return 2;
        return 1;
      }

      function scProductsV2GetSizeTiers(colCount) {
        if (colCount >= 3) return SC_PRODUCTS_V2_SIZE_TIERS_3COL;
        if (colCount >= 2) return SC_PRODUCTS_V2_SIZE_TIERS_2COL;
        return ['small', 'small', 'small', 'small', 'small', 'small'];
      }

      function scProductsV2FormatPrice(value) {
        var num = Number(value);
        if (isNaN(num)) return value;
        if (num === 0.01) return '1';
        return num % 1 === 0 ? num.toFixed(0) : num.toFixed(2);
      }

      function scProductsV2BuildApiUrl(params) {
        var url = SC_PRODUCTS_V2_API_URL + '?apikey=' + encodeURIComponent(SC_PRODUCTS_V2_API_KEY);
        for (var key in params) {
          if (params.hasOwnProperty(key)) {
            url += '&' + encodeURIComponent(key) + '=' + encodeURIComponent(params[key]);
          }
        }
        return url;
      }

      function scProductsV2RenderCard(item, index) {
        var colCount = scProductsV2GetColumnCount();
        var sizeTier = scProductsV2GetSizeTiers(colCount)[index] || 'large';
        var isFeatured = sizeTier === 'small';
        var isMobile = colCount <= 1;
        var title = scProductsV2Esc(item.title_product || '');
        var subtitle = item.line === 'Hogar' ? 'Hogar' : scProductsV2Esc(item.title_plan || '');
        var priceLabel = item.line === 'Hogar' ? 'Precio mensual' : scProductsV2Esc(item.title_price_prod || 'Ahora desde');
        var priceValue = 'S/' + scProductsV2FormatPrice(item.price);
        var oldPrice = '';
        var imgSrc = item.image || '';
        var ctaUrl = item.calltoaction_url || '#';

        // SVG flecha para el botón circular (mismo que home-carrousel)
        var btnSvg = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">' +
          '<path d="M7.65039 1L14.3004 8L7.65039 15" stroke="#1D1D1D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>' +
          '<path d="M1 8L14.3 8" stroke="#1D1D1D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>' +
          '</svg>';
        var circleBtn = '<a href="' + ctaUrl + '" class="sc_products_v2__card__btnv2" aria-label="Conoce más"><span>Conoce más</span>' + btnSvg + '</a>';
        var enlaceCard = '<a href="' + ctaUrl + '" class="enlaceCard"></a>';

        // On mobile/tablet (<1200px) ALL cards use the compact horizontal
        // layout (body left + image right), same as the featured card.
        if (isFeatured || isMobile) {
          return '<article class="sc_products_v2__card sc_products_v2__card--featured">' +
            '<div class="sc_products_v2__card__body">' +
            '<div>' +
            '<h3 class="sc_products_v2__card__title">' + title + '</h3>' +
            '<p class="sc_products_v2__card__subtitle">' + subtitle + '</p>' +
            '</div>' +
            '<div class="sc_products_v2__card__price">' +
            '<span class="sc_products_v2__card__price__label">' + priceLabel + '</span>' +
            '<span class="sc_products_v2__card__price__value">' + priceValue + '</span>' +
            (oldPrice ? '<span class="sc_products_v2__card__price__old">' + oldPrice + '</span>' : '') +
            '</div>' +
            '</div>' +
            '<div class="sc_products_v2__card__media">' +
            '<img class="sc_products_v2__card__image" src="' + imgSrc + '" alt="' + title + '" loading="lazy">' +
            '</div>' +
            circleBtn + enlaceCard +
            '</article>';
        }

        var standardSizeClass = sizeTier === 'medium' ? ' sc_products_v2__card--standard-medium' : ' sc_products_v2__card--standard-large';
        return '<article class="sc_products_v2__card sc_products_v2__card--standard' + standardSizeClass + '">' +
          '<div class="sc_products_v2__card__body">' +
          '<h3 class="sc_products_v2__card__title">' + title + '</h3>' +
          '<p class="sc_products_v2__card__subtitle">' + subtitle + '</p>' +
          '</div>' +
          '<div class="sc_products_v2__card__media">' +
          '<img class="sc_products_v2__card__image" src="' + imgSrc + '" alt="' + title + '" loading="lazy">' +
          '</div>' +
          '<div class="sc_products_v2__card__footer">' +
          '<div class="sc_products_v2__card__price">' +
          '<span class="sc_products_v2__card__price__label">' + priceLabel + '</span>' +
          '<span class="sc_products_v2__card__price__value">' + priceValue + '</span>' +
          (oldPrice ? '<span class="sc_products_v2__card__price__old">' + oldPrice + '</span>' : '') +
          '</div>' +
          '</div>' +
          circleBtn + enlaceCard +
          '</article>';
      }

      function scProductsV2GridShowLoading(gridEl) {
        scProductsV2LastFlatHtml = '';
        scProductsV2LastItems = null;
        scProductsV2VerMasWrap.hidden = true;
        scProductsV2VerMasWrap.innerHTML = '';
        gridEl.className = 'sc_products_v2__grid sc_products_v2__grid--loading';
        gridEl.style.display = 'flex';
        gridEl.style.alignItems = 'center';
        gridEl.style.justifyContent = 'center';
        gridEl.style.minHeight = '300px';
        gridEl.innerHTML = '<img width="100" src="' + SC_PRODUCTS_V2_LOADING_ICON_URL + '" alt="Cargando...">';
      }

      function scProductsV2GridShowError(gridEl, msg) {
        scProductsV2LastFlatHtml = '';
        scProductsV2LastItems = null;
        scProductsV2VerMasWrap.hidden = true;
        scProductsV2VerMasWrap.innerHTML = '';
        gridEl.className = 'sc_products_v2__grid';
        gridEl.style.display = '';
        gridEl.style.alignItems = '';
        gridEl.style.justifyContent = '';
        gridEl.style.minHeight = '';
        gridEl.innerHTML = '<p style="text-align:center;padding:2rem;color:#8B8B8B;">' + scProductsV2Esc(msg) + '</p>';
      }

      function scProductsV2DistributeMasonry(gridEl, cards, cols) {
        var colHeights = [0, 0, 0];
        for (var i = 0; i < cards.length; i++) {
          var card = cards[i];
          var cardHeight = card.offsetHeight;
          var minIdx = 0;
          for (var j = 1; j < cols.length; j++) {
            if (colHeights[j] < colHeights[minIdx]) minIdx = j;
          }
          cols[minIdx].appendChild(card);
          colHeights[minIdx] += cardHeight + (colHeights[minIdx] > 0 ? 24 : 0);
        }
      }

      function scProductsV2RenderVerMasButton(gridEl, colCount) {
        var total = scProductsV2LastItems ? scProductsV2LastItems.length : 0;
        if (colCount !== 1 || total <= SC_PRODUCTS_V2_MOBILE_PREVIEW_ITEMS) {
          scProductsV2VerMasWrap.hidden = true;
          scProductsV2VerMasWrap.innerHTML = '';
          return;
        }
        scProductsV2VerMasWrap.hidden = false;
        var label = (scProductsV2Expanded ? 'Ver menos' : 'Ver más') + ' productos';
        scProductsV2VerMasWrap.innerHTML = '<button type="button" class="sc_products_v2__vermas' +
          (scProductsV2Expanded ? ' is-expanded' : '') + '" aria-expanded="' + scProductsV2Expanded +
          '" aria-label="' + label + '"></button>';
        scProductsV2VerMasWrap.querySelector('.sc_products_v2__vermas').addEventListener('click', function () {
          scProductsV2Expanded = !scProductsV2Expanded;
          scProductsV2LayoutGrid(gridEl);
        });
      }

      function scProductsV2LayoutGrid(gridEl) {
        gridEl.classList.remove('sc_products_v2__grid--masonry');
        gridEl.style.alignItems = '';

        var colCount = scProductsV2GetColumnCount();
        var total = scProductsV2LastItems ? scProductsV2LastItems.length : 0;
        var isMobilePreview = colCount === 1 && !scProductsV2Expanded && total > SC_PRODUCTS_V2_MOBILE_PREVIEW_ITEMS;
        var visibleCount = isMobilePreview ? SC_PRODUCTS_V2_MOBILE_PREVIEW_ITEMS : total;

        // Regenerate HTML from raw items to reflect current viewport
        // (handles resize between mobile, 2-col, and 3-col correctly)
        if (scProductsV2LastItems && scProductsV2LastItems.length > 0) {
          var _html = '';
          for (var _ri = 0; _ri < visibleCount; _ri++) {
            _html += scProductsV2RenderCard(scProductsV2LastItems[_ri], _ri);
          }
          scProductsV2LastFlatHtml = _html;
        }

        scProductsV2RenderVerMasButton(gridEl, colCount);

        // For masonry viewports: hide grid BEFORE setting innerHTML to
        // prevent any flash of the flat/single-column state
        if (scProductsV2LastFlatHtml && colCount >= 2) {
          gridEl.classList.add('sc_products_v2__grid--rendering');
        }

        gridEl.innerHTML = scProductsV2LastFlatHtml;

        if (!scProductsV2LastFlatHtml || colCount <= 1) return;

        var cards = Array.prototype.slice.call(gridEl.children);
        if (cards.length === 0) return;

        var cols = [];
        for (var c = 0; c < colCount; c++) {
          var col = document.createElement('div');
          col.className = 'sc_products_v2__grid__col';
          cols.push(col);
        }

        // Mount the empty columns first so they take on their real flex
        // width, then park every card in column 0. Since all columns are
        // equal-width flex siblings, each card is now measured at the same
        // width it will actually render at once distributed - measuring
        // before this (e.g. while cards sit full-width in a single column)
        // gives wrong heights for line-clamped titles that wrap differently
        // at 1/3 width vs full width.
        gridEl.innerHTML = '';
        for (var m = 0; m < cols.length; m++) gridEl.appendChild(cols[m]);
        gridEl.classList.add('sc_products_v2__grid--masonry');
        for (var p = 0; p < cards.length; p++) cols[0].appendChild(cards[p]);

        var images = gridEl.querySelectorAll('.sc_products_v2__card__image');
        var pending = 0;
        var settled = false;

        function finish() {
          if (settled) return;
          settled = true;
          scProductsV2DistributeMasonry(gridEl, cards, cols);
          gridEl.classList.remove('sc_products_v2__grid--rendering');
        }

        function onImgSettle() {
          pending--;
          if (pending <= 0) finish();
        }

        for (var im = 0; im < images.length; im++) {
          if (images[im].complete) continue;
          pending++;
          images[im].addEventListener('load', onImgSettle);
          images[im].addEventListener('error', onImgSettle);
        }

        if (pending === 0) {
          finish();
        } else {
          setTimeout(finish, 200);
        }
      }

      function scProductsV2GridRender(gridEl, data) {
        if (!data || data.length === 0) {
          scProductsV2GridShowError(gridEl, 'No hay productos disponibles en esta categor\u00EDa.');
          return;
        }
        var filtered = [];
        for (var fi = 0; fi < data.length; fi++) {
          if (data[fi].line !== 'Hogar') filtered.push(data[fi]);
        }
        if (filtered.length === 0) {
          scProductsV2GridShowError(gridEl, 'No hay productos disponibles en esta categor\u00EDa.');
          return;
        }
        gridEl.className = 'sc_products_v2__grid';
        gridEl.style.display = '';
        gridEl.style.alignItems = '';
        gridEl.style.justifyContent = '';
        gridEl.style.minHeight = '';
        scProductsV2LastItems = filtered.slice(0, SC_PRODUCTS_V2_MAX_ITEMS);
        scProductsV2Expanded = false;
        scProductsV2LayoutGrid(gridEl);
      }

      document.addEventListener("DOMContentLoaded", function () {
        var scProductsV2TabsNav = document.querySelector(".sc_products_v2__tabs");
        var scProductsV2Tabs = document.querySelectorAll(".sc_products_v2__tab");
        var scProductsV2Grid = document.querySelector(".sc_products_v2__grid");
        var scProductsV2DataCache = {};
        var scProductsV2CurrentIndex = -1;

        function scProductsV2TabsCarouselMode() {
          // El breakpoint >=768px cambia .sc_products_v2__tabs a
          // justify-content:center (entran todos los tabs, no hace falta scroll).
          return getComputedStyle(scProductsV2TabsNav).justifyContent !== "center";
        }

        function scProductsV2SetTabsEdgePadding() {
          if (!scProductsV2TabsCarouselMode()) {
            scProductsV2TabsNav.style.paddingLeft = "";
            scProductsV2TabsNav.style.paddingRight = "";
            return;
          }
          // Espacio fantasma al inicio/final para que el primer y el último
          // tab también puedan centrarse, igual que el Swiper (centeredSlides)
          // de referencia, en vez de quedar pegados a los bordes.
          var half = Math.ceil(scProductsV2TabsNav.clientWidth / 2) + "px";
          scProductsV2TabsNav.style.paddingLeft = half;
          scProductsV2TabsNav.style.paddingRight = half;
        }

        function scProductsV2CenterTab(tab, instant) {
          if (!scProductsV2TabsCarouselMode()) return;
          var navRect = scProductsV2TabsNav.getBoundingClientRect();
          var tabRect = tab.getBoundingClientRect();
          var target = scProductsV2TabsNav.scrollLeft + (tabRect.left - navRect.left) + tabRect.width / 2 - navRect.width / 2;
          var max = scProductsV2TabsNav.scrollWidth - scProductsV2TabsNav.clientWidth;
          scProductsV2TabsNav.scrollTo({
            left: Math.max(0, Math.min(target, max)),
            behavior: instant ? "auto" : "smooth"
          });
        }

        function scProductsV2NearestTabIndex() {
          var navRect = scProductsV2TabsNav.getBoundingClientRect();
          var navCenter = navRect.left + navRect.width / 2;
          var nearestIdx = 0;
          var nearestDist = Infinity;
          for (var i = 0; i < scProductsV2Tabs.length; i++) {
            var tabRect = scProductsV2Tabs[i].getBoundingClientRect();
            var dist = Math.abs((tabRect.left + tabRect.width / 2) - navCenter);
            if (dist < nearestDist) {
              nearestDist = dist;
              nearestIdx = i;
            }
          }
          return nearestIdx;
        }

        function scProductsV2ActivateTab(idx) {
          for (var j = 0; j < scProductsV2Tabs.length; j++) {
            scProductsV2Tabs[j].classList.remove("is-active");
            scProductsV2Tabs[j].setAttribute("aria-pressed", "false");
          }
          scProductsV2Tabs[idx].classList.add("is-active");
          scProductsV2Tabs[idx].setAttribute("aria-pressed", "true");
          scProductsV2LoadTab(idx);
        }

        function scProductsV2SettleTabs() {
          var idx = scProductsV2NearestTabIndex();
          scProductsV2CenterTab(scProductsV2Tabs[idx]);
          if (idx !== scProductsV2CurrentIndex) scProductsV2ActivateTab(idx);
        }

        // Igual que el swiper de tienda (centeredSlides): al soltar el dedo, el tab
        // más cercano al centro se activa al instante. Swiper no usa el scroll nativo,
        // así que no espera a que termine la inercia del navegador; por eso se ve
        // inmediato. Reaccionamos en "touchend" (no en "scroll") para igualar ese
        // comportamiento: se calcula y centra apenas se suelta, interrumpiendo
        // cualquier inercia nativa en curso.
        var scProductsV2TabsScrollTimer;
        var scProductsV2TabsTouching = false;

        scProductsV2TabsNav.addEventListener("touchstart", function () {
          scProductsV2TabsTouching = true;
        }, { passive: true });

        scProductsV2TabsNav.addEventListener("touchend", function () {
          scProductsV2TabsTouching = false;
          if (!scProductsV2TabsCarouselMode()) return;
          clearTimeout(scProductsV2TabsScrollTimer);
          scProductsV2SettleTabs();
        }, { passive: true });

        // Respaldo para mouse/trackpad (sin eventos touch): mantiene el debounce
        // sobre "scroll" para ese caso.
        scProductsV2TabsNav.addEventListener("scroll", function () {
          if (scProductsV2TabsTouching || !scProductsV2TabsCarouselMode()) return;
          clearTimeout(scProductsV2TabsScrollTimer);
          scProductsV2TabsScrollTimer = setTimeout(scProductsV2SettleTabs, 150);
        }, { passive: true });

        function scProductsV2LoadTab(index) {
          if (index === scProductsV2CurrentIndex) return;
          scProductsV2CurrentIndex = index;
          scProductsV2GridShowLoading(scProductsV2Grid);

          var config = SC_PRODUCTS_V2_TAB_CONFIG[index];
          if (!config) return;

          if (scProductsV2DataCache[index]) {
            scProductsV2GridRender(scProductsV2Grid, scProductsV2DataCache[index]);
            return;
          }

          fetch(scProductsV2BuildApiUrl(config.params))
            .then(function (r) {
              if (!r.ok) throw new Error('HTTP ' + r.status);
              return r.json();
            })
            .then(function (json) {
              if (index !== scProductsV2CurrentIndex) return;
              if (json.success && Array.isArray(json.data)) {
                scProductsV2DataCache[index] = json.data;
                scProductsV2GridRender(scProductsV2Grid, json.data);
              } else {
                scProductsV2GridShowError(scProductsV2Grid, 'Error al cargar productos.');
              }
            })
            .catch(function (err) {
              if (index !== scProductsV2CurrentIndex) return;
              scProductsV2GridShowError(scProductsV2Grid, 'Error de conexi\u00F3n. Intente nuevamente.');
            });
        }

        for (var i = 0; i < scProductsV2Tabs.length; i++) {
          (function (idx) {
            scProductsV2Tabs[idx].addEventListener("click", function () {
              scProductsV2ActivateTab(idx);
              scProductsV2CenterTab(scProductsV2Tabs[idx]);
            });
          })(i);
        }

        var scProductsV2ResizeTimer;
        window.addEventListener("resize", function () {
          clearTimeout(scProductsV2ResizeTimer);
          scProductsV2ResizeTimer = setTimeout(function () {
            if (scProductsV2LastFlatHtml) scProductsV2LayoutGrid(scProductsV2Grid);
            scProductsV2SetTabsEdgePadding();
            var activeTab = document.querySelector(".sc_products_v2__tab.is-active");
            if (activeTab) scProductsV2CenterTab(activeTab, true);
          }, 150);
        });

        scProductsV2Grid.addEventListener("click", function (e) {
          var card = e.target.closest(".sc_products_v2__card");
          if (!card) return;
          if (e.target.closest("a")) return;
          var btn = card.querySelector(".sc_products_v2__card__btn");
          if (btn) btn.click();
        });

        scProductsV2SetTabsEdgePadding();
        scProductsV2CenterTab(scProductsV2Tabs[0], true);
        scProductsV2LoadTab(0);
      });
    })();
