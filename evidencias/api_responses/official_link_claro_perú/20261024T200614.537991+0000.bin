      font-size: 14px;
      font-style: normal;
      font-weight: 500;
      line-height: normal;
      text-decoration: underline;
    }

    .contentForm .formBC__footer button.active {
      background-color: #ee122c;
      color: #ffffff;
      pointer-events: all;
    }


