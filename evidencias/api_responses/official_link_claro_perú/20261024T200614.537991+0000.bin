    }

    .sliderTabsView .slick-prev {
      left: -80px;
    }

    .sliderTabsView .slick-next {
      right: -80px;
    }

    .sliderTabsView .slick-prev:before,
    .sliderTabsView .slick-next:before {
      content: "\e90f" !important;
      font-family: "claroicons";
font-size: 2.5rem;
      color: #3C3C3C !important;
opacity: 1 !important;
    }

    .sliderTabsView .slick-next:before {
      content: "\e911" !important;
font-size: 2.5rem;
      font-family: "claroicons";
      color: #3C3C3C !important;
opacity: 1 !important;
    }

    .c09.bgWhiteSpace.pTB30 {
      overflow: hidden;
    }

    @media (max-width: 1330px) {
      .c09.bgWhiteSpace.pTB30 .sliderTabsView .slick-prev {
        left: -44px;
      }

      .c09.bgWhiteSpace.pTB30 .sliderTabsView .slick-next {
        right: -44px;
      }
    }

    @media (max-width: 1250px) {
      .c09.bgWhiteSpace.pTB30 .js-c09SliderFull {
        padding: 0 50px;
      }

      .c09.bgWhiteSpace.pTB30 .sliderTabsView .slick-prev {
        left: 0px;
      }

      .c09.bgWhiteSpace.pTB30 .sliderTabsView .slick-next {
        right: 0px;
      }
    }

    @media (max-width: 700px) {

      .c09.bgWhiteSpace.pTB30 .sliderTabsView .slick-next,
      .c09.bgWhiteSpace.pTB30 .sliderTabsView .slick-prev {
        display: none !important;
      }

      .c09.bgWhiteSpace.pTB30 .js-c09SliderFull {
        padding: 0;
      }
    }
