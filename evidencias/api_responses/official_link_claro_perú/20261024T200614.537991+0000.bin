              background-repeat: no-repeat;
              height: 9px;
              background-size: 100%;
              top: 19px;
              right: 18px;
              z-index: 1;
            }

            .formulario.modulo .contentSelect.valid::before,
            .formulario.modulo .contentSelect.invalid::before {
              display: none;
