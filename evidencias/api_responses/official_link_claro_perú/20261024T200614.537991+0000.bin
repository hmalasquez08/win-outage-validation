    .sc_articles * {
      box-sizing: border-box;
    }


    .sc_articles__title {
      text-align: center;
      font-size: 24px;
      text-wrap: balance;
    }

    .sc_articles__wrapper {
      padding-top: 20px;
    }

    .sc_articles__card {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      position: relative;
      padding-top: 4px;
    }

    .sc_articles__card__picture {
      display: block;
      position: relative;
      transition: all ease-in-out 300ms;
    }

    .sc_articles__card__picture::before,
    .sc_articles__card__picture::after {
      content: '';
      display: block;
      width: 148px;
      height: 148px;
      position: absolute;
      left: 50%;
      transform: translateX(-50%) translateY(-50%) scale(1);
      top: 55%;
      border-radius: 100%;
      z-index: 1;
      transition: transform .4s ease, height .4s ease, opacity .4s ease;
    }

    section.sc_articles .contentImg {
      width: 110px;
      height: 110px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    section.sc_articles .slick-list {
      padding-top: 40px !important;
      padding-bottom: 10px !important;
    }

    section.sc_articles .contentImg::before,
    section.sc_articles .contentImg::after {
      content: '';
      display: block;
      width: 100%;
      height: 100%;
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translateX(-50%) translateY(-50%) scale(1);
      border-radius: 100%;
      z-index: 1;
      transition: transform .4s ease, height .4s ease, opacity .4s ease;
    }

    .sc_articles__card__picture::before,
    section.sc_articles .contentImg::before {
      background: linear-gradient(113.96deg, #E0E7F6 0%, #E0E7F6 100%);
      opacity: 1;
      z-index: 1;
    }

    .sc_articles__card__picture::after,
    section.sc_articles .contentImg::after {
      background: linear-gradient(180deg, #7ECCCF 0%, #B2E3D3 100%);
      opacity: 0;
      z-index: 2;
    }

    @media (min-width:501px) {

      .sc_articles__card:hover .sc_articles__card__picture::before,
      section.sc_articles .sc_articles__card:hover .contentImg::before {
        opacity: 0;
        transform: translateX(-50%) translateY(-50%) scale(1.29);
      }

      .sc_articles__card:hover .sc_articles__card__picture::after,
      section.sc_articles .sc_articles__card:hover .contentImg::after {
        opacity: 1;
        transform: translateX(-50%) translateY(-50%) scale(1.29);
        background: linear-gradient(180deg, #7ECCCF 0%, #B2E3D3 100%);
      }

      section.sc_articles .sc_articles__card:hover .sc_articles__card__image.blanco {
        filter: brightness(0) invert(1);
        -webkit-filter: brightness(0) invert(1);
      }

    }


    .sc_articles__card__image {
      /*max-width: 120px;*/
      object-fit: cover;
      position: relative;
      z-index: 2;
      transition: all ease-in-out 300ms;
      z-index: 3;
      width: auto;
      transform: scale(0.35);
      max-width: initial;
    }

    @media (max-width: 500px) {
      section.sc_articles .slick-active .sc_articles__card__image.blanco {
        transform: scale(0.47);
      }
    }

    .globo {
      object-fit: cover;
      position: relative;
      z-index: 2;
      transition: all ease-in-out 300ms;
      z-index: 3;
      width: auto;
      transform: scale(0.27);
      max-width: initial;
      position: absolute;
      top: -93px;
    }

    @media (max-width: 500px) {
      .globo {
        top: -97px;
      }
    }

    @media (max-width:500px) {
      section.sc_articles .slick-active .contentImg::before {
        opacity: 0;
        transform: translateX(-50%) translateY(-50%) scale(1.29);
      }

      section.sc_articles .slick-active .contentImg::after {
        opacity: 1;
        transform: translateX(-50%) translateY(-50%) scale(1.29);
        background: linear-gradient(180deg, #7ECCCF 0%, #B2E3D3 100%);
      }

      section.sc_articles .slick-active .sc_articles__card__body__title {
        color: #228E9B;
      }

      /*
      .sc_articles__card__image {
        transform: scale(0.4);
      }*/
      /*
      section.sc_articles .contentImg {
        width: 130px;
        height: 130px;
      }*/
    }

    section.sc_articles [data-campaign="cyberwow"] .contentImg::before {
      background: linear-gradient(0deg, #0433FF 0%, #021F99 100%);
    }

    /* Logo images (SVG) have their own size, so they skip the scale used for the big PNGs */
    section.sc_articles .sc_articles__card__image.is-logo,
    section.sc_articles .slick-active .sc_articles__card__image.blanco.is-logo {
      transform: none;
      width: 80px;
      height: auto;
    }

    .sc_articles__card__body {
      padding-top: 26px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .sc_articles__card__body__title {
      font-size: 16px;
      font-family: 'AMX Medium';
      font-weight: 500;
      width: 100%;
      max-width: 100%;
      text-align: center;
      line-height: 1.1;
      min-height: inherit;
      transition: .4s ease;
    }

    .sc_articles__card__body__price {
      background-color: #FFC721;
      font-size: 14px;
      line-height: normal;
      font-family: 'AMX';
      font-weight: 400;
      text-align: center;
      padding: 3px 6px;
      width: fit-content;
      margin: 0 auto;
      border-radius: 6px;
    }

    .sc_articles__card__btn {
      background-color: #FFC722;
      width: 40px;
      height: 40px;
      border-radius: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      top: 70%;
      left: 50%;
      position: absolute;
      transform: translateX(-50%) translateY(-50%);
      z-index: 2;
      opacity: 0;
      transition: all ease-in-out 300ms;
      opacity: 0 !important;
    }

    /*
    @media (min-width: 960px) {
      .sc_articles__list {
        padding: 0 40px !important;
      }
    }
    */

    .sc_articles__list .slick-dots {
      display: flex !important;
      justify-content: center;
      position: static;
      margin-top: 24px;
    }

    .sc_articles__list .slick-dots li {
      transition: all .5s ease;
      border-radius: 6px;
      width: 12px;
      height: 12px;
      margin: 0 6px;
      position: relative;
    }

    .sc_articles__list .slick-dots li.slick-active {
      width: 40px;
    }

    .sc_articles__list .slick-dots li.slick-active button {
      background-color: #DA291C;
    }

    .sc_articles__list .slick-dots li button {
      transition: all .5s ease;
      border-radius: 6px;
      width: 100%;
      height: 12px;
      padding: 0;
      background: #DBDBDB;
    }


    .sc_articles__list .slick-prev,
    .sc_articles__list .slick-next {
      z-index: 10;
    }

    .sc_articles__list .slick-prev:before {
      content: "\e90f";
      font-family: "claroicons";
      font-size: 2.5rem;
      color: #3C3C3C;
      opacity: 1;
    }

    .sc_articles__list .slick-next:before {
      content: "\e911";
      font-size: 2.5rem;
      font-family: "claroicons";
      color: #3C3C3C;
      opacity: 1;
    }

    /* @media (min-width:400px) {
      .sc_articles__card__image {
        max-width: 120px;
      }
    }*/

    @media (min-width:768px) {
      .sc_articles__title {
        font-size: 32px;
      }
    }

    @media (min-width:1200px) {
      .sc_articles__list {
        padding: 0 2rem;
      }

      .sc_articles .container {
        padding: 0 20px !important;
      }

      .sc_articles__card:hover .sc_articles__card__btn {
        opacity: 1;
        top: 50%;
      }

      /*
      .sc_articles__card:hover .sc_articles__card__picture {
        transform: scale(1.15);
      }*/


      .sc_articles__card:hover .sc_articles__card__body__title {
        color: #228E9B;
      }

      .sc_articles__card__body__title {
        max-width: 100%;
        min-height: inherit;
      }

      .sc_articles__card__body__price {
        font-size: 12px;
      }

      .sc_articles__list .slick-prev {
        display: block !important;
      }

      .sc_articles__list .slick-next {
        display: block !important;
      }
    }

    @media (min-width:1600px) {
      .sc_articles__list {
        padding: 0;
      }

      .sc_articles__list .slick-dots {
        display: none !important;
      }

      .sc_articles__title {
        font-size: 36px;
      }
    }



    .sc_articles__list .slick-prev {
      left: -0 !important;
    }

    .sc_articles__list .slick-next {
      right: 19px !important;
    }

    @media (max-width: 639px) {
      .containerSliderTienda {
        padding: 0 !important;
      }
    }
  </style><style>
