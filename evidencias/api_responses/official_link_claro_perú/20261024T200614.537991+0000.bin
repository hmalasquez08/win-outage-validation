      /* Estilos modal */
      .modalMasInformacion .masInfoCard {
        position: relative;
        width: 428px;
        min-height: 446px;
        margin: 0 auto;
        border-radius: 10px;
        box-sizing: border-box;
        font-family: Roboto, sans-serif;
        overflow: visible;
        padding: 16px 0 20px;
        max-height: 100%;
        overflow: auto;
        -webkit-overflow-scrolling: touch;
      }

      .modalMasInformacion .fondo-blanco {
        background: #fff;
      }

      .modalMasInformacion .fondo-gris-claro {
        /*background: linear-gradient(180deg,
          rgba(255, 255, 255, 0.9) 0%,
          rgba(244, 244, 244, 0.9) 100%) !important;*/
        background: linear-gradient(180deg, rgb(233 233 233) 0%, rgb(228 228 228) 100%) !important;
      }

      .modalMasInformacion .fondo-gris-oscuro {
        background: #e2e8f0;
      }

      .modalMasInformacion .fondo-personalizado {
        background: #edf2f7;
      }

      .modalMasInformacion .infoHeader {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 20px;
      }

      .modalMasInformacion .nombrePlan {
        margin: 0;
        flex: 1;
        font-size: 20px;
        font-weight: 700;
        line-height: 1.25;
        color: #2d2d2d;
        font-family: "AMX", "Roboto", sans-serif;
      }
      .modalMasInformacion .infoCerrar {
        background: rgba(30, 30, 30, .6);
        border: 0;
        border-radius: 0;
        box-shadow: none;
        cursor: pointer;
        display: inline-block;
        height: 44px;
        margin: 0;
        padding: 10px;
        position: relative;
        transition: color .2s;
        vertical-align: top;
        visibility: inherit;
        width: 44px;
        background: transparent;
        border: 0;
        border-radius: 0;
        color: #ccc;
        cursor: pointer;
        opacity: .8;
        padding: 8px;
        position: absolute;
        right: -12px;
        top: -44px;
        z-index: 401;
        color: currentColor;
        padding: 10px;
        right: 0;
        top: 0;
      }

      .modalMasInformacion .infoCerrar::before {
        font-size: 1.5rem;
        content: "\ea0f";
        font-family: "claroicons";
      }

      .modalMasInformacion .seccion--info {
        padding: 24px 20px 0 20px;
      }

      .modalMasInformacion .preview-seccion {
        position: relative;
        border: 1px dashed #0055a5;
        border-radius: 4px;
        padding: 12px 8px 8px;
        margin: 0 8px 10px;

        &.seccion--info {
          margin-top: 8px;
        }
      }

      .modalMasInformacion .preview-label {
        position: absolute;
        top: -9px;
        left: 8px;
        background: #0055a5;
        color: #fff;
        font-size: 10px;
        font-weight: 600;
        padding: 1px 6px;
        border-radius: 4px;
        pointer-events: none;
        white-space: nowrap;
        text-transform: none;
        letter-spacing: normal;
      }

      .modalMasInformacion .seccionFila {
        display: flex;
        align-items: stretch;
        gap: 0px;
        padding: 0 16px;
        padding: 0 36px;
        margin-bottom: 20px;

        .preview-seccion {
          flex: 1;
          min-width: 0;
          margin: 0;
          width: 33.33%;
          padding: 8px 20px;
          margin-bottom: 20px;
        }
      }

      .modalMasInformacion .modalMasInformacion .seccion--mitad {
        /*flex: 1;*/
        min-width: 0;
      }

      .modalMasInformacion .preview-seccion .seccionCuerpo,
      .modalMasInformacion .preview-seccion .desplegableLista {
        padding: 0;
      }

      .modalMasInformacion .seccion--legal {
        padding: 0 20px;
        margin-bottom: 20px;
      }

      /*.modalMasInformacion .seccionCuerpo {
      padding: 8px 12px 12px;
    }*/
      .modalMasInformacion .seccion--info .seccionCuerpo--info {
        margin-bottom: 16px;
      }

      .modalMasInformacion .seccionCuerpo.seccionCuerpo--precio,
      .modalMasInformacion .seccionCuerpo.seccionCuerpo--redes {
        padding: 8px 20px 12px 20px;
      }

      @media (max-width: 500px) {

        .modalMasInformacion .seccionCuerpo.seccionCuerpo--precio,
        .modalMasInformacion .seccionCuerpo.seccionCuerpo--redes {
          padding: 0;
        }
      }

      .modalMasInformacion .seccion {
        position: relative;
      }

      .modalMasInformacion .infoConoceMas {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        /*margin: 0 0 14px;*/
        padding: 12px;
        background: #f4f6f8;
        border-radius: 8px 8px 0 0;
        text-align: center;
        width: calc(25% - 8px);
        background: #f4f4f4;
        border: 1px solid #f4f4f4;
      }

      .modalMasInformacion .infoConoceMasIcono {
        display: flex;
        line-height: 0;
      }

      .modalMasInformacion .infoConoceMasTexto,
      .modalMasInformacion .infoConoceMasTexto.movil {
        font-size: 12px;
        font-weight: 700;
        color: #333;
        line-height: 1.2;
        font-family: Roboto, sans-serif;
      }

      .modalMasInformacion .infoConoceMasTexto.movil {
        display: none;
      }

      @media (max-width: 500px) {
        .modalMasInformacion .infoConoceMasTexto {
          display: none;
        }

        .modalMasInformacion .infoConoceMasTexto.movil {
          display: block;
          font-family: Roboto, sans-serif;
          font-size: 12px;
          font-weight: 700;
          color: #333;
          line-height: 1.2;
          padding: 16px 20px 0 20px;
          background: #f4f4f4;
        }
      }

      .modalMasInformacion .infoSubtitulo {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        color: #000;
        line-height: 1.3;
        background: #f4f4f4;
      }

      @media (max-width: 500px) {
