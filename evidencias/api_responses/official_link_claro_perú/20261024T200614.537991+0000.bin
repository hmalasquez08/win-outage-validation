    .modalFormulario {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100dvh;
      background: #000000ab;
      transition-timing-function: cubic-bezier(.47, 0, .74, .71);
      align-items: center;
      justify-content: center;
      padding: 30px 0;
      z-index: 999;
    }

    .modalFormulario.active {
      display: flex;
    }

    .modalFormulario .modalPeLegal {
      display: none;
    }

    .modalFormulario .modalPeLegal.active {
      display: inline-block;
    }

    .modalFormulario .modalPeLegalCont {
      max-height: 340px;
      overflow-y: scroll;
    }

    .modalFormulario .modalPeLegalCont::-webkit-scrollbar-thumb {
      -webkit-border-radius: 4px;
      -moz-border-radius: 4px;
      border-radius: 4px;
      background-color: rgba(0, 0, 0, 0.5);
    }

    .modalFormulario .modalPeLegalCont::-webkit-scrollbar {
      -webkit-appearance: none;
      width: 7px;
    }

    .modalFormulario .fancybox-content {
      background: #fff;
      display: inline-block;
      margin: 0;
      max-width: 100%;
      overflow: auto;
      -webkit-overflow-scrolling: touch;
      padding: 44px;
      padding-bottom: 26px;
      position: relative;
      text-align: left;
      vertical-align: middle;
      border-radius: 32px;
      width: 760px;
      margin: 0 20px;
      display: none;
    }

    .modalFormulario .fancybox-content.active {
      display: inline-block;
    }

    .modalFormulario .modalPeLegalTitle {
      color: #283342;
      font-family: AMX;
      font-size: 24px;
      font-style: normal;
      font-weight: 700;
      line-height: normal;
      margin-bottom: 15px;
      padding-right: 45px;
    }

    .modalFormulario .modalPeLegalCont p {
      color: #283342;
      font-family: Roboto;
      font-size: 16px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
    }

    .modalFormulario .modalPeLegalCont p a {
      color: #0097A9;
      font-family: Roboto;
      font-size: 16px;
      font-style: normal;
      font-weight: 700;
      line-height: normal;
      text-decoration: underline;
    }

    .modalFormulario .btn.btnPrimario {
      border-radius: 25px;
      background: #DA291C;
      width: 140px;
      margin: 0 auto;
      margin-top: 20px;
      display: flex;
