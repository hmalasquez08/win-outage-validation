1790972768" target="_self"><picture id="IMG-3-83374254-5f10-4e0c-9640-a2ab5e9de048"><source class="lazyloaded" loading="lazy" media="(max-width: 640px)" data-srcset="/portal/pe/recursos_contenido/1791922837431-iphone18-pro-postpago-claroperu-mb.webp" type="image/webp"><source class="lazyloaded" loading="lazy" media="(max-width: 640px)" data-srcset="/portal/pe/recursos_contenido/1791922837431-iphone18-pro-postpago-claroperu-mb.jpg" type="image/jpg"><source class="lazyloaded" loading="lazy" media="(min-width: 640px)" data-srcset="/portal/pe/recursos_contenido/1791922832783-iphone18-pro-postpago-claroperu-dk.webp" type="image/webp"><source class="lazyloaded" loading="lazy" media="(min-width: 640px)" data-srcset="/portal/pe/recursos_contenido/1791922832783-iphone18-pro-postpago-claroperu-dk.jpg" type="image/jpg"><img class="lazyload" data-src="/portal/pe/recursos_contenido/1791922832783-iphone18-pro-postpago-claroperu-dk.jpg" alt="iPhone 18 pro" title="iPhone 18 pro" width="" height="" loading="lazy"></picture></a></div></div></div><div class="hcarousel__item Blancas"><div class="content" data-content="type1"><div class="content__image"><a id="C01-4-4--tienda-claro_" data-module="C01" data-variant="V1" data-slot="4" _ data-index=" 4" href="https://tienda.claro.com.pe/personas/catalogo-celulares/postpago/portabilidad/si?initialMap=c,c,c&map=category-1,category-2,category-3,modalidad,plan-destacado&order=&searchState&utm_campaign=performance_tienda&utm_source=medios_propios&utm_medium=claro_pe&utm_content=carrusel_principal-tiendaclaro_postpago&utm_term=postpago-portabilidad%2Brenovacion&cu=cp1791990541" target="_self"><picture id="IMG-4-83374254-5f10-4e0c-9640-a2ab5e9de048"><source class="lazyloaded" loading="lazy" media="(max-width: 640px)" data-srcset="/portal/pe/recursos_contenido/1791990477951-tiendaclaro-galaxy-claro-mb.webp" type="image/webp"><source class="lazyloaded" loading="lazy" media="(max-width: 640px)" data-srcset="/portal/pe/recursos_contenido/1791990477951-tiendaclaro-galaxy-claro-mb.jpg" type="image/jpg"><source class="lazyloaded" loading="lazy" media="(min-width: 640px)" data-srcset="/portal/pe/recursos_contenido/1791991090078-tiendaclaro-equipos-claro-dk.webp" type="image/webp"><source class="lazyloaded" loading="lazy" media="(min-width: 640px)" data-srcset="/portal/pe/recursos_contenido/1791991090078-tiendaclaro-equipos-claro-dk.jpg" type="image/jpg"><img class="lazyload" data-src="/portal/pe/recursos_contenido/1791991090078-tiendaclaro-equipos-claro-dk.jpg" alt="Galaxy A57" title="Galaxy A57" width="" height="" loading="lazy"></picture></a></div></div></div><div class="content" data-content="type1"><div class="content__image"><a href="https://www.clarolareddelavelocidad.com/" target="_blank" id="Slider1-personas-claro-gp---espa-ntilde-a-"><picture class="c01SldBg" id="IMG-4-83374254-5f10-4e0c-9640-a2ab5e9de048"><source media="(max-width: 640px)" data-srcset="/portal/pe/recursos_contenido/INVITACION-GP-AUSTIN-19-Octubre-26-Octubre-520x550-PORTAL_MOVIL.webp" type="image/webp"><source media="(max-width: 640px)" data-srcset="/portal/pe/recursos_contenido/INVITACION-GP-AUSTIN-19-Octubre-26-Octubre-520x550-PORTAL_MOVIL.jpg" type="image/jpg"><source media="(min-width: 640px)" data-srcset="/portal/pe/recursos_contenido/INVITACION-GP-AUSTIN-19-Octubre-26-Octubre-1540x480-PORTAL_ESCRITORIO.webp" type="image/webp"><source media="(min-width: 640px)" data-srcset="/portal/pe/recursos_contenido/INVITACION-GP-AUSTIN-19-Octubre-26-Octubre-1540x480-PORTAL_ESCRITORIO.png" type="image/jpg"><img class="lazyload" data-src="/portal/pe/recursos_contenido/INVITACION-GP-AUSTIN-19-Octubre-26-Octubre-1540x480-PORTAL_ESCRITORIO.png" alt="INVITACIÓN GP AUSTIN" title="INVITACIÓN GP AUSTIN" width="1700" height="400"></picture></a></div></div></div></div></div></div></div><div class="modalFormulario"><div class="modalPeLegal fancybox-content" id="modalTratamiento"><div class="modalPeLegalTitle"> Tratamiento de mis datos personales </div><div class="modalPeLegalCont"><p>Autorizo a AMERICA MOVIL PERU S.A.C. con domicilio en Av. Nicolás Arriola N° 480, Santa Catalina, La Victoria, provincia y departamento de Lima (CLARO), para tratar mis datos personales y registrarlos en el Banco de Datos Personales “Clientes” de su titularidad, con la finalidad de llamarme o enviarme mensajes de texto (SMS), mensajes electrónicos y/o correos electrónicos con contenido informativo, publicitario y/o promocional sobre los productos y/o servicios que he solicitado mediante este formulario. Declaro conocer que (i) mis datos serán registrados por el tiempo necesario para cumplir con la finalidad expuesta, o hasta que decida revocar mi autorización, (ii) CLARO podrá compartir su información con terceros encargados del tratamiento de sus datos personales, (iii) mi autorización resulta facultativa, pero en caso de negativa, la finalidad expuesta no podrá realizarse, (iv) podré ejercer los derechos ARCO (Acceso, Rectificación, Cancelación y Oposición); en los puntos de atención designados para tal efecto o a través del siguiente enlace. Para consultar el detalle de los encargados de tratamiento y mayor información, revisa nuestra <a href="https://www.claro.com.pe/proteccion-datos/" target="_blank" rel="noopener noreferrer" class="textLink">Política de Privacidad</a>.</p></div><div class="modalPeLegalBtn"><a class="btn btnPrimario">Entendido</a></div><button type="button" data-fancybox-close="" class="fancybox-button fancybox-close-small" title="Close"><svg xmlns="http://www.w3.org/2000/svg" version="1" viewBox="0 0 24 24"><path d="M13 12l5-5-1-1-5 5-5-5-1 1 5 5-5 5 1 1 5-5 5 5 1-1z"/></svg></button></div><div class="modalPeLegal fancybox-content" id="modalPublicidad"><div class="modalPeLegalTitle"> Solicito recibir publicidad de CLARO </div><div class="modalPeLegalCont"><p>En aplicación del artículo 58 e) de la Ley N.° 29571, solicito, mediante mi consentimiento libre, previo, informado, expreso e inequívoco, que AMÉRICA MÓVIL PERÚ S.A.C., con domicilio en Av. Nicolás Arriola N.° 480, Santa Catalina, La Victoria, Lima (CLARO), me contacte con fines publicitarios y de prospección comercial por llamadas, SMS, mensajes electrónicos, correos electrónicos y/o cualquier otro medio análogo, sobre cualquier producto y/o servicio de CLARO, a la línea telefónica y/o correo electrónico utilizados para completar este formulario.</p><p>Declaro conocer que: (i) mis datos personales proporcionados en este formulario serán registrados en el Banco de Datos Personales “Clientes” de CLARO para cumplir con la finalidad expuesta; (ii) mis datos personales serán conservados mientras mantenga vigente mi consentimiento, esto es, hasta que decida revocarlo, momento a partir del cual dejaré de ser contactado con fines publicitarios; (iii) CLARO podrá compartir mis datos personales con encargados de tratamiento; (iv) mi consentimiento es facultativo, por lo que, en caso de negativa, la finalidad publicitaria no podrá realizarse; y, (v) podré ejercer mis derechos de acceso, rectificación, cancelación, oposición y portabilidad, así como revocar mi consentimiento en cualquier momento y sin justificación previa, en los puntos de atención designados o a través del siguiente <a href="https://www.claro.com.pe/legal-y-regulatorio/derechos-arco/" target="_blank" rel="noopener noreferrer" class="textLink">enlace</a>.</p><br><p class="section__modals__modal-main-text">Podré consultar el detalle de los encargados de tratamiento y mayor información sobre las condiciones del tratamiento de mis datos personales, revisando la <a href="https://www.claro.com.pe/proteccion-datos/" target="_blank" rel="noopener noreferrer" class="textLink">Política de Privacidad</a>.</p></div><div class="modalPeLegalBtn"><a class="btn btnPrimario">Entendido</a></div><button type="button" data-fancybox-close="" class="fancybox-button fancybox-close-small" title="Close"><svg xmlns="http://www.w3.org/2000/svg" version="1" viewBox="0 0 24 24"><path d="M13 12l5-5-1-1-5 5-5-5-1 1 5 5-5 5 1 1 5-5 5 5 1-1z"/></svg></button></div></div><section class="c04C bgWhiteSpace"><div class="container"><div class="c04CGridText"><h2>¿En qué podemos ayudarte?</h2></div><div class="c04CGrid"><div class="c04CGridSlider" id="caja"><a id="C04-1-cambiate-a-claro" data-module="C04" data-variant="V1-C" data-slot="1" class="c04CGridEle" href="https://www.claro.com.pe/portabilidad/" target="_self"><picture class="c04CGridEleImg" id="IMG-1-e80736bb-5ef6-4b9a-a08d-c4c4bfa64992"><source class="lazyloaded" loading="lazy" media="(max-width: 640px)" data-srcset="/portal/pe/recursos_contenido/1770840363782-card-1.webp" type="image/webp"><source class="lazyloaded" loading="lazy" media="(max-width: 640px)" data-srcset="/portal/pe/recursos_contenido/1770840363782-card-1.png" type="image/png"><source class="lazyloaded" loading="lazy" media="(min-width: 640px)" data-srcset="/portal/pe/recursos_contenido/1770840358968-card-1.webp" type="image/webp"><source class="lazyloaded" loading="lazy" media="(min-width: 640px)" data-srcset="/portal/pe/recursos_contenido/1770840358968-card-1.png" type="image/png"><img class="lazyload" data-src="/portal/pe/recursos_contenido/1770840358968-card-1.png" alt="Cámbiate a Claro" title="Cámbiate a Claro" width="264" height="324" loading="lazy"></picture><span class="c04CGridEleImgOverBefore">&nbsp;</span><span class="c04CGridEleImgOverAfter">&nbsp;</span><div class="c04CGridEleText"><h3>Cámbiate a Claro</h3><p>Accede a un mundo de beneficios</p></div><div id="C04-1-cambiate-a-claro_conoce-mas" data-module="C04" data-variant="V1-C" data-slot="1" class="c04CGridEleFakeLink"><span class="iconTextLink"> Conoce más <i class="ico-arrow-right-circle"></i></span></div><span class="c04CGridEleBorder">&nbsp;</span></a><a id="C04-2-claro-hogar" data-module="C04" data-variant="V1-C" data-slot="2" class="c04CGridEle" href="https://www.claro.com.pe/personas/hogar/internet-fibra-optica/" target="_self"><picture class="c04CGridEleImg" id="IMG-2