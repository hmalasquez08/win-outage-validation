function limpiaNombreC94(cadena){
      var specialChars = '!@#$^&%*()+=-[]\/{}|:<>¿?,.#¡"';
      for (var i = 0; i < specialChars.length; i++) {
        cadena= cadena.replace(new RegExp("\\" + specialChars[i], 'gi'), '');
      }   
      cadena = cadena.toLowerCase();
      cadena = cadena.replace(/ /g,"-");
      cadena = cadena.normalize('NFD').replace(/[\u0300-\u036f]/g,"");
      if(cadena.endsWith('_')) cadena = cadena.substring(0, (cadena.length-1));
      if(cadena.endsWith('-')) cadena = cadena.substring(0, (cadena.length-1));
      if(cadena.startsWith('-')) cadena = cadena.substring(1, cadena.length);
      return cadena;
    } 
   function getTagComponenteC94(modulo, posicion, variante, titulo, texto, showId) {     
      var taggeo = '';
      if(showId){
        if(titulo.endsWith(' ')) titulo = titulo.substring(0, (titulo.length-1));
        if(titulo == ''){
          taggeo += ' id="' + modulo + '-' + posicion + '_' + limpiaNombreC94(texto) + '"';
          taggeo += ' data-id="' + modulo + '-' + posicion + '_' + limpiaNombreC94(texto) + '"';
        } else {
          taggeo += ' id="' + modulo + '-' + posicion + '-' + limpiaNombreC94(titulo + '_' + texto) + '"';
          taggeo += ' data-id="' + modulo + '-' + posicion + '-' + limpiaNombreC94(titulo + '_' + texto) + '"';
        }
      }
      taggeo += ' data-module="' + modulo + '"';
      taggeo += ' data-variant="' + variante + '"';
      taggeo += ' data-slot="' + posicion + '"';
      return taggeo;
    }

	var html94 = ''; 
	$('[id=tabBen]').each(function(index){
		if (index == 0){
			html94 += '<li ' + getTagComponenteC94('C94', (index+1), 'v1', $(this).val(), '', true) + ' class="active" data-slide="'+(index + 1)+'"><h3 class="h3">' + $(this).val() + '</h3><span></span><strong class="progressBar" data-slick-index="'+(index)+'"></strong></li>'
		} else {
			html94 += '<li ' + getTagComponenteC94('C94', (index+1), 'v1', $(this).val(), '', true) + ' data-slide="'+(index + 1)+'"><h3 class="h3">' + $(this).val() + '</h3><span></span><strong class="progressBar" data-slick-index="'+(index)+'"></strong></li>'
		}
	});
	$('#tabsBeneficios').html(html94);
