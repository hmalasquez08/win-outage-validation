    .sc_products_v2 {
      padding: 40px 0;
    }

    .sc_products_v2 * {
      box-sizing: border-box;
    }

    .sc_products_v2__title {
      text-align: center;
      font-size: 24px;
      text-wrap: balance;
      color: #1C1C1C;
    }

    .sc_products_v2__tabs {
      display: flex;
      gap: 28px;
      margin: 1.8rem 0 0;
      padding: 0 0 4px;
      overflow-x: auto;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .sc_products_v2__tabs::-webkit-scrollbar {
      display: none;
    }

    .sc_products_v2__tab {
      flex: 0 0 auto;
      background: none;
      border: 0;
      padding: 6px 2px 12px;
      font-family: 'AMX Regular';
      font-size: 1.125rem;
      font-weight: 700;
      color: #6c6c6c;
      position: relative;
      cursor: pointer;
      white-space: nowrap;
    }

    .sc_products_v2__tab::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 3px;
      border-radius: 3px;
      background: transparent;
    }

    .sc_products_v2__tab.is-active {
      color: #3c3c3c;
    }

    .sc_products_v2__tab.is-active::after {
      background: linear-gradient(90deg, rgba(218, 41, 28, 0) 0%, #DA291C 50%, rgba(218, 41, 28, 0) 100%);
    }

    .sc_products_v2__grid {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-top: 24px;
    }

    .sc_products_v2__vermas-wrap {
      display: flex;
      justify-content: center;
      margin-top: 8px;
    }

    .sc_products_v2__vermas-wrap[hidden] {
      display: none;
    }

    .sc_products_v2__vermas {
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      background: transparent url('https://claroperupoc.vtexassets.com/arquivos/vermasmenos_button_art_recomendados.svg') no-repeat center / contain;
      cursor: pointer;
      transform: rotate(180deg);
      transition: transform .5s;
    }

    .sc_products_v2__vermas.is-expanded {
      transform: rotate(0deg);
    }

    .sc_products_v2__card {
      background: linear-gradient(112deg, #DBDBDB 0%, #FFF 39.31%);
      box-shadow: 0 2px 16px 0 rgba(0, 0, 0, 0.08);
      border-radius: 20px;
      position: relative;
      padding: 20px;
      cursor: pointer;
      overflow: hidden;
      border: none;
    }

    /* ── Botón circular (todas las cards) ── */
    .sc_products_v2__card__btn {
      width: 40px;
      height: 40px;
      background: #FFC722;
      border-radius: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      right: 16px;
      bottom: 16px;
      z-index: 3;
      cursor: pointer;
      transition: all 0.5s ease;
      box-shadow: 0 4px 16px 0 rgba(250, 156, 45, 0.74);
      border: none;
      outline: none;
      text-decoration: none;
      overflow: hidden;
      gap: 8px;
      padding: 0;
    }

    .sc_products_v2__card__btn svg {
      flex-shrink: 0;
      transition: transform 0.3s ease;
    }

    .sc_products_v2__card__btn::before {
      content: "Conoce más";
      color: #3C3C3C;
      text-align: center;
      font-family: 'Roboto';
      font-size: 16px;
      font-style: normal;
      font-weight: 700;
      line-height: 20px;
      text-decoration: none;
      white-space: nowrap;
      /*display: none;
      opacity: 0;*/
      transition: all .5s ease;
      width: 0;
      height: 0;
      white-space: nowrap;
      overflow: hidden;
      opacity: 0;
    }

    .sc_products_v2__card__btnv2 {
      -moz-box-sizing: border-box;
      -webkit-box-sizing: border-box;
      box-sizing: border-box;
      -webkit-transition: all .3s ease;
      -moz-transition: all .3s ease;
      -ms-transition: all .3s ease;
      transition: all .3s ease;
      border-radius: 40px;
      font-family: 'Roboto';
      font-size: 16px;
      font-style: normal;
      font-weight: 700;
      line-height: 20px;
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      overflow: hidden;
      position: relative;
      border: none;
      height: 40px;
      color: #3C3C3C;
      background: #FFC722;
      box-shadow: 0 4px 16px 0 rgba(250, 156, 45, 0.74);
      align-self: end;
      max-width: 160px;
      width: 40px;
      min-width: initial;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      right: 30px;
      bottom: 30px;
      position: absolute;
      z-index: 2;
    }

    .enlaceCard {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
    }

    .sc_products_v2__card__btnv2 span {
      transition: all .5s ease;
      width: 0;
      height: 0;
      white-space: nowrap;
      overflow: hidden;
      opacity: 0;
      display: flex;
      position: relative;
    }

    .sc_products_v2__card__btnv2 svg {
      transition: all .5s ease;
    }

    @media (min-width: 1200px) {
      .sc_products_v2__card:hover .sc_products_v2__card__btnv2 {
        width: 160px;
        height: 40px;
      }

      .sc_products_v2__card:hover .sc_products_v2__card__btnv2 span {
        width: auto;
        height: auto;
        opacity: 1;
      }

      .sc_products_v2__card:hover .sc_products_v2__card__btnv2 svg {
        margin-left: 8px;
        margin-top: 0;
      }
    }

    @media (max-width: 500px) {
      .sc_products_v2__card__btnv2 {
        right: 14px;
        bottom: 14px;
      }
    }

    @keyframes btnSlideIn {
      0% {
        opacity: 0;
      }

      100% {
        opacity: 1;
      }
    }

    .sc_products_v2__card:hover .sc_products_v2__card__btn,
    .sc_products_v2__card__btn:hover {
      width: fit-content;
      height: auto;
      padding: 10px 20px 10px 16px;
      animation: btnExpand 0.5s ease forwards;
    }

    .sc_products_v2__card:hover .sc_products_v2__card__btn::before,
    .sc_products_v2__card__btn:hover::before {
      display: block;
      animation: btnSlideIn 0.5s ease forwards;
    }

    @keyframes btnExpand {
      0% {
        width: 40px;
        padding: 0;
      }

      100% {
        width: fit-content;
        padding: 10px 20px 10px 16px;
      }
    }

    .sc_products_v2__card:hover .sc_products_v2__card__btn svg,
    .sc_products_v2__card__btn:hover svg {
      transform: translateX(2px);
    }

    .sc_products_v2__card__body {
      display: flex;
      flex-direction: column;
      gap: 4px;
      position: relative;
      z-index: 2;
      max-width: 52%;
    }

    .sc_products_v2__card__title {
      font-family: 'AMX';
      font-weight: 700;
      font-size: 20px;
      color: #1C1C1C;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    .sc_products_v2__card__subtitle {
      font-family: 'Roboto';
      font-weight: 700;
      font-size: 14px;
      color: #3C3C3C;
      font-style: italic;
    }

    .sc_products_v2__card__price {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .sc_products_v2__card__price__label {
      font-family: 'Roboto';
      font-weight: 700;
      font-size: 14px;
      color: #3C3C3C;
    }

    .sc_products_v2__card__price__value {
      font-family: 'AMX';
      font-weight: 700;
      font-size: 28px;
      color: #1C1C1C;
      line-height: 1.2;
    }

    .sc_products_v2__card__price__old {
      font-family: 'Roboto';
      font-weight: 400;
      font-size: 12px;
      color: #8B8B8B;
      text-decoration: line-through;
    }

    .sc_products_v2__card__image {
      width: 100%;
      height: auto;
      object-fit: contain;
      mix-blend-mode: darken;
    }

    /* Compact card (featured): text left, image right, circle button bottom-right */
    .sc_products_v2__card--featured {
      display: flex;
      align-items: stretch;
      height: 180px;
      cursor: pointer;
      justify-content: space-between;
    }

    .sc_products_v2__card--featured .sc_products_v2__card__body {
      flex: 0 0 auto;
      max-width: 55%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding-right: 8px;
      padding-bottom: 4px;
      position: relative;
      z-index: 2;
    }

    .sc_products_v2__card--featured .sc_products_v2__card__price {
      margin-top: 8px;
    }

    .sc_products_v2__card--featured .sc_products_v2__card__media {
      flex: 1 1 auto;
      min-width: 0;
      margin: 0;
      display: flex;
      align-items: flex-start;
      justify-content: flex-end;
      position: relative;
      z-index: 1;
      max-width: 140px;
    }

    .sc_products_v2__card--featured .sc_products_v2__card__image {
      width: 100%;
      height: auto;
      transform: scale(1.15);
      mix-blend-mode: darken;
    }

    .sc_products_v2__card--featured .sc_products_v2__card__btn {
      right: 14px;
      bottom: 14px;
    }

    /* Standard card: title/subtitle on top, image fills below, price + CTA replaced by circle button */
    .sc_products_v2__card--standard {
      display: flex;
      flex-direction: column;
      height: 260px;
      justify-content: flex-start;
    }

    .sc_products_v2__card--standard .sc_products_v2__card__body {
      max-width: 100%;
      padding-right: 40px;
    }

    .sc_products_v2__card--standard .sc_products_v2__card__media {
      flex: 1;
      min-height: 0;
      margin: 0;
      padding-top: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
    }

    .sc_products_v2__card--standard .sc_products_v2__card__media .sc_products_v2__card__image {
      max-width: 160px;
      width: 100%;
      height: auto;
      mix-blend-mode: darken;
    }

    .sc_products_v2__card--standard .sc_products_v2__card__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      position: relative;
      z-index: 2;
      margin-top: auto;
    }

    .sc_products_v2__more {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin: 32px auto 10px;
      font-family: 'Roboto';
      font-weight: 500;
      font-size: 16px;
      color: #00818F;
      line-height: 1.1;
      text-decoration: none;
