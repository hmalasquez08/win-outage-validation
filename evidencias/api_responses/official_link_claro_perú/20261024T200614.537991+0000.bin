    .sc_products_v2__more:hover .sc_products_v2__more__text{
      text-decoration: underline;
    }

    .sc_products_v2__more__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      line-height: 1;
      text-decoration: none;
    }

    .sc_products_v2__grid--loading {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 300px;
    }

    /* Hide grid while masonry preps — visibility preserves layout dimensions
       so children still have correct offsetHeight for distribution */
    .sc_products_v2__grid.sc_products_v2__grid--rendering {
      visibility: hidden;
    }

