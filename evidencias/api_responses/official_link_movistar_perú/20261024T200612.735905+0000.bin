</style><script>
document.addEventListener("DOMContentLoaded", function() {
  function replaceWithButton() {
    const oldEl = document.querySelector("#hv-hv_home3-c2c-0800btn");
    if (oldEl && !document.querySelector("#hv-mt_equipos-c2c-0800btn_dos")) {
      const newEl = document.createElement("p");
      newEl.id = "hv-mt_equipos-c2c-0800btn_dos";
      newEl.className = "hv-header-custom-c2c-0800btn--2";

      const btn = document.createElement("button");
      btn.textContent = "080010078";
      btn.className = "hv-c2c-btn";

      btn.addEventListener("click", function() {
        window.location.href = "tel:080010078";
      });

      newEl.appendChild(btn);
      oldEl.replaceWith(newEl);

      // Una vez reemplazado, desconectamos el observer
      if (observer) observer.disconnect();
    }
  }

  // Vigilar solo el contenedor donde GTM inyecta
  const observer = new MutationObserver(replaceWithButton);
  observer.observe(document.body, { childList: true, subtree: false });

  // Ejecutar una vez al inicio
  replaceWithButton();
});
</script><script>
document.addEventListener("DOMContentLoaded", function () {
  // Observa el body completo para detectar cuando aparece el contenedor
  const observer = new MutationObserver(() => {
    const targetNode = document.querySelector("#hv-hv_planes_moviles-c2c-0800btn");
    if (targetNode) {
      const anchor = targetNode.querySelector("a");
      if (anchor) {
        // Crear el botón
        const btn = document.createElement("button");
        btn.textContent = "080010078";
        btn.className = "hv-c2c-btn";
        btn.addEventListener("click", function () {
          window.location.href = "tel:080010078";
        });

        // Reemplazar el anchor por el botón
        anchor.replaceWith(btn);
      }
    }
  });

  // Observa todo el body para detectar inserciones dinámicas
  observer.observe(document.body, { childList: true, subtree: true });

  // Además, fuerza el reemplazo inmediato si ya existe al cargar
  const targetNode = document.querySelector("#hv-hv_planes_moviles-c2c-0800btn a");
  if (targetNode) {
    const btn = document.createElement("button");
    btn.textContent = "080010078";
    btn.className = "hv-c2c-btn";
    btn.addEventListener("click", function () {
      window.location.href = "tel:080010078";
    });
    targetNode.replaceWith(btn);
  }
});
</script><script>
document.addEventListener("DOMContentLoaded", function () {
  const overlay = document.querySelector("#atm-c2c-hv_home4-lb-overlay");

  if (overlay) {
    const observer = new MutationObserver(() => {
      // Solo actuar si el overlay está visible
      if (overlay.style.display === "block") {
        const target = document.querySelector("#hv-hv_home4-c2c-0800btn");
        const title2 = document.querySelector("#atm-c2c-hv_home4-lb-overlay .hv-header-custom-c2c-title2");

        if (target && title2) {
          // Forzar ocultar el número original
          target.style.display = "none";

          // Si la imagen no existe, crearla
          if (!document.querySelector(".hv-c2c-img")) {
            const img = document.createElement("img");
            img.src = "https://cert-cdn.movistar.com.pe/2026/09/SVG_SET_Button-0800.svg"; // tu imagen con el número
            img.alt = "080010078";
            img.className = "hv-c2c-img";
            img.style.cursor = "pointer";

            img.addEventListener("click", function () {
              window.location.href = "tel:080010078";
            });

            // Insertar justo debajo del título
            title2.insertAdjacentElement("afterend", img);
          }
        }
      }
    });

    // Observar todo el body para detectar cambios constantes
    observer.observe(document.body, { childList: true, subtree: true, attributes: true });
  }
});
</script><script>
document.addEventListener("DOMContentLoaded", function() {
  const trigger = document.getElementById("WP-formulario-banner-uno");
  const resetBtn = document.getElementById("atm-c2c-hv_home4-lb-close");

  // Guardar estado inicial de todos los elementos con "0800" en id o class
  const initialState = [];
  document.querySelectorAll("[id*='0800'], [class*='0800']").forEach(el => {
    initialState.push({
      element: el,
      originalId: el.id,
      originalClass: el.className
    });
  });

  // Función para renombrar
  function rename0800Elements() {
    initialState.forEach(item => {
      if (item.element.id.includes("0800")) {
        item.element.id = item.element.id.replace(/0800/g, "btn");
      }
      if (item.element.className.includes("0800")) {
        item.element.className = item.element.className.split(" ")
          .map(cls => cls.replace(/0800/g, "btn"))
          .join(" ");
      }
    });
  }

  // Función para restaurar al estado inicial
  function restoreInitialState() {
    initialState.forEach(item => {
      item.element.id = item.originalId;
      item.element.className = item.originalClass;
    });
  }

  // Al hacer clic en el trigger, renombra
  if (trigger) {
    trigger.addEventListener("click", rename0800Elements);
  }

  // Al hacer clic en el botón de cerrar, restaura
  if (resetBtn) {
    resetBtn.addEventListener("click", restoreInitialState);
  }
});
</script><style>
