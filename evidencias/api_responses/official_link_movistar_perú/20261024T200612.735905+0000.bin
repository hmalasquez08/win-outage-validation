        border-radius: 14px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, .03);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .stefa_benefits-suscripciones-banner__content {
        flex: 1 1 55%;
        min-width: 280px;
      }

      .stefa_benefits-suscripciones-banner__title {
        margin: 0;
        font-size: 28px;
        line-height: 1.15;
        color: #313235;
        font-weight: 500;
      }

      .stefa_benefits-suscripciones-banner__title strong {
        font-weight: 800;
      }

      .stefa_benefits-suscripciones-banner__subtitle {
        margin: 8px 0 20px;
        font-size: 18px;
        line-height: 1.35;
        color: #313235;
        font-weight: 400;
      }

      .stefa_benefits-suscripciones-banner__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 40px;
        padding: 0 18px;
        border-radius: 999px;
        background: #019BEF;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
        transition: background .2s ease;
      }

      .stefa_benefits-suscripciones-banner__button:hover {
        background: #019BEF;
        color: #fff;
      }

      .stefa_benefits-suscripciones-banner__logos {
        flex: 0 0 auto;
        display: grid;
        grid-template-columns: repeat(3, 80px);
        gap: 4px;
      }

      .logo-card {
        width: 80px;
        height: 80px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #fff;
        font-weight: 700;
        font-size: 18px;
        line-height: 1;
        overflow: hidden;
      }

      .stefa-suscripciones-activas_card-content--header-img {
        width: 80px;
        border-radius: 8px;
      }

      /* Responsive */
      @media (max-width: 768px) {
        .stefa_benefits-suscripciones-banner {
          flex-direction: row;
          align-items: flex-start;
          padding: 22px;
          max-width: 328px;
          margin: 16px auto 24px;
        }

