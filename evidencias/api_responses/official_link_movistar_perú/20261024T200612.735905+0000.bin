  .stefa_parrillas_home_vKenos .lt__parent {
    max-width: 1224px;
    margin: 0 auto;
  }

  .tooltip-trigger {
    position: relative;
    display: inline-block;
    cursor: pointer;
  }

  .tooltip-content {
    position: absolute;
    bottom: 120%;
    left: 50%;
    transform: translateX(-50%);
    background-color: #333;
    color: #fff;
    padding: 8px;
    border-radius: 4px;
    white-space: nowrap;
    font-size: 14px;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .tooltip-content::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 6px;
    border-style: solid;
    border-color: #333 transparent transparent transparent;
  }

  .tooltip-trigger:hover .tooltip-content {
    opacity: 1;
    visibility: visible;
  }

  .stefa_parrillas_home_vKenos .header {
    display: flex;
