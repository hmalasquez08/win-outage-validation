</style><!--<script>
  function reorderSwiperForMobile() {
    if (window.matchMedia("(max-width: 768px)").matches) {
      const swiperWrapper = document.querySelector(
        '[tab-id="tab1"] .swiper-wrapper',
      );
      if (!swiperWrapper) return;
      const slides = swiperWrapper.querySelectorAll(".swiper-slide");
      if (slides.length >= 3) {
        const thirdSlide = slides[2];
        swiperWrapper.insertBefore(thirdSlide, swiperWrapper.firstChild);
      }
    }
  }

  // Ejecutar al cargar
  reorderSwiperForMobile();

  // Escuchar cambios de viewport
  window
    .matchMedia("(max-width: 768px)")
    .addEventListener("change", reorderSwiperForMobile);
</script>--><section class="stefa-card-beneficios"><div class="stefa-card-beneficios__container"><h2 class="text-center">Lo mejor de Movistar para ti</h2><div lt-carousel="view: 1.18; view1200: 3; view800: 2; autoheight: false; space600: 18px; "><div class="swiper-container"><div class="swiper-wrapper"><div class="swiper-slide"><div class="stefa-card-beneficios__item"><div class="stefa-card-beneficios__box-uno"><picture class="stefa-card-beneficios__picture"><source media="(min-width:600px)" srcset="
