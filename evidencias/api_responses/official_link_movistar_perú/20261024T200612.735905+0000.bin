//# sourceURL=search-autocomplete-js-extra
</script><script id="search-autocomplete-js" src="/wp-content/themes/movistar-residencial/assets/js/search-autocomplete.js"></script><script type='text/javascript'  src='/wp-content/themes/movistar-residencial/assets/js/swiper-bundle.min.js'  id='swiper-js-js'></script><script type='text/javascript' src='https://cert-cdn.movistar.com.pe/2026/02/JS_FEB_libreria-front.min.js'></script><script type='text/javascript' src='https://cert-cdn.movistar.com.pe/2026/03/JS_MAR_Home-2026-3.min.js'></script><script>
  const slideDuration = 7000; // Duración de cada slide en milisegundos
  let progressInterval = null;
  let lastActiveIndex = 0;
  let lastBulletIndex = 0;

  function resetAllBars() {
    document.querySelectorAll('.swiper-pagination-bullet .progress-bar').forEach(bar => bar.style.width = '0%');
  }

  function startProgressBar(swiper) {
    // Solo hay una .swiper-pagination-bullet-active marcada por Swiper (aunque sean slides dobles por el loop)
    resetAllBars();
    const bullets = document.querySelectorAll('.swiper-pagination-bullet');
    // Obtener el índice del bullet activo según el slide real
    const activeBulletIndex = swiper.realIndex;
    const activeBullet = bullets[activeBulletIndex];
    const bar = activeBullet.querySelector('.progress-bar');

    let start = Date.now();
    progressInterval = setInterval(() => {
      const perc = ((Date.now() - start) / slideDuration) * 100;
      bar.style.width = Math.min(100, perc) + '%';
      if (perc >= 100) {
        clearInterval(progressInterval);
        swiper.slideNext();
      }
    }, 18);
  }

  const swiper = new Swiper(".mySwiper", {
    loop: false,
    speed: 420,
    slidesPerView: 1,
    autoplay: {
      delay: slideDuration,
      disableOnInteraction: false
    },
    breakpoints: {
      600: {
        slidesPerView: 1,
        spaceBetween: 8
      },
      800: {
        slidesPerView: 1,
        spaceBetween: 8
      },
      1200: {
        slidesPerView: 1,
        spaceBetween: 10
      }
    },
    pagination: {
      el: ".stefa__container--swiper-pagination .swiper-pagination",
      clickable: true,
      renderBullet: function (index, className) {
        return `<span class="${className}"><span class="progress-bar"></span></span>`;
      }
    },
    navigation: {
      nextEl: ".stefa__container--swiper-pagination .swiper-button-next",
      prevEl: ".stefa__container--swiper-pagination .swiper-button-prev",
    },
    on: {
    slideChange: function () {
      const currentIndex = this.activeIndex;

      // Detecta si el slide activo es el tercero (índice 2)
      if (currentIndex === 2) {
        // Cambia el color de las flechas
        document.querySelector('.stefa_home_BannerAgo2025 .swiper-button-next').style.color = '#FFFFFF'; 
        document.querySelector('.stefa_home_BannerAgo2025 .swiper-button-prev').style.color = '#FFFFFF';

        // Cambia el color de los dots
        document.querySelectorAll('.stefa_home_BannerAgo2025 .swiper-pagination-bullet').forEach(bullet => {
          bullet.style.backgroundColor = '#FFFFFF';
          bullet.style.border = '1px solid #FFFFFF';
        });
      } else {
        // Restablece los colores originales
        document.querySelector('.stefa_home_BannerAgo2025 .swiper-button-next').style.color = '#FFFFFF';
        document.querySelector('.stefa_home_BannerAgo2025 .swiper-button-prev').style.color = '#FFFFFF';
        document.querySelectorAll('.stefa_home_BannerAgo2025 .swiper-pagination-bullet').forEach(bullet => {
          bullet.style.backgroundColor = '#FFFFFF';
 bullet.style.border = 'none';
        });
      }
    }
  }
  });


  // Para corregir el inicio, usa 'slideChange' y fuerza una animación inicial
  swiper.on('slideChange', function () {
    clearInterval(progressInterval);
    startProgressBar(swiper);
  });

  // Al hacer clic en paginación, reinicia la barra
  swiper.on('paginationUpdate', function () {
    clearInterval(progressInterval);
    startProgressBar(swiper);
  });

  // Cuando se reanuda el autoplay
  swiper.on('autoplayStart', function () {
    clearInterval(progressInterval);
    startProgressBar(swiper);
  });

  // Al cargar la página: se asegura de que todo esté inicializado antes de arrancar la barra
  window.addEventListener('DOMContentLoaded', function () {
    setTimeout(() => {
      startProgressBar(swiper);
    }, 80);
  });
(function() {
  // 1. Neutraliza la función t() del script
  if (typeof window.t === "function") {
    window.t = function() {
      console.log("Función t() neutralizada");
    };
  }

  // 2. Desconecta el MutationObserver que usa ese script
  if (typeof B !== "undefined" && B.disconnect) {
    B.disconnect();
    console.log("Observer B desconectado");
  }

  // 3. Blindar tu enlace específico
  const enlace = document.querySelector('#hv-hv_home4-c2c-0800btn a');
  if (enlace) {
    // Fija el número que tú quieras
    enlace.href = "tel:080010078";   // reemplaza con tu número real
    enlace.textContent = "0800 10078";

    // Congela el nodo y sus atributos para evitar modificaciones
    Object.freeze(enlace);
    Object.freeze(enlace.attributes);

    console.log("Enlace blindado con tu número");
  }
})();

</script></body></html>
