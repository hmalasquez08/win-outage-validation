          min-width: 184px;
          max-width: 184px;
        }

        .stefa_benefits-suscripciones-banner__logos .logo-card:nth-child(3),
        .stefa_benefits-suscripciones-banner__logos .logo-card:nth-child(4),
        .stefa_benefits-suscripciones-banner__logos .logo-card:nth-child(5) {
