="_self" data-alt=""><a id="subMenu-3_negocios" data-variant="v1" data-module="subMenu" data-slot="3" class="linkCat" url="/hablando-claro/negocios/" href="/hablando-claro/negocios/" target="_self">Negocios<i class="ico-briefcase"></i><span class="openSubCat"></span></a><ul class="subMenuCat"><li><a url="/hablando-claro/negocios/empresas/" id="subMenuCat-1_empresas" data-variant="v1" data-module="subMenuCat" data-slot="1" href="/hablando-claro/negocios/empresas/" target="_self"><span>Empresas</span></a></li><li><a url="/hablando-claro/negocios/emprendimientos/" id="subMenuCat-2_emprendimientos" data-variant="v1" data-module="subMenuCat" data-slot="2" href="/hablando-claro/negocios/emprendimientos/" target="_self"><span>Emprendimientos</span></a></li></ul></li><li data-ad="/portal/pe/recursos_contenido/bg-innovacion-header-v2.jpg" data-url="" data-target="_self" data-alt=""><a id="subMenu-4_compromiso" data-variant="v1" data-module="subMenu" data-slot="4" class="linkCat" url="/hablando-claro/compromiso/" href="/hablando-claro/compromiso/" target="_self">Compromiso<i class="ico-help"></i><span class="openSubCat"></span></a><ul class="subMenuCat"><li><a url="/hablando-claro/compromiso/sostenibilidad/" id="subMenuCat-1_sostenibilidad" data-variant="v1" data-module="subMenuCat" data-slot="1" href="/hablando-claro/compromiso/sostenibilidad/" target="_self"><span>Sostenibilidad</span></a></li><li><a url="/hablando-claro/compromiso/gente-claro/" id="subMenuCat-2_gente-claro" data-variant="v1" data-module="subMenuCat" data-slot="2" href="/hablando-claro/compromiso/gente-claro/" target="_self"><span>Gente Claro</span></a></li><li><a url="/logros/?reconocimientos=true/" id="subMenuCat-3_nuestros-reconocimientos" data-variant="v1" data-module="subMenuCat" data-slot="3" href="/logros/?reconocimientos=true/" target="_self"><span>Nuestros reconocimientos</span></a></li><li><a url="https://aprendeconclaro.claro.com.pe/" id="subMenuCat-4_aprende-con-claro" data-variant="v1" data-mod