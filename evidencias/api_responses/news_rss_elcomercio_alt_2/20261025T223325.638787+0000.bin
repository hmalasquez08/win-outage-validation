DJLVDWQNFOXPGTK35JYOOK4Y","type":"text","content":"DAZN Italia, según el paquete"}],[{"_id":"PUYQE7MP6NFWTENDYEL36NB5BQ","type":"text","content":"España"},{"_id":"X5ANHQSYENBA5DTU624YXYOVUQ","type":"text","content":"21:00"},{"_id":"AEVY54R3IZGHNCOFJDLE3IJCQU","type":"text","content":"DAZN F1 y operadores que incluyan el canal"}]],"type":"table"},{"subtype":"about_author","_id":"D6FWFFVAM5GWVNQVXZBJOGGN5A","embed":{"id":"1792887774774","config":{"authorTwitter":"NY20204","authorSlug":"noe-yactayo","authorName":"Noé Yactayo","authorImage":"https://author-service-images-prod-us-east-1.publishing.aws.arc.pub/elcomercio/FQYUXFUHRZF25E2GIMQK2REYXA.png","authorLinkedIn":"https://www.linkedin.com/in/noé-yactayo-a8a693299/","authorBio":"Noé Yactayo es periodista de El Comercio desde 2022. Con 13 años de experiencia en medios digitales, se ha consolidado como especialista en fútbol internacional y deportes de combate, además de cubrir temas de actualidad para las audiencias hispanas de Estados Unidos. Antes de sumarse a la redacción, trabajó en Mi Bundesliga, La República y Líbero."},"url":"/pf/api/v3/content/fetch/photo-by-id"},"type":"custom_embed"},{"_id":"2U34R3N5KVDJFCSAP4UZ4CB3WQ","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"Consulta los canales de TV y plataformas online para ver la carrera del Gran Premio de los Estados Unidos 2026 por el Campeonato Mundial de la Fórmula Uno en el Circuito de las Américas de Austin, Texas."},"description":{"basic":"Consulta los canales de TV y plataformas online para ver la carrera del Gran Premio de los Estados Unidos 2026 por el Campeonato Mundial de la Fórmula Uno en el Circuito de las Américas de Austin, Texas."},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"primary_site":{"path":"/mag/usa/en-vivo-us","parent_id":"/mag/usa","name":"En Vivo US","description":null,"_id":"/mag/usa/en-vivo-us","additional_properties":{"original":{"parent":{"header-pro":"/mag/u