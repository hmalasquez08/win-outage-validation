ara que funcione?","native":"","web":"","mobile":"","basic":"Después de 12 años, la Línea 2 del Metro de Lima alcanza un hito clave: ¿Qué falta para que funcione? "},"websites":{"elcomercio":{"website_url":"/respuestas/tramites/despues-de-12-anos-la-linea-2-del-metro-de-lima-alcanza-un-hito-clave-que-falta-para-que-funcione-tdpe-noticia/","website_section":{"path":"/respuestas/tramites","parent":{"default":"/respuestas"},"_website":"elcomercio","parent_id":"/respuestas","name":"Tramites","description":null,"_id":"/respuestas/tramites","additional_properties":{"original":{"parent":{"header-pro":null,"default":"/respuestas","menu-pro":"/respuestas"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":null},"_admin":{"alias_ids":["/respuestas/tramites"]},"inactive":false,"node_type":"section","_website":"elcomercio","name":"Tramites","_id":"/respuestas/tramites","ancestors":{"header-pro":[],"default":["/respuestas"],"menu-pro":["/respuestas"]},"order":{"menu-pro":2003}}},"_website_section_id":"elcomercio./respuestas/tramites","type":"section","version":"0.6.0"}}},"created_date":"2026-10-23T13:27:17.78Z","publish_date":"2026-10-25T22:16:00Z","_id":"SEPT66HKXVEJDNTOFPQQKV7IHU","website":"elcomercio","website_url":"/respuestas/tramites/despues-de-12-anos-la-linea-2-del-metro-de-lima-alcanza-un-hito-clave-que-falta-para-que-funcione-tdpe-noticia/"},{"content_elements":[{"_id":"FRM2LEKMPRAVRLXACTQZ2PH4X4","additional_properties":{},"type":"text","content":"La etapa nacional de los Juegos Escolares Deportivos y Paradeportivos 2026 (JEDPA) reunirá en Lima a más de 3.000 estudiantes clasificados, quienes competirán del 26 de octubre al 6 de noviembre."},{"_id":"4KMZG627SBG6LM522LPH33OLQA","additional_properties":{},"type":"text","content":"Las fases anteriores convocaron a millones de escolares peruanos, desde la instancia inicial hasta las competencias organizadas por las UGEL. Estas cifras reflejan el alcance nacional del certamen."},{"_id":"MGV2QNY6M5FTLCK3HBSZURFPPU","additional_properties":{},"type":"text","content":"Además de promover el rendimiento deportivo, los JEDPA fortalecen la convivencia escolar y el desarrollo socioemocional. La competencia fomenta valores como respeto, honestidad, compañerismo y juego limpio."},{"_id":"P7Z5MUCHANA23FABBW6AYVQBRA","additional_properties":{},"type":"text","content":"El campeonato también permitirá identificar representantes peruanos para los Juegos Sudamericanos Escolares, previstos para diciembre en Guayaquil, Ecuador. La delegación nacional buscará superar sus resultados anteriores."},{"_id":"MHANPJMCRJCVLMQYBFFNUZUYV4","additional_properties":{},"type":"text","content":"La ceremonia inaugural será este 26 de octubre en el Coliseo Eduardo Dibós. Las delegaciones participantes se alojarán en la Villa Panamericana, ubicada en Villa El Salvador, durante el evento."},{"_id":"PZUDWET3XVB57MBKDFSJR5O4YA","additional_properties":{},"type":"text","content":"San Martín lidera la representación regional con más de 270 clasificados, seguida por Loreto, Arequipa e Ica. Las disciplinas incluyen futsal, fútbol, vóley, atletismo, judo y natación."},{"_id":"B6K5VTBDAZDJXEI3NITUNIUZGQ","additional_properties":{},"type":"text","content":"La edición 2026 incorporará por primera vez el vóley playa, cuya final reunirá más de 15 equipos. El público podrá ingresar gratuitamente presentando su documento de identidad."},{"subtype":"stamp_trust","_id":"ERXNWDDCJFF6DHSAYEHQZD6IXM","embed":{"id":"1792966248601-545730","config":{"url_img":"","url":""},"url":"/pf/api/v3/content/fetch/photo-by-id"},"type":"custom_embed"},{"_id":"I2VF7NGDY5H7JLWEZNRPOTOS4E","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"Con la participación de los mejores talentos clasificados de todo el país, comienza el certamen decisivo de los Juegos Escolares Deportivos y Paradeportivos 2026."},"description":{"basic":"Con la participación de los mejores talentos clasificados de todo el país, comienza el certamen decisivo de los Juegos Escolares Deportivos y Paradeportivos 2026."},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"primary_site":{"path":"/deporte-total","parent_id":"/","name":"DT","_id":"/deporte-total","additional_properties":{"original":{"parent":{"header-pro":null,"default":"/","navbar-default":"/","sitemap-default":"/","default-pro":"/","test":"/","search-filter-default":"/","menu-default":"/","header-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","name":"DT","_id":"/deporte-total","ancestors":{"header-pro":[],"navbar-default":["/"],"sitemap-default":["/"],"default-pro":["/"],"search-filter-default":["/"],"menu-default":["/"],"header-default":[],"menu-pro":["/"]},"order":{"default":1013,"navbar-default":1009,"sitemap-default":1010,"default-pro":1009,"test":1013,"search-filter-default":1004,"menu-default":1021,"menu-pro":1014}}},"type":"site","version":"0.5.8"},"sites":[{"path":"/deporte-total","parent_id":"/","name":"DT","_id":"/deporte-total","additional_properties":{"original":{"parent":{"header-pro":null,"default":"/","navbar-default":"/","sitemap-default":"/","default-pro":"/","test":"/","search-filter-default":"/","menu-default":"/","header-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","name":"DT","_id":"/deporte-total","ancestors":{"header-pro":[],"navbar-default":["/"],"sitemap-default":["/"],"default-pro":["/"],"search-filter-default":["/"],"menu-default":["/"],"header-default":[],"menu-pro":["/"]},"order":{"default":1013,"navbar-default":1009,"sitemap-default":1010,"default-pro":1009,"test":1013,"search-filter-default":1004,"menu-default":1021,"menu-pro":1014}}},"type":"site","version":"0.5.8"},{"path":"/deporte-total/polidepo