c011c219064a58d01874a49e3a1fed558d619a&width=482&height=290&quality=75&smart=true","amp_new":"https://elcomercio.pe/resizer/v2/XQQ54H45MJDX7JHD4XW243IDYA.webp?auth=8bdaf8abe80e60fccede1b150ec011c219064a58d01874a49e3a1fed558d619a&width=1200&height=800&quality=75&smart=true","amp":"https://elcomercio.pe/resizer/v2/XQQ54H45MJDX7JHD4XW243IDYA.webp?auth=8bdaf8abe80e60fccede1b150ec011c219064a58d01874a49e3a1fed558d619a&width=900&height=600&quality=75&smart=true","impresa":"https://elcomercio.pe/resizer/v2/XQQ54H45MJDX7JHD4XW243IDYA.webp?auth=8bdaf8abe80e60fccede1b150ec011c219064a58d01874a49e3a1fed558d619a&width=617&height=637&quality=75&smart=true","impresa_s":"https://elcomercio.pe/resizer/v2/XQQ54H45MJDX7JHD4XW243IDYA.webp?auth=8bdaf8abe80e60fccede1b150ec011c219064a58d01874a49e3a1fed558d619a&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/respuestas/mexico/temblor-en-mexico-hoy-en-vivo-ultimo-sismo-25-y-26-de-octubre-2026-registrado-por-el-ssn-cual-fue-la-magnitud-epicentro-y-hora-servicio-sismologico-nacional-mexico-cdmx-mx-lbposting-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"elcomercio","revision":{"editions":["default"],"parent_id":"CGLEENPR7BBGBJQO54E4ZKQFM4","published":true,"branch":"default","revision_id":"3UMB7U4WPNA3ZGTQ6SGF2LUSDU"},"planning":{"scheduling":{"will_have_video":true,"planned_publish_date":"2025-07-02T03:15:00.000Z"},"story_length":{"character_count_actual":865,"inch_count_actual":1,"word_count_actual":151,"line_count_actual":7}},"content_restrictions":{"content_code":"free"},"display_date":"2026-10-25T22:28:04Z","headlines":{"tablet":"","print":"","meta_title":"Temblor en México HOY domingo 25 de octubre EN VIVO cuál fue la magnitud y epicentro del último sismo según SSN | Servicio Sismológico Nacional | México | CDMX | MX | lbposting","native":"","web":"","mobile":"","basic":"Temblor en México hoy, domingo 25 de octubre: epicentro y magnitud según reporte SSN"},"websites":{"elcomercio":{"website_url":"/respuestas/mexico/temblor-en-mexico-hoy-en-vivo-ultimo-sismo-25-y-26-de-octubre-2026-registrado-por-el-ssn-cual-fue-la-magnitud-epicentro-y-hora-servicio-sismologico-nacional-mexico-cdmx-mx-lbposting-noticia/","website_section":{"path":"/respuestas/mexico","parent":{"default":"/respuestas"},"_website":"elcomercio","parent_id":"/respuestas","name":"Mexico","description":null,"_id":"/respuestas/mexico","additional_properties":{"original":{"parent":{"header-pro":null,"default":"/respuestas","menu-pro":"/respuestas"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":null},"_admin":{"alias_ids":["/respuestas/mexico"]},"inactive":false,"node_type":"section","_website":"elcomercio","name":"Mexico","_id":"/respuestas/mexico","ancestors":{"header-pro":[],"default":["/respuestas"],"menu-pro":["/respuestas"]},"order":{"menu-pro":2008}}},"_website_section_id":"elcomercio./respuestas/mexico","type":"section","version":"0.6.0"}}},"created_date":"2026-10-25T14:11:03.302Z","publish_date":"2026-10-25T22:28:04Z","_id":"YIURN2F4CZCPZKYCLBOFXVQ454","website":"elcomercio","website_url":"/respuestas/mexico/temblor-en-mexico-hoy-en-vivo-ultimo-sismo-25-y-26-de-octubre-2026-registrado-por-el-ssn-cual-fue-la-magnitud-epicentro-y-hora-servicio-sismologico-nacional-mexico-cdmx-mx-lbposting-noticia/"},{"content_elements":[{"level":2,"_id":"TOHF32GWXBFR3HZ6QOL7ERBVCQ","additional_properties":{},"type":"header","content":"<b>Sismos en Venezuela: últimos temblores, epicentro y magnitud </b>"},{"_id":"UIUHSQV24BEDJEZ7BW42DLXTXM","type":"raw_html","content":"<mxm-event id=\"11398\"></mxm-event><div class=\"live-event\"><div class=\"live-event2-comment  \"><div id=\"liveblog-397686\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">17:26</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>Sismo a 32 km al norte de Isnotu</b> </li><li>  </li><li>Fecha: 25-10-2026 15:07 </li><li>Profundidad: 1.8 km </li><li>Magnitud: 1.9 </li></ul>  </div></div></div><div id=\"gpt_caja2\" class=\"flex justify-center\"></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397587\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">16:05</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿POR QUÉ NUNCA DEBERÍAS USAR UN ASCENSOR DURANTE UN SISMO?</b> </li><li>  </li><li>Los especialistas recomiendan nunca utilizar el ascensor durante un sismo o terremoto, ya que este podría desprenderse de su estructura y caer desde una gran altura con personas adentro. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397542\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">15:45</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿QUÉ HACER EN CASO DE UN TSUNAMI?</b> </li><li>  </li><li>Si recibes información oficial de alerta o alarma de tsunami o ves que se recoge el mar, evacúa hacia zonas en altura. Muévete hacia una zona libre de inundación y dirígete al punto de encuentro más cercano. Si no puedes llegar hasta una zona en altura, sube a un piso superior o al techo de una construcción sólida. </li></ul>  </div></div></div><div id=\"gpt_caja3\" class=\"flex justify-center\"></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397505\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">15:25</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿CUÁL ES LA DIFERENCIA ENTRE LA MAGNITUD Y LA INTENSIDAD DE UN SISMO?</b> </li><li>  </li><li>Son escalas para medir el tamaño o el impacto de un temblor. La escala de magnitud se obtiene de forma numérica a partir de registros obtenidos por sismógrafos y está relacionada con el tamaño y la energía liberada durante un temblor. La escala de intensidad se asigna en función a los daños o efectos causados al hombre y sus construcciones. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397366\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">14:15</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿QUÉ DEBE CONTENER MI MOCHILA DE EMERGENCIA?</b> </li><li>  </li><li>• Artículos indispensables de higiene </li><li>  </li><li>• Botiquín (vendas, gasa, alcohol, pastillas, agua oxigenada, etc) </li><li>  </li><li>• Abrigo </li><li>  </li><li>• Alimentos no perecibles (latas de atún, barra de cereales, chocolates, frutos secos, etc) y dinero </li><li>  </li><li>• Artículos de comunicación </li><li>  </li><li>• Artículos específicos para bebés e infantes, de uso femenino, para el adulto mayor y para otras necesidades básicas. </li></ul>  </div></div></div><div id=\"gpt_caja4\" class=\"flex justify-center\"></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397311\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">13:45</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>REVISA LO QUE UN MORRAL DE EMERGENCIAS PARA EL HOGAR DEBE CONTENER.</b> </li></ul>  </div><img class=\"live-event-image\" src=\"https://elcomercio.pe/resizer/v2/GQ4TCOBNGEYC2MRVKQ2DKORUHE.jpg?auth=6a2aeecd9339f1b4aee42b0b01832cf93e5a28f038e8d1687bf20564e5fc3fbd\"></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397283\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">13:31</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>Sismo en 37 km al suroeste de Bucaramanga</b> </li><li>  </li><li>Fecha: 25-10-2026 11:17 </li><li>Profundidad: 152.0 km </li><li>Magnitud: 3.2 </li></ul>  </div></div></div><div id=\"gpt_caja5\" class=\"flex justify-center\"></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397281\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">13:31</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>Sismo a 36 km al sureste de Bucaramanga</b> </li><li>  </li><li>Fecha: 25-10-2026 10:09 </li><li>Profundidad: 159.0 km </li><li>Magnitud: 2.7 </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397280\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">13:30</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>Sismo a 25 km al sur de Bucaramanga</b> </li><li>  </li><li>Fecha: 25-10-2026 09:57 </li><li>Profundidad: 149.0 km </li><li>Magnitud: 3.0 </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397242\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">12:10</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿SE PUEDE PREDECIR UN SISMO?</b> </li><li>  </li><li>Actualmente, es algo imposible de determinar, pues el mismo planeta Tierra presenta una amplia dinámica respecto a sus movimientos, teniendo en cuenta que, no se trata únicamente de predecir cuándo va a templar, sino, poder determinar la intensidad, magnitud, profundidad y demás factores de importancia. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397222\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">11:55</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿QUÉ HACER EN CASO DE UN TSUNAMI?</b> </li><li>  </li><li>Si recibes información oficial de alerta o alarma de tsunami o ves que se recoge el mar, evacúa hacia zonas en altura. Muévete hacia una zona libre de inundación y dirígete al punto de encuentro más cercano. Si no puedes llegar hasta una zona en altura, sube a un piso superior o al techo de una construcción sólida. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397211\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">11:52</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿QUÉ ES LA FUNVISIS?</b> </li><li>  </li><li>La Fundación Venezolana de Investigaciones Sismológicas (Funvisis) es el organismo responsable de ejecutar y promover investigaciones y estudios sismológicos, así como la encargada de la operación y mantenimiento de las estaciones del servicio sismológico de Venezuela, desde donde se registra y monitorea toda la actividad sismológica de ese país. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397162\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">10:02</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿Por qué se reportan varias magnitudes para un mismo sismo?  </b> </li><li>Porque la primera información proviene de estaciones cercanas y se ajusta conforme más datos llegan de diferentes sensores. La ciencia sigue calculando después del primer aviso. </li></ul>  <p> </p>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397161\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">10:02</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿Cómo se sabe que va a temblar?</b> </li><li>Los sismos no se pueden predecir, pero los sismógrafos y acelerógrafos detectan los movimientos del suelo en tiempo real para alertarnos lo más rápido posible. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397116\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">02:54</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿CUÁLES SON LAS PLACAS TECTÓNICAS QUE SE ENCUENTRAN EN VENEZUELA?</b> </li><li>  </li><li>La placa del Caribe es la zona geológica que abarca Centroamérica y el mar Caribe, mientras que la placa sudamericana sostiene casi toda la zona de América del Sur y parte del lecho del océano Atlántico. </li><li>  </li><li>Ambas placas interactúan principalmente en el norte de Sudamérica mediante deslizamientos laterales y zonas de subducción (límite convergente donde una placa mayor se hunde bajo otra más ligera hacia el manto de la Tierra). </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397115\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">02:52</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿QUÉ ES EL SILENCIO SÍSMICO?</b> </li><li>  </li><li>El silencio sísmico es un período prolongado sin actividad sísmica importante o de significativa intensidad en una región, que puede indicar la acumulación de tensiones tectónicas y un aumento en el riesgo de un futuro terremoto. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397114\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">02:52</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿QUÉ HACER EN CASO DE UN TSUNAMI?</b> </li><li>  </li><li>Si recibes información oficial de alerta o alarma de tsunami o ves que se recoge el mar, evacúa hacia zonas en altura. Muévete hacia una zona libre de inundación y dirígete al punto de encuentro más cercano. Si no puedes llegar hasta una zona en altura, sube a un piso superior o al techo de una construcción sólida. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397113\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">02:51</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿CUÁL ES LA DIFERENCIA ENTRE LA MAGNITUD Y LA INTENSIDAD DE UN SISMO?</b> </li><li>  </li><li>Son escalas para medir el tamaño o el impacto de un temblor. La escala de magnitud se obtiene de forma numérica a partir de registros obtenidos por sismógrafos y está relacionada con el tamaño y la energía liberada durante un temblor. La escala de intensidad se asigna en función a los daños o efectos causados al hombre y sus construcciones. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397112\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">02:51</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿QUÉ ES LA FUNVISIS?</b> </li><li>  </li><li>La Fundación Venezolana de Investigaciones Sismológicas (Funvisis) es el organismo responsable de ejecutar y promover investigaciones y estudios sismológicos, así como la encargada de la operación y mantenimiento de las estaciones del servicio sismológico de Venezuela, desde donde se registra y monitorea toda la actividad sismológica de ese país. </li></ul>  </div></div></div><div class=\"live-event2-comment fixed   \"><div id=\"liveblog-397111\" ><div class=\"parent-\">:fijado:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">02:50</span> </div> <div><p>En esta nota podrás revisar los últimos <a href='https://elcomercio.pe/noticias/venezuela/'>sismos en Venezuela</a> con información de los reportes oficiales de la Fundación Venezolana de Investigaciones Sismológicas (Funvisis).</p>  </div></div></div></div>:<script type=\"application/ld+json\">{\"@graph\": [{\"@type\": \"Organization\", \"@id\": \"#organization\", \"name\": \"El Comercio Per\\u00fa\", \"url\": \"https://elcomercio.pe/\", \"sameAs\": [\"https://www.facebook.co