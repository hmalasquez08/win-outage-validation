608a4db8724f8b89272464f8248fe37&width=320&quality=75&smart=true","large":"https://elcomercio.pe/resizer/v2/GGHEIRFVVFERXHFUAJTTHOFQEU.jpg?auth=e9553834716179600b4108e76662b41a9608a4db8724f8b89272464f8248fe37&width=940&height=569&quality=75&smart=true","story_small":"https://elcomercio.pe/resizer/v2/GGHEIRFVVFERXHFUAJTTHOFQEU.jpg?auth=e9553834716179600b4108e76662b41a9608a4db8724f8b89272464f8248fe37&width=482&height=290&quality=75&smart=true","amp_new":"https://elcomercio.pe/resizer/v2/GGHEIRFVVFERXHFUAJTTHOFQEU.jpg?auth=e9553834716179600b4108e76662b41a9608a4db8724f8b89272464f8248fe37&width=1200&height=800&quality=75&smart=true","amp":"https://elcomercio.pe/resizer/v2/GGHEIRFVVFERXHFUAJTTHOFQEU.jpg?auth=e9553834716179600b4108e76662b41a9608a4db8724f8b89272464f8248fe37&width=900&height=600&quality=75&smart=true","impresa":"https://elcomercio.pe/resizer/v2/GGHEIRFVVFERXHFUAJTTHOFQEU.jpg?auth=e9553834716179600b4108e76662b41a9608a4db8724f8b89272464f8248fe37&width=617&height=637&quality=75&smart=true","impresa_s":"https://elcomercio.pe/resizer/v2/GGHEIRFVVFERXHFUAJTTHOFQEU.jpg?auth=e9553834716179600b4108e76662b41a9608a4db8724f8b89272464f8248fe37&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/mag/usa/en-vivo-us/sky-sports-en-vivo-como-ver-carrera-del-gp-de-estados-unidos-2026-por-izzi-tv-y-sky-plus-online-en-mexico-nnda-nnrt-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"elcomercio","revision":{"editions":["default"],"parent_id":"ZXQJOZWQHFBEZNVNDCEQCJBFCI","published":true,"branch":"default","revision_id":"DI5ZLMWH3NCQNAYISPRGYXODTI"},"planning":{"scheduling":{"will_have_image":true},"story_length":{"character_count_actual":1785,"inch_count_actual":3,"word_count_actual":345,"line_count_actual":16}},"content_restrictions":{"content_code":"free"},"display_date":"2026-10-25T22:29:54.888Z","headlines":{"tablet":"","print":"","meta_title":"SKY Sports transmitió la carrera del Gran Premio de Estados Unidos 2026","native":"","web":"","mobile":"","basic":"SKY Sports transmitió la carrera del Gran Premio de Estados Unidos 2026"},"websites":{"elcomercio":{"website_url":"/mag/usa/en-vivo-us/sky-sports-en-vivo-como-ver-carrera-del-gp-de-estados-unidos-2026-por-izzi-tv-y-sky-plus-online-en-mexico-nnda-nnrt-noticia/","website_section":{"path":"/mag/usa/en-vivo-us","parent":{"default":"/mag/usa"},"_website":"elcomercio","parent_id":"/mag/usa","name":"En Vivo US","description":null,"_id":"/mag/usa/en-vivo-us","additional_properties":{"original":{"parent":{"header-pro":"/mag/usa","default":"/mag/usa","menu-pro":null},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"_admin":{"alias_ids":["/mag/usa/en-vivo-us"]},"navigation":{"nav_title":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"inactive":false,"node_type":"section","_website":"elcomercio","name":"En Vivo US","_id":"/mag/usa/en-vivo-us","ancestors":{"header-pro":["/mag","/mag/usa"],"default":["/mag","/mag/usa"],"menu-pro":[]},"order":{}}},"_website_section_id":"elcomercio./mag/usa/en-vivo-us","type":"section","version":"0.6.0"}}},"created_date":"2026-10-20T15:31:43.184Z","publish_date":"2026-10-25T22:29:54.888Z","_id":"3ECLL2LH3JHIND56AL7DWAZKOI","website":"elcomercio","website_url":"/mag/usa/en-vivo-us/sky-sports-en-vivo-como-ver-carrera-del-gp-de-estados-unidos-2026-por-izzi-tv-y-sky-plus-online-en-mexico-nnda-nnrt-noticia/"},{"content_elements":[{"level":2,"_id":"FYKT2BG67JDZZIBSQO4FK7VJBE","additional_properties":{},"type":"header","content":"<u><b>Sismo en Colombia vía el Servicio Geológico</b></u>"},{"_id":"BTDUOMLI3BGJLPBTSS6GQNZ2HU","type":"text","content":"El SGC tiene un total de 339 estaciones sísmicas, ubicadas en todo el territorio colombiano y en zonas específicas como los volcanes activos. 206 estaciones sísmicas se ubican cubriendo todo el territorio correspondiente a la Red Sísmica Nacional y 133 estaciones sísmicas instaladas en los volcanes activos colombianos que se monitorean permanentemente en tres observatorios vulcanológicos y sismológicos."},{"_id":"25WCUJ2EO5D6VPESKZ3HGRN6AY","type":"text","content":"Conoce aquí los sismos ocurridos en el territorio colombiano, reportados por el Servicio Geológico. Aquí te contamos cuáles fueron los últimos."},{"_id":"WSOPYGI4H5APHHD5P34OEOK4VE","type":"raw_html","content":"<mxm-event id=\"11410\"></mxm-event><div class=\"live-event\"><div class=\"live-event2-comment  \"><div id=\"liveblog-397691\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">17:29</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>Sismo en Chaparral - Tolima, Colombia</b> </li><li>  </li><li>Magnitud: 2.2 </li><li>Profundidad: Superficial </li><li>Hora Local: 2026-10-25 14:33 </li><li>Latitud: 3.83° </li><li>Longitud: -75.64° </li></ul>  </div></div></div><div id=\"gpt_caja2\" class=\"flex justify-center\"></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397589\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">16:05</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿POR QUÉ NUNCA DEBERÍAS USAR UN ASCENSOR DURANTE UN SISMO?</b> </li><li>  </li><li>Los especialistas recomiendan nunca utilizar el ascensor durante un sismo o terremoto, ya que este podría desprenderse de su estructura y caer desde una gran altura con personas adentro. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397544\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">15:45</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿QUÉ HACER EN CASO DE UN TSUNAMI?</b> </li><li>  </li><li>Si recibes información oficial de alerta o alarma de tsunami o ves que se recoge el mar, evacúa hacia zonas en altura. Muévete hacia una zona libre de inundación y dirígete al punto de encuentro más cercano. Si no puedes llegar hasta una zona en altura, sube a un piso superior o al techo de una construcción sólida. </li></ul>  </div></div></div><div id=\"gpt_caja3\" class=\"flex justify-center\"></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397504\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">15:25</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>REVISA Y ANOTA EL NÚMERO DE ASISTENCIA EN CASO DE EMERGENCIAS.</b> </li></ul>  </div><img class=\"live-event-image\" src=\"https://elcomercio.pe/resizer/v2/GUYDEMBNGEYC2MRVKQZDKORVGA.png?auth=7949e797cb199cdf0a716dee0d19cfa974b0362f274368b061d8b1e63179e080\"></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397364\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">14:15</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿QUÉ DEBE CONTENER MI MOCHILA DE EMERGENCIA?</b> </li><li>  </li><li>• Artículos indispensables de higiene </li><li>  </li><li>• Botiquín (vendas, gasa, alcohol, pastillas, agua oxigenada, etc) </li><li>  </li><li>• Abrigo </li><li>  </li><li>• Alimentos no perecibles (latas de atún, barra de cereales, chocolates, frutos secos, etc) y dinero </li><li>  </li><li>• Artículos de comunicación </li><li>  </li><li>• Artículos específicos para bebés e infantes, de uso femenino, para el adulto mayor y para otras necesidades básicas. </li></ul>  </div></div></div><div id=\"gpt_caja4\" class=\"flex justify-center\"></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397312\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">13:46</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>REVISA LO QUE UNA MOCHILA DE EMERGENCIAS PARA EL HOGAR DEBE CONTENER.</b> </li></ul>  </div><img class=\"live-event-image\" src=\"https://elcomercio.pe/resizer/v2/GEZTCOBNGEYC2MRVKQ2DMORRGM.png?auth=ccb4ffa4f259134f6c8bb98f5de1c751360a59b1e932a1a96ed1cedff80e603d\"></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397302\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">13:36</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>Sismo en Chaparral - Tolima, Colombia</b> </li><li>  </li><li>Magnitud: 2.7 </li><li>Profundidad: Superficial </li><li>Hora Local: 2026-10-25 11:03 </li><li>Latitud: 3.83° </li><li>Longitud: -75.67° </li></ul>  </div></div></div><div id=\"gpt_caja5\" class=\"flex justify-center\"></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397301\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">13:35</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>Sismo en Los Santos - Santander, Colombia</b> </li><li>  </li><li>Magnitud: 2.7 </li><li>Profundidad: 133 km </li><li>Hora Local: 2026-10-25 10:17 </li><li>Latitud: 6.84° </li><li>Longitud: -73.09° </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397244\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">12:10</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿POR QUÉ HAY TANTOS SISMOS EN COLOMBIA?</b> </li><li>  </li><li>Colombia está situada en la esquina noroccidental de Suramérica, donde confluyen las placas tectónicas Suramericana, Nasca y Caribe; una característica que explica el alto nivel de sismicidad en el país. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397220\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">11:55</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>TELÉFONOS DE EMERGENCIA - COLOMBIA</b> </li><li>  </li><li>• Línea de emergencia: 123 </li><li>  </li><li>(Es la línea única de emergencias Nacional, que permite que en un sólo número los colombianos puedan acceder a todos los servicios de emergencia y seguridad que ofrece el Estado) </li><li>  </li><li>• Policía Nacional: 112 </li><li>  </li><li>• Policía de Tránsito: 127 </li><li>  </li><li>• Defensa Civil: 144 </li><li>  </li><li>• Bomberos: 119 </li><li>  </li><li>• Cruz Roja: 132 </li><li>  </li><li>• Servicio de Ambulancias: 125 </li><li>  </li><li>• Gaula – Antisecuestros: 165 </li><li>  </li><li>• Atención a Desastres: 111 </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397213\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">11:52</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿PUEDEN PREDECIRSE LOS SISMOS?</b> </li><li>  </li><li>Hasta el momento no se cuenta en ninguna parte del mundo con una técnica segura para el pronóstico de sismos y se está todavía muy lejos de poder llegar a ella.  </li><li>  </li><li>Sin embargo, aunque no se pueden predecir los sismos en el tiempo si se pueden predecir en el espacio, es decir en ciertas zonas se puede decir que ocurrirá un sismo, lo que no se sabe es cuando.​ </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397174\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">10:04</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>Sismo a Versalles, Valle del Cauca, Colombia</b> </li><li>Hora Local: 09:32:51 25/10/2026 </li><li>Latitud: 4.63° </li><li>Longitud: -76.27° </li><li>Profundidad: 112 km </li><li>Magnitud: 3.3 </li></ul>  <p> </p>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397173\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">10:04</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>Sismo a Istmina, Chocó, Colombia</b> </li><li>Hora Local: 08:49:09 25/10/2026 </li><li>Latitud: 4.54° </li><li>Longitud: -76.80° </li><li>Profundidad: Superficial (menor a 70 km) </li><li>Magnitud: 2.8 </li></ul>  <p> </p>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397172\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">10:04</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>Sismo a Sipí, Chocó, Colombia</b> </li><li>Hora Local: 07:15:06 25/10/2026 </li><li>Latitud: 4.57° </li><li>Longitud: -76.67° </li><li>Profundidad: Superficial (menor a 70 km) </li><li>Magnitud: 2.8 </li></ul>  <p> </p>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397171\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">10:04</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>Sismo a Paratebueno, Cundinamarca, Colombia</b> </li><li>Hora Local: 06:11:12 25/10/2026 </li><li>Latitud: 4.40° </li><li>Longitud: -73.29° </li><li>Profundidad: Superficial (menor a 30 km) </li><li>Magnitud: 2.7 </li></ul>  <p> </p>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397164\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">10:02</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿Por qué se reportan varias magnitudes para un mismo sismo?  </b> </li><li>Porque la primera información proviene de estaciones cercanas y se ajusta conforme más datos llegan de diferentes sensores. La ciencia sigue calculando después del primer aviso. </li></ul>  <p> </p>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397158\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">10:02</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿Cómo se sabe que va a temblar?</b> </li><li>Los sismos no se pueden predecir, pero los sismógrafos y acelerógrafos detectan los movimientos del suelo en tiempo real para alertarnos lo más rápido posible. </li></ul>  <p> </p>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397138\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">09:40</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿QUÉ DIFERENCIA HAY ENTRE TERREMOTO, TEMBLOR, SISMO Y MOVIMIENTO TELÚRICO?</b> </li><li>En realidad, los cuatro términos son sinónimos, pero en Latino América se le ha dado especial énfasis a la expresión terremoto para ser asignada a los sismos destructores o que han causado víctimas.​​ </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397137\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">09:40</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿CUÁNTOS SISMÓGRAFOS HAY?</b> </li><li><i>RED SISMOLÓGICA NACIONAL DE COLOMBIA-RSNC</i> </li><li>​El SGC tiene un total de 339 estaciones sísmicas, ubicadas en todo el territorio colombiano y en zonas específicas como los volcanes activos. 206 estaciones sísmicas se ubican cubriendo todo el territorio correspondientes a la Red Sísmica Nacional. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397136\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">09:40</span> </div> <div><ul class='story-contents__paragraph-list'> <li>Son 133 estaciones sísmicas instaladas en los volcanes activos colombianos que se monitorean permanentemente en tres observatorios vulcanológicos y sismológicos. </li></ul>  </div></div></div><div class=\"live-event2-comment  \"><div id=\"liveblog-397135\" ><div class=\"parent-\">:icon:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">09:40</span> </div> <div><ul class='story-contents__paragraph-list'> <li><b>¿QUÉ ES EL SERVICIO GEOLÓGICO COLOMBIANO?</b> </li><li>El SGC una entidad centenaria de ciencia y tecnología adscrita al Ministerio de Minas y Energía, que tiene como objetivo contribuir al desarrollo económico y social del país, a través de la investigación en geociencias básicas y aplicadas del subsuelo, el potencial de sus recursos, la evaluación y monitoreo de amenazas de origen geológico, la gestión integral del conocimiento geocientífico, la investigación y el control nuclear y radiactivo, atendiendo las prioridades de las políticas del Gobierno Nacional. </li></ul>  <p> </p>  </div></div></div><div class=\"live-event2-comment fixed   \"><div id=\"liveblog-397134\" ><div class=\"parent-\">:fijado:<span class=\"live-type-\" ></span><span class=\"live-event-minute\">09:40</span> </div> <div><ul class='story-contents__paragraph-list'> <li><a href=https://elcomercio.pe/noticias/temblor-en-colombia/>¿De qué magnitud y en dónde fue el último temblor?</a>  Mira aquí los reportes del Servicio Geológico Colombiano ( <a href=https://elcomercio.pe/noticias/servicio-geologico/>SGC</a> ) sobre los últimos sismos en el país. </li></ul>  </div></div></div></div>:<script type=\"application/ld+json\">{\"@graph\": [{\"@type\": \"Organization\", \"@id\": \"#organization\", \"name\": \"El Comercio Per\\u00fa\", \"url\": \"https://elcomercio.pe/\", \"sameAs\": [\"https://www.facebook.com/elcomercio.pe\", \"https://www.instagram.com/elcomercio/\", \"https://twitter.com/elcomercio_peru\"], \"logo\": {\"@type\": \"ImageObject\", \"@id\": \"#logoImage\", \"url\": \"https://elcomercio.pe/pf/resources/dist/elcomercio/images/logo-elcomercio-388x60.png?d=733\", \"width\": \"388\", \"height\": \"60\"}}, {\"@context\": \"https://schema.org\", \"@type\": \"LiveBlogPosting\", \"@id\": \"#liveBlogPosting\", \"about\": {\"@context\": \"https://schema.org/\", \"@type\": \"Event\", \"name\": \"Temblor en Colombia EN VIVO: cu\\u00e1l fue el epicentro y magnitud del \\u00faltimo sismo reportado HOY por el Servicio Geol\\u00f3gico Colombiano (SGC).\", \"startDate\": \"2026-10-25T09:38:00-0500\", \"endDate\": \"2026-10-25T22:29:23-0500\", \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\", \"eventStatus\": \"https://schema.org/EventScheduled\", \"location\": {\"@type\": \"Place\", \"name\": \"sismo colombia 25/26 octubre\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Lima\", \"addressCountry\": {\"@type\": \"Country\", \"name\": \"PE\"}}}, \"image\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c\", \"description\": \"Temblor en Colombia EN VIVO: cu\\u00e1l fue el epicentro y magnitud del \\u00faltimo sismo reportado HOY por el Servicio Geol\\u00f3gico Colombiano (SGC).\", \"performer\": {\"@type\": \"Organization\", \"name\": \"El Comercio Per\\u00fa\", \"url\": \"https://elcomercio.pe\"}, \"organizer\": {\"name\": \"sismo colombia 25/26 octubre\", \"url\": \"https://elcomercio.pe/respuestas/colombia/temblor-en-colombia-hoy-en-vivo-ultimo-sismos-25-y-26-de-octubre-2026-reporte-de-magnitud-epicentro-y-hora-segun-sgc-servicio-geologico-colombiano-tolima-bogota-co-lbposting-noticia/\"}}, \"coverageStartTime\": \"2026-10-25T09:38:00-0500\", \"coverageEndTime\": \"2026-10-27T09:38:00-0500\", \"headline\": \"Temblor en Colombia hoy, domingo 25 de octubre: epicentro y magnitud seg\\u00fan reporte SGC\", \"description\": \"Temblor en Colombia EN VIVO: cu\\u00e1l fue el epicentro y magnitud del \\u00faltimo sismo reportado HOY por el Servicio Geol\\u00f3gico Colombiano (SGC).\", \"dateModified\": \"2026-10-25T22:29:23-0500\", \"url\": \"https://elcomercio.pe/respuestas/colombia/temblor-en-colombia-hoy-en-vivo-ultimo-sismos-25-y-26-de-octubre-2026-reporte-de-magnitud-epicentro-y-hora-segun-sgc-servicio-geologico-colombiano-tolima-bogota-co-lbposting-noticia/\", \"name\": \"Temblor en Colombia hoy, domingo 25 de octubre: epicentro y magnitud seg\\u00fan reporte SGC\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"liveBlogUpdate\": [{\"@type\": \"BlogPosting\", \"headline\": \"Temblor en Colombia hoy, domingo 25 de octubre: epicentro y magnitud seg\\u00fan reporte SGC\", \"datePublished\": \"2026-10-25T17:29:21-0500\", \"dateModified\": \"2026-10-25T17:29:21-0500\", \"alternateName\": \"Mira aqu\\u00ed los reportes del Servicio Geol\\u00f3gico Colombiano (SGC) sobre los \\u00faltimos sismos en el pa\\u00eds.\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397691\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/respuestas/colombia/temblor-en-colombia-hoy-en-vivo-ultimo-sismos-25-y-26-de-octubre-2026-reporte-de-magnitud-epicentro-y-hora-segun-sgc-servicio-geologico-colombiano-tolima-bogota-co-lbposting-noticia/#liveblog-397691\", \"articleBody\": \"\\t<ul class='story-contents__paragraph-list'>\\n<li><b>Sismo en Chaparral - Tolima, Colombia</b>\\n</li><li> \\n</li><li>Magnitud: 2.2\\n</li><li>Profundidad: Superficial\\n</li><li>Hora Local: 2026-10-25 14:33\\n</li><li>Latitud: 3.83\\u00b0\\n</li><li>Longitud: -75.64\\u00b0\\n</li></ul>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Temblor en Colombia hoy, domingo 25 de octubre: epicentro y magnitud seg\\u00fan reporte SGC\", \"datePublished\": \"2026-10-25T16:05:51-0500\", \"dateModified\": \"2026-10-25T16:05:51-0500\", \"alternateName\": \"Mira aqu\\u00ed los reportes del Servicio Geol\\u00f3gico Colombiano (SGC) sobre los \\u00faltimos sismos en el pa\\u00eds.\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397589\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/respuestas/colombia/temblor-en-colombia-hoy-en-vivo-ultimo-sismos-25-y-26-de-octubre-2026-reporte-de-magnitud-epicentro-y-hora-segun-sgc-servicio-geologico-colombiano-tolima-bogota-co-lbposting-noticia/#liveblog-397589\", \"articleBody\": \"\\t<ul class='story-contents__paragraph-list'>\\n<li><b>\\u00bfPOR QU\\u00c9 NUNCA DEBER\\u00cdAS USAR UN ASCENSOR DURANTE UN SISMO?</b>\\n</li><li> \\n</li><li>Los especialistas recomiendan nunca utilizar el ascensor durante un sismo o terremoto, ya que este podr\\u00eda desprenderse de su estructura y caer desde una gran altura con personas adentro.\\n</li></ul>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Temblor en Colombia hoy, domingo 25 de octubre: epicentro y magnitud seg\\u00fan reporte SGC\", \"datePublished\": \"2026-10-25T15:45:47-0500\", \"dateModified\": \"2026-10-25T15:45:47-0500\", \"alternateName\": \"Mira aqu\\u00ed los reportes del Servicio Geol\\u00f3gico Colombiano (SGC) sobre los \\u00faltimos sismos en el pa\\u00eds.\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397544\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/respuestas/colombia/temblor-en-colombia-hoy-en-vivo-ultimo-sismos-25-y-26-de-octubre-2026-reporte-de-magnitud-epicentro-y-hora-segun-sgc-servicio-geologico-colombiano-tolima-bogota-co-lbposting-noticia/#liveblog-397544\", \"articleBody\": \"\\t<ul class='story-contents__paragraph-list'>\\n<li><b>\\u00bfQU\\u00c9 HACER EN CASO DE UN TSUNAMI?</b>\\n</li><li> \\n</li><li>Si recibes informaci\\u00f3n oficial de alerta o alarma de tsunami o ves que se recoge el mar, evac\\u00faa hacia zonas en altura. Mu\\u00e9vete hacia una zona libre de inundaci\\u00f3n y dir\\u00edgete al punto de encuentro m\\u00e1s cercano. Si no puedes llegar hasta una zona en altura, sube a un piso superior o al techo de una construcci\\u00f3n s\\u00f3lida.\\n</li></ul>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Temblor en Colombia hoy, domingo 25 de octubre: epicentro y magnitud seg\\u00fan reporte SGC\", \"datePublished\": \"2026-10-25T15:25:50-0500\", \"dateModified\": \"2026-10-25T15:25:50-0500\", \"alternateName\": \"Mira aqu\\u00ed los reportes del Servicio Geol\\u00f3gico Colombiano (SGC) sobre los \\u00faltimos sismos en el pa\\u00eds.\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397504\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/respuestas/colombia/temblor-en-colombia-hoy-en-vivo-ultimo-sismos-25-y-26-de-octubre-2026-reporte-de-magnitud-epicentro-y-hora-segun-sgc-servicio-geologico-colombiano-tolima-bogota-co-lbposting-noticia/#liveblog-397504\", \"articleBody\": \"\\t<ul class='story-contents__paragraph-list'>\\n<li><b>REVISA Y ANOTA EL N\\u00daMERO DE ASISTENCIA EN CASO DE EMERGENCIAS.</b>\\n</li></ul>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GUYDEMBNGEYC2MRVKQZDKORVGA.png?auth=7949e797cb199cdf0a716dee0d19cfa974b0362f274368b061d8b1e63179e080?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GUYDEMBNGEYC2MRVKQZDKORVGA.png?auth=7949e797cb199cdf0a716dee0d19cfa974b0362f274368b061d8b1e63179e080?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GUYDEMBNGEYC2MRVKQZDKORVGA.png?auth=7949e797cb199cdf0a716dee0d19cfa974b0362f274368b061d8b1e63179e080?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Temblor en Colombia hoy, domingo 25 de octubre: epicentro y magnitud seg\\u00fan reporte SGC\", \"datePublished\": \"2026-10-25T14:15:40-0500\", \"dateModified\": \"2026-10-25T14:15:40-0500\", \"alternateName\": \"Mira aqu\\u00ed los reportes del Servicio Geol\\u00f3gico Colombiano (SGC) sobre los \\u00faltimos sismos en el pa\\u00eds.\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397364\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/respuestas/colombia/temblor-en-colombia-hoy-en-vivo-ultimo-sismos-25-y-26-de-octubre-2026-reporte-de-magnitud-epicentro-y-hora-segun-sgc-servicio-geologico-colombiano-tolima-bogota-co-lbposting-noticia/#liveblog-397364\", \"articleBody\": \"\\t<ul class='story-contents__paragraph-list'>\\n<li><b>\\u00bfQU\\u00c9 DEBE CONTENER MI MOCHILA DE EMERGENCIA?</b>\\n</li><li> \\n</li><li>\\u2022 Art\\u00edculos indispensables de higiene\\n</li><li> \\n</li><li>\\u2022 Botiqu\\u00edn (vendas, gasa, alcohol, pastillas, agua oxigenada, etc)\\n</li><li> \\n</li><li>\\u2022 Abrigo\\n</li><li> \\n</li><li>\\u2022 Alimentos no perecibles (latas de at\\u00fan, barra de cereales, chocolates, frutos secos, etc) y dinero\\n</li><li> \\n</li><li>\\u2022 Art\\u00edculos de comunicaci\\u00f3n\\n</li><li> \\n</li><li>\\u2022 Art\\u00edculos espec\\u00edficos para beb\\u00e9s e infantes, de uso femenino, para el adulto mayor y para otras necesidades b\\u00e1sicas.\\n</li></ul>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/EWBZKPJOY5BAFDYJFDLS55G5HU.jpg?auth=05ac3cfb73c481537ef2f1e7a26c0d4f952d51e80f59aa2a212c0c552282313c?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Temblor en Colombia hoy, domingo 25 de octubre: epicentro y magnitud seg\\u00fan reporte SGC\", \"datePublished\": \"2026-10-25T13:46:13-0500\", \"dateModified\": \"2026-10-25T13:46:13-0500\", \"alternateName\": \"Mira aqu\\u00ed los reportes del Servicio Geol\\u00f3gico Colombiano (SGC) sobre los \\u00faltimos sismos en el pa\\u00eds.\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397312\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/respuestas/colombia/temblor-en-colombia-hoy-en-vivo-ultimo-sismos-25-y-26-de-octubre-2026-reporte-de-magnitud-epicentro-y-hora-segun-sgc-servicio-geologico-colombiano-tolima-bogota-co-lbposting-noticia/#liveblog-397312\", \"articleBody\": \"\\t<ul class='story-contents__paragraph-list'>\\n<li><b>REVISA LO QUE UNA MOCHILA DE EMERGENCIAS PARA EL HOGAR DEBE CONTENER.</b>\\n</li></ul>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/re