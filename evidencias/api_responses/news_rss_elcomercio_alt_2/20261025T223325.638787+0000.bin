":"https://elcomercio.pe/resizer/v2/W7YAIT5WRFFLRFAT7OMQCBJ3OE.jpg?auth=c80511fed2efdbea64f714824be268e6ea65f07f550d7dc992791767e6d417b4&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/deporte-total/espana/en-que-canal-tv-transmiten-real-madrid-vs-fc-barcelona-en-vivo-gratis-hoy-por-laliga-como-ver-el-clasico-online-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"elcomercio","revision":{"editions":["default"],"parent_id":"FTUH45OMEBH7NOREZR54QP5WWI","published":true,"branch":"default","revision_id":"GKBWX365NBFEHEAVERMBSHQNIM"},"planning":{"budget_line":"{\"textContent1\":\"• Real Madrid enfrenta a Barcelona en el Camp Nou por la jornada 10 de LaLiga, en un nuevo capítulo del histórico Clásico español. • El partido está programado para este domingo 25 de octubre de 2026, a las 3:00 p. m. en Perú y 10:00 p. m. en España. • Barcelona y Real Madrid se midieron 264 veces, con una igualdad histórica: 106 triunfos para cada equipo y 52 empates. • DirecTV transmitirá el encuentro en Perú y varios países de Sudamérica, mientras DGO ofrecerá la señal vía streaming online. • En España se verá por Movistar Plus+ y DAZN; en México por izzi y Sky Sports; y en Estados Unidos por ESPN+ y ABC.\",\"textContent2\":\"• Real Madrid enfrenta a Barcelona en el Camp Nou por la jornada 10 de LaLiga, en un nuevo capítulo del histórico Clásico español. • El partido está programado para este domingo 25 de octubre de 2026, a las 3:00 p. m. en Perú y 10:00 p. m. en España. • Barcelona y Real Madrid se midieron 264 veces, con una igualdad histórica: 106 triunfos para cada equipo y 52 empates. • DirecTV transmitirá el encuentro en Perú y varios países de Sudamérica, mientras DGO ofrecerá la señal vía streaming online. • En España se verá por Movistar Plus+ y DAZN; en México por izzi y Sky Sports; y en Estados Unidos por ESPN+ y ABC.\",\"story_id\":\"IHQ42SNKTZG37A7STENAHY3EDU\",\"premium\":\"free\",\"textEnd2\":true}","story_length":{"character_count_actual":2320,"inch_count_actual":3,"word_count_actual":407,"line_count_actual":19}},"content_restrictions":{"content_code":"free"},"display_date":"2026-10-25T22:17:47.922Z","headlines":{"tablet":"","print":"","meta_title":"En qué canales ver transmisión de El Clásico, Real Madrid-FC Barcelona EN VIVO","native":"","web":"","mobile":"","basic":"¿En qué canales ver repetición de El Clásico, Real Madrid vs FC Barcelona (1-2) por LaLiga?"},"websites":{"elcomercio":{"website_url":"/deporte-total/espana/en-que-canal-tv-transmiten-real-madrid-vs-fc-barcelona-en-vivo-gratis-hoy-por-laliga-como-ver-el-clasico-online-noticia/","website_section":{"path":"/deporte-total/espana","parent":{"default":"/deporte-total"},"_website":"elcomercio","parent_id":"/deporte-total","name":"España","description":null,"_id":"/deporte-total/espana","additional_properties":{"original":{"parent":{"header-pro":null,"default":"/deporte-total","menu-pro":"/deporte-total"},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":"España"},"_admin":{"alias_ids":["/deporte-total/espana"]},"inactive":false,"node_type":"section","social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"_website":"elcomercio","site_topper":{"site_logo_image":null},"name":"España","_id":"/deporte-total/espana","ancestors":{"header-pro":[],"default":["/deporte-total"],"menu-pro":["/deporte-total"]}}},"_website_section_id":"elcomercio./deporte-total/espana","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T00:47:13.578Z","publish_date":"2026-10-25T22:17:47.922Z","_id":"IHQ42SNKTZG37A7STENAHY3EDU","website":"elcomercio","website_url":"/deporte-total/espana/en-que-canal-tv-transmiten-real-madrid-vs-fc-barcelona-en-vivo-gratis-hoy-por-laliga-como-ver-el-clasico-online-noticia/"},{"content_elements":[{"_id":"GZN5OZPBLZERPLIBWBSAAFM6PU","type":"raw_html","content":"<iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/_zbxXYAWrG8?si=NeL5P91XRwxXakhS\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>"},{"_id":"6ZRGBEYWF5AINIHMMWTFDJK53A","additional_properties":{},"type":"text","content":"<b>Real Madrid venció 2-1 al FC Barcelona</b> en el estadio Camp Nou por LaLiga, arrebatándole el invicto al conjunto azulgrana en un vibrante Clásico español. Tras un primer tiempo con llegadas en ambos lados, Kylian Mbappé abrió el marcador al minuto 41 tras cazar un rebote en el área. En la segunda mitad, el Barcelona reaccionó y consiguió la igualdad al minuto 61 con un certero cabezazo de Raphinha a pase de Pedri. Sin embargo, cuando el dominio local parecía inclinar la balanza, una brillante jugada de Eduardo Camavinga asistió a Mbappé para firmar su doblete definitivo al minuto 88."},{"_id":"JXONNXAPLZFUFEPPV2ZDTF2ISQ","additional_properties":{},"type":"text","content":"<b>¿Cómo ver DGO y DirecTV EN VIVO en Perú y Sudamérica? </b>A continuación te mostramos qué opciones tienes para ver DGO y DirecTV."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"9450fe2bb5595b11b79464d61c116929a1849298053cf256d8374794d6a347f7"},"caption":"DGO y DirecTV EN VIVO ONLINE: transmite el partido de FC Barcelona vs. Real Madrid por la jornada 10 de LaLiga desde el Camp Nou.","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/OGYZQCTAUBDHBO74LVGLWRC66M.jpg","licensable":false,"planning":{},"credits":{"affiliation":[]},"subtitle":"DGO y DirecTV EN 