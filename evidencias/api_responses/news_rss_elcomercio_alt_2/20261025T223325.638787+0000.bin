&smart=true","large":"https://elcomercio.pe/resizer/v2/NZ5O7GVMCNCPLCUYY5Q6CIOTZA.jpg?auth=f93125736807b574bc00650db06a65547d64444869af207d686cf73d970c9c2b&width=940&height=569&quality=75&smart=true","story_small":"https://elcomercio.pe/resizer/v2/NZ5O7GVMCNCPLCUYY5Q6CIOTZA.jpg?auth=f93125736807b574bc00650db06a65547d64444869af207d686cf73d970c9c2b&width=482&height=290&quality=75&smart=true","amp_new":"https://elcomercio.pe/resizer/v2/NZ5O7GVMCNCPLCUYY5Q6CIOTZA.jpg?auth=f93125736807b574bc00650db06a65547d64444869af207d686cf73d970c9c2b&width=1200&height=800&quality=75&smart=true","amp":"https://elcomercio.pe/resizer/v2/NZ5O7GVMCNCPLCUYY5Q6CIOTZA.jpg?auth=f93125736807b574bc00650db06a65547d64444869af207d686cf73d970c9c2b&width=900&height=600&quality=75&smart=true","impresa":"https://elcomercio.pe/resizer/v2/NZ5O7GVMCNCPLCUYY5Q6CIOTZA.jpg?auth=f93125736807b574bc00650db06a65547d64444869af207d686cf73d970c9c2b&width=617&height=637&quality=75&smart=true","impresa_s":"https://elcomercio.pe/resizer/v2/NZ5O7GVMCNCPLCUYY5Q6CIOTZA.jpg?auth=f93125736807b574bc00650db06a65547d64444869af207d686cf73d970c9c2b&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/politica/senador-gavidia-del-buen-gobierno-defiende-su-voto-la-abstencion-es-peor-que-cometer-un-error-es-un-calculo-politico-apuesplan-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"elcomercio","revision":{"editions":["default"],"parent_id":"YTBYMLVNQBHJFOFT3T2YB7YFNU","published":true,"branch":"default","revision_id":"32OEGQOHWVGZDK4GS3PIU6QTXA"},"planning":{"budget_line":"{\"textContent1\":\"• Jorge Gavidia lleva 87 días como senador y enfrenta críticas por votar a favor de facultades legislativas para el Ejecutivo.\\n<br> • Cinco senadores de Buen Gobierno acordaron abstenerse, pero Gavidia y Juver Flores apoyaron la delegación por 90 días.\\n<br> • Gavidia defendió su voto, rechazó ser traidor y afirmó que abstenerse sería evitar decidir ante una situación de crisis.\\n<br> • El partido considera que ambos senadores incurrieron en indisciplina al incumplir el acuerdo adoptado por la bancada.\\n<br> • El reglamento permite sanciones como amonestación, multa, suspensión, separación del cargo, suspensión o expulsión.\",\"textContent2\":\"• Jorge Gavidia lleva 87 días como senador y enfrenta críticas por votar a favor de facultades legislativas para el Ejecutivo.\\n<br> • Cinco senadores de Buen Gobierno acordaron abstenerse, pero Gavidia y Juver Flores apoyaron la delegación por 90 días.\\n<br> • Gavidia defendió su voto, rechazó ser traidor y afirmó que abstenerse sería evitar decidir ante una situación de crisis.\\n<br> • El partido considera que ambos senadores incurrieron en indisciplina al incumplir el acuerdo adoptado por la bancada.\\n<br> • El reglamento permite sanciones como amonestación, multa, suspensión, separación del cargo, suspensión o expulsión.\",\"story_id\":\"BP2BVXHAWFA4PG7RV3PNKWUADU\",\"premium\":\"metered\",\"textEnd2\":true}","story_length":{"character_count_actual":5033,"inch_count_actual":6,"word_count_actual":799,"line_count_actual":38}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-25T22:15:00Z","headlines":{"tablet":"","print":"","meta_title":"Senador Gavidia del Buen Gobierno defiende su voto: \"La abstención es peor que cometer un error. Es un cálculo político\" | apuesplan","native":"","web":"","mobile":"","basic":"Senador Gavidia del Buen Gobierno defiende su voto: “La abstención es peor que cometer un error. Es un cálculo político”  "},"websites":{"elcomercio":{"website_url":"/politica/senador-gavidia-del-buen-gobierno-defiende-su-voto-la-abstencion-es-peor-que-cometer-un-error-es-un-calculo-politico-apuesplan-noticia/","website_section":{"path":"/politica","parent":{"default":"/"},"_website":"elcomercio","parent_id":"/","name":"Política","_id":"/politica","additional_properties":{"original":{"parent":{"+ add":"/","header-pro":null,"default":"/","navbar-default":"/","sitemap-default":"/","default-pro":"/","test":"/","search-filter-default":"/","menu-default":"/","header-default":null,"menu-pro":"/"},"_admin":{"alias_ids":["0"]},"inactive":false,"node_type":"section","_website":"elcomercio","name":"Política","_id":"/politica","ancestors":{"+ add":["/"],"header-pro":[],"navbar-default":["/"],"sitemap-default":["/"],"default-pro":["/"],"search-filter-default":["/"],"menu-default":["/"],"header-default":[],"menu-pro":["/"]},"order":{"+ add":1003,"default":1004,"navbar-default":1004,"sitemap-default":1001,"default-pro":1004,"test":1004,"search-filter-default":1002,"menu-default":1015,"menu-pro":1005}}},"_website_section_id":"elcomercio./politica","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T00:19:07.854Z","publish_date":"2026-10-25T22:15:00Z","_id":"BP2BVXHAWFA4PG7RV3PNKWUADU","website":"elcomercio","website_url":"/politica/senador-gavidia-del-buen-gobierno-defiende-su-voto-la-abstencion-es-peor-que-cometer-un-error-es-un-calculo-politico-apuesplan-noticia/"},{"content_elements":[{"list_type":"unordered","_id":"ROZ3GDU4SVG53BBNFRHMEUD35I","type":"list","items":[{"_id":"QDABIOZSABERLNVUWSVZLYOTBM","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://elcomercio.pe/mag/usa/florida/fin-del-horario-de-verano-en-florida-2026-cual-es-la-fecha-del-cambio-y-como-ajustar-el-reloj-al-horario-de-invierno-miami-orlando-nnda-nnrt-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://elcomercio.pe/mag/usa/florida/fin-del-horario-de-verano-en-florida-2026-cual-es-la-fecha-del-cambio-y-como-ajustar-el-reloj-al-horario-de-invierno-miami-orlando-nnda-nnrt-noticia/\">Fin del horario de verano en Florida 2026: cuál es la fecha del cambio y cómo debes ajustar el reloj al de invierno</a>"},{"_id":"D5UC6LTWT5GLLD2S4VDQZCIIOM","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://elcomercio.pe/mag/usa/florida/florida-cambio-sus-reglas-para-hacer-pagos-en-efectivo-en-cualquier-lugar-ron-desantis-firmo-la-ley-y-ya-rige-en-todo-el-estado-estados-unidos-nnda-nnlt-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://elcomercio.pe/mag/usa/florida/florida-cambio-sus-reglas-para-hacer-pagos-en-efectivo-en-cualquier-lugar-ron-desantis-firmo-la-ley-y-ya-rige-en-todo-el-estado-estados-unidos-nnda-nnlt-noticia/\">Florida cambió sus reglas para hacer pagos en efectivo en cualquier lugar: DeSantis firmó la ley y ya rige en todo el estado</a>"}]},{"_id":"7XPQCIUZ55AXFPH533JZJS6OIE","additional_properties":{},"type":"text","content":"Las personas que necesitan ayuda para cubrir los gastos de alimentación pueden encontrar distintas opciones gratuitas en <a href=\"https://elcomercio.pe/mag/usa/florida/miami-tendra-13-feriados-y-11-fines-de-semana-largos-en-2027-fechas-confirmadas-y-como-obtener-mas-dias-de-descanso-florida-estados-unidos-nnda-nnlt-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://elcomercio.pe/mag/usa/florida/miami-tendra-13-feriados-y-11-fines-de-semana-largos-en-2027-fechas-confirmadas-y-como-obtener-mas-dias-de-descanso-florida-estados-unidos-nnda-nnlt-noticia/\"><b>Miami</b></a> y otras zonas de Miami-Dade <b>entre el lunes 26 y el jueves 29 de octubre de 2026</b>. Bancos de alimentos, iglesias y organizaciones comunitarias mantienen programas de entrega de comestibles, aunque los horarios, los requisitos y la disponibilidad pueden variar según cada punto."},{"level":2,"_id":"4XOEGM2OBVH4DGYVSLUGVNJSXI","additional_properties":{},"type":"header","content":"<b>Dónde conseguir alimentos gratis del 26 al 29 de octubre</b>"},{"_id":"JAY56WMCMFDPVM26Z7B3KA7WZ4","additional_properties":{},"type":"text","content":"Uno de los recursos disponibles es <b>La Bodega Community Food Pantry</b>, que funciona en el YMCA de Allapattah, en el 2370 NW 17th Avenue, Miami. Según información publicada por Miami on the Cheap, este centro entrega alimentos de lunes a viernes, de 2:00 p. m. a 5:00 p. m. Los turnos para recibir productos se reparten desde la 1:00 p. m. y la atención depende de las existencias, por lo que conviene confirmar el servicio antes de desplazarse."},{"_id":"SDRCW6DM6FCQDFGAAHOOZVW5DE","additional_properties":{},"type":"text","content":"Otra alternativa es <b>Curley’s House of Style</b>, ubicada en el 6025 NW 6th Court, Miami. La organización ofrece asistencia alimentaria los martes, miércoles, jueves y viernes, de 11:00 a. m. a 3:00 p. m. Por ello, las personas interesadas pueden consultar la disponibilidad para el martes 27, miércoles 28 o jueves 29 de octubre. Para verificar los detalles, pueden llamar al 305-754-7784 o al 305-759-9805."},{"level":2,"_id":"UW4MNLI3YFBORM6RRH674ANIEU","additional_properties":{},"type":"header","content":"<b>Calendario de puntos de distribución y horarios</b>"},{"header":[{"_id":"42X2HJY44RCDRABH236UFEYN2E","type":"text","content":"Fecha"},{"_id":"X3YTEX36YJEHTGOOCEIIHCPXJQ","type":"text","content":"Punto de distribución"},{"_id":"EPE6P2KAC5D4RPAOC4OZZ3CPQA","type":"text","content":"Dirección"},{"_id":"3BD2BVJH4REL5L7ZQZGGIDP7KY","type":"text","content":"Horario publicado"}],"_id":"JQN5BG7S7JCAJN2RRXVH3XM3ZM","additional_properties":{},"rows":[[{"_id":"WWY5ABTM7JGRTGSIJKBK4ZHKGA","type":"text","content":"Lunes 26 de octubre"},{"_id":"AFUPQOTCWJC2ZP3XYBDYE4ACSI","type":"text","content":"La Bodega Community Food Pantry, en el YMCA de Allapattah"},{"_id":"TVJBTIVNHRDILFGJRQLM5X3GFI","type":"text","content":"2370 NW 17th Ave., Miami, FL 33125"},{"_id":"J5GVVBBL7FC25LWVQ4UICWLFYY","type":"text","content":"2:00 p. m. a 5:00 p. m."}],[{"_id":"SS5ICVBQ5NBHDIEV7PJLIEEQW4","type":"text","content":"Martes 27 de octubre"},{"_id":"YRQKLIMULNHOZKTQ3WCNBZYU2M","type":"text","content":"Curley’s House of Style"},{"_id":"CNUGDBNW5FGMRDUZCA377RZYYQ","type":"text","content":"6025 NW 6th Ct., Miami, FL 33127"},{"_id":"3FUBPMD3NBD33IJDDZWYU3NLII","type":"text","content":"11:00 a. m. a 3:00 p. m."}],[{"_id":"7D6GLPV47VFHHMYXGNEQBSJ6EY","type":"text","content":"Miércoles 28 de octubre"},{"_id":"RIRN3S3GZZF7TCDWNFIAPN4T7Q","type":"text","content":"Curley’s House of Style"},{"_id":"MCQ3V4L6VFBKVCZY2GT2HR4NRM","type":"text","content":"6025 NW 6th Ct., Miami, FL 33127"},{"_id":"NHKEERTAZ5GPJBKEHGHPI5O3I4","type":"text","content":"11:00 a. m. a 3:00 p. m."}],[{"_id":"VLZQFHVVWVDY7CYUPM23DD3ADM","type":"text","content":"Jueves 29 de octubre"},{"_id":"NXLDGBA3DBHMBLJZXUYGBFF75A","type":"text","content":"Curley’s House of Style"},{"_id":"EJJUIE5DBNDY3PQNBGHGLOV4FI","type":"text","content":"6025 NW 6th Ct., Miami, FL 33127"},{"_id":"6SYSQAW7OFEJXJ5P4VCOZXBQ34","type":"text","content":"11:00 a. m. a 3:00 p. m."}]],"type":"table"},{"_id":"5FXM2KPT6BB5HIFNZFB7RYNYBE","additional_properties":{},"type":"text","content":"Los horarios corresponden a los publicados por el directorio consultado. Se recomienda confirmar que la entrega de alimentos esté activa el día de la visita."},{"level":2,"_id":"IM6QHXPR7RFKNDGT4XITVHV66A","additional_properties":{},"type":"header","content":"<b>Otras opciones en el condado de Miami-Dade</b>"},{"_id":"EJHJDFGRFVH33JPWHFDWPZ4ZSY","additional_properties":{},"type":"text","content":"El calendario comunitario <b>Community Food Finder</b>, desarrollado con apoyo de Urban Health Partnerships, también registra actividades de distribución de alimentos para esas fechas. Para el miércoles 28 de octubre figura una jornada de MAU Foundation a las 12:00 p. m., además de otras actividades. Sin embargo, la información pública consultada no permite confirmar todos los domicilios y detalles de acceso, por lo que es recomendable revisar el calendario actualizado antes de acudir."},{"_id":"5LM22LXCGVEARJCALJ7ILGNRGA","additional_properties":{},"type":"text","content":"En el sur del condado, Sprout Up anuncia una distribución para el martes 27 de octubre, de 1:00 p. m. a 3:00 p. m., en Touching Miami with Love: West Homestead, ubicada en 1350 SW 4th Street, Homestead. "},{"_id":"FUGNLORVN5HNDAWIBWSZ3EYR2I","additional_properties":{},"type":"text","content":"Para el jueves 29, la organización también publica una entrega de alimentos de 3:00 p. m. a 5:00 p. m. en Homestead Housing Authority - South Dade, en 31220 SW 134th Avenue, Homestead. Estos puntos están en Homestead, dentro de Miami-Dade, pero fuera de la ciudad de Miami."},{"level":2,"_id":"EJHBWY23FFHZ5NXJ2JXVMWAEJQ","additional_properties":{},"type":"header","content":"<b>Qué debes saber antes de acudir</b>"},{"_id":"GQSBVLZXOVE75K7GF5HR7W5PJM","additional_properties":{},"type":"text","content":"Las condiciones para recibir alimentos dependen de cada organización: algunas distribuyen productos por orden de llegada y hasta agotar existencias, mientras que otras pueden solicitar registro o cumplir ciertos criterios de elegibilidad. "},{"_id":"4XZD5D3S6VAELH5JSLNUYFTXBI","additional_properties":{},"type":"text","content":"Es aconsejable llamar previamente, llegar con anticipación y preguntar si se necesita identificación, comprobante de domicilio o inscripción. Para localizar otras despensas según el código postal, se puede consultar el directorio comunitario de alimentos de Miami-Dade o llamar al <b>211</b>, una línea de información y derivación a servicios de ayuda local."},{"_id":"Q2CN2VYWJBGWLLQBURDXJR45LY","additional_properties":{},"type":"text","content":"La disponibilidad de frutas, verduras, productos enlatados y otros comestibles puede cambiar en cada jornada. Antes de salir, revisa los canales oficiales de la organización que te interese para confirmar que la distribución sigue programada y conocer cualquier cambio de última hora."}],"subheadlines":{"basic":"Varias organizaciones de Miami y el condado de Miami-Dade ofrecen asistencia alimentaria gratuita durante la última semana de octubre. "},"description":{"basic":"Consulta dónde conseguir alimentos gratis en Miami del 26 al 29 de octubre de 2026. Revisa direcciones, horarios de distribución y recomendaciones para acceder a la ayuda alimentaria."},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"primary_site":{"path":"/mag/usa/florida","parent_id":"/mag/usa","name":"Florida","description":null,"_id":"/mag/usa/florida","additional_properties":{"original":{"parent":{"default":"/mag/usa"},"navigation":{"nav_title":"Florida"},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"inactive":false,"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"name":"Florida","_id":"/mag/usa/florida","ancestors":{"default":["/mag","/mag/usa"]}}},"type":"site","version":"0.5.8"},"sites":[{"path":"/mag/usa/florida","parent_id":"/mag/usa","name":"Florida","description":null,"_id":"/mag/usa/florida","additional_properties":{"original":{"parent":{"default":"/mag/usa"},"navigation":{"nav_title":"Florida"},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"inactive":false,"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"name":"Florida","_id":"/mag/usa/florida","ancestors":{"default":["/mag","/mag/usa"]}}},"type":"site","version":"0.5.8"},{"path":"/mag/usa","parent_id":"/mag","name":"USA","description":null,"_id":"/mag/usa","additional_properties":{"original":{"parent":{"header-pro":null,"default":"/mag","mag":"/","menu-section-mag":"/","footer-mag-default":"/","menu-pro":"/mag"},"navigation":{"nav_title":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"inactive":false,"node_type":"section","social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":