stors":{"header-pro":[],"default":["/respuestas"],"menu-pro":["/respuestas"]},"order":{"menu-pro":2008}}},"_website_section_id":"elcomercio./respuestas/mexico","type":"section","version":"0.6.0"}}},"created_date":"2026-09-27T00:32:25.437Z","publish_date":"2026-10-25T22:23:53.36Z","_id":"TWQMHBNN7BEC7J2FBD4MOIE5FA","website":"elcomercio","website_url":"/respuestas/mexico/sorteo-zodiaco-especial-1762-hoy-en-vivo-resultados-del-domingo-27-de-septiembre-de-2026-video-youtube-lotenal-mx-loterias-de-mexico-lbposting-cdmx-noticia/"},{"content_elements":[{"_id":"LQL6AHWVG5EEHHVMSE25G357BQ","type":"raw_html","content":"<iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/_zbxXYAWrG8?si=NeL5P91XRwxXakhS\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>"},{"_id":"DCHXDCYNLNC5FLGSZMS6LWABNI","additional_properties":{},"type":"text","content":"<b>Real Madrid venció 2-1 al FC Barcelona</b> en el estadio Camp Nou por LaLiga, arrebatándole el invicto al conjunto azulgrana en un vibrante Clásico español. Tras un primer tiempo con llegadas en ambos lados, Kylian Mbappé abrió el marcador al minuto 41 tras cazar un rebote en el área. En la segunda mitad, el Barcelona reaccionó y consiguió la igualdad al minuto 61 con un certero cabezazo de Raphinha a pase de Pedri. Sin embargo, cuando el dominio local parecía inclinar la balanza, una brillante jugada de Eduardo Camavinga asistió a Mbappé para firmar su doblete definitivo al minuto 88."},{"_id":"THEAYE7G3JBWTD2Z5GYZBR46A4","additional_properties":{},"type":"text","content":"<b>¿A qué hora juega Barcelona vs. Real Madrid por El Clásico de LaLiga? </b>Revisa los horarios de El Clásico de España."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"55405