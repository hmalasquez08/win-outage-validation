/mundo","name":"Latinoamérica","_id":"/mundo/latinoamerica","additional_properties":{"original":{"parent":{"header-pro":null,"default":"/mundo","sitemap-default":null,"test":"/mundo","menu-pro":"/mundo"},"inactive":false,"node_type":"section","_website":"elcomercio","name":"Latinoamérica","_id":"/mundo/latinoamerica","ancestors":{"header-pro":[],"default":["/"],"sitemap-default":[],"test":["/"],"menu-pro":["/"]},"order":{"default":139,"test":139,"menu-pro":139}}},"_website_section_id":"elcomercio./mundo/latinoamerica","type":"section","version":"0.6.0"}}},"created_date":"2026-10-23T22:48:02.584Z","publish_date":"2026-10-25T22:29:57.899Z","_id":"NDWOLKZ2SVFPROLOQ426KA5JXA","website":"elcomercio","website_url":"/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/"},{"content_elements":[{"list_type":"unordered","_id":"25B5DH572ZBC3FBO6U4PK2RQTY","type":"list","items":[{"_id":"Q2HJR6HUWZFJPHZDANNVIZUL3E","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://elcomercio.pe/mag/usa/en-vivo-us/dazn-f1-en-directo-donde-ver-carrera-del-gp-de-estados-unidos-2026-por-tv-y-streaming-online-en-espana-nnda-nnrt-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://elcomercio.pe/mag/usa/en-vivo-us/dazn-f1-en-directo-donde-ver-carrera-del-gp-de-estados-unidos-2026-por-tv-y-streaming-online-en-espana-nnda-nnrt-noticia/\"><i>DAZN F1 EN DIRECTO - Ver el GP de Estados Unidos 2026 EN VIVO por TV online</i></a>"},{"_id":"QTMLPCNHO5ENPJBOR2YTAZBPDA","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://elcomercio.pe/mag/usa/en-vivo-us/f1-tv-en-vivo-en-directo-donde-ver-carrera-del-gp-de-estados-unidos-2026-por-streaming-tv-y-online-eeuu-mexico-nnda-nnrt-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://elcomercio.pe/mag/usa/en-vivo-us/f1-tv-en-vivo-en-directo-donde-ver-carrera-del-gp-de-estados-unidos-2026-por-streaming-tv-y-online-eeuu-mexico-nnda-nnrt-noticia/\"><i>F1 TV EN VIVO EN DIRECTO — dónde ver carrera del GP de Estados Unidos 2026 por Streaming TV y Online</i></a><i> </i>"}]},{"_id":"PEBCACBLCVEF5EVBGU33SKSANI","additional_properties":{},"type":"text","content":"<b>Este domingo 25 de octubre se llevará a cabo la carrera del GP de Estados Unidos 2026 en el Circuito de las Américas (COTA) en Austin, Texas, y no te la puedes perder</b>. El evento deportivo arrancará a las 2:00 pm en CDMX y 4:00 pm en Estados Unidos (ET). SKY Sports, SKY Plus e Izzi TV lo transmitirán EN VIVO y EN DIRECTO, así que prepárate."},{"copyright":"Ranjith Kumar/NurPhoto","syndication":{"search":false,"external_distribution":false},"auth":{"1":"321f083bb91df887acbe6a9639214eb937c24ddde5477701849fd0f80a1eaed4"},"caption":"La carrera del GP de Estados Unidos 2026 se realizará en el Circuito de las Américas (COTA) en Austin, Texas. (Foto: RANJITH KUMAR / NURPHOTO / NURPHOTO / AFP)","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","licensable":false,"alt_text":"SKY Sports EN VIVO - cómo ver carrera del GP de Estados Unidos 2026 por Izzi TV y SKY Plus Online en México","credits":{"affiliation":[{"name":"NurPhoto via AFP","type":"author"}],"by":[{"name":"RANJITH KUMAR","type":"author","byline":"RANJITH KUMAR"}]},"creditIPTC":"NurPhoto via AFP","country_name":"Singapore","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/V22DATLN7RGPRLQIT2KSEOWYAY.jpg?auth=321f083bb91df887acbe6a9639214eb937c24ddde5477701849fd0f80a1eaed4","iptc_source":"NurPhoto","iptc_category":"SPO","keywords":["11 october 2026","action shot","charles leclerc","f1","formula1","grand prix","horizontal","marina bay street circuit","motor sports","scuderia ferrari hp","singapore","singapore airlines singapore grand prix","two people"],"proxyUrl":"/resizer/v2/V22DATLN7RGPRLQIT2KSEOWYAY.jpg?auth=321f083bb91df887acbe6a9639214eb937c24ddde5477701849fd0f80a1eaed4","takenOn":"2026-10-11T19:17:14Z","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/V22DATLN7RGPRLQIT2KSEOWYAY.jpg","published":true,"resizeUrl":"/resizer/v2/V22DATLN7RGPRLQIT2KSEOWYAY.jpg?auth=321f083bb91df887acbe6a9639214eb937c24ddde5477701849fd0f80a1eaed4","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/V22DATLN7RGPRLQIT2KSEOWYAY.jpg?auth=321f083bb91df887acbe6a9639214eb937c24ddde5477701849fd0f80a1eaed4&width=300","version":0,"countryId":193,"iptc_supplemental_categories":["sports event"],"originalName":"sky-sports-en-vivo-como-ver-carrera-gp-estados-unidos-2026-izzi-tv-sky-plus-online-mexico.jpg","iptc_urgency":5,"mime_type":"image/jpeg","restricted":false,"iptc_caption_writer":"ME","template_id":302,"galleries":[],"iptc_title":"STR"},"last_updated_date":"2026-10-20T15:31:33Z","slug":"MOTOR-F1/","height":1620,"image_type":"photograph","owner":{"sponsored":false,"id":"elcomercio"},"address":{"locality":"Singapore","country_name":"SGP"},"version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/V22DATLN7RGPRLQIT2KSEOWYAY.jpg","planning":{},"subtitle":"SKY Sports EN VIVO - cómo ver carrera del GP de Estados Unidos 2026 por Izzi TV y SKY Plus Online en México","width":2476,"_id":"V22DATLN7RGPRLQIT2KSEOWYAY","created_date":"2026-10-20T15:31:33Z","status":""},{"level":2,"_id":"IILBC6E7DJAYXCFXNG72ARIPQI","additional_properties":{},"type":"header","content":"<b>¿Cómo ver el GP de Estados Unidos 2026 EN VIVO vía SKY Sports en México?</b>"},{"_id":"DTQ2PMTLLFD53LI727M6L2M2JA","additional_properties":{},"type":"text","content":"<b>Para acceder a la transmisión oficial del Gran Premio de Estados Unidos 2026, es necesario contar con una suscripción activa a SKY México</b>. El canal SKY Sports está incluido en los paquetes SKY HD o SKY Platinum, que permiten ver la carrera en calidad Full HD y con señal en vivo."},{"level":2,"_id":"FTWBAO2LJBAPRE3STGWZ64EGQE","additional_properties":{},"type":"header","content":"<b>¿Cómo ver el GP de Estados Unidos 2026 EN VIVO vía SKY Plus?</b>"},{"_id":"HMFV2CY6L5GM3MZ6H2HVXOUUVE","additional_properties":{},"type":"text","content":"<b>Ten en cuenta que es posible seguir el GP de Estados Unidos 2026 desde cualquier dispositivo con la aplicación SKY Plus (antes SKY Go)</b>. Solo debes descargarla en tu teléfono (para iOS y Android), tablet o Smart TV, iniciar sesión con tu cuenta de Sky y seleccionar el canal de SKY Sports F1 el día del evento. De esta manera, podrás disfrutar de la carrera de manera online, en vivo y sin interrupciones."},{"level":2,"_id":"RS7OWWZZWZAHVCVVS6UPGJ3OKM","additional_properties":{},"type":"header","content":"<b>¿Cómo ver el GP de Estados Unidos 2026 EN VIVO vía Izzi TV e Izzi Go?</b>"},{"_id":"HOWCXSWKHNGPTHD6PF4JCDTIFE","additional_properties":{},"type":"text","content":"<b>También es importante que sepas que Sky Sports está incluido en Izzi TV, pero es necesario contratar el servicio de TV de paga o un paquete específico para poder acceder a él</b>. Una vez contratado, puedes ver todos los canales de SKY Sports en tu televisión o a través de la aplicación Izzi Go. Esta es otra alternativa para mirar el GP de Estados Unidos 2026 EN VIVO y de manera online."},{"subtype":"about_author","_id":"P7DN5MIZDBDFLBWQG43NDMYVGQ","embed":{"id":"1792510062605","config":{"authorTwitter":"CesarQuispeA","authorSlug":"cesar-quispe","authorName":"César Quispe Alcócer","authorImage":"https://author-service-images-prod-us-east-1.publishing.aws.arc.pub/elcomercio/HV4ZDQUR7JATDFOCFV4GI35XKM.png","authorLinkedIn":"","authorBio":"Soy Licenciado en Ciencias de la Comunicación por la USMP y Redactor Real Time del Núcleo de Audiencias del Grupo El Comercio. Tengo casi 10 años de experiencia en investigación, análisis y coberturas en vivo online, y me especializo en artículos de actualidad, deportes y espectáculos para audiencias en EE.UU., México y España."},"url":"/pf/api/v3/content/fetch/photo-by-id"},"type":"custom_embed"},{"_id":"PQJUWDE6RNA6VCNTYPDB6WQRGQ","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"Kimi Antonelli convirtió la pole position en triunfo en el GP de Estados Unidos 2026. El piloto de Mercedes dominó la clasificación final por delante de Leclerc y Verstappen en el Circuito de las Américas."},"description":{"basic":"Kimi Antonelli convirtió la pole position en triunfo en el GP de Estados Unidos 2026. El piloto de Mercedes dominó la clasificación final por delante de Leclerc y Verstappen en el Circuito de las Américas."},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"primary_site":{"path":"/mag/usa/en-vivo-us","parent_id":"/mag/usa","name":"En Vivo US","description":null,"_id":"/mag/usa/en-vivo-us","additional_properties":{"original":{"parent":{"header-pro":"/mag/usa","default":"/mag/usa","menu-pro":null},"_admin":{"alias_ids":["/mag/usa/en-vivo-us"]},"navigation":{"nav_title":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"inactive":false,"node_type":"section","social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"name":"En Vivo US","_id":"/mag/usa/en-vivo-us","ancestors":{"header-pro":["/mag","/mag/usa"],"default":["/mag","/mag/usa"],"menu-pro":[]},"order":{}}},"type":"site","version":"0.5.8"},"sites":[{"path":"/mag/usa/en-vivo-us","parent_id":"/mag/usa","name":"En Vivo US","description":null,"_id":"/mag/usa/en-vivo-us","additional_properties":{"original":{"parent":{"header-pro":"/mag/usa","default":"/mag/usa","menu-pro":null},"_admin":{"alias_ids":["/mag/usa/en-vivo-us"]},"navigation":{"nav_title":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"inactive":fal