    <!--funciones de respuesta a errores-->
    <script src="../../Scripts/admin/error.js"></script>

    <!--función de carga de metadatos de datasets-->
    <script src="../../Scripts/alasql/alasql.min.js"> </script>
    <script src="../../Scripts/jszip/jszip.js"></script>
    <script src="../../Scripts/filesaver/FileSaver.js"></script>
    <script src="../../Scripts/datasets/datasetsMeta.js"></script>        


    </form>    

