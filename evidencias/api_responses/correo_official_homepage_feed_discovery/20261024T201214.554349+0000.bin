nch":"default","revision_id":"FURX7Y54K5GZ3ML5W4HKVSIKGY"},"planning":{"story_length":{"character_count_actual":1242,"inch_count_actual":2,"word_count_actual":190,"line_count_actual":13}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T18:54:12.05Z","headlines":{"tablet":"","print":"","meta_title":"Chavimochic tiene la tarea de garantizar la disponibilidad del agua La Libertad Perú ","native":"","web":"","mobile":"","basic":"La Libertad: Chavimochic tiene la tarea de garantizar la disponibilidad del agua"},"websites":{"diariocorreo":{"website_url":"/edicion/la-libertad/chavimochic-tiene-la-tarea-de-garantizar-la-disponibilidad-del-agua-la-libertad-peru-noticia/","website_section":{"path":"/edicion/la-libertad","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"La Libertad","_id":"/edicion/la-libertad","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"La Libertad","_id":"/edicion/la-libertad","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":84,"default":84,"test":84,"menu-pro":84}}},"_website_section_id":"diariocorreo./edicion/la-libertad","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T18:51:04.469Z","publish_date":"2026-10-24T18:56:50.745Z","_id":"DHTXDF4O5ZHOLLLC26KZWARBRA","website":"diariocorreo","website_url":"/edicion/la-libertad/chavimochic-tiene-la-tarea-de-garantizar-la-disponibilidad-del-agua-la-libertad-peru-noticia/"},{"content_elements":[{"_id":"GRV2GVQZFBEADJ6QP4AJK4PSYE","additional_properties":{},"type":"text","content":"<a href=\"https://diariocorreo.pe/edicion/ica/ica-decomisan-panetones-sin-registro-sanitario-tras-operativo-en-el-mercado-santo-domingo-noticia/\" target=\"_self\" rel=\"\" title=\"https://diariocorreo.pe/edicion/ica/ica-decomisan-panetones-sin-registro-sanitario-tras-operativo-en-el-mercado-santo-domingo-noticia/\"><b>Seis presuntos integrantes de la banda denominada “Los dulces de la Navidad” </b></a><b>fueron capturados por la Policía Nacional del Perú, tras una intervención realizada a la altura del kilómetro 338 de la carretera Panamericana Sur, en el distrito de Santiago, provincia de Ica. Los intervenidos son investigados por su presunta participación en el hurto agravado de </b><a href=\"https://diariocorreo.pe/edicion/ica/mpi-verificara-salubridad-de-panetones-y-panaderias-858427/\" target=\"_self\" rel=\"\" title=\"https://diariocorreo.pe/edicion/ica/mpi-verificara-salubridad-de-panetones-y-panaderias-858427/\"><b>mercadería transportada en vehículos de carga, bajo la modalidad conocida como “patinaje”.</b></a>"},{"level":2,"_id":"UGXHSXUZ6NDMPI7JCWBYJFL3AM","additional_properties":{},"type":"header","content":"<b>Golpe policial</b>"},{"_id":"4HEJX6L5YBHJPL7HETLJDSESWI","additional_properties":{},"type":"text","content":"Durante el operativo, los agentes recuperaron 33 cajas selladas de panetones y una caja abierta que contenía crema de leche, productos cuyo valor aproximado asciende a S/ 5900. La mercadería habría sido sustraída durante el traslado de la carga en Palpa, por lo que las circunstancias del hecho son materia de investigación."},{"_id":"RUM2IOYFKJGIZAK73EFPDJG7HE","additional_properties":{},"type":"text","content":"De acuerdo con la información policial, los productos eran transportados en una camioneta de color gris, cuya tolva contenía varias decenas de cajas de panetones que estaban cubiertos. Asimismo, durante la intervención se identificó un automóvil Hyundai de color rojo, con placa de rodaje CMD-656. Ambos vehículos fueron incautados por su presunta utilización en el hecho investigado."},{"_id":"DMLTBFWAMRFZDPESJMZJMQRV3A","additional_properties":{},"type":"text","content":"Los detenidos y las especies recuperadas fueron puestos a disposición de las autoridades competentes para continuar con las diligencias correspondientes y determinar las responsabilidades individuales. Además, la Policía investigará la posible vinculación de los intervenidos con otra denuncia por hurto registrada en Palpa."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"962eaf0ae0ac416f5a242a34ccc5de2fe524c4f80463247ddd4cf1cc8b7969a4"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/3ADWUGDTCND65IB5G6GA3BIZSA.jpg","licensable":false,"credits":{"affiliation":[]},"subtitle":"ica","width":891,"_id":"3ADWUGDTCND65IB5G6GA3BIZSA","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/3ADWUGDTCND65IB5G6GA3BIZSA.jpg?auth=962eaf0ae0ac416f5a242a34ccc5de2fe524c4f80463247ddd4cf1cc8b7969a4","proxyUrl":"/resizer/v2/3ADWUGDTCND65IB5G6GA3BIZSA.jpg?auth=962eaf0ae0ac416f5a242a34ccc5de2fe524c4f80463247ddd4cf1cc8b7969a4","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/3ADWUGDTCND65IB5G6GA3BIZSA.jpg","published":true,"resizeUrl":"/resizer/v2/3ADWUGDTCND65IB5G6GA3BIZSA.jpg?auth=962eaf0ae0ac416f5a242a34ccc5de2fe524c4f80463247ddd4cf1cc8b7969a4","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/3ADWUGDTCND65IB5G6GA3BIZSA.jpg?auth=962eaf0ae0ac416f5a242a34ccc5de2fe524c4f80463247ddd4cf1cc8b7969a4&width=300","version":0,"originalName":"859899495_1646006300314023_1657351443033718022_n.jpg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T15:06:11Z","last_updated_date":"2026-10-24T15:06:11Z","height":384,"image_type":"photograph","status":""},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"10159fba4c79d953c3783f85e58f070864e6abc