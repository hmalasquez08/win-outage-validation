/0029Vb7TiRS9cDDcPrLTPY0z\"><b>https://whatsapp.com/channel/0029Vb7TiRS9cDDcPrLTPY0z</b></a>"},{"level":2,"_id":"OOOVBD32ZNEXRA7T4HHV2JFLDU","additional_properties":{},"type":"header","content":"<b>VIDEO RECOMENDADO</b>"},{"_id":"REKXCDTBJ5CCPPFN7BOCBBWZMQ","type":"raw_html","content":"<iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/3u0hANhfT4E?si=6HaW92QatoGLlHki\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>"},{"_id":"Z4RIW2UCOVCFDE42R7FQZ6YRTE","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"Robaron las cajas en Palpa, mediante la modalidad del “patinaje”"},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/edicion/ica","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Ica","_id":"/edicion/ica","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Ica","_id":"/edicion/ica","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":85,"default":85,"test":85,"menu-pro":85}}},"_website_section_id":"diariocorreo./edicion/ica","type":"section","version":"0.6.0"},{"path":"/edicion","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Edición","_id":"/edicion","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","sitemap-default":"/","test":"/","search-filter-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Edición","_id":"/edicion","ancestors":{"sitemap-default":["/"],"search-filter-default":[]},"order":{"header-pro":75,"default":75,"sitemap-