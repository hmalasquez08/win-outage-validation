:"info"},"facebook_ia":{"display":true,"text":"Si","url":"true"},"locador":{"display":true,"text":"Si","url":"true"},"nucleo":{"display":true,"text":"Redacción","url":"redaccion"}},"promo_items":{"basic":{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984"},"caption":"El presidente de la Cámara de Senadores informó que se corregirá la palabra “Senado” por “Congreso” en el documento referido a la delegación de facultades legislativas. (Foto: Andina)","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg","licensable":false,"credits":{"affiliation":[]},"subtitle":"Miguel Torres defiende procedimiento para delegación de facultades y afirma que se ajustó al marco legal. (Foto: Andina)","width":1200,"_id":"IBWXXQCH2ZHF7PG36JQWNNMVZU","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984","proxyUrl":"/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg","published":true,"resizeUrl":"/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=300","version":0,"originalName":"miki.jpg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T00:30:53Z","last_updated_date":"2026-10