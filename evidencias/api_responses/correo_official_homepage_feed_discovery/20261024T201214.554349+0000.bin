","content":"<b>📲 Únete al canal oficial de Diario Correo en WhatsApp y recibe en tu celular las noticias más importantes del Perú y el mundo, alertas de último minuto y las portadas del día, todo de forma rápida y confiable. No te quedes fuera de la información.</b>"},{"_id":"VCPISMSVJBD3ZCTZBW6W3PXYAI","additional_properties":{},"type":"text","content":"<b>Súmate aquí: 👉 </b><a href=\"https://whatsapp.com/channel/0029Vb7TiRS9cDDcPrLTPY0z/\" rel=\"\" title=\"https://whatsapp.com/channel/0029Vb7TiRS9cDDcPrLTPY0z\"><b>https://whatsapp.com/channel/0029Vb7TiRS9cDDcPrLTPY0z</b></a>"},{"level":2,"_id":"PYUPBCWAV5GJDBV75L6Z7LMNP4","additional_properties":{},"type":"header","content":"<b>VIDEO RECOMENDADO</b>"},{"_id":"UWPVKO2MERC2LBYDZYP3YJRAWU","type":"raw_html","content":"<iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/3u0hANhfT4E?si=84v5BYeU9rqhl625\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>"},{"_id":"N3D3U2QF6JEF5JA2J7EAC4WMUA","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"Asistentes realizaron una visita guiada para conocer la riqueza histórica y cultural"},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/edicion/ica","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Ica","_id":"/edicion/ica","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Ica","_id":"/edicion/ica","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":85,"default":85,"test":85,"menu-pro":85}}},"_website_section_id":"diariocorreo./edicion/ica","type":"sec