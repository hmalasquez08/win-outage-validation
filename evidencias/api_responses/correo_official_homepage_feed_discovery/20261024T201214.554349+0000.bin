dth=314&height=374&quality=75&smart=true","portrait_s":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=161&height=220&quality=75&smart=true","portrait_xs":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=75&height=90&quality=75&smart=true","square_xl":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=900&height=900&quality=75&smart=true","square_l":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=600&height=600&quality=75&smart=true","square_md":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=300&height=300&quality=75&smart=true","square_s":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=150&height=150&quality=75&smart=true","square_xs":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=75&height=75&quality=75&smart=true","small":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=100&height=200&quality=75&smart=true","medium":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=480&quality=75&smart=true","content":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=980&quality=75&smart=true","content_small":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=320&quality=75&smart=true","large":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=940&height=569&quality=75&smart=true","story_small":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=482&height=290&quality=75&smart=true","amp_new":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=1200&height=800&quality=75&smart=true","amp":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=900&height=600&quality=75&smart=true","impresa":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=617&height=637&quality=75&smart=true","impresa_s":"https://diariocorreo.pe/resizer/v2/IBWXXQCH2ZHF7PG36JQWNNMVZU.jpg?auth=92f578cac9f8212407e51dc64bd30388d15346e5ab05ba5ac82c32627bc56984&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/politica/miguel-torres-anuncia-fe-de-erratas-para-corregir-error-en-el-encabezado-de-la-ley-n-32743-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"diariocorreo","revision":{"editions":["default"],"parent_id":"5GYYIE4NKREIVL3PYGVZ5KQUKA","published":true,"branch":"default","revision_id":"62FLBPYGCZEOLBK5ZLB65624PM"},"planning":{"story_length":{"character_count_actual":1284,"inch_count_actual":2,"word_count_actual":201,"line_count_actual":14}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T19:13:16.148Z","headlines":{"tablet":"","print":"","meta_title":"Miguel Torres anuncia fe de erratas para corregir error en el encabezado de la Ley N.° 32743","native":"","web":"","mobile":"","basic":"Miguel Torres anuncia fe de erratas por error en la ley de facultades legislativas"},"websites":{"diariocorreo":{"website_url":"/politica/miguel-torres-anuncia-fe-de-erratas-para-corregir-error-en-el-encabezado-de-la-ley-n-32743-noticia/","website_section":{"path":"/politica","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Política","_id":"/politica","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","search-filter-default":null,"menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Política","_id":"/politica","ancestors":{"navbar-default":[],"sitemap-default":["/"],"search-filter-default":[],"menu-default":[],"footer-secciones-default":["/"],"footer-default":[]},"order":{"header-pro":45,"default":45,"sitemap-default":1010,"test":45,"footer-secciones-default":1001,"menu-pro":45}}},"_website_section_id":"diariocorreo./politica","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T19:10:58.932Z","publish_date":"2026-10-24T19:17:07.94Z","_id":"XCBGDKGP7FGPFLXFRBX6BC6D6A","website":"diariocorreo","website_url":"/politica/miguel-torres-anuncia-fe-de-erratas-para-corregir-error-en-el-encabezado-de-la-ley-n-32743-noticia/"},{"content_elements":[{"_id":"VI2RZSTWD5FOXPW5ETCUT2ABVI","additional_properties":{},"type":"text","content":"<b>Ante las alertas meteorológicas por </b><a href=\"https://diariocorreo.pe/edicion/ica/ica-juasvi-senala-que-lluvias-podrian-darse-desde-diciembre-por-el-fenomeno-el-nino-2026-2027-noticia/\" target=\"_self\" rel=\"\" title=\"https://diariocorreo.pe/edicion/ica/ica-juasvi-senala-que-lluvias-podrian-darse-desde-diciembre-por-el-fenomeno-el-nino-2026-2027-noticia/\"><b>lluvias en la costa</b></a><b>, el </b><a href=\"https://diariocorreo.pe/edicion/ica/fenomeno-el-nino-ica-prepara-tres-refugios-para-mas-de-6000-personas-ante-posibles-inundaciones-noticia/\" target=\"_self\" rel=\"\" title=\"https://diariocorreo.pe/edicion/ica/fenomeno-el-nino-ica-prepara-tres-refugios-para-mas-de-6000-personas-ante-posibles-inundaciones-noticia/\"><b>Instituto Nacional de Defensa Civil (INDECI)</b></a><b> informó que cuenta con recursos y personal preparado para responder ante posibles emergencias en la región Ica. Fabricio Velásquez Portella, director de la institución en la región, señaló que se han identificado albergues temporales y existen reservas de ayuda humanitaria para atender a las familias que pudieran resultar afectadas por inundaciones, desbordes u otras contingencias.</b>"},{"level":2,"_id":"OUIKNBAAXJADVH6QHYUZ6XZHNA","additional_properties":{},"type":"header","content":"<b>Prevención ante lluvias</b>"},{"_id":"3F4PFVDMYFHS3IC2S3TQDUNLRQ","additional_properties":{},"type":"text","content":"Velásquez explicó que las lluvias ligeras registradas el jueves 22 de octubre generaron preocupación entre la población ante la posibilidad de que las precipitaciones se intensifiquen y provoquen la activación de quebradas o el incremento del caudal de los ríos. Frente a este escenario, pidió mantener la calma y confiar en las acciones preventivas de las autoridades. “Lo primero que yo les invoco es a mantener la calma”, manifestó."},{"_id":"ERFWPMJHOJFAZFCGBLZELGQ5LU","additional_properties":{},"type":"text","content":"El funcionario precisó que la labor principal del INDECI consiste en proporcionar bienes de ayuda humanitaria durante las emergencias. Explicó que, de acuerdo con el Sistema Nacional de Gestión del Riesgo de Desastres, la atención inicial corresponde a las autoridades locales y regionales, mientras que la intervención habitual de la institución se produce ante emergencias de mayor nivel. No obstante, señaló que las nuevas facultades otorgadas al Ejecutivo permitirán acompañar a las municipalidades en la entrega de ayuda a las personas damnificadas."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"468530038d1f49ee6827150c35fc11830bbdb09b857379ebc55ac668262e0180"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/PM3KDXM2YZDW5PE6KUMNHSGWV4.jpeg","licensable":false,"credits":{"affiliation":[]},"subtitle":"ica","width":2048,"_id":"PM3KDXM2YZDW5PE6KUMNHSGWV4","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/PM3KDXM2YZDW5PE6KUMNHSGWV4.jpeg?auth=468530038d1f49ee6827150c35fc11830bbdb09b857379ebc55ac668262e0180","proxyUrl":"/resizer/v2/PM3KDXM2YZDW5PE6KUMNHSGWV4.jpeg?auth=468530038d1f49ee6827150c35fc11830bbdb09b857379ebc55ac668262e0180","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/PM3KDXM2YZDW5PE6KUMNHSGWV4.jpeg","published":true,"resizeUrl":"/resizer/v2/PM3KDXM2YZDW5PE6KUMNHSGWV4.jpeg?auth=468530038d1f49ee6827150c35fc11830bbdb09b857379ebc55ac668262e0180","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/PM3KDXM2YZDW5PE6KUMNHSGWV4.jpeg?auth=468530038d1f49ee6827150c35fc11830bbdb09b857379ebc55ac668262e0180&width=300","version":0,"usage_instructions":"FBMD0a000a4f020000f38900007e1101008b270100bc4b01001b8c0100216f0200558b0200bf9602002aa60200d7520300","originalName":"858076743_1792310641815722_8717602634049847689_n.png.jpeg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T13:20:01Z","last_updated_date":"2026-10-24T13:20:01Z","height":1153,"image_type":"photograph","status":""},{"_id":"OGDGZ3JFPRA6LCBV3EXWC2E4CM","additional_properties":{},"type":"text","content":"Respecto a los albergues temporales, el director indicó que estos espacios fueron identificados mediante un trabajo coordinado con las municipalidades. Precisó que se trata de lugares seguros, como estadios y espacios abiertos, donde se instalarían carpas para recibir a las familias que resulten gravemente afectadas por inundaciones. En total, se han identificado tres espacios que podrían habilitarse como albergues temporales, según lo informado por el funcionario. En caso de emergencia, los gobiernos locales, con el apoyo del INDECI, también brindarían asistencia humanitaria y alimentación durante la permanencia de los damnificados."},{"_id":"HAMUH7GEXVFTVC4PPX6LYVBJS4","additional_properties":{},"type":"text","content":"Sobre la capacidad de respuesta de los municipios, Velásquez afirmó que los gobiernos locales tienen identificados los espacios destinados a los albergues y los puntos donde podría recibirse ayuda humanitaria. Sin embargo, reconoció que el próximo cambio de autoridades podría generar algunas dificultades iniciales en la continuidad de la gestión. Pese a ello, aseguró que se encuentran identificadas las zonas que podrían recibir apoyo por vía aérea mediante espacios habilitados para el aterrizaje de helicópteros, conocidos como helipuertos."},{"_id":"QZROGJ75TBDNLG574RX54JEROE","additional_properties":{},"type":"text","content":"En cuanto a las reservas disponibles, el director informó que Ica cuenta con un almacén de ayuda humanitaria con capacidad para aproximadamente 900 kits, destinados a atender a unas 4.500 personas. Añadió que otros almacenes ubicados en Lima podrían abastecer a la región si se presentara una emergencia de mayor magnitud. “Tenemos una capacidad grande de casi 900 kits, o sea, podemos atender a casi 4.500 personas”, declaró. Los bienes de ayuda humanitaria pueden incluir artículos para brindar techo y abrigo, alimentos, utensilios y herramientas básicas. Entre los elementos utilizados en la atención de emergencias figuran carpas, camas, colchones, frazadas, raciones de alimentos, menaje de cocina, bidones y baldes. "},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"e555453398d1d83dd1d5be245c8074f12a67742f3ada230a919d8e195934214c"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/3AOVHRSCHBHOPIKQJAKEEZMG6U.jpeg","licensable":false,"credits":{"affiliation":[]},"subtitle":"ICA","width":1600,"_id":"3AOVHRSCHBHOPIKQJAKEEZMG6U","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/3AOVHRSCHBHOPIKQJAKEEZMG6U.jpeg?auth=e555453398d1d83dd1d5be245c8074f12a67742f3ada230a919d8e195934214c","proxyUrl":"/resizer/v2/3AOVHRSCHBHOPIKQJAKEEZMG6U.jpeg?auth=e555453398d1d83dd1d5be245c8074f12a67742f3ada230a919d8e195934214c","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/3AOVHRSCHBHOPIKQJAKEEZMG6U.jpeg","published":true,"resizeUrl":"/resizer/v2/3AOVHRSCHBHOPIKQJAKEEZMG6U.jpeg?auth=e555453398d1d83dd1d5be245c8074f12a67742f3ada230a919d8e195934214c","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/3AOVHRSCHBHOPIKQJAKEEZMG6U.jpeg?auth=e555453398d1d83dd1d5be245c8074f12a67742f3ada230a919d8e195934214c&width=300","version":0,"originalName":"WhatsApp Image 2026-10-23 at 10.07.28 AM.jpeg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T14:54:31Z","last_updated_date":"2026-10-24T14:54:31Z","height":900,"image_type":"photograph","status":""},{"_id":"QMPXBJUTFNAXXB6HPC4OFFVMO4","additional_properties":{},"type":"text","content":"Asimismo, indicó que la institución dispone de personal preparado para desplazarse a las diferentes provincias y brindar asistencia técnica durante una emergencia. Estos equipos de intervención orientan a las autoridades en la evaluación de daños y análisis de necesidades (EDAN), herramienta que permite identificar a las personas afectadas y damnificadas para organizar una respuesta oportuna y determinar la ayuda requerida."},{"_id":"XZXBP7KOVZG7PCXUA666DQ6B5E","additional_properties":{},"type":"text","content":"Por su parte, el Servicio Nacional de Meteorología e Hidrología del Perú (SENAMHI) mantenía vigente para este sábado 24 de octubre una alerta roja por lluvias y lloviznas de moderada a extrema intensidad en sectores de la costa centro y sur, incluida la franja costera de Ica. El aviso advertía también sobre el incremento de la velocidad del viento y la presencia de niebla y neblina cerca del litoral, principalmente durante la noche, la madrugada y las primeras horas del día. Para la costa de Ica se estimaban acumulados cercanos a 1,5 milímetros de lluvia por día."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"e3b126ca31762c99c3129df077731305516617bb6ec51c19e927a410c69ef984"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/7XLQSDDLCJEC7ICVJ2FNDD4XAE.jpeg","licensable":false,"credits":{"affiliation":[]},"subtitle":"ica","width":1600,"_id":"7XLQSDDLCJEC7ICVJ2FNDD4XAE","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/7XLQSDDLCJEC7ICVJ2FNDD4XAE.jpeg?auth=e3b126ca31762c99c3129df077731305516617bb6ec51c19e927a410c69ef984","proxyUrl":"/resizer/v2/7XLQSDDLCJEC7ICVJ2FNDD4XAE.jpeg?auth=e3b126ca31762c99c3129df077731305516617bb6ec51c19e927a410c69ef984","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/7XLQSDDLCJEC7ICVJ2FNDD4XAE.jpeg","published":true,"resizeUrl":"/resizer/v2/7XLQSDDLCJEC7ICVJ2FNDD4XAE.jpeg?auth=e3b126ca31762c99c3129df077731305516617bb6ec51c19e927a410c69ef984","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/7XLQSDDLCJEC7ICVJ2FNDD4XAE.jpeg?auth=e3b126ca31762c99c3129df077731305516617bb6ec51c19e927a410c69ef984&width=300","version":0,"originalName":"WhatsApp Image 2026-10-23 at 17.09.28.jpeg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T13:20:27Z","last_updated_date":"2026-10-24T13:20:27Z","height":1200,"image_type":"photograph","status":""},{"_id":"PTNORX553RABTFHUA2A3AGMNAM","additional_properties":{},"type":"text","content":"En paralelo, otro aviso meteorológico del SENAMHI contemplaba precipitaciones de moderada a fuerte intensidad hasta el domingo 25 de octubre en sectores de la sierra y la costa norte. Se pronosticaron lluvias y granizo, descargas eléctricas y ráfagas de viento cercanas a los 40 kilómetros por hora. También se advirtió sobre la posibilidad de granizo en zonas de la sierra norte ubicadas por encima de los 2.800 metros sobre el nivel del mar. Para este aviso, los acumulados previstos variaban entre 2 y 17 milímetros diarios en la costa norte, entre 10 y 25 en la sierra norte, entre 8 y 16 en la sierra centro y entre 6 y 24 en la sierra sur."},{"_id":"WOPWTJKD7RCDHDK3LE7UVFE5EI","additional_properties":{},"type":"text","content":"Ante las condiciones meteorológicas previstas, se recomendó a la población mantenerse informada sobre la evolución de las alertas, seguir las indicaciones de las autoridades y actuar con precaución frente a posibles emergencias. Asimismo, se resaltó la importancia de que las municipalidades mantengan activos sus mecanismos de prevención y respuesta, especialmente en sectores expuestos a inundaciones, desbordes o activación de quebradas."},{"_id":"V2OWX6YNTJADLAXEIBB3HFDFIM","additional_properties":{},"type":"text","content":"Finalmente, Velásquez reiteró que el INDECI cuenta con personal, reservas de ayuda humanitaria y mecanismos de coordinación para apoyar a las autoridades ante una emergencia."},{"_id":"BLVSHXWZFZB3ZNAWIFW33C4AN4","additional_properties":{},"type":"text","content":"El director insistió en que la población debe conservar la calma y atender la información oficial, mientras las instituciones mantienen las acciones de preparación frente a las precipitaciones previstas para este fin de semana."},{"_id":"KRR6DCGYPNDLNBKZLLKGLGGKSU","additional_properties":{},"type":"text","content":"<b>📲 Únete al canal oficial de Diario Correo en WhatsApp y recibe en tu celular las noticias más importantes del Perú y el mundo, alertas de último minuto y las portadas del día, todo de forma rápida y confiable. No te quedes fuera de la información.</b>"},{"_id":"EF3EMN3U7FC7TDDPRI5XME4EFU","additional_properties":{},"type":"text","content":"<b>Súmate aquí: 👉 </b><a href=\"https://whatsapp.com/channel/0029Vb7TiRS9cDDcPrLTPY0z/\" rel=\"\" title=\"https://whatsapp.com/channel/0029Vb7TiRS9cDDcPrLTPY0z\"><b>https://whatsapp.com/channel/0029Vb7TiRS9cDDcPrLTPY0z</b></a>"},{"level":2,"_id":"HGQXN6BCPZGIVN45P2QYC6KI34","additional_properties":{},"type":"header","content":"<b>VIDEO RECOMENDADO</b>"},{"_id":"Z6DWSC6ZGZCIZM2UPPKHPZJIAM","type":"raw_html","content":"<iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/3u0hANhfT4E?si=6HaW92QatoGLlHki\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>"},{"_id":"53W4HXIHPZBTVJRQXBJH4ESET4","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"Kits para atender a unas 4.500 personas ante posibles emergencias"},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/edicion/ica","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Ica","_id":"/edicion/ica","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type"