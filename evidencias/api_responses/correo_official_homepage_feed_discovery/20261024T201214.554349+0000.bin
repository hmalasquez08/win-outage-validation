orreo","last_updated_date":"2025-05-19T13:50:26.079Z","byline":"Redacción Diario Correo","email":"","slug":"redaccion-diariocorreo","status":true}},"type":"author","version":"0.5.8","url":"/autor/redaccion-diariocorreo","slug":"redaccion-diariocorreo"}]},"first_publish_date":"2026-10-24T17:18:11.407Z","additional_properties":{"is_published":true,"publish_date":"2026-10-24T17:18:11.407Z","has_published_copy":true},"last_updated_date":"2026-10-24T20:04:50.526Z","publishing":{"scheduled_operations":{"unpublish_edition":[],"publish_edition":[]}},"owner":{"sponsored":false,"id":"elcomercio"},"comments":{"moderation_required":false,"allow_comments":false,"display_comments":false},"workflow":{"status_code":1},"label":{"genero":{"display":true,"text":"Informativo","url":"info"},"facebook_ia":{"display":true,"text":"Si","url":"true"},"nucleo":{"display":true,"text":"Zona País","url":"np"}},"promo_items":{"basic":{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962"},"caption":"Bebé procedente de Arequipa padecía de una alteración en el corazón. Foto: ESSALUD.","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/BMK2W3KPANEJBBZGPF6HKCPY3U.png","licensable":false,"credits":{"affiliation":[]},"subtitle":"Bebé procedente de Arequipa padecía de una alteración en el corazón. Foto: ESSALUD.","width":1350,"_id":"BMK2W3KPANEJBBZGPF6HKCPY3U","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962","proxyUrl":"/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962","originalUrl":"https://cloudfront-u