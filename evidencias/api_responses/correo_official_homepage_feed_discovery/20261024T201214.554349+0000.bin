arge":"https://diariocorreo.pe/resizer/v2/ADCXTLCRAJBIZO7CAXRWIKABOA.jpeg?auth=c29e808ae516607ae3e02aa4590dc38bc7961ddfc97966f78b8e19290302703a&width=940&height=569&quality=75&smart=true","story_small":"https://diariocorreo.pe/resizer/v2/ADCXTLCRAJBIZO7CAXRWIKABOA.jpeg?auth=c29e808ae516607ae3e02aa4590dc38bc7961ddfc97966f78b8e19290302703a&width=482&height=290&quality=75&smart=true","amp_new":"https://diariocorreo.pe/resizer/v2/ADCXTLCRAJBIZO7CAXRWIKABOA.jpeg?auth=c29e808ae516607ae3e02aa4590dc38bc7961ddfc97966f78b8e19290302703a&width=1200&height=800&quality=75&smart=true","amp":"https://diariocorreo.pe/resizer/v2/ADCXTLCRAJBIZO7CAXRWIKABOA.jpeg?auth=c29e808ae516607ae3e02aa4590dc38bc7961ddfc97966f78b8e19290302703a&width=900&height=600&quality=75&smart=true","impresa":"https://diariocorreo.pe/resizer/v2/ADCXTLCRAJBIZO7CAXRWIKABOA.jpeg?auth=c29e808ae516607ae3e02aa4590dc38bc7961ddfc97966f78b8e19290302703a&width=617&height=637&quality=75&smart=true","impresa_s":"https://diariocorreo.pe/resizer/v2/ADCXTLCRAJBIZO7CAXRWIKABOA.jpeg?auth=c29e808ae516607ae3e02aa4590dc38bc7961ddfc97966f78b8e19290302703a&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/edicion/ica/ica-pronostico-de-lluvias-lleva-a-reforzar-la-preparacion-ante-posibles-emergencias-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"diariocorreo","revision":{"editions":["default"],"parent_id":"R4YZ5FUAJNHOJFZ5Q4LZXDK3DI","published":true,"branch":"default","revision_id":"X3E5JLJCPVEWTG43ET4EKZX5N4"},"planning":{"story_length":{"character_count_actual":6224,"inch_count_actual":6,"word_count_actual":945,"line_count_actual":38}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T19:00:00Z","headlines":{"tablet":"","print":"","meta_title":"Fenómeno El Niño: Indeci Ica exhorta a la prevención y cuenta con 900 kits de ayuda humanitaria","native":"","web":"","mobile":"","basic":"Fenómeno El Niño: Indeci Ica exhorta a la prevención y cuenta con 900 kits de ayuda humanitaria"},"websites":{"diariocorreo":{"website_url":"/edicion/ica/ica-pronostico-de-lluvias-lleva-a-reforzar-la-preparacion-ante-posibles-emergencias-noticia/","website_section":{"path":"/edicion/ica","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Ica","_id":"/edicion/ica","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Ica","_id":"/edicion/ica","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":85,"default":85,"test":85,"menu-pro":85}}},"_website_section_id":"diariocorreo./edicion/ica","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T13:15:45.639Z","publish_date":"2026-10-24T19:00:00Z","_id":"MW3LEOG7IZDSTBQRMGF7PHX5ZY","website":"diariocorreo","website_url":"/edicion/ica/ica-pronostico-de-lluvias-lleva-a-reforzar-la-preparacion-ante-posibles-emergencias-noticia/"},{"content_elements":[{"_id":"KW2XMM5G7NBOLDHHPNAXQQEYNY","additional_properties":{},"type":"text","content":"<b>La victoria de FBC Melgar por 2-1 ante UTC de Cajamarca permitió al equipo rojinegro mantenerse en la lucha por sus objetivos de la temporada y reforzó la confianza del técnico Miguel Rondelli, quien aseguró que el equipo seguirá peleando mientras las matemáticas lo hagan posible.</b>"},{"_id":"JPTY6XVBG5FATFNSMXSBBDNPLU","additional_properties":{},"type":"text","content":"Tras el triunfo, Rondelli destacó en conferencia de prensa la capacidad de su equipo para sostener la ventaja, a pesar de ciertas condiciones registradas en el partido, especialmente en el segundo tiempo. No obstante, afirmó que se continuará<b> reforzando el objetivo a cuatro fechas de terminar.</b>"},{"_id":"XBJE24WB4JBE7NWB7QI6AYDDKY","additional_properties":{},"type":"text","content":"<i><b>“Mientras tengamos chance matemático, seguiremos con esa ilusión de tener un ojo en cada tabla, uno en el Acumulado porque estamos a puntos de Universitario. También un ojo en la tabla del Clausura porque no estamos lejos de la punta. Tenemos que ilusionarnos”</b></i>, expresó."},{"_id":"S4OFHSUJ7JHNPF7LFAOR7ZOHGI","additional_properties":{},"type":"text","content":"El estratega argentino pidió mantener la calma pese al buen momento del equipo y recordó que aún quedan cuatro jornadas por disputarse.<i><b> “A esta altura del campeonato, hay que ganar los partidos, sea como sea (…) Todavía no podemos festejar, ni estar contentos, ni nada. Como dije la semana pasada, por más que empiecen a decir que el campeonato termina hoy, todavía quedan cuatro partidos”</b></i>, indicó."},{"_id":"ZSBOMKMJCJAG7NG55TDQCWGSYU","additional_properties":{},"type":"text","content":"<b>FBC Melgar sumó 53 puntos en el Acumulado</b>; mientras que en <b>Clausura </b>también escala provisionalmente al segundo lugar, igualando en puntaje a Sporting Cristal, líder de la competencia."},{"level":2,"_id":"NGFYT7ETDNHFRKUCUIELQBXU3M","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><b>VIDEO RECOMENDADO:</b></mark>"},{"_id":"H6E3SIHFJZEQJLAFG3T4VKV24E","type":"raw_html","content":"<iframe src=\"https://www.facebook.com/plugins/video.php?height=314&href=https%3A%2F%2Fwww.facebook.com%2Freel%2F2122253385055908%2F&show_text=false&width=560&t=0\" width=\"560\" height=\"314\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\" allowFullScreen=\"true\"></iframe>"},{"_id":"ZI5E6YJI6ZG7NPGFKE57V6YFRI","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"El técnico de FBC Melgar, Miguel Rondelli, destacó que el equipo se mantiene en la pelea por el Torneo Clausura y la tabla Acumulada a falta de cuatro fechas para el final de la temporada."},"description":{"basic":"La victoria de FBC Melgar por 2-1 ante UTC de Cajamarca permitió al equipo rojinegro mantenerse en la lucha por sus objetivos de la temporada y reforzó la confianza del técnico Miguel Rondelli, quien aseguró que el equipo seguirá peleando mientras las matemáticas lo hagan posible."},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/deportes","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Deportes","_id":"/deportes","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","search-filter-default":null,"menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Deportes","_id":"/deportes","ancestors":{"navbar-default":[],"sitemap-default":["/"],"search-filter-default":[],"menu-default":[],"footer-secciones-default":["/"],"footer-default":[]},"order":{"header-pro":54,"default":54,"sitemap-default":1007,"test":54,"footer-secciones-default":1004,"menu-pro":54}}},"_website_section_id":"diariocorreo./deportes","type":"section","version":"0.6.0"},{"path":"/edicion/arequipa","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Arequipa","_id":"/edicion/arequipa","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Arequipa","_id":"/edicion/arequipa","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":76,"default":76,"test":76,"menu-pro":76}}},"_website_section_id":"diariocorreo./edicion/arequipa","type":"section","version":"0.6.0"}],"primary_section":{"path":"/deportes","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Deportes","_id