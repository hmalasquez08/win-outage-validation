r/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=600&height=600&quality=75&smart=true","square_md":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=300&height=300&quality=75&smart=true","square_s":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=150&height=150&quality=75&smart=true","square_xs":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=75&height=75&quality=75&smart=true","small":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=100&height=200&quality=75&smart=true","medium":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=480&quality=75&smart=true","content":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=980&quality=75&smart=true","content_small":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=320&quality=75&smart=true","large":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=940&height=569&quality=75&smart=true","story_small":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=482&height=290&quality=75&smart=true","amp_new":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=1200&height=800&quality=75&smart=true","amp":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=900&height=600&quality=75&smart=true","impresa":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=617&height=637&quality=75&smart=true","impresa_s":"https://diariocorreo.pe/resizer/v2/DSTS6QF6PFEIJN5GAA3MG5RKBU.jpg?auth=1b479421b05db818f0e5dcd67e5ce6f9b2aa28c51f13ec57b9c715c9f23c118e&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/edicion/la-libertad/refuerzan-vigilancia-en-80-sectores-del-distrito-de-la-esperanza-trujillo-la-libertad-peru-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"diariocorreo","revision":{"editions":["default"],"parent_id":"7URHML7FVJAJVF2KDQCA7MJSI4","published":true,"branch":"default","revision_id":"EETDNKK6LNHDTNDRQYTLTT4OLU"},"planning":{"story_length":{"character_count_actual":1234,"inch_count_actual":2,"word_count_actual":187,"line_count_actual":13}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T20:01:36.364Z","headlines":{"tablet":"","print":"","meta_title":"Refuerzan vigilancia en 80 sectores del distrito de La Esperanza Trujillo La Libertad Perú ","native":"","web":"","mobile":"","basic":"Trujillo: Refuerzan vigilancia en 80 sectores del distrito de La Esperanza"},"websites":{"diariocorreo":{"website_url":"/edicion/la-libertad/refuerzan-vigilancia-en-80-sectores-del-distrito-de-la-esperanza-trujillo-la-libertad-peru-noticia/","website_section":{"path":"/edicion/la-libertad","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"La Libertad","_id":"/edicion/la-libertad","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"La Libertad","_id":"/edicion/la-libertad","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":84,"default":84,"test":84,"menu-pro":84}}},"_website_section_id":"diariocorreo./edicion/la-libertad","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T19:54:23.982Z","publish_date":"2026-10-24T20:02:25.183Z","_id":"7NGH43DIFVABJOG6TDAQN336VM","website":"diariocorreo","website_url":"/edicion/la-libertad/refuerzan-vigilancia-en-80-sectores-del-distrito-de-la-esperanza-trujillo-la-libertad-peru-noticia/"},{"content_elements":[{"_id":"Y7MJF36VK5GSLI435MN4B3VHVQ","additional_properties":{},"type":"text","content":"<b>El 8 de octubre pasado, Roxana Félix Carbajal de 59 años, empresaria dedicada a la promoción de eventos, fue </b><a href=\"https://diariocorreo.pe/edicion/ica/chincha-dan-ultimo-adios-a-roxana-felix-victima-de-ataque-criminal-noticia/\" target=\"_self\" rel=\"\" title=\"https://diariocorreo.pe/edicion/ica/chincha-dan-ultimo-adios-a-roxana-felix-victima-de-ataque-criminal-noticia/\"><b>asesinada a balazos </b></a><b>durante la instalación del campo ferial de Chincha. Las investigaciones de la policía permitieron la detención, en Villa El Salvador (Lima), de tres presuntos involucrados, entre ellos el ‘gatillero’, quien relató el monto de </b><a href=\"https://diariocorreo.pe/edicion/ica/chincha-extorsionadores-exigian-s100-mil-soles-a-empresaria-y-la-mataron-a-balazos-noticia/\" target=\"_self\" rel=\"\" title=\"https://diariocorreo.pe/edicion/ica/chincha-extorsionadores-exigian-s100-mil-soles-a-empresaria-y-la-mataron-a-balazos-noticia/\"><b>dinero recibido </b></a><b>y todos los pasos previos al homicidio por encargo.</b>"},{"level":2,"_id":"R5UN2I6BW5FWNGPC6BNN5S7AHE","additional_properties":{},"type":"header","content":"<b>Sujetos detenidos</b>"},{"_id":"QB4GHOBRFRAJXFZLX2YO6XGUCI","additional_properties":{},"type":"text","content":"Mediante acciones de inteligencia de la policía el 21 de octubre, en el distrito capitalino, fueron atrapados Edson Joaquín Ramírez (20) (a) “JJ” y Olivia Aponte (44) (a) la “China”, ambos con mandato de detención preliminar por presunta participación y vinculación, respectivamente, en el asesinato de Roxana Félix. Ese mismo día fue apresado Sebastián Esteban Peña Vilca (22) (a) “Diablo”, en posesión de una pistola con serie erradicada."},{"_id":"7HV6QND7IRHKZHAGFB4IVFYDFA","additional_properties":{},"type":"text","content":"La captura de este último ha cobrado relevancia en el caso de la empresaria chinchana. Alias “Diablo” narró a la policía que el 8 de octubre llegó a Chincha procedente de Lima, a bordo de un auto en compañía de Boris (propietario del vehículo) y Joaquín. En esta unidad escondieron el arma destinada para el crimen. Mientras que en una motocicleta arribaron otros dos sujetos conocidos como “Paolo” y “Zeta”."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"ac4c3b909a0f13fce72c591c4eec4add996f11dc973f4068e220a5eef094607c"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/BBHGOWM5ORAOXPAVEHEFAOTOYQ.jpeg","licensable":false,"credits":{"affiliation":[]},"subtitle":"ica","width":1600,"_id":"BBHGOWM5ORAOXPAVEHEFAOTOYQ","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/BBHGOWM5ORAOXPAVEHEFAOTOYQ.jpeg?auth=ac4c3b909a0f13fce72c591c4eec4add996f11dc973f4068e220a5eef094607c","proxyUrl":"/resizer/v2/BBHGOWM5ORAOXPAVEHEFAOTOYQ.jpeg?auth=ac4c3b909a0f13fce72c591c4eec4add996f11dc973f4068e220a5eef094607c","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/BBHGOWM5ORAOXPAVEHEFAOTOYQ.jpeg","published":true,"resizeUrl":"/resizer/v2/BBHGOWM5ORAOXPAVEHEFAOTOYQ.jpeg?auth=ac4c3b909a0f13fce72c591c4eec4add996f11dc973f4068e220a5eef094607c","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/BBHGOWM5ORAOXPAVEHEFAOTOYQ.jpeg?auth=ac4c3b909a0f13fce72c591c4eec4add996f11dc973f4068e220a5eef094607c&width=300","version":0,"originalName":"WhatsApp Image 2026-10-23 at 5.48.44 PM (2).jpeg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T14:42:14Z","last_updated_date":"2026-10-24T14:42:14Z","height":900,"image_type":"photograph","status":""},{"_id":"AVJGUET6IVBWNGTEFS3XKCTPQQ","additional_properties":{},"type":"text","content":"La banda realizó seguimiento a la víctima, a quien detectaron vulnerable en el lugar donde se instalaban los juegos mecánicos. La información fue alcanzada al “gatillero”. Este paso por el lugar en motocicleta junto a su compinche, vio a la víctima y recibe la orden “dispárale, dispárale”. Una cámara registró al verdugo bajar del vehículo menor para cometer el crimen. ¿Cuántos impactos le diste? pregunta la policía y el detenido señala “cinco o cuatro. No sé”."},{"_id":"T5EFKVO36REPLAVMSPVLEHVSTI","additional_properties":{},"type":"text","content":"Otra interrogante de los investigadores para “diablo” ¿cuánto te han pagado por este sicariato? Y su respuesta fue: “dos mil soles”. La orden habría sido dada por Daniel o también conocido como “Jota”. El intervenido en Villa El Salvador, junto a Edson Ramírez y Olivia Aponte están siendo puestos a disposición del Departamento de Investigación Criminal de Chincha para continuar con las diligencias con participación del Ministerio Público."},{"_id":"WN6RQDVNINAKDN3R5BOOFI5QRQ","additional_properties":{},"type":"text","content":"<b>EL DATO:</b> Roxana Félix y su familia venían siendo víctimas de atentados y extorsión. Su hijo salvo de la muerte tras ser atacado a balazos en Cañete. En otro hecho, un sicario ingresó a su vivienda y disparo, dejando herida a una menor."},{"_id":"DGVLZYLD25BC3PEGWLAN6R2AWM","additional_properties":{},"type":"text","content":"<b>LA CIFRA:</b> 100 mil soles exigían los extorsionadores para dejar tranquila a la familia chinchana."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"6077a1abc00b910f5bf5880b05b282f7a499954a09bec92a068cff211e50e508"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/ZUYFIMHNIRFL3DEUHMIJ2H5NY4.jpeg","licensable":false,"credits":{"affiliation":[]},"subtitle":"ica","width":1600,"_id":"ZUYFIMHNIRFL3DEUHMIJ2H5NY4","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/ZUYFIMHNIRFL3DEUHMIJ2H5NY4.jpeg?auth=6077a1abc00b910f5bf5880b05b282f7a499954a09bec92a068cff211e50e508","proxyUrl":"/resizer/v2/ZUYFIMHNIRFL3DEUHMIJ2H5NY4.jpeg?auth=6077a1abc00b910f5bf5880b05b282f7a499954a09bec92a068cff211e50e508","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/ZUYFIMHNIRFL3DEUHMIJ2H5NY4.jpeg","published":true,"resizeUrl":"/resizer/v2/ZUYFIMHNIRFL3DEUHMIJ2H5NY4.jpeg?auth=6077a1abc00b910f5bf5880b05b282f7a499954a09bec92a068cff211e50e508","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/ZUYFIMHNIRFL3DEUHMIJ2H5NY4.jpeg?auth=6077a1abc00b910f5bf5880b05b282f7a499954a09bec92a068cff211e50e508&width=300","version":0,"originalName":"WhatsApp Image 2026-10-23 at 5.48.44 PM.jpeg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T14:42:14Z","last_updated_date":"2026-10-24T14:42:14Z","height":1165,"image_type":"photograph","status":""},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"e5a22fee30c71da6bd3c2600526fb298703666b8f499638dfcd7823b6bae06bb"},"caption":"","source":{"syste