}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T17:10:39-0500\", \"dateModified\": \"2026-10-25T17:10:39-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397670\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397670\", \"articleBody\": \"\\t<p> <b>Resultados de las elecciones en Brasil al 1,51% de votos</b></p>\\n\\n<p>Lula da Silva 52,27%\\u00a0</p>\\n\\n<p>Fl\\u00e1vio Bolsonaro 47,73%</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T17:04:47-0500\", \"dateModified\": \"2026-10-25T17:04:47-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397666\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397666\", \"articleBody\": \"\\t<p>Los \\u00faltimos colegios electorales de Brasil cerraron sus puertas a las 19.00 hora local (22.00 GMT) de este domingo para reanudar inicio al recuento de votos en la segunda vuelta electoral, poniendo fin al plazo extraordinario de dos horas fijado por la Corte Suprema.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T15:39:33-0500\", \"dateModified\": \"2026-10-25T15:39:33-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397529\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397529\", \"articleBody\": \"\\t<p> <b>Lula da Silva tiene el 57,6 % de los votos, frente al 42,3 % de Fl\\u00e1vio Bolsonaro</b>, con el 0,25 % del recuento, que fue pausado poco despu\\u00e9s por la Corte Suprema.\\u00a0</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T15:27:11-0500\", \"dateModified\": \"2026-10-25T15:27:11-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397510\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397510\", \"articleBody\": \"\\t<p>Un juez de la corte suprema  <a href='https://elcomercio.pe/mundo/latinoamerica/brasil-juez-extiende-dos-horas-la-votacion-tras-denuncias-de-lula-por-obstaculos-al-transporte-noticia/'>prorrog\\u00f3 por dos horas el cierre de los colegios electorales</a> en el balotaje, despu\\u00e9s de que el presidente Lula denunciara obst\\u00e1culos en el transporte p\\u00fablico para ir a votar en varias ciudades de Brasil.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T14:59:27-0500\", \"dateModified\": \"2026-10-25T14:59:27-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397411\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397411\", \"articleBody\": \"\\t<p>La campa\\u00f1a de Lula da Silva solicit\\u00f3 a la Justicia extender el horario de votaci\\u00f3n de la segunda vuelta de las presidenciales por dos horas en todo el pa\\u00eds, ante \\\"las incidencias\\\" registradas \\\"en el transporte de votantes\\\" en diversos estados.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T14:35:58-0500\", \"dateModified\": \"2026-10-25T14:35:58-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397375\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397375\", \"articleBody\": \"\\t<p>Lula pidi\\u00f3 a la justicia \\\"garantizar\\\" que todos los electores puedan votar despu\\u00e9s de que en ciudades como Sao Paulo o Salvador de Bah\\u00eda se retiren de la circulaci\\u00f3n de autobuses de l\\u00ednea, denunci\\u00f3. \\\"Nadie puede dejar de votar porque alg\\u00fan empresario sinverg\\u00fcenza o alg\\u00fan alcalde de mala cala\\u00f1a, bandido, intent\\u00f3 impedir que el pueblo votara\\\", dijo el mandatario izquierdista a periodistas frente a su casa en Sao Paulo.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T14:33:50-0500\", \"dateModified\": \"2026-10-25T14:33:50-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397374\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397374\", \"articleBody\": \"\\t<p>Lula da Silva denunci\\u00f3 el domingo  <a href='https://elcomercio.pe/mundo/latinoamerica/lula-da-silva-denuncia-obstaculos-para-ir-a-votar-en-transporte-publico-en-varias-ciudades-de-brasil-flavio-bolsonaro-apuesplan-ultimas-noticia/'>obst\\u00e1culos para que las personas se desplacen hasta sus centros de votaci\\u00f3n en transporte p\\u00fablico</a> en varias ciudades de Brasil.\\u00a0</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GUYDCOJNGEYC2MRVKQZTGORVGA.jpg?auth=31a368774e16f9c21497816061e05844bcef87d0568ca6aa9ad17a640dce4d90?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GUYDCOJNGEYC2MRVKQZTGORVGA.jpg?auth=31a368774e16f9c21497816061e05844bcef87d0568ca6aa9ad17a640dce4d90?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GUYDCOJNGEYC2MRVKQZTGORVGA.jpg?auth=31a368774e16f9c21497816061e05844bcef87d0568ca6aa9ad17a640dce4d90?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T14:19:43-0500\", \"dateModified\": \"2026-10-25T14:19:43-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397368\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397368\", \"articleBody\": \"\\t<p>El presidente del Tribunal Regional Electoral del estado de Bah\\u00eda, Mauricio Kertzman Szporer, dispuso la detenci\\u00f3n de Souza luego de que las autoridades municipales incumplieran una primera orden que exig\\u00eda restablecer toda la flota de autobuses, con una frecuencia equivalente a la de los d\\u00edas laborales y de forma gratuita.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T14:19:03-0500\", \"dateModified\": \"2026-10-25T14:19:03-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397367\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397367\", \"articleBody\": \"\\t<p>La Justicia electoral de Brasil orden\\u00f3 detener al secretario de Movilidad de la ciudad de Salvador, Pablo Souza, por la retenci\\u00f3n de autobuses durante la segunda vuelta de las elecciones presidenciales, una situaci\\u00f3n que se ha repetido en otras ciudades gobernadas por la derecha, seg\\u00fan denunci\\u00f3 la campa\\u00f1a del presidente Lula da Silva.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GAZTCOJNGEYC2MRVKQYTSORQGM.jpg?auth=c575340ffabbdcd68d0e81df42cd3bffa4edd3ad427a12359e2057e626ca2ae3?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GAZTCOJNGEYC2MRVKQYTSORQGM.jpg?auth=c575340ffabbdcd68d0e81df42cd3bffa4edd3ad427a12359e2057e626ca2ae3?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GAZTCOJNGEYC2MRVKQYTSORQGM.jpg?auth=c575340ffabbdcd68d0e81df42cd3bffa4edd3ad427a12359e2057e626ca2ae3?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T12:35:10-0500\", \"dateModified\": \"2026-10-25T12:35:10-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397253\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397253\", \"articleBody\": \"\\t<p>En los estados de S\\u00e3o Paulo, Minas Gerais, R\\u00edo de Janeiro y Paran\\u00e1, cuatro de los cinco principales colegios electorales, las lluvias se registraron desde las primeras horas del d\\u00eda. Aunque en R\\u00edo el agua ya mengu\\u00f3, la lluvia puede aparecer de nuevo en la tarde y en el estado de Minas tambi\\u00e9n se prev\\u00e9 inestabilidad durante este per\\u00edodo. En Paran\\u00e1 los aguaceros bloquearon tres carreteras y las autoridades buscan alternativas para los votantes.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GEYDCNZNGEYC2MRVKQZTKORRGA.jpg?auth=a3312586c269f7e772ba8d0895874126d0dd88b53de91dd571172d3c48496fb2?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GEYDCNZNGEYC2MRVKQZTKORRGA.jpg?auth=a3312586c269f7e772ba8d0895874126d0dd88b53de91dd571172d3c48496fb2?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GEYDCNZNGEYC2MRVKQZTKORRGA.jpg?auth=a3312586c269f7e772ba8d0895874126d0dd88b53de91dd571172d3c48496fb2?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T12:31:08-0500\", \"dateModified\": \"2026-10-25T12:31:08-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397252\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397252\", \"articleBody\": \"\\t<p>De acuerdo con el \\u00faltimo reporte de la Polic\\u00eda Federal, al menos 22 personas han sido detenidas este domingo por delitos electorales durante la segunda vuelta en Brasil, principalmente por casos relacionados con propaganda irregular, violaci\\u00f3n del secreto del voto y desobediencia electoral.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T12:30:37-0500\", \"dateModified\": \"2026-10-25T12:30:37-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397251\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397251\", \"articleBody\": \"\\t<p>El presidente del Tribunal Superior Electoral e Brasil, magistrado Kassio Nunes Marques, afirm\\u00f3 que <b> la segunda vuelta presidencial transcurre \\\"dentro de lo esperado\\\".</b></p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GM3TCNZNGEYC2MRVKQZTAORTG4.jpg?auth=61d1144ad3f68bc9f0f3ed3846609d4eb5813d09e3f23c5fb1b193945029bee9?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GM3TCNZNGEYC2MRVKQZTAORTG4.jpg?auth=61d1144ad3f68bc9f0f3ed3846609d4eb5813d09e3f23c5fb1b193945029bee9?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GM3TCNZNGEYC2MRVKQZTAORTG4.jpg?auth=61d1144ad3f68bc9f0f3ed3846609d4eb5813d09e3f23c5fb1b193945029bee9?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T11:26:12-0500\", \"dateModified\": \"2026-10-25T11:26:12-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397205\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397205\", \"articleBody\": \"\\t<p>Los brasile\\u00f1os acuden a las urnas este domingo entre  <a href='https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-2026-los-brasilenos-votan-entre-el-miedo-a-los-flavio-bolsonaro-y-el-descontento-con-lula-da-silva-apuesplan-ultimas-noticia/'>el temor de los votantes del presidente Luiz In\\u00e1cio Lula da Silva a un regreso de la familia Bolsonaro al poder y el descontento de quienes reclaman un cambio</a> preocupados por las dificultades econ\\u00f3micas y la inseguridad. \\u201cLa democracia, nuestra soberan\\u00eda, el respeto al pueblo, a los pobres, a las mujeres. La dignidad, en definitiva. Est\\u00e1 todo en juego\\u201d, resume Lourdes, jubilada de 63 a\\u00f1os, que lleva d\\u00e9cadas votando al Partido de los Trabajadores (PT) desde su colegio electoral en S\\u00e3o Bernardo do Campo, ciudad vecina a S\\u00e3o Paulo.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T09:16:01-0500\", \"dateModified\": \"2026-10-25T09:16:01-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397133\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397133\", \"articleBody\": \"\\t<p>La campa\\u00f1a en Brasil estuvo marcada por una intensa <b> batalla en las redes sociales que involucr\\u00f3 a Meta</b>, due\\u00f1a de WhatsApp, Facebook e Instagram. El equipo de Lula acus\\u00f3 a la empresa estadounidense de favorecer a Fl\\u00e1vio Bolsonaro mediante una \\\"manipulaci\\u00f3n algor\\u00edtmica\\\". Meta lo neg\\u00f3, pero reconoci\\u00f3 errores como la desactivaci\\u00f3n de anuncios de la campa\\u00f1a de Lula por motivos t\\u00e9cnicos.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GAYTCNBNGEYC2MRVKQYTMORQGE.jpg?auth=39ec363276aa6512f29537adb0b7310d09d2e22976941348f7b9bc9c4c6e7c9c?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GAYTCNBNGEYC2MRVKQYTMORQGE.jpg?auth=39ec363276aa6512f29537adb0b7310d09d2e22976941348f7b9bc9c4c6e7c9c?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GAYTCNBNGEYC2MRVKQYTMORQGE.jpg?auth=39ec363276aa6512f29537adb0b7310d09d2e22976941348f7b9bc9c4c6e7c9c?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T09:11:52-0500\", \"dateModified\": \"2026-10-25T09:11:52-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397132\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397132\", \"articleBody\": \"\\t<p>Fl\\u00e1vio Bolsonaro se ha presentado como m\\u00e1s moderado que su padre Jair, que cumple una condena de 27 a\\u00f1os bajo arresto domiciliario por un intento de golpe de Estado tras perder las elecciones de 2022.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T09:11:07-0500\", \"dateModified\": \"2026-10-25T09:11:07-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397131\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397131\", \"articleBody\": \"\\t<p>Fl\\u00e1vio Bolsonaro, de 45 a\\u00f1os, promete soportar la lucha contra la delincuencia, recortar el gasto p\\u00fablico y aliviar el costo de vida.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GA3TCNBNGEYC2MRVKQYTCORQG4.jpg?auth=8bfb9e95a8776038bd3faff4150cfc9c1674b70d9c7894ab086896d40e8b6402?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GA3TCNBNGEYC2MRVKQYTCORQG4.jpg?auth=8bfb9e95a8776038bd3faff4150cfc9c1674b70d9c7894ab086896d40e8b6402?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GA3TCNBNGEYC2MRVKQYTCORQG4.jpg?auth=8bfb9e95a8776038bd3faff4150cfc9c1674b70d9c7894ab086896d40e8b6402?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T09:09:26-0500\", \"dateModified\": \"2026-10-25T09:09:26-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397130\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397130\", \"articleBody\": \"\\t<p> <b>Lula aspira a un cuarto mandato no consecutivo </b>y se ha presentado como un baluarte contra una injerencia de Estados Unidos y un protector de la democracia.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GI3DCNBNGEYC2MRVKQYDSORSGY.jpg?auth=24932d8bd947135902e3cad4b84161b3e19fa2c8a982d089195ec1c27b3e3d60?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GI3DCNBNGEYC2MRVKQYDSORSGY.jpg?auth=24932d8bd947135902e3cad4b84161b3e19fa2c8a982d089195ec1c27b3e3d60?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GI3DCNBNGEYC2MRVKQYDSORSGY.jpg?auth=24932d8bd947135902e3cad4b84161b3e19fa2c8a982d089195ec1c27b3e3d60?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T09:07:53-0500\", \"dateModified\": \"2026-10-25T09:07:53-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397129\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397129\", \"articleBody\": \"\\t<p>La segunda vuelta determinar\\u00e1 si Brasil se mantiene como gran reducto de la izquierda en Am\\u00e9rica Latina o si se suma al giro regional hacia la derecha impulsado por el presidente estadounidense Donald Trump.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T08:48:26-0500\", \"dateModified\": \"2026-10-25T08:48:26-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397126\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397126\", \"articleBody\": \"\\t<p> <b>Lula</b>, que opta a un cuarto mandato no consecutivo, destac\\u00f3 que en la campa\\u00f1a electoral para la segunda vuelta se produjeron las \\u201cmayores manifestaciones pol\\u00edticas\\u201d de los \\u00faltimos 50 a\\u00f1os en Brasil.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T08:43:51-0500\", \"dateModified\": \"2026-10-25T08:43:51-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397125\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397125\", \"articleBody\": \"\\t<p>La derecha \\u201cquiere gobernar con la bandera estadounidense\\u201d, declar\\u00f3 Lula tras votar este domingo en el estado de Sao Paulo. Pero los brasile\\u00f1os elegir\\u00e1n un pa\\u00eds donde los colores nacionales \\u201csean respetados\\u201d, asegur\\u00f3 el mandatario.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GUYTCMZNGEYC2MRVKQ2DGORVGE.jpg?auth=159f75142b980fa7aed1a120f45af711fd1056f0deb72b5e4740d64c9c6ff30c?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GUYTCMZNGEYC2MRVKQ2DGORVGE.jpg?auth=159f75142b980fa7aed1a120f45af711fd1056f0deb72b5e4740d64c9c6ff30c?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GUYTCMZNGEYC2MRVKQ2DGORVGE.jpg?auth=159f75142b980fa7aed1a120f45af711fd1056f0deb72b5e4740d64c9c6ff30c?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T08:42:44-0500\", \"dateModified\": \"2026-10-25T08:42:44-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397124\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397124\", \"articleBody\": \"\\t<p> <a href='https://elcomercio.pe/mundo/latinoamerica/lula-vota-y-dice-que-brasil-debe-decidir-entre-quien-defiende-la-bandera-nacional-y-la-de-estados-unidos-flavio-bolsonaro-noticia/'>Luiz In\\u00e1cio Lula da Silva</a> dijo que los brasile\\u00f1os deben elegir este domingo en el balotaje entre su gobierno que defiende la bandera nacional y el senador Fl\\u00e1vio Bolsonaro, que quiere dirigir el pa\\u00eds con la de Estados Unidos.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GQ2DCMZNGEYC2MRVKQ2DEORUGQ.jpg?auth=0cffee0d8e287037ed06107d8d716d7745877ccb08fa876098266e6c0eb4a067?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GQ2DCMZNGEYC2MRVKQ2DEORUGQ.jpg?auth=0cffee0d8e287037ed06107d8d716d7745877ccb08fa876098266e6c0eb4a067?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GQ2DCMZNGEYC2MRVKQ2DEORUGQ.jpg?auth=0cffee0d8e287037ed06107d8d716d7745877ccb08fa876098266e6c0eb4a067?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T06:52:04-0500\", \"dateModified\": \"2026-10-25T06:52:04-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397120\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397120\", \"articleBody\": \"\\t<p>\\\"Brasil no aguanta cuatro a\\u00f1os m\\u00e1s de la manera en que est\\u00e1, la vida de todo el mundo empeor\\u00f3\\\", dijo el Bolsonaro fuera de su centro electoral en R\\u00edo de Janeiro, cubri\\u00e9ndose de la lluvia con un paraguas</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GA2DCMJNGEYC2MRVKQ2TEORQGQ.jpg?auth=cca59369139bea18ed0c88622b6840c2c64c538792a3c9d0d3b718cf5d25b296?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GA2DCMJNGEYC2MRVKQ2TEORQGQ.jpg?auth=cca59369139bea18ed0c88622b6840c2c64c538792a3c9d0d3b718cf5d25b296?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GA2DCMJNGEYC2MRVKQ2TEORQGQ.jpg?auth=cca59369139bea18ed0c88622b6840c2c64c538792a3c9d0d3b718cf5d25b296?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T06:50:44-0500\", \"dateModified\": \"2026-10-25T06:50:44-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397119\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397119\", \"articleBody\": \"\\t<p>Fl\\u00e1vio Bolsonaro dijo este domingo que  <a href='https://elcomercio.pe/mundo/latinoamerica/flavio-bolsonaro-vota-en-la-segunda-vuelta-de-las-elecciones-presidenciales-de-brasil-noticia/'>lleg\\u00f3 la hora \\\"del cambio de verdad\\\" en Brasil</a> tras votar en el balotaje que lo enfrenta al mandatario izquierdista Luiz In\\u00e1cio Lula da Silva.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GQ2DCMJNGEYC2MRVKQ2TAORUGQ.jpg?auth=09cbf3244dae9cfd34411ec41dfc7f4ea2287bd7ea9517b9b312bec7158fb06f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GQ2DCMJNGEYC2MRVKQ2TAORUGQ.jpg?auth=09cbf3244dae9cfd34411ec41dfc7f4ea2287bd7ea9517b9b312bec7158fb06f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GQ2DCMJNGEYC2MRVKQ2TAORUGQ.jpg?auth=09cbf3244dae9cfd34411ec41dfc7f4ea2287bd7ea9517b9b312bec7158fb06f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T06:12:34-0500\", \"dateModified\": \"2026-10-25T06:12:34-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397118\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397118\", \"articleBody\": \"\\t<p>Unos 158,7 millones de votantes fueron convocados a las urnas en esta jornada en la que tambi\\u00e9n se elegir\\u00e1 a seis mandatarios regionales.\\u00a0</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T06:12:06-0500\", \"dateModified\": \"2026-10-25T06:12:06-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397117\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397117\", \"articleBody\": \"\\t<p>Los colegios electorales de Brasil abrieron este domingo puntualmente a las 08.00 hora local (11.00 GMT) para la segunda vuelta de las presidenciales, en la que el actual mandatario, Luiz In\\u00e1cio Lula da Silva, y su rival Fl\\u00e1vio Bolsonaro se disputan el principal cargo del pa\\u00eds</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GA3TCMJNGEYC2MRVKQYTEORQG4.jpg?auth=2a88fad2c240173ee8e974343eb115119fe8458a25038aba55d4ab56e1bd2bec?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GA3TCMJNGEYC2MRVKQYTEORQG4.jpg?auth=2a88fad2c240173ee8e974343eb115119fe8458a25038aba55d4ab56e1bd2bec?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"https://elcomercio.pe/resizer/v2/GA3TCMJNGEYC2MRVKQYTEORQG4.jpg?auth=2a88fad2c240173ee8e974343eb115119fe8458a25038aba55d4ab56e1bd2bec?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-24T22:37:41-0500\", \"dateModified\": \"2026-10-24T22:37:41-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397070\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397070\", \"articleBody\": \"\\t<p>En comparaci\\u00f3n con el sondeo de Datafolha divulgado el jueves pasado, que mostr\\u00f3 a los dos aspirantes empatados con el 50 %, ahora Quaest y Datafolha muestran que Fl\\u00e1vio Bolsonaro ha recuperado cierta ventaja num\\u00e9rica en las \\u00faltimas 48 horas.</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-24T22:35:47-0500\", \"dateModified\": \"2026-10-24T22:35:47-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397066\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397066\", \"articleBody\": \"\\t<p>Fl\\u00e1vio Bolsonaro ganar\\u00eda la segunda vuelta de las elecciones con un 51 % de los votos v\\u00e1lidos frente al 49 % del presidente brasile\\u00f1o, Luiz In\\u00e1cio Lula da Silva, seg\\u00fan los dos \\u00faltimos sondeos antes de la cita en las urnas del domingo</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-24T17:31:24-0500\", \"dateModified\": \"2026-10-24T17:31:24-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-396914\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-396914\", \"articleBody\": \"\\t<ul class='story-contents__paragraph-list'>\\n<li>El dirigente progresista y el hijo mayor del expresidente\\u00a0Jair Bolsonaro (2019-2022) se vieron a cara a cara en los estudios de Globo de R\\u00edo de Janeiro, la cadena con m\\u00e1s audiencia del pa\\u00eds, tras el tenso debate del domingo pasado en la emisora Band.\\n</li></ul>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-24T17:29:43-0500\", \"dateModified\": \"2026-10-24T17:29:43-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-396913\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-396913\", \"articleBody\": \"\\t<ul class='story-contents__paragraph-list'>\\n<li>Ambos candidatos se enfrentaron este viernes en un \\u00faltimo debate antes de la segunda vuelta de las elecciones en el que se atacaron por la econom\\u00eda, la seguridad y la corrupci\\u00f3n.\\n</li></ul>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-24T17:29:11-0500\", \"dateModified\": \"2026-10-24T17:29:11-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-396912\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-396912\", \"articleBody\": \"\\t<ul class='story-contents__paragraph-list'>\\n<li>Este domingo 25 de octubre se llevar\\u00e1 a cabo la segunda vuelta por las elecciones presidenciales en Brasil, que tiene como contendientes al \\n<b>presidente Luiz In\\u00e1cio Lula da Silva, y el senador opositor Fl\\u00e1vio Bolsonaro</b>\\n.\\n</li></ul>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}]}], \"@context\": \"https://schema.org\"}<\/script>:"},{"_id":"R6BFFFMXXVEBJCUEYTAIMVCXTQ","type":"text","content":""},{"subtype":"stamp_trust","_id":"E2IZGBEEHVCBXKOR2T2Z4VFKYM","embed":{"id":"1792795656879-157818","config":{"url_img":"","url":""},"url":"/pf/api/v3/content/fetch/photo-by-id"},"type":"custom_embed"},{"subtype":"about_author","_id":"RBJFNXGVPNHYTJDJDGAENW6ESA","embed":{"id":"1792795665193","config":{"authorTwitter":"elcomercio_peru","authorSlug":"redaccion-ec","authorName":"Redacción EC","authorImage":"https://author-service-images-prod-us-east-1.publishing.aws.arc.pub/elcomercio/5f71beb8-bb6d-4743-9ed2-fc9ea6159daa.jpg","authorLinkedIn":"","authorBio":"La notas firmadas como “Redacción EC” son producidas por miembros de nuestra redacción bajo la supervisión del editor de la sección en las que son publicadas. Puede conocer a nuestro equipo editorial en https://elcomercio.pe/buenas-practicas/. Si usted tiene algún comentario sobre nuestro proceso editorial, escriba al correo indicado abajo "},"url":"/pf/api/v3/content/fetch/photo-by-id"},"type":"custom_embed"},{"_id":"ONYJNT7JJFBG3PTKVP55RA5MFM","type":"text","content":""}],"subheadlines":{"basic":"Las últimas encuestas de Datafolha y Quaest otorgan a Flávio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate técnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia"},"description":{"basic":"Las últimas encuestas de Datafolha y Quaest otorgan a Flávio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate técnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia"},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"primary