37&quality=75&smart=true","impresa_s":"https://elcomercio.pe/resizer/v2/YFPJK652G5HC3NXCP7WUPCWZFE.png?auth=3add48a7407eca4983eaa8b28413a6f465bb608d25a026be94c768e801efc577&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/respuestas/venezuela/temblor-en-veneuzela-hoy-ultimos-sismos-reportados-en-octubre-en-vivo-cual-fue-el-epicentro-magnitud-y-hora-segun-la-funvisis-proteccion-civil-caracas-la-guaira-lbposting-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"elcomercio","revision":{"editions":["default"],"parent_id":"QZBHLFJ6GFDMJGMGLP3M372TJA","published":true,"branch":"default","revision_id":"JYEXKYWAAJAP5FH3APUNCP66UE"},"planning":{"scheduling":{"will_have_image":true},"story_length":{"character_count_actual":60,"inch_count_actual":1,"word_count_actual":8,"line_count_actual":1}},"content_restrictions":{"content_code":"free"},"display_date":"2026-10-25T22:26:06Z","headlines":{"tablet":"","print":"","meta_title":"Temblor en Venezuela HOY domingo 25 de octubre EN VIVO cuál fue la magnitud y epicentro del último sismo según FUNVISIS | Protección Civil | Caracas | La Guaira | lbposting","native":"","web":"","mobile":"","basic":"Temblor en Venezuela hoy, domingo 25 de octubre: epicentro y magnitud según reporte FUNVISIS"},"websites":{"elcomercio":{"website_url":"/respuestas/venezuela/temblor-en-veneuzela-hoy-ultimos-sismos-reportados-en-octubre-en-vivo-cual-fue-el-epicentro-magnitud-y-hora-segun-la-funvisis-proteccion-civil-caracas-la-guaira-lbposting-noticia/","website_section":{"path":"/respuestas/venezuela","parent":{"default":"/respuestas"},"_website":"elcomercio","parent_id":"/respuestas","name":"Venezuela","description":null,"_id":"/respuestas/venezuela","additional_properties":{"original":{"parent":{"header-pro":null,"default":"/respuestas","menu-pro":"/respuestas"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":null},"_admin":{"alias_ids":["/respuestas/venezuela"]},"inactive":false,"node_type":"section","_website":"elcomercio","name":"Venezuela","_id":"/respuestas/venezuela","ancestors":{"header-pro":[],"default":["/respuestas"],"menu-pro":["/respuestas"]},"order":{"menu-pro":2006}}},"_website_section_id":"elcomercio./respuestas/venezuela","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T20:12:10.564Z","publish_date":"2026-10-25T22:26:06Z","_id":"ZXXK2GPESBB27ANDICHVO6L6SA","website":"elcomercio","website_url":"/respuestas/venezuela/temblor-en-veneuzela-hoy-ultimos-sismos-reportados-en-octubre-en-vivo-cual-fue-el-epicentro-magnitud-y-hora-segun-la-funvisis-proteccion-civil-caracas-la-guaira-lbposting-noticia/"},{"content_elements":[{"list_type":"unordered","_id":"S4NGXSHUHJA7VEBKFZHOSSGZSY","type":"list","items":[{"_id":"DDGAO5FRKFDQTOA6OKAODERSQ4","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://elcomercio.pe/mag/usa/en-vivo-us/a-que-hora-es-la-carrera-de-f1-gp-de-estados-unidos-2026-en-vivo-hoy-por-la-formula-uno-en-eeuu-mexico-y-espana-nnda-nnrt-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://elcomercio.pe/mag/usa/en-vivo-us/a-que-hora-es-la-carrera-de-f1-gp-de-estados-unidos-2026-en-vivo-hoy-por-la-formula-uno-en-eeuu-mexico-y-espana-nnda-nnrt-noticia/\"><i>¿A qué hora es la carrera de F1 GP de Estados Unidos 2026 EN VIVO hoy por la Fórmula Uno en EE.UU., México y España?</i></a>"}]},{"_id":"F3EJDRQPZFETPCQYSMKVSAXSPQ","additional_properties":{},"type":"text","content":"<b>Andrea Kimi Antonelli</b> partirá desde la pole position del <b>Gran Premio de Estados Unidos 2026 de Fórmula 1</b>, una carrera que puede definir la lucha por el título mundial <b>este domingo 25 de octubre</b> en el Circuito de las Américas, en Austin, Texas. El piloto de Mercedes tendrá a Max Verstappen (Red Bull) a su lado en la primera fila, mientras que Isack Hadjar saldrá tercero. Los aficionados podrán seguir la prueba en vivo por televisión y streaming, con opciones de transmisión que varían según el país."},{"_id":"Z3GLEA3PJZDQBPORBWC5LQL3CU","additional_properties":{},"type":"text","content":"En <b>Estados Unidos</b>, los seguidores de la <b>Fórmula 1</b> podrán consultar la oferta de <b>Apple TV y F1 TV</b> para seguir la carrera. La disponibilidad de la transmisión en directo, las funciones y los planes depende del servicio contratado y del mercado. La prueba tendrá como principal atractivo la posibilidad de que Antonelli asegure matemáticamente el campeonato, siempre que se cumplan las condiciones necesarias durante la carrera."},{"_id":"WUII3ZHGRBDANCXK265EPVX47E","additional_properties":{},"type":"text","content":"En <b>México</b>, la cobertura del <b>Gran Premio de Estados Unidos</b> incluye las señales de <b>Sky Sports y las opciones digitales de Sky e Izzi, además de F1 TV</b>, según la disponibilidad de cada servicio. Para los aficionados mexicanos, la carrera comenzará a las 14:00, hora del centro del país."},{"_id":"QGIAVLRYFVBNTID6B32GY2N3OY","additional_properties":{},"type":"text","content":"En el <b>resto de Latinoamérica</b>, <b>ESPN y Disney+ Premium</b> figuran entre las principales alternativas de transmisión, mientras que F1 TV ofrece opciones adicionales sujetas a los derechos y las funciones habilitadas en cada territorio."},{"_id":"YVHE2I3YUFACVBOCLROBH53DBQ","additional_properties":{},"type":"text","content":"En <b>Europa</b>, los aficionados podrán seguir la carrera mediante los servicios que poseen los derechos de <b>Fórmula 1</b> en sus respectivos mercados. En <b>España</b>, la transmisión corresponde a <b>DAZN</b> y a los operadores que ofrecen sus canales; en <b>Reino Unido, Alemania, Francia e Italia,</b> la disponibilidad debe consultarse según la plataforma local."},{"_id":"MZXEPQ525VD6JNUE6YVBEINNDI","additional_properties":{},"type":"text","content":"La salida está programada para las 21:00 en la España peninsular, seis horas después del horario previsto en Austin."},{"level":2,"_id":"S46AKT7HYVEAHPOR4GWJ5SL4OE","additional_properties":{},"type":"header","content":"<b>¿En qué canal transmiten el GP de Estados Unidos 2026 de Fórmula 1?</b>"},{"_id":"QGOWDZTFCFBOLOMFB7XUYTYQX4","additional_properties":{},"type":"text","content":"El Gran Premio de Estados Unidos 2026 se disputará el domingo 25 de octubre en el Circuito de las Américas, en Austin. La carrera comenzará a las 14:00 en el centro de México, las 15:00 en Perú y Colombia, las 17:00 en Argentina y las 21:00 en España peninsular. La transmisión estará disponible a través de los canales de televisión y las plataformas digitales autorizados en cada territorio."},{"header":[{"_id":"QNXR2CNXNREN3MO2QWMOWZSOIM","type":"text","content":"PAÍSES"},{"_id":"CD4GZAAQTJE2FFG4YVXXSWL7AY","type":"text","content":"HORARIOS"},{"_id":"XXLPI5RPORFBXPPAUPGR35H2UA","type":"text","content":"CANALES TV / STREAMING"}],"_id":"NNPISGESY5GT7HGXZ7CO2A5YRQ","additional_properties":{},"rows":[[{"_id":"44RDN2MBJZBLHLISS63AJQGT4U","type":"text","content":"México"},{"_id":"ILGLGUW27VE6TOGZXT53WJEXUU","type":"text","content":"14:00"},{"_id":"HJL3UJM5LZEUFAT2PHSOWBJBIY","type":"text","content":"Sky Sports, F1 TV"}],[{"_id":"XFR3S4AXT5CF3DCGPZU2W3FZFU","type":"text","content":"Estados Unidos"},{"_id":"RFMIPQVPYJBUNGQL2TFFRBHEKY","type":"text","content":"4 p. m. ET / 1 p. m. PT"},{"_id":"5VSALJJIMJAETE3MIONEMIDFHI","type":"text","content":"Apple TV, F1 TV"}],[{"_id":"KOAKL3KN7JHFLJMRNIGJ4PF5IE","type":"text","content":"Costa Rica"},{"_id":"ACLYIDXX4FEUNIPDVJNASRBGW4","type":"text","content":"14:00"},{"_id":"HDE63LMJE5A53LQV4UKV7RVYR4","type":"text","content":"ESPN y Disney+ Premium"}],[{"_id":"53VPNZJ7MVERHMPJSJXSSBR7AM","type":"text","content":"El Salvador"},{"_id":"NDLB4RAAP5AGNITPJOWF4