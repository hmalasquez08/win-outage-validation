as-de-tres-mil-estudiantes-participaran-en-la-recta-final-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"elcomercio","revision":{"editions":["default"],"parent_id":"DZSSXVI6GFHGJBS5KQB6QC5EWU","published":true,"branch":"default","revision_id":"MNNLOCFEJVFBJO6RLUDYCTRSTI"},"planning":{"story_length":{"character_count_actual":1374,"inch_count_actual":1,"word_count_actual":196,"line_count_actual":7}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-25T22:15:51.766Z","headlines":{"tablet":"","print":"","meta_title":"JEDPA 2026: Más de tres mil estudiantes participarán en la recta final","native":"","web":"","mobile":"","basic":"JEDPA 2026: Más de tres mil estudiantes participarán en la recta final"},"websites":{"elcomercio":{"website_url":"/deporte-total/jedpa-2026-mas-de-tres-mil-estudiantes-participaran-en-la-recta-final-noticia/","website_section":{"path":"/deporte-total","parent":{"default":"/"},"_website":"elcomercio","parent_id":"/","name":"DT","_id":"/deporte-total","additional_properties":{"original":{"parent":{"header-pro":null,"default":"/","navbar-default":"/","sitemap-default":"/","default-pro":"/","test":"/","search-filter-default":"/","menu-default":"/","header-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"elcomercio","name":"DT","_id":"/deporte-total","ancestors":{"header-pro":[],"navbar-default":["/"],"sitemap-default":["/"],"default-pro":["/"],"search-filter-default":["/"],"menu-default":["/"],"header-default":[],"menu-pro":["/"]},"order":{"default":1013,"navbar-default":1009,"sitemap-default":1010,"default-pro":1009,"test":1013,"search-filter-default":1004,"menu-default":1021,"menu-pro":1014}}},"_website_section_id":"elcomercio./deporte-total","type":"section","version":"0.6.0"}}},"created_date":"2026-10-25T22:15:46.414Z","publish_date":"2026-10-25T22:15:51.766Z","_id":"M2WMMKO255ATFPCSFT7SU6SZEY","website":"elcomercio","website_url":"/deporte-total/jedpa-2026-mas-de-tres-mil-estudiantes-participaran-en-la-recta-final-noticia/"},{"content_elements":[{"list_type":"unordered","_id":"5FZIMSLQCFBNFIEV5F3KCENLLQ","type":"list","items":[{"_id":"A52O2GDNRFFDLA5ZAFGGCXN2ZQ","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://elcomercio.pe/politica/congreso/presidente-del-congreso-miguel-torres-firma-autografa-que-faculta-al-ejecutivo-a-legislar-contra-la-delincuencia-y-frente-al-fenomeno-el-nino-ultimas-noticia/\" target=\"_self\" rel=\"\" title=\"Presidente del Congreso, Miguel Torres, firma autógrafa que delega facultades legislativas al Gobierno\"><b>Presidente del Congreso, Miguel Torres, firma autógrafa que delega facultades legislativas al Gobierno</b></a>"},{"_id":"MVFSFCYYZBBVPDDGUHX7CGTH6Y","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/\"><b>Partido del Buen Gobierno: senadores que votaron a favor de otorgar las facultades afrontarán medidas disciplinarias</b></a>"}]},{"subtype":"stamp_trust","_id":"NNLXEOBDDZFGNHIH4WCLFFJM2Y","embed":{"id":"1792800976741-841359","config":{"url_img":"","url":""},"url":"/pf/api/v3/content/fetch/photo-by-id"},"type":"custom_embed"},{"_id":"JIWNDDJHHNAQBMNVAKB32Q7SGU","additional_properties":{},"type":"text","content":"No tiene un ápice de arrepentimiento. <a href=\"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/?ref=ecr\" target=\"_blank\" rel=\"noreferrer\" title=\"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/?ref=ecr\"><b>Jorge Gavidia</b></a> (Buen Gobierno) lleva 87 días en el cargo de <a href=\"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/?ref=ecr\" target=\"_blank\" rel=\"noreferrer\" title=\"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/?ref=ecr\"><b>senador </b></a>y desde hace dos enfrenta duras críticas de su bancada por haber votado a favor de las facultades legislativas para el Ejecutivo, una decisión que —según el parlamentario— respondió a criterios personales y coyunturales."},{"subtype":"mira-aqui","_id":"RG7CC6DK55DNJNQFWWNM24ZVBQ","embed":{"id":"1792803726019-361046","config":{"link_url":"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/?ref=ecr","label":"MIRA AQUÍ","link_text":"Partido del Buen Gobierno: senadores que votaron a favor de otorgar las facultades afrontarán medidas disciplinarias","timestamp":1792803732153},"url":"/pf/api/v3/content/fetch/photo-by-id"},"type":"custom_embed"},{"_id":"6SEFQCQBB5HCZM7MHX3B7GKSDA","additional_properties":{},"type":"text","content":"El último miércoles, cinco de sus colegas del <a href=\"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/?ref=ecr\" target=\"_blank\" rel=\"noreferrer\" title=\"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/?ref=ecr\"><b>Buen Gobierno</b></a> acordaron abstenerse en la votación del dictamen que otorgó facultades al Gobierno por 90 días. Sin embargo, el texto fue aprobado por el pleno del Senado con los votos de <a href=\"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/?ref=ecr\" target=\"_blank\" rel=\"noreferrer\" title=\"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/?ref=ecr\"><b>Gavidia, su compañero Juver Flores</b></a>, Fuerza Popular, Renovación Popular y el Partido Cívico Obras."},{"_id":"STFGPMD76FFDXKVU25VTITRJMQ","additional_properties":{},"type":"text","content":"<b>Consultado por El Comercio, el legislador explicó que nunca consideró la abstención como una alternativa, pues prefería equivocarse antes que dejar de “pensar en el país”. A su juicio, quienes optaron por no respaldar ni rechazar el dictamen incurrieron deliberadamente en un “cálculo político”.</b>"},{"_id":"H3XKBCEFZFA2BNVGJ5STJ37USA","additional_properties":{},"type":"text","content":"“Pienso que la abstención es peor que cometer un error y no decidir. La abstención es un cálculo político en el cual uno se protege a sí mismo y no decide por el país. Prefiero equivocarme o acertar”, dijo."},{"_id":"FEFZRLLLTJFRRMWP2WWOIARKEE","additional_properties":{},"type":"text","content":"Reitera sus críticas, aunque prefirió no señalar nombres. Cinco compañeros suyos optaron por la alternativa de la abstención: Nora Bonifaz, Carlos Caballero, Flavio Figallo, Patricia Iturregui y Susana Matute."},{"_id":"R7LTP442BRBBZDFVTPGR7VEVAQ","additional_properties":{},"type":"text","content":"“Es como Pilatos, no me lavo las manos sabiendo las implicancias que puede tener una decisión. Yo no me lavo las manos. Yo decido”, criticó."},{"_id":"HQK7EJ3R6NB6DOUDEXD2RJJNK4","additional_properties":{},"type":"text","content":"El senador negó que sea un traidor y dijo que su posición era conocida por el partido, incluso por Jorge Nieto, líder de su agrupación, quien días previos lo llamó para que “recapacite en no tener esa diferencia”."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"cad0f22f33c45ed7c8f573e03c1983d1f61fad3aeb976057bd6b2659bb6808f5"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/KI3NPALSQVH2PO2KYYNXGCOMTY.jpg","licensable":false,"credits":{"affiliation":[]},"subtitle":"Discrepancias en el Buen Gobierno: Juver Flores, Jorge Nieto y Jorge Gavidia.","width":1200,"_id":"KI3NPALSQVH2PO2KYYNXGCOMTY","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/KI3NPALSQVH2PO2KYYNXGCOMTY.jpg?auth=cad0f22f33c45ed7c8f573e03c1983d1f61fad3aeb976057bd6b2659bb6808f5","proxyUrl":"/resizer/v2/KI3NPALSQVH2PO2KYYNXGCOMTY.jpg?auth=cad0f22f33c45ed7c8f573e03c1983d1f61fad3aeb976057bd6b2659bb6808f5","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/KI3NPALSQVH2PO2KYYNXGCOMTY.jpg","published":true,"resizeUrl":"/resizer/v2/KI3NPALSQVH2PO2KYYNXGCOMTY.jpg?auth=cad0f22f33c45ed7c8f573e03c1983d1f61fad3aeb976057bd6b2659bb6808f5","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/KI3NPALSQVH2PO2KYYNXGCOMTY.jpg?auth=cad0f22f33c45ed7c8f573e03c1983d1f61fad3aeb976057bd6b2659bb6808f5&width=300","version":0,"originalName":"Política El Comercio (97).jpg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-22T22:49:26Z","last_updated_date":"2026-10-22T22:49:26Z","height":647,"image_type":"photograph","status":""},{"level":2,"_id":"CXFMA52ICRD5PKFN6JLWR4CVFA","additional_properties":{},"type":"header","content":"<b>Indisciplina</b>"},{"_id":"QEHAHVUBAJHPFODCTQBQSH4LQY","additional_properties":{},"type":"text","content":"En el diálogo, Gavidia reconoció que es indisciplinado, luego de que Jorge Nieto y la senadora Nora Bonifaz lo cuestionaran por apartarse de la posición acordada. Incluso admitió que su falta de disciplina podría explicar buena parte de los problemas de su vida."},{"_id":"GI7J77D2D5AVFJ76M53TJDHLRA","additional_properties":{},"type":"text","content":"Adelantó que explicará las razones de fondo sobre su voto diferenciado, en el proceso que afrontará junto a su colega Juver Flores, quien también optó por apoyar las facultades sin consentimiento de la agrupación."},{"_id":"2DTR5NS54NGF7GCUU5VVJUUXDY","additional_properties":{},"type":"text","content":"“Solamente espero que en la decisión del partido sobre mi indisciplina se considere mi perfil y la utilidad de mi representación como senador en el país, porque tengo una serie de actividades y proyectos”, afirmó."},{"_id":"23PCJDSSKNDWRJDJUUJUVZNDCA","additional_properties":{},"type":"text","content":"Gavidia también contó que, al término de la votación en el pleno del Senado, algunos legisladores de la derecha le agradecieron su postura, mientras que representantes de otras bancadas mantenían su mirada crítica."},{"level":2,"_id":"3ZL4HX4GBRE7NPZD3UPWKWAI6A","additional_properties":{},"type":"header","content":"<b>Posiciones</b>"},{"_id":"FP5F6C3XANFYJK2FZH24EQZOBE","additional_properties":{},"type":"text","content":"Desde su bancada, el diputado Fernando García aseguró que todavía no hubo descargos de los dos senadores que votaron a favor de las facultades."},{"_id":"KCZKGWGWCNG7DM2QQVEFGFOKII","additional_properties":{},"type":"text","content":"García consideró que las acciones de sus colegas “fueron una indisciplina” y sostuvo que estas podrían derivar en una sanción. “Tenemos que escucharlos primero”, agregó."},{"_id":"E5MFRCGRONGXBN5LNLJ3ODRCEU","additional_properties":{},"type":"text","content":"Por la tarde, Daniel Barragán, del Partido Cívico Obras, otra agrupación que apoyó las facultades, evitó referirse sobre el fondo del tema pero sí se pronunció sobre su hermana María del Carmen Barragán, quien fue separada del cargo de asesora 3 en Essalud."},{"_id":"VRSAWGHCUBGM5EXBZJED664IBM","additional_properties":{},"type":"text","content":"Explicó que su previa designación en el puesto solo era una “coincidencia” con la postura de Obras en favor de las facultades. Indicó que nunca refirió a un familiar en el Estado y que su hermana ostentó previamente otros altos cargos."},{"level":2,"_id":"SVNK7NWDEJBBDOWJZ3YVSGYK2U","additional_properties":{},"type":"header","content":"<b>¿Qué sanciones podrían enfrentar Gavidia y Juver Flores? </b>"},{"_id":"FDUYWSAUGNBUHAT76ECJEQSK5A","additional_properties":{},"type":"text","content":"De acuerdo con el reglamento del Partido del Buen Gobierno en el Senado, constituyen infracciones graves los actos que atenten contra la unidad del grupo parlamentario y el incumplimiento de los acuerdos adoptados por el Plenario. En tanto, se considera una infracción muy grave afectar gravemente la imagen del partido político."},{"_id":"5P4OJJWSHFH3TLR32UPV73UPHU","additional_properties":{},"type":"text","content":"El artículo 18 establece que el incumplimiento de las disposiciones del reglamento puede dar lugar a seis tipos de sanciones: amonestación verbal, amonestación escrita, multa, suspensión temporal de alguno o todos los derechos al interior del grupo parlamentario, separación de un cargo y suspensión o expulsión del grupo."},{"_id":"GKKXY2MLR5FHHCJLQX3EEVELVE","additional_properties":{},"type":"text","content":"No obstante, refiere que para determinar la sanción se deben tener en consideración los criterios de razonabilidad, proporcionalidad y gravedad de la falta u omisión incurrida."},{"_id":"OJ3YYM7RZ5CB5K3NMPFVH4NU3Q","additional_properties":{},"type":"text","content":"Asimismo, que las multas a imponerse no podrán superar el 20% de una Unidad Impositiva Tributaria (UIT) del respectivo año fiscal."},{"subtype":"mira-aqui","_id":"2BQDGSVTH5HPDIOR4445EOG3NY","embed":{"id":"1792803726019-361046","config":{"link_url":"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/?ref=ecr","label":"MIRA AQUÍ","link_text":"Partido del Buen Gobierno: senadores que votaron a favor de otorgar las facultades afrontarán medidas disciplinarias","timestamp":1792803732153},"url":"/pf/api/v3/content/fetch/photo-by-id"},"type":"custom_embed"},{"_id":"NWHRGTPIN5FJ5MKXOEW4ESFIPE","additional_properties":{},"type":"text","content":"De iniciar el procedimiento disciplinario, este deberá garantizar el derecho de defensa del investigado con la imputación de cargos, evaluación de descargos y derecho a alegación y prueba."},{"_id":"BPLWONKVZFHRRJ7P3BQFDAZRHQ","additional_properties":{},"type":"text","content":"“La sanción en primera instancia es impuesta por el vocero del grupo parlamentario y su decisión puede ser recurrida ante el Plenario de Senadores”, reza el reglamento."},{"subtype":"custom-ec-blocks","_id":"VUVQA3F3EBEADC3O2EWBEBMOLQ","embed":{"id":"no-fetch","config":{"data":{"listTitle":"TE PUEDE INTERESAR","itsAtTheEnd":false,"list":[{"id":"1644950768472","text":"Partido del Buen Gobierno: senadores que votaron a favor de otorgar las facultades afrontarán medidas disciplinarias","error":false,"url":"https://elcomercio.pe/politica/partido-del-buen-gobierno-senadores-que-apoyaron-las-facultades-en-disidencia-afrontaran-medidas-disciplinarias-apuesplan-noticia/?ref=ecr"},{"id":1792803795938,"text":"Pleno del Senado aprueba 27 facultades: ¿Qué bancadas votaron de forma dividida?","error":false,"url":"https://elcomercio.pe/politica/pleno-del-senado-aprueba-27-facultades-que-bancadas-votaron-de-forma-dividida-apuesplan-noticia/"},{"id":1792803808680,"text":"Ausencia de senadores de izquierda y aliados frustra debate y votación de facultades: los entretelones de la sesión","error":false,"url":"https://elcomercio.pe/politica/bancadas-de-izquierda-y-aliados-frustan-debate-y-votacion-de-facultades-los-entretelones-de-la-sesion-de-la-comision-de-constitucion-apuesplan-noticia/"},{"id":1792803819436,"text":"Tenso altercado en plena sesión del Senado: Así se desarrolló el incidente entre Iber Maraví y el ministro Astudillo","error":false,"url":"https://elcomercio.pe/politica/tenso-altercado-en-plena-sesion-del-senado-asi-se-desarrollo-el-enfrentamiento-entre-iber-maravi-y-el-ministro-astudillo-apuesplan-noticia/"}]},"block":"related-links"},"url":"/"},"type":"custom_embed"}],"subheadlines":{"basic":"Jorge Gavidia no se siente arrepentido. En diálogo con El Comercio cuenta su verdad y sostiene que el respaldo al dictamen —aprobado por el pleno del Senado— respondió a criterios personales y coyunturales. "},"source":{"system":"composer","name":"https://arc-json-repository.ec.pe/polly-audio/polly_speech_BP2BVXHAWFA4PG7RV3PNKWUADU_full.mp3","source_type":"staff"},"taxonomy":{"primary_site":{"path":"/politica","parent_id":"/","name":"Política","_id":"/politica","additional_properties":{"original":{"parent":{"+ add":"/","header-pro":null,"default":"/","navbar-default":"/","sitemap-default":"/","default-pro":"/","test":"/","search-filter-default":"/","menu-default":"/","header-default":null,"menu-pro":"/"},"_admin":{"alias_ids":["0"]},"inactive":false,"node_type":"section","name":"Política","_id":"/politica","ancestors":{"+ add":["/"],"header-pro":[],"navbar-default":["/"],"sitemap-default":["/"],"default-pro":["/"],"search-filter-default":["/"],"menu-default":["/"],"header-default":[],"menu-pro":["/"]},"order":{"+ add":1003,"default":1004,"navbar-default":1004,"sitemap-default":1001,"default-pro":1004,"test":1004,"search-filter-default":1002,"menu-default":1015,"menu-pro":1005}}},"type":"site","version":"0.5.8"},"sites":[{"path":"/politica","parent_id":"/","name":"Política","_id":"/politica","additional_properties":{"original":{"parent":{"+ add":"/","header-pro":null,