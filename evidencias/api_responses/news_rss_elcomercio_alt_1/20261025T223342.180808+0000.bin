":"https://elcomercio.pe/resizer/v2/JLIP5PZYKZCA5OUDPQTD5Q5VQE.png?auth=80066e60c5325c8b3bdd6634820d78b6c1d397a50244f5cf18d231e472bcfd38&width=170&height=90&quality=75&smart=true","portrait_xl":"https://elcomercio.pe/resizer/v2/JLIP5PZYKZCA5OUDPQTD5Q5VQE.png?auth=80066e60c5325c8b3bdd6634820d78b6c1d397a50244f5cf18d231e472bcfd38&width=528&height=900&quality=75&smart=true","portrait_l":"https://elcomercio.pe/resizer/v2/JLIP5PZYKZCA5OUDPQTD5Q5VQE.png?auth=80066e60c5325c8b3bdd6634820d78b6c1d397a50244f5cf18d231e472bcfd38&width=374&height=648&quality=75&smart=true","portrait_md":"https://elcomercio.pe/resizer/v2/JLIP5PZYKZCA5OUDPQTD5Q5VQE.png?auth=80066e60c5325c8b3bdd6634820d78b6c1d397a50244f5cf18d231e472bcfd38&width=314&height=374&quality=75&smart=true","portrait_s":"https://elcomercio.pe/resizer/v2/JLIP5PZYKZCA5OUDPQTD5Q5VQE.png?auth=80066e60c5325c8b3bdd6634820d78b6c1d397a50244f5cf18d231e472bcfd38&width=161&height=220&quality=75&smart=true","portrait_xs":"https://elcomercio.pe/resizer/v2/JLIP5PZYKZCA5OUDPQTD5Q5VQE.png?auth=80066e60c5325c8b3bdd6634820d78b6c1d397a50244f5cf18d231e472bcfd38&width=75&height=90&quality=75&smart=true","square_xl":"https://elcomercio.pe/resizer/v2/JLIP5PZYKZCA5OUDPQTD5Q5VQE.png?auth=80066e60c5325c8b3bdd6634820d78b6c1d397a50244f5cf18d231e472bcfd38&width=900&height=900&quality=75&smart=true","square_l":"https://elcomercio.pe/resizer/v2/JLIP5PZYKZCA5OUDPQTD5Q5VQE.png?auth=80066e60c5325c8b3bdd6634820d78b6c1d397a50244f5cf18d231e472bcfd38&width=600&height=600&quality=75&smart=true","square_md":"https://elcomercio.pe/resizer/v2/JLIP5PZYKZCA5OUDPQTD5Q5VQE.png?auth=80066e60c5325c8b3bdd6634820d78b6c1d397a50244f5cf18d231e472bcfd38&width=300&height=300&quality=75&smart=true","square_s":"https://elcomercio.pe/resizer/v2/JLIP5PZYKZCA5OUDPQTD5Q5VQE.png?auth=80066e60c5325c8b3bdd6634820d78b6c1d397a50244f5cf18d231e472bcfd38&width=150&height=150&quality=75&smart=true","square_xs":"https://elcomercio.pe/resizer/v2/JLIP5PZYKZCA5OUDPQTD5Q5VQE.png?auth=80066e60c5325c8