mage\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=675&width=1200\", \"height\": \"675\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=900&width=1200\", \"height\": \"900\", \"width\": \"1200\"}, {\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVUILQL7X5FZVNQVQ7XYWREORI.jpg?auth=c68a4ff8a496fa1f788bca29b845ec2a67f88393575d61eb4ec15e3dfcce227f?height=1200&width=1200\", \"height\": \"1200\", \"width\": \"1200\"}]}, {\"@type\": \"BlogPosting\", \"headline\": \"Resultados de la segunda vuelta en Brasil EN VIVO: Lula vs. Fl\\u00e1vio Bolsonaro por la presidencia\", \"datePublished\": \"2026-10-25T17:27:37-0500\", \"dateModified\": \"2026-10-25T17:27:37-0500\", \"alternateName\": \"Las \\u00faltimas encuestas de Datafolha y Quaest otorgan a Fl\\u00e1vio Bolsonaro una ligera ventaja sobre Lula da Silva, aunque ambos candidatos se mantienen en empate t\\u00e9cnico. Brasil celebra este domingo una segunda vuelta marcada por la incertidumbre y una ajustada disputa por la Presidencia\", \"mainEntityOfPage\": {\"@type\": \"WebPage\", \"@id\": \"\"}, \"@id\": \"#liveblog-397688\", \"author\": [{\"@type\": \"Person\", \"@id\": \"#author\", \"name\": \"Redacci\\u00f3n EC\", \"url\": \"https://elcomercio.pe/autor/redaccion-ec/\"}], \"publisher\": {\"@type\": \"Organization\", \"@id\": \"#organization\"}, \"url\": \"https://elcomercio.pe/mundo/latinoamerica/elecciones-brasil-segunda-vuelta-2026-en-vivo-lula-vs-bolsonaro-resultados-y-escrutinio-lbposting-noticia/#liveblog-397688\", \"articleBody\": \"\\t<p> <b>Resultados de las elecciones en Brasil al 4,10% de votos</b></p>\\n\\n<p>Lula da Silva 51,26%\\u00a0</p>\\n\\n<p>Fl\\u00e1vio Bolsonaro 48,74%</p>\\n\\n\", \"image\": [{\"@type\": \"ImageObject\", \"url\": \"/resizer/v2/YVU