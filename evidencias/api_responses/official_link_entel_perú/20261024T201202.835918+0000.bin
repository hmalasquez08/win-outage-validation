  /* ============================================================
     SUBTÍTULO SECCIÓN
     ============================================================ */
  .banner-complementario-skeleton__section-subtitle {
    margin-bottom: 16px;
  }
  .sk-section-subtitle {
    width: 55%;
    max-width: 540px;
    height: 16px;
  }
  /* ============================================================
     BANNER
     ============================================================ */
  .banner-complementario-skeleton__banner {
    width: 100%;
    min-height: 130px;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
    border: 1px solid #e6e8ec;
    border-radius: 12px;
    background: #f6f7f9;
  }
  /* ============================================================
     ILLUSTRATION
     ============================================================ */
  .banner-complementario-skeleton__illustration {
    flex-shrink: 0;
  }
  .sk-illustration {
    width: 72px;
    height: 72px;
    border-radius: 50%;
  }
  /* ============================================================
     CONTENT
     ============================================================ */
  .banner-complementario-skeleton__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sk-title {
    width: 45%;
    max-width: 350px;
    height: 24px;
  }
  .sk-subtitle {
    width: 65%;
    max-width: 500px;
    height: 16px;
  }
  /* ============================================================
     BUTTON
     ============================================================ */
  .banner-complementario-skeleton__footer {
    flex-shrink: 0;
  }
  .sk-button {
    width: 160px;
    height: 40px;
    border-radius: 999px !important;
  }
  /* ============================================================
     SKELETON BASE
     ============================================================ */
  .banner-complementario-skeleton .banner-complementario-sk {
    position: relative;
    overflow: hidden;
    background: #e5e8ed;
    border-radius: 8px;
  }
  .banner-complementario-skeleton .banner-complementario-sk::after {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateX(-120%);
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, .55) 45%,
      rgba(255, 255, 255, .85) 55%,
      rgba(255, 255, 255, 0) 100%
    );
    animation: banner-complementario-shimmer 1.2s infinite;
  }
  @keyframes banner-complementario-shimmer {
    100% {
      transform: translateX(120%);
    }
  }
  /* ============================================================
     MOBILE
     ============================================================ */
  @media (max-width: 768px) {
    .banner-complementario-skeleton__banner {
      align-items: flex-start;
      flex-direction: column;
      padding: 20px;
      gap: 16px;
    }
    .sk-illustration {
      width: 56px;
      height: 56px;
    }
    .banner-complementario-skeleton__content {
      width: 100%;
    }
    .sk-title {
