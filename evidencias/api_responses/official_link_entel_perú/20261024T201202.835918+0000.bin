		const swiperEl = document.querySelector(".swiper-banner-hero");

		Object.assign(swiperEl, {
			slidesPerView: 1,
			pagination: { clickable: true },
			loop: true,
			autoplay: { delay: 10000 },
			injectStyles: [
				`.swiper-button-next svg, .swiper-button-prev svg { display: none; }
     :host(.swiper-card-general-custom) { padding-top: 6px !important; }
     .swiper-pagination-bullet {
       width: 8px; height: 8px; text-align: center; line-height: 20px;
       font-size: 12px; color: #000; opacity: 1; background: rgba(0, 0, 0, 0.2);
     }
     .swiper-pagination-bullet-active {
       width: 32px; border-radius: 12px; color: #fff; background: #002EFF;
     }`
			],
			on: {
				slideChange: handleSlideChange,
				init: handleSlideChange,
			},
		});

		swiperEl.initialize();
		const swiper = swiperEl.swiper;

		// Aplicar clase de background dinámica a los banners estáticos
		const slidesEstaticos = document.querySelectorAll('.banner_estático_home[data-bg-class]');
		slidesEstaticos.forEach(slide => {
			const bgClass = slide.getAttribute('data-bg-class');
			const bgImagesData = slide.getAttribute('data-bg-images');

			if (bgClass) {
				const bannerForm = slide.querySelector('.andino-banner-hero-form');
				if (bannerForm) {
					bannerForm.classList.add(bgClass);
				}
			}

			// Generar estilos dinámicos ordenados correctamente
			if (bgClass && bgImagesData) {
				try {
					const bgImages = JSON.parse(bgImagesData);
					// Ordenar numéricamente por breakpoint (de menor a mayor)
					bgImages.sort((a, b) => a.breakpoint - b.breakpoint);

					let cssRules = '';
					bgImages.forEach((img, index) => {
						const baseStyles = `
							background-image: url("${img.url}");
							background-size: cover;
							background-repeat: no-repeat;
							background-position: center;
						`;

						if (index === 0) {
							// Primera imagen = estilos base móvil (sin media query)
							cssRules += `.${bgClass} { ${baseStyles} }\n`;
						} else {
							// Demás imágenes con su breakpoint exacto
							cssRules += `@media (min-width: ${img.breakpoint}px) { .${bgClass} { ${baseStyles} } }\n`;
						}
					});

					// Crear y agregar el style tag
					const styleTag = document.createElement('style');
					styleTag.setAttribute('data-banner-bg', bgClass);
					styleTag.textContent = cssRules;
					document.head.appendChild(styleTag);
				} catch (e) {
					console.error('Error parsing background images:', e);
				}
			}
		});


	
		
		
