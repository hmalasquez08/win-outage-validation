<script>
	(() => {
		const setupSwiper = () => {
			const el = document.getElementById("cards-general-tab-5-controlador-card-general-contactanos-y-te-atenderemos-home");
			if (!el || el.dataset.swiperjsReady === "true") return;

			const initializeSwiper = () => {
				if (typeof el.initialize !== "function") return;

				const slides = el.querySelectorAll("swiper-slide").length;
				const fit = (max) => (slides > max ? max : slides);

				Object.assign(el, {
					slidesPerView: fit(),
					spaceBetween: 16,
					grabCursor: true,
					watchOverflow: true,
					observer: true,
					observeParents: true,
					breakpointsBase: "window",
					
					
					
					
					
					breakpoints: {
	0: { slidesPerView: 1 },
	576: { slidesPerView: 1.2 },
	768: { slidesPerView: 2 },
	992: { slidesPerView:3},
	1200: { slidesPerView: 4 },
},
					
					pagination: { clickable: true },
					
					injectStyles: [
						
						`
						.swiper-pagination {
							position: sticky;
							margin-top: 1rem;
						}
						.swiper-pagination-bullet {
							width: 8px;
							height: 8px;
							text-align: center;
							line-height: 20px;
							font-size: 12px;
							color: #000;
							opacity: 1;
							background: rgba(0, 0, 0, 0.2);
							margin-top: 2rem;
						}
						.swiper-pagination-bullet-active {
							width: 32px;
							border-radius: 12px;
							color: #fff;
							background: #002EFF;
						}
						.swiper-button-next svg,
						.swiper-button-prev svg {
							display: none;
						}
						.swiper-button-next {
							background-image: url(https://entel.cdn.modyo.com/uploads/9209f4be-0674-467f-90ab-c2b9ff3e3a5a/original/next.png);
							background-color: white;
							background-repeat: no-repeat;
							background-position: center;
							margin-right: 10px;
							padding-right: 0;
							right: -8px;
							margin-top: -1.5625rem !important;
						}
						.swiper-button-prev {
							background-image: url(https://entel.cdn.modyo.com/uploads/1077f413-caae-4b55-b6ed-89a728c3ff1c/original/prev.png);
							background-color: white;
							background-repeat: no-repeat;
							background-position: center;
							margin-left: 10px;
							padding-left: 0;
							left: -8px;
							margin-top: -1.5625rem !important;
						}
						.swiper-button-next,
						.swiper-button-prev {
							position: absolute;
							top: var(--swiper-navigation-top-offset, 50%);
							width: 44px;
							height: 44px;
							margin-top: calc(0px - (var(--swiper-navigation-size) / 2));
							z-index: 10;
							cursor: pointer;
							display: flex;
							align-items: center;
							justify-content: center;
							box-shadow: 0px 0px 7px 1px rgba(0, 0, 0, 0.13);
							border-radius: 100%;
						}
						.swiper-button-next.swiper-button-disabled,
						.swiper-button-prev.swiper-button-disabled {
							opacity: 0;
							cursor: auto;
							pointer-events: none;
						}
						.swiper-button-lock {
							display: none !important;
						}
						@media (max-width: 991.98px) {
							.swiper-button-next,
							.swiper-button-prev {
								display: none;
							}
						}
						`
						
					]
				});

				el.initialize();
				el.dataset.swiperjsReady = "true";

				const syncLockedClass = () => {
					const sw = el.swiper;
					if (!sw || sw.destroyed) return;
					el.classList.toggle("swiperjs-locked-center", !!sw.isLocked);
				};
				syncLockedClass();

				if ("ResizeObserver" in window) {
					let frame = null;
					const observerResize = new ResizeObserver(() => {
						if (frame) cancelAnimationFrame(frame);
						frame = requestAnimationFrame(() => {
							const sw = el.swiper;
							if (!sw || sw.destroyed) return;
							sw.setBreakpoint();
							sw.update();
							syncLockedClass();
						});
					});
					observerResize.observe(el);
				}
			};

			if (customElements.get("swiper-container")) {
				initializeSwiper();
				return;
			}
			customElements.whenDefined("swiper-container").then(initializeSwiper);
		};

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", setupSwiper, { once: true });
		} else {
			setupSwiper();
		}
	})();
</script>
									</div>
							
							
							
					</section>
			
		
		</div>
	</div>

</section>

<script type="module">
	


	
	import "https://entel.cdn.modyo.com/libraries/v3.3.0/src/ads-components/molecules/cards/general/web-component.min.js";



	(() => {
		const skeleton = document.getElementById("card-general-skeleton-controlador-card-general-contactanos-y-te-atenderemos-home");
		const realSection = document.getElementById("card-general-real-controlador-card-general-contactanos-y-te-atenderemos-home");
		let revealed = false;

		const revealSection = () => {
			if (revealed) return;
			revealed = true;
			if (realSection) realSection.style.display = "";
			if (skeleton) skeleton.remove();
		};

		const afterRender = () =>
			requestAnimationFrame(() => requestAnimationFrame(revealSection));

		customElements.whenDefined("ads-card-general").then(() => {
			const cards = realSection ? realSection.querySelectorAll("ads-card-general") : [];
			const ready = Array.from(cards).map((card) =>
				card.updateComplete && typeof card.updateComplete.then === "function"
					? card.updateComplete.catch(() => {})
					: Promise.resolve()
			);
			Promise.all(ready).then(afterRender, afterRender);
		});

		window.addEventListener("load", () => setTimeout(revealSection, 4000), { once: true });
	})();
	
		 const tabsCardGeneral = document.querySelector("#tabs-card-general-controlador-card-general-contactanos-y-te-atenderemos-home");
		 const panels = {
			 
					'btn_tab_1controlador-card-general-contactanos-y-te-atenderemos-home': document.querySelector("#content_tab_1controlador-card-general-contactanos-y-te-atenderemos-home"),
			 
					'btn_tab_2controlador-card-general-contactanos-y-te-atenderemos-home': document.querySelector("#content_tab_2controlador-card-general-contactanos-y-te-atenderemos-home"),
			 
					'btn_tab_3controlador-card-general-contactanos-y-te-atenderemos-home': document.querySelector("#content_tab_3controlador-card-general-contactanos-y-te-atenderemos-home"),
			 
					'btn_tab_4controlador-card-general-contactanos-y-te-atenderemos-home': document.querySelector("#content_tab_4controlador-card-general-contactanos-y-te-atenderemos-home"),
			 
					'btn_tab_5controlador-card-general-contactanos-y-te-atenderemos-home': document.querySelector("#content_tab_5controlador-card-general-contactanos-y-te-atenderemos-home"),
			 
			 
		 };

		 const showPanel = (id) => {
			 Object.values(panels).forEach((panel) => {
				 panel?.classList.add("d-none");
				 panel?.classList.remove("d-block");
			 });
			 panels[id]?.classList.add("d-block");
			 panels[id]?.classList.remove("d-none");
		 };

		tabsCardGeneral?.addEventListener("ads-tab:change", (ev) => {
			const selected = ev.detail.selected;
			const btnId = selected.id;
			const edsData = JSON.parse(selected.getAttribute("eds-data") || "{}");

			const title = (edsData.title || "")
			.normalize("NFD")
			.replace(/[\u0300-\u036f]/g, "")
			.toLowerCase()
			.replace(/[^a-z0-9+\s]/g, "")
			.replace(/\s+/g, " ")
			.trim();

			window.dataLayer = window.dataLayer || [];

			window.dataLayer.push({
				event: "load",
				event_category: "home",
				event_action: "impressions",
				event_label: "",
				section: "contacto",
				level_1: title,
				location: "",
				market: "pe"
			});

			showPanel(btnId);
		});
</script>



