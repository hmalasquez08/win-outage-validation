	async function getAndUseTokenFabTransversalLit() {
		return new Promise((resolve, reject) => {
			grecaptcha.enterprise.ready(async () => {
				try {
					const token = await grecaptcha.enterprise.execute('6LdydjgrAAAAAEpuSFFgKEb9evyr_NjrnE4GHloJ', { action: 'LOGIN' });
