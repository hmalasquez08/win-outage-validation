						flagModalFab = false;
					});

					const formModal4 = elementModalC2C4?.querySelector(".formModalContratacion");
					const inputPhone4 = document.getElementById("inputPhone_4");
					const checkbox4 = document.querySelector('[eds-id-for="input_checkbox_4"]');
					const buttonsModal4 = formModal4 ? [...formModal4.querySelectorAll("ads-button")] : [];

					bindModalFormValidation({
