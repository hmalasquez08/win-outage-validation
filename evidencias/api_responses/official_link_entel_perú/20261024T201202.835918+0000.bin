	<script type="module" nonce="UCnyNFJSX4">
			

const ENDPOINT =
  window.location.hostname === 'www.entel.pe'
    ? 'https://api-forms-peru-b2c.en.tel/api/register'
    : 'https://uat-api-forms-peru-b2c.en.tel/api/register';

const baseData = {
  id: '20250624_participa',
  fields: {
    numero_documento: '',
    correo: '',
    telefono: '',
    acepta_envio_publicidad: false,
    nombre: '',
    tipo_documento: ''
  }
};

window.addEventListener('load', () => {
  /* ---- Elementos DOM ---- */
  const $ = (s) => document.querySelector(s);

  const modSuccess = $('#modalSuccessRequest');
  const modError   = $('#modalErrorRequest');

  const btnSend         = $('#enviarButtonForm');
  const btnCloseSuccess = $('.closeModalSuccess');
  const btnCloseError   = $('.closeModalError');

  const inpName   = $('#inputNameForm');
  const inpType   = $('#inputTypeDocForm');
  const inpNum    = $('#inputNumDocForm');
  const inpPhone  = $('#inputMovilForm');
  const inpEmail  = $('#inputEmailForm');
  const chkPubli  = $('#checkBoxPubliForm');
  const chkTyc    = $('#checkBoxTycForm');

  /* ---- Helpers ---- */
  const toggle = (m) => m.funcs.toggleModal();
  const setOk =  (el, ok) => {
    el.toggleAttribute('eds-success', ok);
    el.toggleAttribute('eds-error', !ok);
  };

  const resetForm = () => {
    [inpName, inpType, inpNum, inpPhone, inpEmail].forEach((el) => {
      el.funcs.clear();
      setOk(el, false);
    });
    inpNum.removeAttribute('eds-error');
		inpType.removeAttribute('eds-error');
		inpName.removeAttribute('eds-error');
		inpType.removeAttribute('eds-error');
		inpPhone.removeAttribute('eds-error');
		inpEmail.removeAttribute('eds-error');
		
    btnSend.setAttribute('eds-disabled', true);
    btnSend.classList.add('d-none-button');
    chkPubli.checked = chkTyc.checked = false;
    Object.keys(state).forEach(key => state[key] = false);
  };

  /* ---- Envío ---- */
	
	function syncFormData() {
  baseData.fields.nombre = inpName.value.trim();
  baseData.fields.tipo_documento = inpType.value;
  baseData.fields.numero_documento = inpNum.value.trim();
  baseData.fields.telefono = parseInt(inpPhone.value.trim());
  baseData.fields.correo = inpEmail.value.trim();
  baseData.fields.acepta_envio_publicidad = chkPubli.checked;
}

	
  async function sendLead(data) {
    try {
      const token = await getDataTokenParticipa();
      await axios.post(ENDPOINT, data, {
        headers: {
          Authorization: `Bearer ${token}`,
          Origin: 'https://www.entel.pe/',
          'Content-Type': 'application/json'
        }
      });
      resetForm();
      toggle(modSuccess);
			const modalframe = document.getElementById("participaModal");
      modalframe.removeAttribute('eds-show');
    } catch (err) {
      console.error(err);
      resetForm();
      toggle(modError);
    }
  }

  /* ---- UTM ---- */
  const UTM_KEYS = [
    'utm_source',
    'utm_medium',
    'utm_campaign',
    'utm_content',
    'utm_term',
    'gclid'
  ];

  const getUTMParams = () => {
    const q = new URLSearchParams(location.search);
    return Object.fromEntries(
      [...q.entries()].filter(([k]) => UTM_KEYS.includes(k))
    );
  };

  const utms = Object.assign(
    JSON.parse(localStorage.getItem('utm_params') || '{}'),
    getUTMParams()
  );

  localStorage.setItem('utm_params', JSON.stringify(utms));
  Object.assign(baseData, utms);

  /* ---- Estado & validaciones ---- */
  const state = {
    name: false,
    type: false,
    num: false,
    phone: false,
    email: false,
    publi: false,
    tyc: false
  };

  const checkReady = () => {
    const ready = Object.values(state).every(Boolean);
    btnSend.toggleAttribute('eds-disabled', !ready);
    btnSend.classList.toggle('d-none-button', !ready);
  };

 inpName.addEventListener('input', () => {
  const value = inpName.value.trim();

  const noNumbers = /^[^\d]+$/.test(value); // no contiene dígitos
  const validLength = value.length >= 5 && value.length <= 50;

  // Valida que cumpla todo
  state.name = !!value && noNumbers && validLength;

  setOk(inpName, state.name);
  checkReady();
});


  inpType.addEventListener('change', () => {
    inpNum.removeAttribute('eds-disabled');
    inpNum.funcs.clear();
    setOk(inpNum, false);
    state.type = inpType.value !== '';
    state.num  = false;
    checkReady();
  });

  const validators = {
    dni: (v) => /^\d{8}$/.test(v),
    ruc: (v) => /^(10|20)\d{9}$/.test(v),
    default: (v) => /^[A-Za-z0-9-]{5,15}$/.test(v)
  };

  const isNumber = (value) => {
    if (!/^\d/.test(value)) return inpNum.funcs.clear();
    return /^\d+$/.test(value) ? value : value.replace(/\D/g, "");
  };

  inpNum.setAttribute('eds-disabled',true);
  inpNum.addEventListener('input', () => {
    const type = inpType.value === 'dni' || inpType.value === 'ruc' ? inpType.value : 'default';
    const maxLength = type === 'dni' ? 8 : type === 'ruc' ? 11 : 0;
    if (maxLength) {
      inpNum.value = isNumber(inpNum.value.slice(0, maxLength));
      if (type === 'ruc' && inpNum.value[0] !== '1') {
        inpNum.value = '10' + inpNum.value.slice(1);
      }
    }
    const ok   = validators[type](inpNum.value);
    state.num  = ok;
    setOk(inpNum, ok);
    checkReady();
  });

  inpPhone.addEventListener('input', () => {
    let v = inpPhone.value.replace(/\D/g, '').slice(0, 9);
    if (v && v[0] !== '9') v = '9' + v.slice(1);
    inpPhone.value = v;
    state.phone = v.length === 9;
    setOk(inpPhone, state.phone);
    checkReady();
  });

  inpEmail.addEventListener('input', () => {
    state.email = /^[\w.\-]+@([\w\-]+\.)+[A-Za-z]{2,4}$/.test(inpEmail.value);
    setOk(inpEmail, state.email);
    checkReady();
  });

  [chkPubli, chkTyc].forEach((c) =>
    c.addEventListener('change', () => {
      state.publi = chkPubli.checked;
      state.tyc   = chkTyc.checked;
      checkReady();
    })
  );

  /* ---- Acciones ---- */
  btnCloseSuccess.addEventListener('click', () => toggle(modSuccess));
  btnCloseError  .addEventListener('click', () => toggle(modError));
  btnSend.addEventListener('click', () => {
  btnSend.setAttribute('eds-disabled', true);
  btnSend.classList.add('d-none-button');
  syncFormData();
  sendLead(baseData);
});
});


window.addEventListener("load", () => {
	
	
	const styleForm = document.getElementById("e-form-participa");
	const styleModalError = document.getElementById("divModalError");
	const styleModalSuccess = document.getElementById("divModalSuccess");

	styleForm.classList.remove("d-none");
	styleModalError.classList.remove("d-none");
	styleModalSuccess.classList.remove("d-none");

  const bannerParticipa = document.getElementById("banner-hero-sorteo-consentimiento");
  if (!bannerParticipa || !bannerParticipa.shadowRoot) return;

  const buttonParticipa = bannerParticipa.shadowRoot.getElementById("banner-hero-sorteo-consentimiento_button");
  if (!buttonParticipa) return;

  const modalframe = document.getElementById("participaModal");
  if (!modalframe) return;

  buttonParticipa.addEventListener("click", function () {
    modalframe.setAttribute('eds-show', true);
  });
});



	</script>






