									consulta: "Ejecutivo de Venta",
									consulta_detalle: "[Home - Banner Estatico]",
									category_form: "",
									webservice: "si",
									plan_tipo_ruc: "20",
									url: "https://www.entel.pe/",
									mark_event: "",
									emailservice: "",
									email_recepcion: "",
									id_lead: "",
									valida_ruc: "si",
									valida_migra: "si",
									origen: codOrigenEstatico_11,
									utm: "no pagado",
									nombre_formulario: "Home - Banner Estatico",
									campaign: "3490",
									gtm_category: "",
									gtm_action: "",
									gtm_label: "",
									gtm_extra_2: "",
									gtm_extra_3: "",
									tipo_producto: "",
									categoria_producto: "",
									producto_id: "",
									equipo: "",
									marca: "",
									producto_precio: "",
									equipo_cantidad: "1",
									form_intencion: "",
									zona: "",
									tipo_zona: "",
									sub_zona: "",
									seccion: "",
									sub_seccion: "",
									componente: "bannerFormularioEstatico",
									cta: "",
									ruc: "20202020202",
									celular: inputPhoneEstatico_11.value,
									term_tyc: "on",
									term_publicidad: checkValueEstatico_11
								};
								
								// Obtener gclid si existe
								const gclidEstatico = getUrlParam('gclid');
								if (gclidEstatico) {
									leadData.gclid = gclidEstatico;
								}
								
								// Actualizar UTMs en leadData
								function updateLeadDataWithUTMsEstatico(leadData) {
									const urlUTMs = getUTMsFromURLEstatico();
									const storedUTMs = getUTMsFromLocalStorageEstatico();
									const finalUTMs = { ...storedUTMs, ...urlUTMs };
									const utmFields = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "gclid"];
									utmFields.forEach((field) => {
										if (finalUTMs[field]) {
											leadData[field] = finalUTMs[field];
										}
									});
									return leadData;
								}
								
								const updatedLeadData = updateLeadDataWithUTMsEstatico(leadData);
								
								// Enviar al API
								const tokenApiSmarleadEstatico = await getAndUseToken();
								axios.post(ENDPOINT, leadData, {
									headers: {
										'Authorization': `Bearer ${tokenApiSmarleadEstatico}`,
										'Origin': 'https://www.entel.pe/',
										'Content-Type': 'application/json'
									}
								}).then(response => {
									// Mostrar modal de éxito
									const modal = document.querySelector("#modal");
									const toggle = modal.funcs.toggleModal;
									toggle();
									
									// Tagging de éxito
									dataLayer.push({
										'event': "generate_lead",
										'event_label': "carga",
										'event_category': "ecommerce - c2c - conversion",
										'event_action': "info",
										'origin': codOrigenEstatico_11,
										'market': "pe",
										'segment': "po",
										'section': 'banner principal',
										'lead_source': 'home - banner',
										'currency': 'undefined',
										'value': 'undefined',
										'product_name': "undefined",
										'product_id': "undefined",
										'product_category': "undefined",
										'product_price': "undefined",
										'product_subprice': "undefined",
										'phone_client': btoa(inputPhoneEstatico_11.value),
										'page_category': "landing-comercial",
										'page_technology': "cms",
										'page_owner': "movil",
										'social_media_id': response.data.id,
										'status': "exito",
										'ecommerce': taggingObject
									});
									
									// Limpiar formulario
									buttonEnviarEstatico_11.setAttribute('eds-text', "Lo quiero");
									buttonEnviarEstatico_11.setAttribute('eds-disabled', true);
									inputPhoneEstatico_11.value = "";
									valuePhoneEstatico_11 = null;
									
									if (checkBoxBannerEstatico_11) {
										checkBoxBannerEstatico_11.setAttribute("eds-checked", false);
										checkBoxBannerEstatico_11.removeAttribute("eds-checked");
									}
									checkValueEstatico_11 = 'off';
									
									inputPhoneEstatico_11.removeAttribute('eds-success');
									inputPhoneEstatico_11.removeAttribute('eds-error');
									inputPhoneEstatico_11.removeAttribute('eds-error-message');
									inputPhoneEstatico_11.setAttribute('eds-value', '9');
									
									formValidoEstatico_11 = false;
									
								}).catch(error => {
									console.error("Error al enviar formulario:", error);
									
									buttonEnviarEstatico_11.setAttribute('eds-text', "Lo quiero");
									buttonEnviarEstatico_11.setAttribute('eds-disabled', true);
									
									// Tagging de error
									dataLayer.push({
										'event': "load",
										'event_label': "carga",
										'event_category': "ecommerce - c2c - error",
										'event_action': "info",
										'origin': codOrigenEstatico_11,
										'market': "pe",
										'segment': "po",
										'section': 'banner principal',
										'phone_client': btoa(inputPhoneEstatico_11.value),
										'page_category': "landing-comercial",
										'page_technology': "cms",
										'page_owner': "movil",
										'status': "error",
										'ecommerce': taggingObject
									});
									
									// Limpiar formulario
									inputPhoneEstatico_11.value = "";
									valuePhoneEstatico_11 = null;
									
									if (checkBoxBannerEstatico_11) {
										checkBoxBannerEstatico_11.setAttribute("eds-checked", false);
										checkBoxBannerEstatico_11.removeAttribute("eds-checked");
									}
									checkValueEstatico_11 = 'off';
									
									// Mostrar modal de error
									const modalError = document.createElement('andino-modal-passive');
									modalError.setAttribute('eds-id', 'modal-formulario-estatico');
									modalError.setAttribute('eds-columns', '{"xs":"12","sm":"12","md":"10","lg":"6","xl":"6","xxl":"4"}');
									
									const contentDiv = document.createElement('div');
									contentDiv.setAttribute('slot', 'content');
									contentDiv.classList.add('div-slot-content');
									contentDiv.innerHTML = `
										<div class="d-flex align-items-center flex-column">
											<andino-icons class="illustrations-xs-4" eds-name="alert-red" eds-type="ilustraciones"></andino-icons>
											<p class="body_2b-xs mt-2">Ocurrió un error al procesar la solicitud.</p>
											<p class="body_2b-xs">Por favor, inténtalo nuevamente. Si el problema persiste, intenta más tarde.</p>
										</div>
									`;
									modalError.appendChild(contentDiv);
									document.body.appendChild(modalError);
									modalError.setAttribute('eds-show', true);
								});
							} else {
								alert("Llene los campos del formulario");
							}
						} catch (error) {
							console.error("Error en el proceso:", error);
						}
					});
				} else {
					console.warn("No se encontraron elementos para banner estático: banner-formulario-estatico-starlink-abril-2026");
				}
			
		
			
		
			
		
		/*=====================================================
		  FIN - CÓDIGO PARA BANNERS ESTÁTICOS
		=====================================================*/

  });

   document.addEventListener("DOMContentLoaded", function () {
    // Detectar si es una versión móvil
    if (window.innerWidth <= 768) { // Puedes ajustar este ancho según tu necesidad
      const banner = document.getElementById("contenedorBanner");
      if (banner && banner.classList.contains("container-lg")) {
        banner.classList.remove("container-lg");
