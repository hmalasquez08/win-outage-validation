  <body>
    







<style>
.grecaptcha-badge
	{
		display:none;
	}

</style>

<script src="https://www.google.com/recaptcha/enterprise.js?render=6LdydjgrAAAAAEpuSFFgKEb9evyr_NjrnE4GHloJ"></script>

<script>
	async function getAndUseToken() {
		return new Promise((resolve, reject) => {
			grecaptcha.enterprise.ready(async () => {
				try {
					const token = await grecaptcha.enterprise.execute('6LdydjgrAAAAAEpuSFFgKEb9evyr_NjrnE4GHloJ', { action: 'LOGIN' });
					resolve(token);
				} catch (error) {
					reject(error);
				}
			});
		});
	}
</script>





  
  
  
  
  
  <!-- Liquid Error -->
  
  
  
  
  
  
  
  
  
  

  <section
  class="container mb-5"
      data-plans-mobile-root
      data-smartlead-origin="C2C_Web_CarruselPlanes"
      
      
      
      data-tagging-market="pe"
      data-tagging-segment="po"
      data-tagging-section="cards planes moviles"
      
        data-tagging-event="load"
        data-tagging-category=""
        data-tagging-action="impressions"
        data-tagging-label="planes"
        data-tagging-level-1=""
        data-tagging-location=""
      
    >
      <div class="plans-skeleton" data-plans-skeleton aria-hidden="true">
        <div class="plans-skeleton-tabs">
          <span class="plans-skeleton-line plans-skeleton-tab"></span>
          <span class="plans-skeleton-line plans-skeleton-tab"></span>
        </div>
        <div class="plans-skeleton-header">
          <span class="plans-skeleton-line plans-skeleton-title"></span>
          <div class="plans-skeleton-chips">
            <span class="plans-skeleton-line"></span>
            <span class="plans-skeleton-line"></span>
            <span class="plans-skeleton-line"></span>
          </div>
        </div>
        <div class="plans-skeleton-cards">
          
            <div class="plans-skeleton-card">
              <span class="plans-skeleton-line skeleton-w-70"></span>
              <span class="plans-skeleton-line skeleton-w-45"></span>
              <span class="plans-skeleton-line skeleton-price"></span>
              <span class="plans-skeleton-line skeleton-w-85"></span>
              <span class="plans-skeleton-line skeleton-w-75"></span>
              <span class="plans-skeleton-line skeleton-w-90"></span>
              <span class="plans-skeleton-line skeleton-button"></span>
            </div>
          
            <div class="plans-skeleton-card">
              <span class="plans-skeleton-line skeleton-w-70"></span>
              <span class="plans-skeleton-line skeleton-w-45"></span>
              <span class="plans-skeleton-line skeleton-price"></span>
              <span class="plans-skeleton-line skeleton-w-85"></span>
              <span class="plans-skeleton-line skeleton-w-75"></span>
              <span class="plans-skeleton-line skeleton-w-90"></span>
              <span class="plans-skeleton-line skeleton-button"></span>
            </div>
          
            <div class="plans-skeleton-card">
              <span class="plans-skeleton-line skeleton-w-70"></span>
              <span class="plans-skeleton-line skeleton-w-45"></span>
              <span class="plans-skeleton-line skeleton-price"></span>
              <span class="plans-skeleton-line skeleton-w-85"></span>
              <span class="plans-skeleton-line skeleton-w-75"></span>
              <span class="plans-skeleton-line skeleton-w-90"></span>
              <span class="plans-skeleton-line skeleton-button"></span>
            </div>
          
            <div class="plans-skeleton-card">
              <span class="plans-skeleton-line skeleton-w-70"></span>
              <span class="plans-skeleton-line skeleton-w-45"></span>
              <span class="plans-skeleton-line skeleton-price"></span>
              <span class="plans-skeleton-line skeleton-w-85"></span>
              <span class="plans-skeleton-line skeleton-w-75"></span>
              <span class="plans-skeleton-line skeleton-w-90"></span>
              <span class="plans-skeleton-line skeleton-button"></span>
            </div>
          
        </div>
      </div>
      <div class="plans-content plans-content-loading" data-plans-content>
      
        <ads-tabs eds-variant="primary" role="tablist">
          
            
            
            
            
            <ads-tab-btn
              id="tab-quiero-ser-cliente-home"
              slot="tab-item"
              eds-variant="primary"
              eds-content-variant="full"
              data-tab-id="tab-quiero-ser-cliente-home"
              eds-data='{"market":"pe","segment":"po","section":"cards planes moviles","title":"quiero ser cliente","action":"interaction","element":"tab","label":"quiero ser cliente","tab":"quiero ser cliente","active":"true"}'
              eds-selected
            >
              <ads-icon slot="icon" eds-name="usuarios" class="icon-3" eds-raw=""></ads-icon>
              <ads-text
                slot="text"
                eds-text="Quiero ser cliente"
                eds-font-class="interface-bold-body-2"
              ></ads-text>
              
            </ads-tab-btn>
          
            
            
            
            
            <ads-tab-btn
              id="tab-soy-cliente-entel-home"
              slot="tab-item"
              eds-variant="primary"
              eds-content-variant="full"
              data-tab-id="tab-soy-cliente-entel-home"
              eds-data='{"market":"pe","segment":"po","section":"cards planes moviles","title":"soy cliente entel","action":"interaction","element":"tab","label":"soy cliente entel","tab":"soy cliente entel","active":"true"}'
              
            >
              <ads-icon slot="icon" eds-name="mi-perfil" class="icon-3" eds-raw=""></ads-icon>
              <ads-text
                slot="text"
                eds-text="Soy cliente Entel"
                eds-font-class="interface-regular-body-2"
              ></ads-text>
              
            </ads-tab-btn>
          
        </ads-tabs>
      

      <header class="plans-header">
        
          <h3 class="plans-title interface-regular-subtitle-1">
            ¿Cuántos planes <strong class="interface-bold-subtitle-1">deseas adquirir</strong>?
          </h3>
        

        <div class="plans-chips" aria-label="Planes móviles">
          
            
            <ads-chips
              data-chip-id="plans-1"
              data-chip-index="0"
              data-chip-multiplier="1"
