<script type="module">
	

window.addEventListener('load', function() {
	const tabs = document.querySelector("#tabs-card-general-controlador-card-general-contactanos-y-te-atenderemos-home");
	const panels = {
		'btn_tab_1controlador-card-general-contactanos-y-te-atenderemos-home': document.querySelector("#content_tab_consultas_y_solicitudes"),
		'btn_tab_2controlador-card-general-contactanos-y-te-atenderemos-home': document.querySelector("#content_tab_productos_y_servicios"),
		'btn_tab_3controlador-card-general-contactanos-y-te-atenderemos-home': document.querySelector("#content_tab_roaming"),
		'btn_tab_4controlador-card-general-contactanos-y-te-atenderemos-home': document.querySelector("#content_tab_bloqueo_por_robo"),
		'btn_tab_5controlador-card-general-contactanos-y-te-atenderemos-home': document.querySelector("#content_tab_tiendas"),
	};

	const showPanel = (id) => {
		Object.values(panels).forEach((panel) => {
			panel?.classList.add("d-none");
			panel?.classList.remove("d-flex");
		});
		panels[id]?.classList.add("d-flex");
		panels[id]?.classList.remove("d-none");
	};

	tabs?.addEventListener("ads-tab:change", (ev) => {
		const btnId = ev.detail.selected.id;
		showPanel(btnId);
	});
});


</script>


