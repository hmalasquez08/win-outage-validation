							titleModal:"Contratar con un asesor",
							textCardSm:"Planes móviles",
						}
					});

				
			
				
				
				
				

				const elementCardSmallTagging2 = document.getElementById("card-small-whatsapp-fab-ads");

				

				elementCardSmallTagging2?.addEventListener("click", function () {
					
					pushDataLayerNormalized({
