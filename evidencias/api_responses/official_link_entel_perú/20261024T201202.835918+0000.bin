    }
  });
  // datalayer tagging Ecommerce ---------------------------------------------------

  window.onload = function() {
    
      let bannerBtn = document.querySelectorAll('.eds-button').shadowRoot.querySelector('.no-button');
    

     bannerBtn?.addEventListener("click", function() {
