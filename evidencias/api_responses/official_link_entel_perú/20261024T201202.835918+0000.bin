							 // Función para obtener los parámetros UTM de una URL
							 function getUTMsFromURL() {
								 const params = new URLSearchParams(window.location.search);
								 const utms = {};
								 for (const [key, value] of params.entries()) {
									 if (key.startsWith('utm_')) {
										 utms[key] = value;
									 }
								 }
								 return utms;
							 }

							 // Función para guardar UTM en localStorage
							 function saveUTMsToLocalStorage(utms) {
								 if (Object.keys(utms).length > 0) {
									 localStorage.setItem('utm_params', JSON.stringify(utms));
								 }
							 }

							 // Función para obtener UTM de localStorage
							 function getUTMsFromLocalStorage() {
								 const storedUTMs = localStorage.getItem('utm_params');
								 return storedUTMs ? JSON.parse(storedUTMs) : {};
							 }

							 // Función principal
							 function handleUTMs() {
								 // Obtener los UTM de la URL actual
								 const urlUTMs = getUTMsFromURL();

								 // Guardar en localStorage si hay UTM en la URL
								 if (Object.keys(urlUTMs).length > 0) {
									 saveUTMsToLocalStorage(urlUTMs);
								 }

								 // Obtener los UTM del localStorage (si existen)
								 const storedUTMs = getUTMsFromLocalStorage();

								 // Usar los UTM almacenados si no hay en la URL actual
								 const finalUTMs = Object.keys(urlUTMs).length > 0 ? urlUTMs : storedUTMs;

								 // Aquí puedes usar los UTM finales para cualquier propósito adicional
								 return finalUTMs;
							 }

							 // Ejecutar la función
							 const utms = handleUTMs();
							 //const dataIp = await axios.get('https://api.ipify.org/?format=json');  

