	}
</style>



<script type="module">
	(() => {
		const tabs = document.querySelector("#tabs-carrusel-terminales-seccion-carrusel-terminales-home");
		if (!tabs) return;

		const panels = document.querySelectorAll('[data-tab-group="tabs-carrusel-terminales-seccion-carrusel-terminales-home"]');
		if (!panels.length) return;

		const link = document.querySelector("#tabs-carrusel-terminales-seccion-carrusel-terminales-home-link");
		const anchorMobile = document.querySelector(".tabs-carrusel-terminales-anchor-mobile");
		const links = { "tabs-carrusel-terminales-seccion-carrusel-terminales-home-carrusel-celulares-home":{"href":"https://miportal.entel.pe/personas/catalogo/postpago/renovacion?_ga=2.190281384.2010246391.1734348240-966499574.1727879111","text":"Mostrar más celulares"},"tabs-carrusel-terminales-seccion-carrusel-terminales-home-carrusel-accesorios-home":{"href":"https://miportal.entel.pe/personas/catalogo/accesorios?_ga=2.123117448.2010246391.1734348240-966499574.1727879111","text":"Mostrar más accesorios"} };

		const parseData = (el) => {
			if (!el) return null;
			try {
				return JSON.parse(el.getAttribute("eds-data") || "");
			} catch {
				return null;
			}
		};

		const linkData = parseData(link);
		const anchorMobileData = parseData(anchorMobile);

		const syncData = (el, base, label) => {
			if (!el || !base) return;
			el.setAttribute("eds-data", JSON.stringify({ ...base, label: label }));
		};

		const showPanel = (id) => {
			if (!id) return;

			panels.forEach((panel) => {
				const isActive = panel.dataset.tabPanel === id;
				panel.classList.toggle("d-none", !isActive);
				panel.classList.toggle("d-block", isActive);

				if (isActive) {
					const swiper = panel.querySelector("swiper-container");
					if (swiper?.swiper) swiper.swiper.update();
				}
			});

			const data = links[id];
			if (!data) return;

			if (link) {
				link.setAttribute("eds-href", data.href);
				link.setAttribute("eds-text", data.text);
				syncData(link, linkData, data.text);
			}

			if (anchorMobile) {
				anchorMobile.setAttribute("eds-href", data.href);
				anchorMobile.setAttribute("eds-aria-label", data.text);
				const anchorText = anchorMobile.querySelector(".tabs-carrusel-terminales-anchor-text");
				if (anchorText) anchorText.textContent = data.text;
				syncData(anchorMobile, anchorMobileData, data.text);
			}
		};

		tabs.addEventListener("ads-tab:change", (ev) => {
			showPanel(ev.detail?.selected?.id);
		});
	})();
</script>




