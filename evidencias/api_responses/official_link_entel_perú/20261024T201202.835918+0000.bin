window.onload = function() {
	const target = document.getElementById("seccion-destacado-doble");
	let hasBeenTriggered = false;

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting && !hasBeenTriggered) {
				hasBeenTriggered = true; // Evitar que se ejecute nuevamente
				setTimeout(function() {
					dataLayer.push({
						event: "view_promotion",
						ecommerce: {
							items: [
								{
									item_id: "",
									item_name: "",
									creative_name: "",
									creative_slot: "",
									promotion_id: "",
									promotion_name: ""
								}
							]
						}
					});
					dataLayer.push({
						event: "view_promotion",
						ecommerce: {
							items: [
								{
									item_id: "",
									item_name: "",
									creative_name: "",
									creative_slot: "",
									promotion_id: "",
									promotion_name: ""
								}
							]
						}
					});
				}, 20);

				// Dejar de observar después de la primera vez
				observer.unobserve(target);
			}
		});
	});
	observer.observe(target);

	
	 	let btnPrimerBanner = document.querySelector('.').shadowRoot.getElementById('').shadowRoot.getElementById('');
	 
	 
	btnPrimerBanner?.addEventListener("click", function() {
		dataLayer.push({
			event: "select_promotion",
			ecommerce: {
				items: [
					{
						item_id: "",
						item_name: "",
						creative_name: "",
						creative_slot: "",
						promotion_id: "",
						promotion_name: ""
					}
				]
			}
		});
	});

	
	 	let btnSegundoBanner = document.querySelector('.').shadowRoot.getElementById('').shadowRoot.getElementById('');
	 

	 btnSegundoBanner?.addEventListener("click", function() {
		 dataLayer.push({
			 event: "select_promotion",
			 ecommerce: {
				 items: [
					 {
						 item_id: "",
						 item_name: "",
						 creative_name: "",
						 creative_slot: "",
						 promotion_id: "",
						 promotion_name: ""
					 }
				 ]
			 }
		 });
	 });
};

	</script>






