<script>
	async function getDataTokenParticipa() {
		return new Promise((resolve, reject) => {
			grecaptcha.enterprise.ready(async () => {
				try {
					const token = await grecaptcha.enterprise.execute('6Ley0VUrAAAAACIlF5tuzxaNsmGB7WDUTYLST9PM', { action: 'LOGIN' });
					resolve(token);
				} catch (error) {
					reject(error);
				}
			});
		});
	}
</script>


