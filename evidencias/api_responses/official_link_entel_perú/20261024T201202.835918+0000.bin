    }
    .sk-subtitle {
      width: 90%;
    }
    .banner-complementario-skeleton__footer {
      width: 100%;
    }
    .sk-button {
      width: 150px;
    }
    .sk-section-title {
      width: 70%;
    }
    .sk-section-subtitle {
      width: 85%;
    }
  }
