<script>
  /**
 * Skeleton Gate transversal
 * - Sirve para cualquier wrapper/root/skeleton
 * - Soporta WebComponents + shadowRoot
 * - Evita display:none, hace reveal + remove skeleton
 */
(function () {
  function createSkeletonGate(opts) {
    const cfg = Object.assign({
      wrapperId: '',
      rootId: '',
      skeletonId: '',
      minH: 20,
      minW: 20,
      rootLoadingClass: 'is-loading',
      rootRevealingClass: 'is-revealing',
      rootRevealedClass: 'is-revealed',
      skeletonHidingClass: 'is-hiding',
      debug: false,
      onReady: null,
			minShowTime: 400,
    }, opts || {});

    const log = (...a) => { if (cfg.debug) console.log('[skeletonGate]', ...a); };

    const wrapper = document.getElementById(cfg.wrapperId);
    const root = document.getElementById(cfg.rootId);
    const sk = document.getElementById(cfg.skeletonId);
    if (!wrapper || !root || !sk) {
      log('missing nodes', { wrapper: !!wrapper, root: !!root, sk: !!sk });
      return { destroy() {} };
    }

    let done = false;
		let startTime = Date.now();

    const raf = () => new Promise(r => requestAnimationFrame(r));
    const twoRaf = async () => { await raf(); await raf(); };

    const isWebComponent = (el) =>
      el && typeof el.tagName === 'string' && el.tagName.includes('-');

    function getPrimaryWC(container) {
      return Array.from(container.children).find(isWebComponent) || container.querySelector('*');
    }

    function shadowReady(el) {
      if (!el || !el.shadowRoot) return true;
      const sr = el.shadowRoot;
      return (sr.childNodes && sr.childNodes.length > 0) || (sr.textContent || '').trim().length > 0;
    }

    function hasLayout(el) {
      const r = el.getBoundingClientRect();
      return r.height > cfg.minH && r.width > cfg.minW;
    }

    function hasContent(el) {
      return !!el.firstElementChild || (el.textContent || '').trim().length > 0;
    }

    function syncWrapperHeight() {
      const h = root.offsetHeight;
      if (h > 0) wrapper.style.minHeight = h + 'px';
    }

    function removeSkeleton() {
      sk.setAttribute('aria-busy', 'false');
      sk.classList.add(cfg.skeletonHidingClass);
      sk.addEventListener('transitionend', (e) => {
        if (e.target === sk) sk.remove();
      }, { once: true });
    }

    function revealRoot() {
      root.setAttribute('aria-busy', 'false');
      root.classList.remove(cfg.rootLoadingClass);
      root.classList.add(cfg.rootRevealingClass);

      requestAnimationFrame(() => {
        root.classList.remove(cfg.rootRevealingClass);
        root.classList.add(cfg.rootRevealedClass);
      });
    }

    async function checkReady() {
      if (done) return;

      // 1) Debe haber algo adentro
      if (!hasContent(root)) return;

      // 2) Si hay WC, esperamos definición + paint + shadow listo
      const wc = getPrimaryWC(root);
      if (wc && isWebComponent(wc)) {
        try { await customElements.whenDefined(wc.localName); } catch (e) {}
        await twoRaf();
        if (!shadowReady(wc)) return;
      } else {
        await twoRaf();
      }

      // 3) Layout aplicado
      if (!hasLayout(root)) return;

      // 4) Sync altura wrapper
      syncWrapperHeight();
			
			const elapsed = Date.now() - startTime;
			if (elapsed < cfg.minShowTime) {
				return; // No revelamos aún, vuelvo a intentar después
			}

      done = true;
      observer.disconnect();
      revealRoot();
      removeSkeleton();

      if (typeof cfg.onReady === 'function') cfg.onReady({ wrapper, root, sk, wc });
    }

    const observer = new MutationObserver(() => { checkReady(); });
    observer.observe(root, { childList: true, subtree: true, attributes: true });

    // Primer check por si ya viene listo
    checkReady();

    // Si cargan imgs/recursos adentro
    root.addEventListener('load', () => {
      syncWrapperHeight();
      checkReady();
    }, true);

    // Resize sync
    const onResize = () => { if (!done) syncWrapperHeight(); };
    window.addEventListener('resize', onResize);

    return {
      destroy() {
        try { observer.disconnect(); } catch (e) {}
        window.removeEventListener('resize', onResize);
      }
    };
  }

  // Exponer global por si lo llamas desde varios snippets
  window.adsCreateSkeletonGate = createSkeletonGate;
})();

  window.adsCreateSkeletonGate({
    wrapperId: "ads-cards-ott-wrapper",
    rootId: "ads-cards-ott-content",
    skeletonId: "ads-cards-ott-skeleton",
    minH: 20,
    minW: 20,
    minShowTime: 0,
    debug: false
  });
</script>

