	let bannerViewInfo = [false ,false ,false ,false ,false ,false ,false ,false ,false ,false ,false ,false ,false ];//Aray para determinar si el slide se vio o no
	 
	const handleSlideChange = (e) => {
		e.autoplay.start();
		
			
				let inputPhone1 = '';

				
				

				inputPhone1 = document.querySelector("#input-banner-formulario-sorteo-portabilidad-octubre-2026-s25-ultra");
				if(inputPhone1) inputPhone1.blur(); // DESACTIVAMOS EL FOCUS PARA QUE SIGA EL AUTOSCROLL
			
		
			
		
			
		
			
		
			
		
			
		
			
		
			
		
			
		
			
		
			
		
			
		
			
		

		const bullets = e.pagination.el?.querySelectorAll(".swiper-pagination-bullet");
		if(bullets){
			const arrowNext = e.navigation.nextEl;
			const arrowPrev = e.navigation.prevEl;

			bullets.forEach(bullet => {
				const activeSlide = e.slides[e.activeIndex];
				let arrowsColors = activeSlide.classList.contains('white') ? 'dark-mode-n' : 
				activeSlide.classList.contains('blue') ? 'arrows-blue' :
				activeSlide.classList.contains('black') ? 'arrows-black' : '';

				if(activeSlide.classList.contains('dark-mode')){
					arrowNext.setAttribute("part", `button-next ${arrowsColors}`);
					arrowPrev.setAttribute("part", `button-prev ${arrowsColors}`);
					bullet.setAttribute("part", `bullet-active dark-mode-n`);
				}else{
					arrowNext.setAttribute("part", `button-next ${arrowsColors}`) ;
					arrowPrev.setAttribute("part", `button-prev ${arrowsColors}`) ;
					bullet.setAttribute("part", `default-color`);
				}
			});
		};

		const index = e.realIndex;
		
		
		if(!bannerViewInfo[index]){

			const items = infoBannersTagging?.[index] || [];
			const ecommerceExtra = infoBannersTaggingecommerceExtra[index] || {};
			const dataPush = {
				event: "view_promotion",
				ecommerce: {
					items: items.map(item => ({
						item_id: item.item_id || "",
						item_name: item.item_name || "",
						creative_name: item.creative_name || "",
						creative_slot: item.creative_slot || "",
						promotion_id: item.promotion_id || "",
						promotion_name: item.promotion_name || ""
					}))
				},
				segment: ecommerceExtra.segment,
				market: ecommerceExtra.market,
				page_owner: ecommerceExtra.page_owner,
				description: ecommerceExtra.description,
				position: ecommerceExtra.position,
				section: ecommerceExtra.section
			};
			dataLayer.push(dataPush);
			bannerViewInfo[index] = true;
		}
	};
		 

	 
