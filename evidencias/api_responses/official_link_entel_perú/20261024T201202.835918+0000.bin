  <style nonce="UCnyNFJSX4">
		


#contenedorBanner {
  min-height: 488px;
}

#contenedorBanner.container-lg{
    padding-right: 0;
    padding-left: 0;
}

/* Cuando el banner tiene Dark Mode activo */
.dark-mode .slot-text-politica-terminos{
  color: white !important;
}
.dark-mode .slot-text-politica-terminos a {
  color: white !important;
}

/* Cuando el banner NO tiene Dark Mode activo */
.black .slot-text-politica-terminos{
  color: black !important;
}
.black .slot-text-politica-terminos a {
  color: black !important;
}


@media (min-width: 768px) {
	#contenedorBanner.container-lg{
		padding-right: calc(var(--bs-gutter-x) * .5);
    padding-left: calc(var(--bs-gutter-x) * .5);
	}
}
@media (min-width: 992px) {
	#contenedorBanner.container-lg{
				padding-right: 0px ;
				padding-left: 0px;
	}
}

@media (max-width: 767px) {
  andino-banner-hero-form {
    height: 33rem !important;
    min-height: auto !important;
  }
}

@media (max-width: 767px) {
	andino-banner-hero-form andino-image{
		height:33rem;
	}
}


.skeleton-banner {
  height: 488px;
	margin-bottom:28px;
  margin-top:10px;
  background: linear-gradient(90deg, #e0e0e0 25%, #f5f5f5 50%, #e0e0e0 75%);
  background-size: 200% 100%;
	animation: loading 1.5s infinite;
  border-radius: 8px;
}

@media (min-width: 768px) {
	.skeleton-banner {
		height: 450px;
	}
}

@keyframes loading {
  from {
    background-position: 200% 0;
  }
  to {
    background-position: -200% 0;
  }
}

.overflow-hidden
{
	overflow: hidden;
}


#contenedorBanner swiper-container {
  &::part(container) {
    padding-top: 0;
    padding-bottom: 0;
  }
  &::part(pagination) {
    margin-bottom: 0;
    bottom: 1rem;
    position: absolute;
		
		&.swiper-pagination-bullet-active{
			width:32px;
		}
  }

  &::part(dark-mode) {
    background: clr(neutral, neutral-600);
  }
  &::part(dark-mode-active) {
    background: clr(neutral, white);
  }

  &::part(bullets-white) {
    background: clr(neutral, white);
  }

  &::part(button-next),
  &::part(button-prev) {
    display: none;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    @media (min-width: 768px) {
      display: block;
    }
  }

  &::part(button-next) {
    background-image: url(https://entel.cdn.modyo.com/libraries/recursos/src/icon-lit/transversales/flechas-right.svg);
    filter: brightness(0) saturate(100%) invert(0%) sepia(14%) saturate(1670%)
      hue-rotate(29deg) brightness(97%) contrast(91%);
		margin-right:10px;
  }

  &::part(button-prev) {
    background-image: url(https://entel.cdn.modyo.com/libraries/recursos/src/icon-lit/transversales/flechas-left.svg);
    filter: brightness(0) saturate(100%) invert(0%) sepia(14%) saturate(1670%)
      hue-rotate(29deg) brightness(97%) contrast(91%);
		margin-left:10px;

  }

  &::part(dark-mode-n) {
    filter: brightness(0) saturate(100%) invert(100%) sepia(99%) saturate(3%)
      hue-rotate(38deg) brightness(104%) contrast(100%);
  }
	
	
  &::part(arrows-white) {
    @include filter("white");
  }

  &::part(arrows-blue) {
    filter: unset;
  }

  &.container-md {
    padding-right: 0;
    padding-left: 0;
    @media (min-width: 768px) {
      padding-right: calc(var(--bs-gutter-x) * 0.5);
      padding-left: calc(var(--bs-gutter-x) * 0.5);
    }
  }
	
}	
	andino-banner-hero-form andino-image::part(andino-image) {
    width: 100%;
    height: 100%;
		object-fit:cover;
}

andino-checkbox::part(input) {
  background-color: white !important;
}

@media (min-width: 992px) {
    andino-modal-channels#modal::part(modal-content) {
        width: 696px;
    }
}


/*Estilos Banner Estatico*/
.andino-banner-hero-form {
  display: block;
  height: 528px;
	background-color:white;
	padding: 1.5rem 1.5rem 0 1.5rem;

}

.andino-banner-hero-form	andino-checkbox::part(andino-checkbox){
		width:1rem;
		height: 1rem;
		min-width:1rem;
		min-height:1rem;
		margin-top:4px;
}

@media screen and (max-width: 767px) {
    .banner_estático_home .col-12 {
        padding-right: 0;
        padding-left: 0;
    }
}

@media (min-width: 768px) {
    .andino-banner-hero-form {
        justify-content: flex-start;
        flex-direction: row;
        align-items: stretch;
        padding-top: 0;
        gap: 2.5rem;
        border-radius: .75rem;
			  border:1px solid #d7d7d7;
        overflow: hidden;
        height: 28rem;
        padding: 1.5rem 3rem 0 3rem;
    }
	
	.andino-banner-hero-form .row .col-12 {
    padding-right: calc(var(1.5rem) * .5);
    padding-left: calc(var(1.5rem) * .5);
	}
}

@media (min-width: 992px) {
    .andino-banner-hero-form {
        padding: 1.5rem 5rem 0 5rem;
    }
}



@media (min-width: 768px) {
    .andino-banner-hero-form {
        height: 28rem;
    }
}

p.text-cambiate{
	
	font-size:18.56px;
