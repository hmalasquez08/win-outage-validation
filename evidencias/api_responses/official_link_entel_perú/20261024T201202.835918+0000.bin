<style>
	ads-modal-passive{
		position: relative;
		z-index: 3000;
	}
	
	@media (min-width: 992px) {
		.formModalContratacion ads-button.limitWidth,
		.formModalContratacion ads-link.limitWidth {
			margin: 0 auto;
			width: 260px;
		}
	}

	.formModalContratacion ads-button[eds-variant="link"],
	.formModalContratacion ads-link[eds-variant="link"] {
		margin: 0 auto;
		width: fit-content;
	}
	#navigationbar-assisted-channels ads-navigation-bar-item ads-icon {
		color: #0c0c0c !important;
	}

	#navigationbar-assisted-channels ads-navigation-bar-item ads-text {
		color: #0c0c0c !important;
	}
</style>

<script type="module">
	const normalizeDataLayerValue = (value) => {
		if (value === undefined || value === null) return value;

		if (typeof value !== "string") return value;

		return value
			.normalize("NFD") // separa letras de tildes
			.replace(/[\u0300-\u036f]/g, "") // elimina tildes
			.toLowerCase()
			.replace(/\*\*/g, "") // elimina dobles asteriscos
			.replace(/[^\w\s-]/g, "") // elimina símbolos extraños
			.replace(/\s+/g, " ") // limpia espacios repetidos
			.trim();
	};

	const normalizeDataLayerObject = (data = {}, options = {}) => {
		const { excludeKeys = [] } = options;

		return Object.entries(data).reduce((acc, [key, value]) => {
			if (excludeKeys.includes(key)) {
				acc[key] = value;
				return acc;
			}

			acc[key] = normalizeDataLayerValue(value);
			return acc;
		}, {});
	};

	const pushDataLayerNormalized = (data = {}, options = {}) => {
		window.dataLayer = window.dataLayer || [];

		const normalizedData = normalizeDataLayerObject(data, options);

		window.dataLayer.push(normalizedData);

		return normalizedData;
	};
	const ENDPOINT = window.location.hostname === "www.entel.pe"
		? "https://api-smartleads.en.tel/api/form"
		: "https://uat-api-smartleads.en.tel/api/form";

	const getFormattedDate = () => {
		const currentDate = new Date();

		return `${currentDate.getFullYear()}-${String(currentDate.getMonth() + 1).padStart(2, "0")}-${String(currentDate.getDate()).padStart(2, "0")} ${String(currentDate.getHours()).padStart(2, "0")}:${String(currentDate.getMinutes()).padStart(2, "0")}:${String(currentDate.getSeconds()).padStart(2, "0")}`;
	};

	const getUrlParam = (param) => {
		const urlParams = new URLSearchParams(window.location.search);
		return urlParams.get(param);
	};

	const baseLeadData = {
		nombres: "",
		consulta: "Ejecutivo de Venta",
		consulta_detalle: "[Home Soho - fab]",
		category_form: "",
		webservice: "si",
		plan_tipo_ruc: "20",
		url: "https://www.entel.pe/",
		mark_event: "",
		emailservice: "",
		email_recepcion: "",
		id_lead: "",
		valida_ruc: "si",
		valida_migra: "si",
		origen: "C2C_Banner",
		utm: "no pagado",
		nombre_formulario: "Home Soho - fab",
		campaign: "3490",
		gtm_category: "",
		gtm_action: "",
		gtm_label: "",
		gtm_extra_2: "",
		gtm_extra_3: "",
		tipo_producto: "",
		categoria_producto: "",
		producto_id: "",
		equipo: "",
		marca: "",
		producto_precio: "",
		equipo_cantidad: "1",
		form_intencion: "",
		zona: "",
		tipo_zona: "",
		sub_zona: "",
		seccion: "",
		sub_seccion: "",
		componente: "fab",
		cta: "",
		ruc: "20202020202",
		term_tyc: "on",
		term_publicidad: "off"
	};

	const gclid = getUrlParam("gclid");

	if (gclid) {
		baseLeadData.gclid = gclid;
	}

	const sendLeadData = async ({ data, phoneNumber }) => {
		const payload = {
			...data,
			ip: "0.0.0.0",
			celular: phoneNumber,
			telefono: phoneNumber,
			fechalead: getFormattedDate()
		};

		const tokenApiSmarlead = await getAndUseTokenFabTransversalLit();

		const response = await axios.post(ENDPOINT, payload, {
			headers: {
				Authorization: `Bearer ${tokenApiSmarlead}`,
				Origin: "https://www.entel.pe/",
				"Content-Type": "application/json"
			}
		});

		return response.data;
	};

	const isDirectToC2C = false;

	const setInputState = (input, { isValid, errorMessage = "", showError = true }) => {
		if (!input) return;

		if (isValid) {
			input.removeAttribute("eds-error");
			input.removeAttribute("eds-caption");
			input.setAttribute("eds-success", "");
			return;
		}

		input.removeAttribute("eds-success");

		if (showError) {
			input.setAttribute("eds-error", "");
			input.setAttribute("eds-caption", errorMessage);
		}
	};

	const resetInputPhone = (input, defaultCaption = "") => {
		if (!input) return;

		const shadowInput = input.shadowRoot?.querySelector("input");

		input.value = "";
		input.removeAttribute("value");
		input.removeAttribute("eds-value");
		input.removeAttribute("eds-error");
		input.removeAttribute("eds-success");

		if (defaultCaption) {
			input.setAttribute("eds-caption", defaultCaption);
		} else {
			input.removeAttribute("eds-caption");
		}

		if (shadowInput) {
			shadowInput.value = "";
			shadowInput.dispatchEvent(new Event("input", { bubbles: true, composed: true }));
			shadowInput.dispatchEvent(new Event("change", { bubbles: true, composed: true }));
		}

		input.dispatchEvent(new Event("input", { bubbles: true, composed: true }));
		input.dispatchEvent(new Event("change", { bubbles: true, composed: true }));
	};

	const resetButtonState = (button, originalText = "") => {
		if (!button) return;

		button.removeAttribute("eds-loading");
		button.toggleAttribute("eds-disabled", false);

		if (originalText) {
			button.setAttribute("eds-text", originalText);
		}
	};

	const getInputValue = (input) => {
		if (!input) return "";

		const shadowInput = input.shadowRoot?.querySelector("input");
		return String(input.value || shadowInput?.value || "").trim();
	};

	const isCheckboxChecked = (checkbox) => {
		if (!checkbox) return false;

		const shadowInput = checkbox.shadowRoot?.querySelector('input[type="checkbox"]');
		const adsCheck = checkbox?.querySelector('ads-checkbox');
		return Boolean(
			checkbox.checked ||
			checkbox.hasAttribute("checked") ||
			checkbox.hasAttribute("eds-checked") ||
			adsCheck.hasAttribute("eds-checked") ||
			shadowInput?.checked
		);
	};

	const validateInputPhone = ({
		input,
		maxLength,
		required = true,
		errorMessage = "Ingresa un número válido.",
	}) => {
		if (!input) return true;

		const value = getInputValue(input);
		const isValid = !required || value.length === Number(maxLength);

		if (isValid) {
			setInputState(input, {
				isValid,
			});
		}

		return isValid;
	};

	const validateFormModal = ({ inputPhone, config }) => {
		const phoneIsValid = validateInputPhone({
			input: inputPhone,
			maxLength: config.phoneMaxLength,
			required: config.phoneRequired,
			errorMessage: config.phoneErrorMessage,
		});

		return phoneIsValid;
	};
	
	const getStorageValue = (key, fallback = "") => {
		const value = localStorage.getItem(key);
		return value && value.length > 0 ? value : fallback;
	};

	const getLeadTaggingContext = () => {
		const storageSection = getStorageValue("storageSection", "topo");
		const storageTab = getStorageValue("storageTab", "");

		return {
			section: storageSection,
			tab: storageSection === "topo" ? "" : storageTab
		};
	};

	const pushGenerateLeadEvent = ({
		status,
		origin,
		phoneNumber,
		check,
		segment = "hh",
		socialMediaId = "",
		pageOwner = "home",
		textCard = "direct",
		title,
		description,
		errorId,
		errorName,
		apiName
	}) => {

		window.dataLayer = window.dataLayer || [];
		const eventCategory = status == "exito" ? `${textCard} - topo - conversion` : "error webservices";
		const section = status == "exito" ? "general" : "topo";
		const subSection = status == "exito" ? "topo" : "modal topo";
		const eventName = status == "exito" ? "generated_lead" : "load";
		
		pushDataLayerNormalized(
			{
				event: eventName,
				event_category: eventCategory,
				event_action: "info",
				event_label: "carga",
				section: section,
				sub_section: subSection,
				title,
				description,
				phone_client: btoa(String(phoneNumber)),
				status,
				privacity_check: `1:${check} / 2: false`,
				page_category: "landing-comercial",
				page_technology: "cms",
				page_owner: pageOwner,
				form_type: "c2c",
				journey_type: "solicitud",
				market: "pe",
				segment,
				...(status == "error" ? {
					error_id: errorId,
					error_name: errorName,
					api_name: apiName
				} : {})
			},
			{
				excludeKeys: ["phone_client", "privacity_check"]
			}
		);
	};
	
	const hasButtonClass = (button, className) => {
		return Boolean(button?.classList?.contains(className));
	};

	const goToWhatsAppLink = (linkWhatsApp) => {
		if (!linkWhatsApp || linkWhatsApp.length === 0) {
			console.warn("No se encontró linkWhatsApp en la configuración del modal.");
			return;
		}

		window.open(linkWhatsApp, "_blank", "noopener,noreferrer");
	};
	
	const safeParseJson = (value, fallback = {}) => {
		try {
			return value ? JSON.parse(value) : fallback;
		} catch (error) {
			console.warn("No se pudo parsear el eds-data del botón:", value);
			return fallback;
		}
	};

	const getEncodedPhoneClient = (phoneNumber) => {
		if (!phoneNumber || phoneNumber.length === 0) return undefined;

		return btoa(String(phoneNumber));
	};

	const updateButtonEdsData = (button, newData = {}) => {
		if (!button) return;

		const currentData = safeParseJson(button.getAttribute("eds-data"), {});

		const updatedData = {
			...currentData,
			...newData
		};

		button.setAttribute("eds-data", JSON.stringify(updatedData));
	};

	const updateSmartLeadButtonsPhoneClient = ({ buttons = [], inputPhone }) => {
		const phoneNumber = getInputValue(inputPhone);
		const phoneClient = getEncodedPhoneClient(phoneNumber);

		buttons.forEach((button) => {
			if (!hasButtonClass(button, "buttonSendSmartLead")) return;

			const currentData = safeParseJson(button.getAttribute("eds-data"), {});

			if (!phoneClient) {
				const { phone_client, ...dataWithoutPhoneClient } = currentData;
				button.setAttribute("eds-data", JSON.stringify(dataWithoutPhoneClient));
				return;
			}

			updateButtonEdsData(button, {
				phone: phoneClient
			});
		});
	};
	
	const updateSmartLeadButtonsPrivacityCheck = ({ buttons = [], inputCheckbox }) => {
		const check = isCheckboxChecked(inputCheckbox);
		
		buttons.forEach((button) => {
			if (!hasButtonClass(button, "buttonSendSmartLead")) return;

			const currentData = safeParseJson(button.getAttribute("eds-data"), {});
			updateButtonEdsData(button, {
				privacity_check: `1:${check} / 2: false`
			});
		});
	};

	const bindModalFormValidation = ({
		form,
		inputPhone,
		checkbox,
		buttons = [],
		modal,
		config
	}) => {
		const btnCloseModal = modal.shadowRoot?.querySelector('slot[name="button-close"]');
		let flagModalFab = true;
		
		// 2. Creamos el observer y definimos qué hacer cuando detecte un cambio
		const observer = new MutationObserver((mutationsList) => {
			for (const mutation of mutationsList) {
				if (mutation.type === 'attributes') {
					const nombreAtributo = mutation.attributeName;

					// Verificamos si el atributo ya no existe en el elemento
					if (!modal.hasAttribute(nombreAtributo)) {
						if(nombreAtributo == "eds-show" && flagModalFab){
							pushDataLayerNormalized({
								event: "interaction",
								event_action: "interaction",
								event_category: `${config.pageOwner || "home"} - topo`,
								event_label: "cerrar",
								section: "topo",
								sub_section: "modal topo",
								title: config.titleModal || "", // ej: te ayudamos a contratar o contrata internet para tu hogar
								page_category: "landing-comercial",
								page_technology: "cms",
								page_owner: config.pageOwner || "home", // dinámico
								form_type: "c2c",  
								market: "pe",
								segment: getLeadSegment(), // dinámico
							});
						}
						flagModalFab = true;
					}
				}
			}
		});

		// 3. Configuramos al observer para que vigile los atributos
		observer.observe(modal, { 
			attributes: true // Solo nos interesan los cambios en los atributos
		});
		
		if (!form) return;

		let isValidForm = false;

		const validate = () => {
			isValidForm = validateFormModal({
				inputPhone,
				config
			});

			updateSmartLeadButtonsPhoneClient({
				buttons,
				inputPhone
			});
			
			updateSmartLeadButtonsPrivacityCheck({
				buttons,
				inputCheckbox: checkbox
			});			
			return isValidForm;
		};

		inputPhone?.addEventListener("input", validate);
		inputPhone?.addEventListener("change", validate);

		checkbox?.addEventListener("click", validate);
		checkbox?.addEventListener("change", validate);

		const getLeadSegment = () => config.leadSegment || "hh";

		const getCodOrigen = () => {
			

			const leadSegment = getLeadSegment();

			if (leadSegment === "hh") {
				return "Hogar_C2C_General";
			}

			return config.codOrigen || "C2C_General";
		};

		const handleWhatsAppButton = () => {
			goToWhatsAppLink(config.linkWhatsApp);
		};

		const handleSmartLeadButton = async (button) => {
			const isValid = validate();

			setInputState(inputPhone, {
				isValid,
				errorMessage: config.phoneErrorMessage || "Ingrese un número válido"
			});

			if (!isValid) return;

			const phoneNumber = getInputValue(inputPhone);
			const check = isCheckboxChecked(checkbox);
			const originalButtonText = button.getAttribute("eds-text") || button.textContent?.trim() || "";

			const leadSegment = getLeadSegment();
			const codOrigen = getCodOrigen();

			try {
				button.setAttribute("eds-text", "Enviando...");
				button.setAttribute("eds-loading", "");
				button.toggleAttribute("eds-disabled", true);

				const leadData = {
					...baseLeadData,
					cod_origen: codOrigen,
					mercado: "Personas",
					segmento: "Alta",
					telefono: phoneNumber
				};

				const response = await sendLeadData({
					data: leadData,
					phoneNumber
				});

				console.log("Lead enviado correctamente:", response);

				pushGenerateLeadEvent({
					status: "exito",
					origin: codOrigen,
					phoneNumber,
					check:check,
					segment: leadSegment,
					socialMediaId: response?.id || "",
					pageOwner: config.pageOwner || "home",
					textCard:config.textCardSm || "direct",
					title:"muchas gracias",
					description: "recibimos correctamente tu informacion y te llamaremos lo mas pronto posible",
				});

				const modalSuccess = document.getElementById("modalSuccess");
				modalSuccess?.toggleAttribute("eds-show", true);
			} catch (error) {
				pushGenerateLeadEvent({
					status: "error",
					origin: codOrigen,
					phoneNumber,
					check:check,
					segment: leadSegment,
					socialMediaId: "",
					pageOwner: config.pageOwner || "home",
					textCard:config.textCardSm || "direct",
					title:"tenemos un problema",
					description: "No podemos procesar tu llamada en este momento. Inténtalo de nuevo en unos minutos o llámanos al 0800 - 09012.",
					errorId: error?.response?.status || "",
					errorName: error?.response?.data?.message || error?.message || "",
					apiName: ENDPOINT || "",
				});

				const modalError = document.getElementById("modalError");
				modalError?.toggleAttribute("eds-show", true);

				console.error("Error al enviar lead a Smartleads:", error);
			} finally {
				resetButtonState(button, originalButtonText);
				resetInputPhone(inputPhone, config.phoneDefaultCaption || "");

				modal?.toggleAttribute("eds-show", false);
				flagModalFab = false;
				
			}
		};

		buttons.forEach((button) => {
			button?.addEventListener("click", async function (event) {
				event.preventDefault();

				if (hasButtonClass(button, "btnWsp")) {
					handleWhatsAppButton();
					return;
				}

				if (hasButtonClass(button, "buttonSendSmartLead")) {
					await handleSmartLeadButton(button);
				}
			});
		});
	};
	
	/*  Aplicamos el z index para el elemento (esto debe ir por DS, por el momento lo hacemos con JS) y por css no tiene ::part*/
	const setNavigationBarZIndex = () => {
		const navigationBar = document.querySelector("ads-navigationbar-assisted-channels");
		if (!navigationBar) return;
		const shadow = navigationBar.shadowRoot;
		if (!shadow) return;
		const directAccess = shadow.querySelector(".ads-navigationbar-direct-access");
		if (!directAccess) return;
		directAccess.style.setProperty("z-index", "999", "important");
	};
  
		/*  Aplicamos estilos para que no se rompa el contenedor del assisted*/
	const setNavigationBarItemsFlex = (navigationBarAssistedChannels) => {
		const navigationItems = navigationBarAssistedChannels?.querySelectorAll("ads-navigation-bar-item");
		if (!navigationItems?.length) return;
		navigationItems.forEach((navigationItem) => {
			const item = navigationItem?.shadowRoot?.querySelector(".item");
			item?.style.setProperty("flex", "auto", "important");
		});
	};

	window.addEventListener("load", function () {
		setNavigationBarZIndex();
		let flagModalFab = true;
		const fab = document.getElementById("fab");
		const modal = document.getElementById("modalFab");
		const navigationBarAssistedChannels = document.getElementById("navigationbar-assisted-channels");
		setNavigationBarItemsFlex(navigationBarAssistedChannels);
		const openFabFlowModal = () => {

			pushDataLayerNormalized({
				event: "interaction",
				event_category: "home - topo", // ej: home - topo
				event_action: "interaction",
				event_label: "¿Quieres contratar?",
				section: "topo",
				location: "00",  
				title: "¿Quieres contratar?",
				form_type: "c2c",
				segment: "po", // dinámico  
				journey_type: "solicitud",    
				page_category: "landing-comercial",  
				page_technology: "cms",
				page_owner: "home", // dinámico
				market: "pe", // dinámico 
			});

			if (!isDirectToC2C) {
				modal?.toggleAttribute("eds-show", true);
				
				pushDataLayerNormalized({
					event: "load",
					event_category: "home - topo", // ej: home - topo
					event_action: "info",
					event_label: "carga",
					section: "topo",
					sub_section: "modal topo",  
					title: "**¿Qué quieres contratar?**",
					page_category: "landing-comercial",  
					page_technology: "cms",
					page_owner: "home", // dinámico
					form_type: "c2c",
					journey_type: "solicitud", 
					market: "pe", // dinámico 
					segment: "po", // dinámico  
				});

				return;
			}

			
		};

		fab?.addEventListener("click", openFabFlowModal);

		navigationBarAssistedChannels?.addEventListener("click", function (event) {
			const openModalItem = event.composedPath().find((element) => {
				return element?.dataset?.openModal === "true";
			});

			if (!openModalItem) return;

			openFabFlowModal();
		});
		
		

			
				
				
				
				

				const elementCardSmallTagging1 = document.getElementById("card-small-planes-moviles-ads");

				

				elementCardSmallTagging1?.addEventListener("click", function () {
					
					pushDataLayerNormalized({
						event: "click_to_action",
						event_category: "home - modal - btn", // ej: home - modal - btn
						event_action: "click_to_action",
						event_label: "Planes móviles", // dinámico - ej: planes moviles, contratar por whatsapp, etc
						section: "topo",
						sub_section: "modal topo",  
						title: "**¿Qué quieres contratar?**",
						page_category: "landing-comercial",  
						page_technology: "cms",
						page_owner: "home", // dinámico
						form_type: "c2c",
						journey_type: "solicitud", 
						market: "pe",
						segment: "po", // dinámico  
					});

				});

				
					
					
					

					const elementCardSmall1 = document.getElementById("card-small-planes-moviles-ads");
					const elementModalC2C1 = document.getElementById("modal-contratacion-movil-ads");

					elementCardSmall1?.addEventListener("click", function () {
