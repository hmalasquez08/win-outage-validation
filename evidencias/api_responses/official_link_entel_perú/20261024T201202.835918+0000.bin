							 // Función para actualizar los valores UTM en el objeto según los datos disponibles
							 function updateLeadDataWithUTMs(leadData) {
								 const urlUTMs = getUTMsFromURL(); // Obtener UTM de la URL
								 const storedUTMs = getUTMsFromLocalStorage(); // Obtener UTM de localStorage

								 // Combinar UTM de URL y localStorage, dando prioridad a los de la URL
								 const finalUTMs = { ...storedUTMs, ...urlUTMs };

								 // Campos UTM que deben actualizarse
								 const utmFields = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "gclid"];

