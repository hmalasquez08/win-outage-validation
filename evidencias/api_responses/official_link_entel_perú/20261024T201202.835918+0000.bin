							linkWhatsApp: "",
							titleModal:"Contrata Internet para tu Hogar",
							textCardSm:"Planes Hogar",
						}
					});

				
			

		
		
		/*IMPRESIONS TAGGING*/
		
		pushDataLayerNormalized({
			event: "load",
			event_category: "home", // dinámico - ej: home 
			event_action: "impressions",
			event_label: "topo",
			section: "topo",
			location: "00",  
			title: '¿Quieres contratar?',
			page_category: "landing-comercial",  
			page_technology: "cms",
			page_owner: "home", // dinámico - ej: movil
			market: "pe",
			segment: "po", // dinámico
		});

		 // 2. Creamos el observer y definimos qué hacer cuando detecte un cambio
		 if(modal){
			 const observer = new MutationObserver((mutationsList) => {
				 for (const mutation of mutationsList) {
					 if (mutation.type === 'attributes') {
						 const nombreAtributo = mutation.attributeName;

						 // Verificamos si el atributo ya no existe en el elemento
						 if (!modal.hasAttribute(nombreAtributo)) {
							 if(nombreAtributo == "eds-show" && flagModalFab){
								 pushDataLayerNormalized({
									 event: "interaction",
									 event_action: "interaction",
									 event_category: "home - c2c - topo - btn",
									 event_label: "cerrar",
									 section: "topo",
									 sub_section: "modal topo",
									 title: '¿Quieres contratar?',
									 page_category: "landing-comercial",
									 page_technology: "cms",
									 page_owner: "home", // dinámico - ej: movil
									 form_type: "c2c",  
									 market: "pe",
									 segment: "po", // dinámico
								 });
							 }
							 flagModalFab = true;
						 }
					 }
				 }
			 });

			 // 3. Configuramos al observer para que vigile los atributos
			 observer.observe(modal, { 
				 attributes: true // Solo nos interesan los cambios en los atributos
			 });
		 }

		 // MANTENER SIEMPRE ACTIVO EL FAB CUANDO VIENE EL ATRIBUTO EN EL CONTROLLER (POR ALGUN MOTIVO SE QUITA, REVISAR CON DS)
		 
			 if (!fab) return;
			 const observerFab = new MutationObserver(() => {
				 if (!fab.hasAttribute("eds-show")) {
					 fab.setAttribute("eds-show", "");
				 }
			 });
			 observerFab.observe(fab, {
				 attributes: true,
				 attributeFilter: ["eds-show"],
			 });
		 
	});
</script>
