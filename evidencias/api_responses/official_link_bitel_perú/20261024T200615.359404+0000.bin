}
formSlides[formTitle]?.css('display', 'block'); formSlides[formTitle]?.find('input').each(function(){ $(this).attr('disabled', false); });
const slider = $('#owl-carousel-slider20'); const currentIndex = me.item.index; const totalItems = me.item.count; const currentItem = slider.find('.owl-item').eq(currentIndex); const currentBannerForm = currentItem.find('.banner-form'); loadLazyObjects(slider); $(document).trigger('changeSlide', { slider, currentBannerForm: currentBannerForm || null });
},
