 .table-menu-top-base>.container .left-menu-top{ flex: 1 }
 .category-icon-type7.table-menu-top-base{ background-color: #fff; padding: 0 }
 .category-icon-type7 ul.category-icon-box-inner { gap: 20px; align-items: center; }
 .category-icon-type7 .c-menu a{ padding: 10px 20px; display: block; }
 .category-icon-type7 .polygon{ width: 11px; height: 7px; clip-path: polygon(50% 100%, 0 0, 100% 0); background: #5A6978; }
 .category-icon-type7 .c-menu li a{ background: #F3F5F8; border-radius: 20px; line-height: 1; color: var(--brand-primary); }
 .category-icon-type7 .c-menu li .category-title{ line-height: 1; }
 .category-icon-type7 .c-menu li a:hover, .category-icon-type7 .c-menu li.active a, .category-icon-type7 .c-menu li a:focus{ color: #F3F5F8; line-height: 1; background: var(--brand-primary); border-radius: 20px 20px 20px 0; /*padding: 12px 28.5px;*/
 padding: 10px 20px; font-family: 'Inter-Bold', sans-serif; }
 .category-icon-type7 .search-form>button{ position: absolute; inset: 0 0 0 auto; background: transparent; outline: none; }
 .category-icon-type7 .input-search{ padding-right: 45px; }
 .category-icon-type7 .form-search{ position: absolute; top: -5px; width: 380px; right: calc(100% + 10px); display: none; }
 .category-icon-type7 .image-icon{ max-width: 16px; }
 .category-icon-type7 .li-search>a>img ~ img{ display: none; }
 .category-icon-type7 .li-search.open>a>img:first-child{ display: none; }
 .category-icon-type7 .li-search.open>a>img ~ img{ display: inherit; }
 .category-icon-type7 ul.category-icon-box-inner > li.item-block:not(.user-greeting-item).active > a{ color: var(--brand-primary); font-family: 'Inter-Bold', sans-serif; }
 .category-icon-type7 ul.category-icon-box-inner > li.item-block:not(.user-greeting-item) > a { font-size: 14px; line-height: 140%; display: flex; justify-content: center; align-items: center; }
 .category-icon-type7 ul.category-icon-box-inner > li.item-block:not(.user-greeting-item) > a:hover, .category-icon-type7 ul.category-icon-box-inner > li.item-block:not(.user-greeting-item).active:hover > a { background-color: #f5f5f5; }
 /* Style cho Acceso Agentes khi chưa login */
 .category-icon-type7 ul.category-icon-box-inner li.agent-access-highlight { position: relative; }
 .category-icon-type7 ul.category-icon-box-inner li.agent-access-highlight a.agent-access-link { background: linear-gradient(135deg, var(--brand-primary) 0%, #0066cc 100%); color: #fff; border-radius: 12px; padding: 12px 16px; flex-direction: column; gap: 8px; min-height: 80px; justify-content: center; align-items: center; text-align: center; }
 .category-icon-type7 ul.category-icon-box-inner li.agent-access-highlight .agent-access-content { display: flex; flex-direction: column; gap: 6px; align-items: center; }
 .category-icon-type7 ul.category-icon-box-inner li.agent-access-highlight .category-title { font-weight: 600; font-size: 13px; line-height: 140%; color: #fff; }
 .category-icon-type7 ul.category-icon-box-inner li.agent-access-highlight .agent-access-badge { display: inline-block; background: rgba(255, 255, 255, 0.3); color: #fff; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600; }
 .category-icon-type7 ul.category-icon-box-inner li.agent-access-highlight a.agent-access-link:hover { background: linear-gradient(135deg, #005bbf 0%, #003d99 100%); box-shadow: 0 4px 12px rgba(0, 102, 204, 0.3); }
 .category-icon-type7 ul.category-icon-box-inner li.agent-access-highlight .img-icon { width: 32px; height: 32px; object-fit: contain; }
 .left-menu-top>ul{ display: flex; align-items: center; }
 .user-greeting-item { display: flex; align-items: center; }
 .user-greeting-section { display: flex; align-items: center; gap: 12px; }
 .user-avatar { width: 40px; height: 40px; border: 2.5px solid var(--brand-primary); border-radius: 12px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #fff; flex-shrink: 0; }
 .avatar-img, .avatar-default-img { object-fit: contain; width: 32px; height: 32px; margin-top: 6px; }
 .avatar-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
 .user-greeting-section { position: relative; display: flex; align-items: center; gap: 12px; cursor: pointer; }
 .user-dropdown-menu { position: absolute; top: calc(100% + 16px); right: 0; width: 222px; background: #fff; border-radius: 8px; padding: 20px 16px; box-shadow: 0 10px 30px rgba(0,0,0,.08); opacity: 0; visibility: hidden; transform: translateY(10px); transition: all .25s ease; z-index: 999; }
 .user-greeting-section.active .user-dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
 .user-dropdown-menu .dropdown-item .view-profile { font-size: 16px; color: #1A1A1A; }
 .user-dropdown-menu .dropdown-item .logout-button { font-size: 16px; color: #D70000; }
 .dropdown-item { display: flex; align-items: center; gap: 18px; font-size: 20px; font-weight: 500; color: #222; text-decoration: none; }
 .dropdown-item.logout { color: #ff0000; }
 .dropdown-icon { width: 18px; height: 18px; object-fit: contain; }
 .dropdown-divider { height: 1px; background: #D9E0E7; margin: 13px 0; }
 .greeting-dropdown-toggle i { transition: opacity .18s ease, transform .18s ease; display: inline-block; }
 .greeting-dropdown-toggle i.icon-hide { opacity: 0; transform: translateY(-2px); }
 .greeting-dropdown-toggle i.icon-show { opacity: 1; transform: translateY(0); }
 @media(min-width: 1199px){ .c-language .dropdown-menu{ left: auto; right: 0; }
 }
 @media (min-width: 700px) and (max-width: 1023px) { .table-menu-top-base>.container { padding: 0 16px !important; }
