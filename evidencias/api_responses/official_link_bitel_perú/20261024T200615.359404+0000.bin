$('#owl-carousel-slider20 .item').show(); function adjustFullSizeItemsHeight() { const fullSizeItems = $('.bg-item-full-size.hide-newResType2-pc.full-width'); if (fullSizeItems.length === 0) return; let loaded = 0, total = fullSizeItems.length; fullSizeItems.each(function () { if (this.complete && this.naturalHeight !== 0) { checkAndApply(); } else {
$(this).one('load', checkAndApply); }
