else { this.src = src; }
$(this).removeAttr('data-lazy-src'); });
};
function fixOwlItemHeight() { const slider = $('#owl-carousel-slider20'); const items = slider.find('.owl-item:visible .item'); let maxHeight = 0; let images = slider.find('.owl-item:visible .bg-item-full-size.hide-newResType2-mobi'); if (images.length === 0) { images = slider.find('.owl-item:visible .bg-item-full-size.hide-newResType2-pc'); }
if (images.length === 0) { applyHeight(); return; }
let loaded = 0; images.each(function () { if (this.complete && this.naturalHeight !== 0) { check(); } else {
$(this).one('load error', check); }
});
function check() { loaded++; if (loaded === images.length) { applyHeight(); }
}
function applyHeight() { items.css('height', 'auto'); images.css('height', 'auto'); items.each(function () { const h = $(this).outerHeight(true); if (h > maxHeight) maxHeight = h; });
maxHeight = Math.round(slider.width() / 2.20); if ($(window).width() <= 1919 && $(window).width() > 1023) { maxHeight = Math.round(slider.width() / 2.24); }
if ($(window).width() <= 1023) { maxHeight = Math.round(slider.width() / 0.75); }
items.css('height', maxHeight); images.css('height', maxHeight); }
}
