                  </linearGradient>
                  </defs>
              </svg>
          </div>
          <div class="corte-guia_info">
              <div class="corte-guia__district">
                  <span class="corte-guia__district-name">Distrito</span>
                  <h2 class="corte-guia__district-title">CIENEGUILLA: Corte de Agua hoy</h2>
              </div>
          </div>
      </div>
      <div class="corte-guia__body">
          <div class="corte-guia__item">
              <div class="corte-guia__item-header">
                  <div class="corte-guia__item-icon">
                      <svg width="18" height="19" viewBox="0 0 18 19" fill="none">
                          <path d="M16 0.875H2C0.9 0.875 0 1.775 0 2.875V16.875C0 17.975 0.9 18.875 2 18.875H16C17.1 18.875 18 17.975 18 16.875V2.875C18 1.775 17.1 0.875 16 0.875ZM4 4.875H6V6.875H4V4.875ZM4 8.875H6V10.875H4V8.875ZM4 12.875H6V14.875H4V12.875ZM14 14.875H8V12.875H14V14.875ZM14 10.875H8V8.875H14V10.875ZM14 6.875H8V4.875H14V6.875Z" fill="#2057A0"/>
