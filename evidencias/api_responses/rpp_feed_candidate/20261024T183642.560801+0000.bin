                      <svg width="16" height="22" viewBox="0 0 16 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M8 0.875C11.31 0.875 14 3.535 14 6.825C14 11.285 8 17.875 8 17.875C8 17.875 2 11.285 2 6.825C2 3.535 4.69 0.875 8 0.875ZM8 4.875C7.46957 4.875 6.96086 5.08571 6.58579 5.46079C6.21071 5.83586 6 6.34457 6 6.875C6 7.40543 6.21071 7.91414 6.58579 8.28921C6.96086 8.66429 7.46957 8.875 8 8.875C8.53043 8.875 9.03914 8.66429 9.41421 8.28921C9.78929 7.91414 10 7.40543 10 6.875C10 6.34457 9.78929 5.83586 9.41421 5.46079C9.03914 5.08571 8.53043 4.875 8 4.875ZM16 17.875C16 20.085 12.42 21.875 8 21.875C3.58 21.875 0 20.085 0 17.875C0 16.585 1.22 15.435 3.11 14.705L3.75 15.615C2.67 16.065 2 16.685 2 17.375C2 18.755 4.69 19.875 8 19.875C11.31 19.875 14 18.755 14 17.375C14 16.685 13.33 16.065 12.25 15.615L12.89 14.705C14.78 15.435 16 16.585 16 17.875Z" fill="#2057A0"/>
