                  <div class="corte-guia__item-icon">
                      <svg width="20" height="23" viewBox="0 0 20 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 12.875H13.5V15.695L15.94 17.105L15.19 18.405L12 16.565V12.875ZM16 7.875H2V18.875H6.67C6.24 17.965 6 16.945 6 15.875C6 14.0185 6.7375 12.238 8.05025 10.9253C9.36301 9.6125 11.1435 8.875 13 8.875C14.07 8.875 15.09 9.115 16 9.545V7.875ZM2 20.875C0.89 20.875 0 19.975 0 18.875V4.875C0 3.765 0.89 2.875 2 2.875H3V0.875H5V2.875H13V0.875H15V2.875H16C16.5304 2.875 17.0391 3.08571 17.4142 3.46079C17.7893 3.83586 18 4.34457 18 4.875V10.975C19.24 12.235 20 13.965 20 15.875C20 17.7315 19.2625 19.512 17.9497 20.8247C16.637 22.1375 14.8565 22.875 13 22.875C11.09 22.875 9.36 22.115 8.1 20.875H2ZM13 11.025C11.7137 11.025 10.4801 11.536 9.57053 12.4455C8.66098 13.3551 8.15 14.5887 8.15 15.875C8.15 18.555 10.32 20.725 13 20.725C13.6369 20.725 14.2676 20.5996 14.856 20.3558C15.4444 20.1121 15.9791 19.7548 16.4295 19.3045C16.8798 18.8541 17.2371 18.3194 17.4808 17.731C17.7246 17.1426 17.85 16.5119 17.85 15.875C17.85 13.195 15.68 11.025 13 11.025Z" fill="#2057A0"/>
