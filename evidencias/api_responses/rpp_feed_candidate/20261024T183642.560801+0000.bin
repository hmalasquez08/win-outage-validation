          <article class="news news--summary news--invert news--ar1x1 news--size75x75 news--title-sm">
            <figure class="news__media">
              <div class="news__image">
                <a href="https://rpp.pe/futbol/ligas-internacionales/premier-league-liverpool-quiere-vencer-y-quitarle-la-racha-positiva-a-brighton-and-hove-noticia-1714231">
