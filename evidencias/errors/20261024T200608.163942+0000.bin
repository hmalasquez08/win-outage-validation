:"manual","thumbnailResizeUrl":"/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=300","version":0,"originalName":"857437502_1827106278609339_7131699257723361368_n.jpg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T15:06:11Z","last_updated_date":"2026-10-24T15:06:11Z","height":960,"image_type":"photograph","status":"","resized_urls":{"landscape_xl":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=980&height=528&quality=75&smart=true","landscape_ext_story":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=980&height=355&quality=75&smart=true","landscape_l":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=648&height=374&quality=75&smart=true","landscape_md":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=314&height=157&quality=75&smart=true","landscape_s":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=234&height=161&quality=75&smart=true","landscape_xs":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=118&height=72&quality=75&smart=true","landscape_xxs":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=170&height=90&quality=75&smart=true","portrait_xl":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=528&height=900&quality=75&smart=true","portrait_l":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=374&height=648&quality=75&smart=true","portrait_md":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=314&height=374&quality=75&smart=true","portrait_s":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=161&height=220&quality=75&smart=true","portrait_xs":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=75&height=90&quality=75&smart=true","square_xl":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=900&height=900&quality=75&smart=true","square_l":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=600&height=600&quality=75&smart=true","square_md":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=300&height=300&quality=75&smart=true","square_s":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=150&height=150&quality=75&smart=true","square_xs":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=75&height=75&quality=75&smart=true","small":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=100&height=200&quality=75&smart=true","medium":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=480&quality=75&smart=true","content":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=980&quality=75&smart=true","content_small":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=320&quality=75&smart=true","large":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=940&height=569&quality=75&smart=true","story_small":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=482&height=290&quality=75&smart=true","amp_new":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=1200&height=800&quality=75&smart=true","amp":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=900&height=600&quality=75&smart=true","impresa":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=617&height=637&quality=75&smart=true","impresa_s":"https://diariocorreo.pe/resizer/v2/6KVHTDVSRBAOZLCOWMPYFIA73Y.jpg?auth=c338fabfd633c5387fd08cdf93dd9232316118f5207c409a585e6770defaf2d8&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/edicion/ica/ica-intervienen-en-ocucaje-vehiculos-con-panetones-presuntamente-sustraidos-en-palpa-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"diariocorreo","revision":{"editions":["default"],"parent_id":"CI5EWTGP6JHWNPVXAOCYJITBNE","published":true,"branch":"default","revision_id":"CBM6JKBJKFCJNJL6QIZCB2LSKU"},"planning":{"story_length":{"character_count_actual":1827,"inch_count_actual":2,"word_count_actual":274,"line_count_actual":14}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T18:32:00Z","headlines":{"tablet":"","print":"","meta_title":"Ica: caen “Los dulces de la Navidad” con decenas de cajas de panetones robados","native":"","web":"","mobile":"","basic":"Ica: caen “Los dulces de la Navidad” con decenas de cajas de panetones robados"},"websites":{"diariocorreo":{"website_url":"/edicion/ica/ica-intervienen-en-ocucaje-vehiculos-con-panetones-presuntamente-sustraidos-en-palpa-noticia/","website_section":{"path":"/edicion/ica","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Ica","_id":"/edicion/ica","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Ica","_id":"/edicion/ica","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":85,"default":85,"test":85,"menu-pro":85}}},"_website_section_id":"diariocorreo./edicion/ica","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T13:29:27.247Z","publish_date":"2026-10-24T18:32:00Z","_id":"3M7YKQLHNVHV7MQEPTUOWE42CM","website":"diariocorreo","website_url":"/edicion/ica/ica-intervienen-en-ocucaje-vehiculos-con-panetones-presuntamente-sustraidos-en-palpa-noticia/"},{"content_elements":[{"_id":"YEC3V62Q4NG3ZDTRJQXTMU3CUY","additional_properties":{},"type":"text","content":"<a href=\"https://diariocorreo.pe/edicion/ica/ica-cuestionan-deterioro-de-infraestructura-de-la-ie-jose-gregorio-huaman-en-los-aquijes-noticia/\" target=\"_self\" rel=\"\" title=\"https://diariocorreo.pe/edicion/ica/ica-cuestionan-deterioro-de-infraestructura-de-la-ie-jose-gregorio-huaman-en-los-aquijes-noticia/\"><b>Vecinos del sector El Arenal, en el distrito de Los Aquijes,</b></a><b> denunciaron presuntas afectaciones por la colocación de un cerco perimétrico de una iglesia católica. Los moradores señalaron que la obra no estaría respetando las dimensiones establecidas en los planos municipales y advirtieron que la </b><a href=\"https://diariocorreo.pe/edicion/ica/ica-crece-malestar-por-obra-en-via-el-guayabo-la-tierra-prometida-que-estaria-suspendida-noticia/\" target=\"_self\" rel=\"\" title=\"https://diariocorreo.pe/edicion/ica/ica-crece-malestar-por-obra-en-via-el-guayabo-la-tierra-prometida-que-estaria-suspendida-noticia/\"><b>construcción estaría dificultando el acceso a sus viviendas. </b></a>"},{"level":2,"_id":"75LKOEBTQZBP7CFKQU3N5CGZ3Y","additional_properties":{},"type":"header","content":"<b>Acceso en riesgo</b>"},{"_id":"RJGNE3ACOFAJJD7JYCXDN6JHVQ","additional_properties":{},"type":"text","content":"Uno de los residentes aseguró que el pasaje 27, utilizado como acceso a dos viviendas ubicadas en la parte posterior, debería tener 3 metros de ancho; sin embargo, afirmó que el espacio se habría reducido a aproximadamente 2 metros tras la instalación del cerco. Asimismo, cuestionó la situación y pidió que se respeten las dimensiones que, según indicó, figuran en los planos. “Yo lo que le estoy diciendo es que respeten solamente lo que está en el plano, que respeten la ley. La ley dice tres metros”, expresó."},{"_id":"IXXI74N355C37NA3Z5QDFF6Z2A","additional_properties":{},"type":"text","content":"El vecino también sostuvo que los trabajos estarían limitando el ingreso de vehículos al pasaje y afirmó que, pese a que los moradores habían conversado con representantes de la iglesia, no se habría cumplido el compromiso de respetar las medidas. "},{"_id":"JTMRXUYWXBHJVGGDWUQY7PN7IE","additional_properties":{},"type":"text","content":"Otra moardor manifestó que los trabajos también habrían generado dificultades relacionadas con el sistema de desagüe. Según indicaron, inicialmente les habían señalado que el problema sería solucionado, pero hasta el momento de la entrevista continuaban esperando una respuesta. “Dijeron que sí, que iban a respetar [...] y hasta ahora no lo arreglan”, reclamó."},{"_id":"PV7TZLVMRFF6FPHLFC6EL7T3BY","additional_properties":{},"type":"text","content":"En otro pasaje, los moradores expresaron preocupación por la falta de una entrada adecuada hacia sus viviendas. Uno de ellos aclaró que no se oponen a que la iglesia delimite su propiedad, pero exigió que se garantice el acceso de los residentes. “Nosotros estamos de acuerdo que ellos cierren sus sitios, sus sitios de la iglesia, pero lo que queremos es que nos dejen nuestro pasaje para acá adentro”, manifestó."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"d7642f1179eb6a415f4688061cc2c85c0c7f001b183922f60d5e37714ff875f2"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/3TXJGJFBOZCMLOP4UE7ISTY7C4.jpg","licensable":false,"credits":{"affiliation":[]},"subtitle":"ICA","width":1800,"_id":"3TXJGJFBOZCMLOP4UE7ISTY7C4","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/3TXJGJFBOZCMLOP4UE7ISTY7C4.jpg?auth=d7642f1179eb6a415f4688061cc2c85c0c7f001b183922f60d5e37714ff875f2","proxyUrl":"/resizer/v2/3TXJGJFBOZCMLOP4UE7ISTY7C4.jpg?auth=d7642f1179eb6a415f4688061cc2c85c0c7f001b183922f60d5e37714ff875f2","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/3TXJGJFBOZCMLOP4UE7ISTY7C4.jpg","published":true,"resizeUrl":"/resizer/v2/3TXJGJFBOZCMLOP4UE7ISTY7C4.jpg?auth=d7642f1179eb6a415f4688061cc2c85c0c7f001b183922f60d5e37714ff875f2","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/3TXJGJFBOZCMLOP4UE7ISTY7C4.jpg?auth=d7642f1179eb6a415f4688061cc2c85c0c7f001b183922f60d5e37714ff875f2&width=300","version":0,"originalName":"vecinmosss56.jpg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T14:58:27Z","last_updated_date":"2026-10-24T14:58:27Z","height":1000,"image_type":"photograph","status":""},{"_id":"DR5VEUSXXZGPNF2ALTUX6BTZSE","additional_properties":{},"type":"text","content":"Los vecinos de este segundo sector advirtieron que entre los habitantes hay adultos mayores y niños pequeños, por lo que consideran necesario que el acceso permita el ingreso de vehículos ante cualquier emergencia. “No pasa la movilidad”, señaló uno de los moradores, al explicar las dificultades que presenta el callejón, donde también existen tuberías de agua potable y desagüe, además de postes de alumbrado público. "},{"_id":"2WR2QAIKQFF5HAGGOGEOI6OKHU","additional_properties":{},"type":"text","content":"Finalmente, los moradores solicitaron a la Municipalidad Distrital de Los Aquijes que verifique los planos, supervise la colocación del cerco perimétrico y determine si se están respetando las dimensiones correspondientes. También pidieron soluciones para el acceso a sus viviendas y el problema relacionado con el desagüe. "},{"_id":"2XVUHGF6IZB6FAWB2TUPVRYXYQ","additional_properties":{},"type":"text","content":"<b>📲 Únete al canal oficial de Diario Correo en WhatsApp y recibe en tu celular las noticias más importantes del Perú y el mundo, alertas de último minuto y las portadas del día, todo de forma rápida y confiable. No te quedes fuera de la información.</b>"},{"_id":"4WRCXZDZMFDH7NH243EW7JXRJQ","additional_properties":{},"type":"text","content":"<b>Súmate aquí: 👉 </b><a href=\"https://whatsapp.com/channel/0029Vb7TiRS9cDDcPrLTPY0z/\" rel=\"\" title=\"https://whatsapp.com/channel/0029Vb7TiRS9cDDcPrLTPY0z\"><b>https://whatsapp.com/channel/0029Vb7TiRS9cDDcPrLTPY0z</b></a>"},{"level":2,"_id":"LRJ5ZTAVIFDM7KUQ7PKNLV5XGU","additional_properties":{},"type":"header","content":"<b>VIDEO RECOMENDADO</b>"},{"_id":"3QBIJVSGWBH53OWB2R5LCKY5SU","type":"raw_html","content":"<iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/3u0hANhfT4E?si=6HaW92QatoGLlHki\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>"},{"_id":"TNVMKKROYNFPVJVQ22OQ7ZCVEE","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"Denuncian que el cerco de una iglesia reduciría el acceso a sus viviendas"},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/edicion/ica","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Ica","_id":"/edicion/ica","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Ica","_id":"/edicion/ica","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":85,"default":85,"test":85,"menu-pro":85}}},"_website_section_id":"diariocorreo./edicion/ica","type":"section","version":"0.6.0"},{"path":"/edicion","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Edición","_id":"/edicion","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","sitemap-default":"/","test":"/","search-filter-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Edición","_id":"/edicion","ancestors":{"sitemap-default":["/"],"search-filter-default":[]},"order":{"header-pro":75,"default":75,"sitemap-default":1002,"test":75,"menu-pro":75}}},"_website_section_id":"diariocorreo./edicion","type":"section","version":"0.6.0"}],"primary_section":{"path":"/edicion/ica","parent":{"default":"/edicion"},"_w