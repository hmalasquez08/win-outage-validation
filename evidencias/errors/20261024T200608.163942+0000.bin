_actual":16}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T19:18:00Z","headlines":{"tablet":"","print":"","meta_title":"Ica: crece demanda en compra de plásticos ante pronóstico de lluvias por el Fenómeno El Niño","native":"","web":"","mobile":"","basic":"Ica: crece demanda en compra de plásticos ante pronóstico de lluvias por el Fenómeno El Niño"},"websites":{"diariocorreo":{"website_url":"/edicion/ica/ica-crece-demanda-en-compra-de-plasticos-ante-pronostico-de-lluvias-por-el-fenomeno-el-nino-noticia/","website_section":{"path":"/edicion/ica","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Ica","_id":"/edicion/ica","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Ica","_id":"/edicion/ica","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":85,"default":85,"test":85,"menu-pro":85}}},"_website_section_id":"diariocorreo./edicion/ica","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T04:16:08.912Z","publish_date":"2026-10-24T19:18:00Z","_id":"6YMQIVPUVVEZ3K5AIQTHLCBLTU","website":"diariocorreo","website_url":"/edicion/ica/ica-crece-demanda-en-compra-de-plasticos-ante-pronostico-de-lluvias-por-el-fenomeno-el-nino-noticia/"},{"content_elements":[{"_id":"54G26OKUGJB35N6U7OFB5VZPHU","additional_properties":{},"type":"text","content":"El presidente de la Cámara de Senadores, <b>Miguel Torres</b>, dispuso que se tramite de inmediato una fe de erratas para corregir un error material en el encabezado de la Ley N.° 32743, luego de que su publicación generara controversia."},{"_id":"AHTOXKUTQBEYNF4U2AEWJI7QQ4","additional_properties":{},"type":"text","content":"Mediante un comunicado, Torres explicó que la norma relacionada con la delegación de facultades legislativas fue aprobada por ambas cámaras y remitida conforme a lo establecido en la Constitución y el Reglamento del Senado."},{"_id":"GHHVAD2VR5HMBAT5EADRMFIQOQ","additional_properties":{},"type":"text","content":"El titular de la Cámara de Senadores precisó que el error consistió en consignar la palabra “Senado” en lugar de “Congreso” en el encabezado del documento. Por ello, indicó que se gestionará la rectificación correspondiente."},{"_id":"65BMMS7IXZF6JCIGNUTUJHPOFY","additional_properties":{},"type":"text","content":"<i><b>“Corregir lo que corresponde también es un deber y una muestra de respeto a quienes representamos, a la transparencia y la institucionalidad”,</b></i> sostuvo Torres. "},{"level":2,"_id":"PBSWLGT63RGTJJXQRP7XSLQJZ4","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><b>Te puede interesar</b></mark>"},{"list_type":"unordered","_id":"UH5R3YYZ4FEDZPR75ZODUIWKOU","type":"list","items":[{"_id":"NAXVOMWY6JAI7FQ77N3XQQ7TKA","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/la-dini-tuvo-nueve-directores-en-seis-anos-noticia/\"><b>La DINI tuvo nueve directores en seis años</b></a>"},{"_id":"NJS23UKAQFBR5MDX6NIYXXLR3E","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/ley-sobre-facultades-enfrenta-a-las-camaras-noticia/\" rel=\"\"><b>Ley sobre facultades enfrenta a las cámaras</b></a>"},{"_id":"HK5WNIRTWBGMVFM2OJQ3DUFYKU","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/jorge-gavidia-nunca-me-senti-totalmente-consolidado-en-el-pbg-noticia/\" rel=\"\"><b>Jorge Gavidia: “Nunca me sentí totalmente consolidado” en el PBG</b></a>"},{"_id":"VHK7NN2JFZDEFNXIPHGA7D26E4","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/miguel-torres-defiende-legalidad-de-autografa-de-facultades-legislativas-enviada-al-ejecutivo-noticia/\" rel=\"\"><b>Miguel Torres defiende legalidad de autógrafa de facultades legislativas enviada al Ejecutivo</b></a>"},{"_id":"JLVFTKECL5BCHK3KPYPXLJ2KWE","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/roberto-sanchez-afrontara-juicio-oral-por-presuntas-irregularidades-en-aportes-a-juntos-por-el-peru-noticia/\" rel=\"\"><b>Roberto Sánchez afrontará juicio oral por presuntas irregularidades en aportes a Juntos por el Perú</b></a>"},{"_id":"ZB5G52XOU5CBJPRRK5UBB2RXKA","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/poder-judicial-rechaza-pedido-de-diputado-julian-perez-para-excluir-certificado-medico-de-su-expareja-noticia/\" rel=\"\"><b>PJ rechaza pedido de diputado Julián Pérez para excluir certificado médico de su expareja</b></a>"}]}],"subheadlines":{"basic":"El presidente de la Cámara de Senadores informó que se corregirá la palabra “Senado” por “Congreso” en el documento referido a la delegación de facultades legislativas."},"description":{"basic":"El presidente de la Cámara de Senadores, Miguel Torres, dispuso que se tramite de inmediato una fe de erratas para corregir un error material en el encabezado de la Ley N.° 32743, luego de que su publicación generara controversia."},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/politica","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Política","_id":"/politica","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","search-filter-default":null,"menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Política","_id":"/politica","ancestors":{"navbar-def