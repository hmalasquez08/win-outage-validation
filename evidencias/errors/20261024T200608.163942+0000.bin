XNA2JDNVAI3ITPJNCQ.jpg?auth=bcb2aa4b06cc40a00c40b2572a033ddfbe8a4ec4c5f518e65d1f597a8c82f040&width=980&quality=75&smart=true","content_small":"https://diariocorreo.pe/resizer/v2/KMFXPGYFXNA2JDNVAI3ITPJNCQ.jpg?auth=bcb2aa4b06cc40a00c40b2572a033ddfbe8a4ec4c5f518e65d1f597a8c82f040&width=320&quality=75&smart=true","large":"https://diariocorreo.pe/resizer/v2/KMFXPGYFXNA2JDNVAI3ITPJNCQ.jpg?auth=bcb2aa4b06cc40a00c40b2572a033ddfbe8a4ec4c5f518e65d1f597a8c82f040&width=940&height=569&quality=75&smart=true","story_small":"https://diariocorreo.pe/resizer/v2/KMFXPGYFXNA2JDNVAI3ITPJNCQ.jpg?auth=bcb2aa4b06cc40a00c40b2572a033ddfbe8a4ec4c5f518e65d1f597a8c82f040&width=482&height=290&quality=75&smart=true","amp_new":"https://diariocorreo.pe/resizer/v2/KMFXPGYFXNA2JDNVAI3ITPJNCQ.jpg?auth=bcb2aa4b06cc40a00c40b2572a033ddfbe8a4ec4c5f518e65d1f597a8c82f040&width=1200&height=800&quality=75&smart=true","amp":"https://diariocorreo.pe/resizer/v2/KMFXPGYFXNA2JDNVAI3ITPJNCQ.jpg?auth=bcb2aa4b06cc40a00c40b2572a033ddfbe8a4ec4c5f518e65d1f597a8c82f040&width=900&height=600&quality=75&smart=true","impresa":"https://diariocorreo.pe/resizer/v2/KMFXPGYFXNA2JDNVAI3ITPJNCQ.jpg?auth=bcb2aa4b06cc40a00c40b2572a033ddfbe8a4ec4c5f518e65d1f597a8c82f040&width=617&height=637&quality=75&smart=true","impresa_s":"https://diariocorreo.pe/resizer/v2/KMFXPGYFXNA2JDNVAI3ITPJNCQ.jpg?auth=bcb2aa4b06cc40a00c40b2572a033ddfbe8a4ec4c5f518e65d1f597a8c82f040&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/politica/conoce-a-los-virtuales-alcaldes-de-19-distritos-de-lima-con-el-100-de-actas-procesadas-por-la-onpe-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"diariocorreo","revision":{"editions":["default"],"parent_id":"5QPFJQT3WBEPLCQ3ODOZQ53EYQ","published":true,"branch":"default","revision_id":"LSEYP2WAUBBZFMA47U3PNZB5WA"},"planning":{"story_length":{"character_count_actual":1675,"inch_count_actual":2,"word_count_actual":259,"line_count_actual":14}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T17:53:52.025Z","headlines":{"tablet":"","print":"","meta_title":"Conoce a los virtuales alcaldes de 19 distritos de Lima con el 100 % de actas procesadas por la ONPE","native":"","web":"","mobile":"","basic":"Conoce a los virtuales alcaldes de 19 distritos de Lima con el 100 % de actas procesadas por la ONPE"},"websites":{"diariocorreo":{"website_url":"/politica/conoce-a-los-virtuales-alcaldes-de-19-distritos-de-lima-con-el-100-de-actas-procesadas-por-la-onpe-noticia/","website_section":{"path":"/politica","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Política","_id":"/politica","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","search-filter-default":null,"menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Política","_id":"/politica","ancestors":{"navbar-default":[],"sitemap-default":["/"],"search-filter-default":[],"menu-default":[],"footer-secciones-default":["/"],"footer-default":[]},"order":{"header-pro":45,"default":45,"sitemap-default":1010,"test":45,"footer-secciones-default":1001,"menu-pro":45}}},"_website_section_id":"diariocorreo./politica","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T17:48:47.683Z","publish_date":"2026-10-24T17:53:52.025Z","_id":"AQQNOHXX25DPROGEEVB3W3ZF3U","website":"diariocorreo","website_url":"/politica/conoce-a-los-virtuales-alcaldes-de-19-distritos-de-lima-con-el-100-de-actas-procesadas-por-la-onpe-noticia/"},{"content_elements":[{"_id":"ELL3OXL5GFGGTLDH3JABKAAHY4","additional_properties":{},"type":"text","content":"<b>Un bebé procedente de Arequipa, con 20 días de nacido, recibió un marcapasos definitivo en el Instituto Nacional Cardiovascular (INCOR) de EsSalud, intervención que permitió corregir una grave alteración cardíaca que ponía en riesgo su vida.</b>"},{"_id":"PHDFS3QNNRGYJO66D4LKA6JFWI","additional_properties":{},"type":"text","content":"La condición fue detectada durante los controles cuando su madre tenía<b> 28 semanas de embarazo</b>, y se advirtió que el corazón del bebé latía a una frecuencia muy baja. Tras el nacimiento por cesárea, el pequeño estuvo en observación y, debido a su condición, fue referido al INCOR."},{"_id":"5XPESCQ7URG33GVQFV3WOPKD4U","additional_properties":{},"type":"text","content":"Los especialistas determinaron que el <b>recién nacido padecía un bloqueo auriculoventricular congénito</b>, el cual altera la transmisión de los impulsos del corazón y provoca latidos insuficientes para garantizar el adecuado suministro de sangre al organismo."},{"_id":"IL6VB6Q2T5BUJN6W2JO5UNPTJM","additional_properties":{},"type":"text","content":"Luego de la evaluación, los equipos de Cardiología y Electrofisiología confirmaron que el <b>bebé necesitaba un marcapasos epicárdico definitivo</b>, a fin de que envíe impulsos eléctricos para mantener el corazón latiendo."},{"_id":"JIZEL5JBWVCI7KFZ2TDZGJMLT4","additional_properties":{},"type":"text","content":"Cabe mencionar que la <b>intervención duró aproximadamente 45 minutos </b>y estuvo a cargo de un equipo de cirujanos cardiovasculares pediátricos del INCOR. Para ello, se realizó una pequeña incisión, sin abrir el esternón, y se colocó el marcapasos."},{"_id":"IIPWCBKWHJEWFLE72J4DFE6AXU","additional_properties":{},"type":"text","content":"Asimismo, se hizo el <b>seguimiento </b>durante los seis días posteriores hasta confirmar que el bebé se encontraba en condiciones estables para recibir el alta. Ahora el <b>pequeño deberá acudir a controles periódicos </b>para monitorear el funcionamiento del dispositivo y acompañar su crecimiento y desarrollo. De acuerdo a los especialistas, este tipo de marcapasos tiene una duración promedio de entre cinco y diez años."},{"_id":"AVXWWGYH3RBFDMRJHQOBIXXEDU","additional_properties":{},"type":"text","content":"<i><b>“Nos advirtieron que nuestro bebé podía sufrir un paro cardíaco y que su estado podía complicarse. Por eso, acudimos al INCOR para que le implantaran un marcapasos y tuviera la oportunidad de salir adelante. Estoy profundamente agradecido con los especialistas y con EsSalud por brindarle una nueva oportunidad de vida a mi hijo”</b></i>, expresó Hugo Delgado Cruz, padre del pequeño."},{"level":2,"_id":"U6A4CTMNPRDZDOFLIOMI73U2GM","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><b>VIDEO RECOMENDADO:</b></mark>"},{"_id":"JYGROWWWOZDSFOJGQG3FA5LLBU","type":"raw_html","content":"<iframe src=\"https://www.facebook.com/plugins/video.php?height=314&href=https%3A%2F%2Fwww.facebook.com%2Freel%2F2122253385055908%2F&show_text=false&width=560&t=0\" width=\"560\" height=\"314\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\" allowFullScreen=\"true\"></iframe>"},{"_id":"67RHRY2QUVD2XPFVTPKV4HZ4ZY","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"El recién nacido fue trasladado desde Arequipa al INCOR de EsSalud, donde especialistas lograron estabilizar su condición y darle el alta médica."},"description":{"basic":"Un bebé procedente de Arequipa, con 20 días de nacido, recibió un marcapasos definitivo en el Instituto Nacional Cardiovascular (INCOR) de EsSalud, intervención que permitió corregir una grave alteración cardíaca que ponía en riesgo su vida."},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/edicion/arequipa","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Arequipa","_id":"/edicion/arequipa","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Arequipa","_id":"/edicion/arequipa","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":76,"default":76,"test":76,"menu-pro":76}}},"_website_section_id":"diariocorreo./edicion/arequipa","type":"section","version":"0.6.0"},{"path":"/peru","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Perú","_id":"/peru","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Perú","_id":"/peru","ancestors":{"navbar-default":[],"sitemap-default":["/"],"menu-default":[],"footer-secciones-default":["/"],"footer-default":[]},"order":{"header-pro":11,"default":11,"sitemap-default":1015,"test":11,"footer-secciones-default":1002,"menu-pro":11}}},"_website_section_id":"diariocorreo./peru","type":"section","version":"0.6.0"}],"primary_section":{"path":"/edicion/arequipa","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Arequipa","_id":"/edicion/arequipa","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Arequipa","_id":"/edicion/arequipa","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":76,"default":76,"test":76,"menu-pro":76}}},"type":"section","version":"0.6.0"},"seo_keywords":["Bebé","ESSALUD","INCOR","Arequipa","recién nacido","marcapasos"],"tags":[{"description":"bebé","_id":"1792861774800","text":"bebé","slug":"bebe"},{"description":"ESSALUD","_id":"1792861776863","text":"ESSALUD","slug":"essalud"},{"description":"INCOR","_id":"1792861778064","text":"INCOR","slug":"incor"},{"description":"Arequipa","_id":"1792861780415","text":"Arequipa","slug":"arequipa"},{"description":"marcapasos","_id":"1792861783234","text":"marcapasos","slug":"marcapasos"}]},"related_content":{"clonedChildren":[],"basic":[],"clonedFromParent":[]},"type":"story","credits":{"by":[{"image":{"version":"0.5.8","url":"https://author-service-images-prod-us-east-1.publishing.aws.arc.pub/elcomercio/98448bc7-d1ed-47a1-909e-fbdec178cdcd.jpg"},"socialLinks":[{"site":"email","deprecated":true,"deprecation_msg":"Please use social_links.","url":""}],"social_links":[{"site":"email","url":""}],"name":"Redacción Diario Correo","description":"","_id":"redaccion-diariocorreo","additional_properties":{"original":{"lastName":"Diario Correo","secondLastName":"","image":"https://author-service-images-prod-us-east-1.publishing.aws.arc.pub/elcomercio/98448bc7-d1ed-47a1-909e-fbdec178cdcd.jpg","role":"author","education":[],"longBio":"","native_app_rendering":false,"fuzzy_match":false,"affiliations":"diariocorreo","bio":"","type":"author","firstName":"Redacción","books":[],"podcasts":[],"contributor":false,"awards":[],"_id":"redaccion-diariocorreo","bio_page":"/autor/redaccion-diariocorreo","last_updated_date":"2025-05-19T13:50:26.079Z","byline":"Redacción Diario Correo","email":"","slug":"redaccion-diariocorreo","status":true}},"type":"author","version":"0.5.8","url":"/autor/redaccion-diariocorreo","slug":"redaccion-diariocorreo"}]},"first_publish_date":"2026-10-24T17:18:11.407Z","additional_properties":{"is_published":true,"has_published_copy":true},"last_updated_date":"2026-10-24T17:18:11.527Z","publishing":{"scheduled_operations":{"unpublish_edition":[],"publish_edition":[]}},"owner":{"sponsored":false,"id":"elcomercio"},"comments":{"moderation_required":false,"allow_comments":false,"display_comments":false},"workflow":{"status_code":1},"label":{"genero":{"display":true,"text":"Informativo","url":"info"},"facebook_ia":{"display":true,"text":"Si","url":"true"},"nucleo":{"display":tru