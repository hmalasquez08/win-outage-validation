ocorreo.pe/resizer/v2/4NK7UENBJNBCLG4PONVV3QTSHQ.jpg?auth=7854a013af9a8a7af4c8922cf7ff9c0eb50a91c63dcc29e2a41983cc115749fd&width=320&quality=75&smart=true","large":"https://diariocorreo.pe/resizer/v2/4NK7UENBJNBCLG4PONVV3QTSHQ.jpg?auth=7854a013af9a8a7af4c8922cf7ff9c0eb50a91c63dcc29e2a41983cc115749fd&width=940&height=569&quality=75&smart=true","story_small":"https://diariocorreo.pe/resizer/v2/4NK7UENBJNBCLG4PONVV3QTSHQ.jpg?auth=7854a013af9a8a7af4c8922cf7ff9c0eb50a91c63dcc29e2a41983cc115749fd&width=482&height=290&quality=75&smart=true","amp_new":"https://diariocorreo.pe/resizer/v2/4NK7UENBJNBCLG4PONVV3QTSHQ.jpg?auth=7854a013af9a8a7af4c8922cf7ff9c0eb50a91c63dcc29e2a41983cc115749fd&width=1200&height=800&quality=75&smart=true","amp":"https://diariocorreo.pe/resizer/v2/4NK7UENBJNBCLG4PONVV3QTSHQ.jpg?auth=7854a013af9a8a7af4c8922cf7ff9c0eb50a91c63dcc29e2a41983cc115749fd&width=900&height=600&quality=75&smart=true","impresa":"https://diariocorreo.pe/resizer/v2/4NK7UENBJNBCLG4PONVV3QTSHQ.jpg?auth=7854a013af9a8a7af4c8922cf7ff9c0eb50a91c63dcc29e2a41983cc115749fd&width=617&height=637&quality=75&smart=true","impresa_s":"https://diariocorreo.pe/resizer/v2/4NK7UENBJNBCLG4PONVV3QTSHQ.jpg?auth=7854a013af9a8a7af4c8922cf7ff9c0eb50a91c63dcc29e2a41983cc115749fd&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/edicion/ica/pisco-brutal-choque-entre-auto-y-patrullero-policial-en-la-via-los-libertadores-deja-a-menor-herida-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"diariocorreo","revision":{"editions":["default"],"parent_id":"3D5BOHN7LRBDHJHG5TPDXVALQY","published":true,"branch":"default","revision_id":"UNHOLUL7SZDJRH765WHF53GZDY"},"planning":{"story_length":{"character_count_actual":1395,"inch_count_actual":2,"word_count_actual":219,"line_count_actual":12}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T16:50:00Z","headlines":{"tablet":"","print":"","meta_title":"Pisco: brutal choque entre auto y patrullero policial en la vía Los Libertadores deja a menor herida","native":"","web":"","mobile":"","basic":"Pisco: brutal choque entre auto y patrullero policial en la vía Los Libertadores deja a menor herida"},"websites":{"diariocorreo":{"website_url":"/edicion/ica/pisco-brutal-choque-entre-auto-y-patrullero-policial-en-la-via-los-libertadores-deja-a-menor-herida-noticia/","website_section":{"path":"/edicion/ica","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Ica","_id":"/edicion/ica","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Ica","_id":"/edicion/ica","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":85,"default":85,"test":85,"menu-pro":85}}},"_website_section_id":"diariocorreo./edicion/ica","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T04:41:05.363Z","publish_date":"2026-10-24T16:50:00Z","_id":"6SE37IHICRDY7BUR2UE5F2XP4A","website":"diariocorreo","website_url":"/edicion/ica/pisco-brutal-choque-entre-auto-y-patrullero-policial-en-la-via-los-libertadores-deja-a-menor-herida-noticia/"},{"content_elements":[{"_id":"J2H4EVLPSBBZDHXQBFKDBSOMAY","additional_properties":{},"type":"text","content":"El Niño es el principal motivo que llevó al Gobierno a lanzar un paquete de medidas fiscales contracíclicas (que implica aumentar el gasto público para evitar la caída de la economía) que <b>incorporará unos 18,000 millones de soles al Presupuesto 2027.</b>"},{"_id":"FVKYXLFD7BBPLGDJFRTNHVJRL4","additional_properties":{},"type":"text","content":"De ese monto, 2,500 millones de soles se destinarán para la entrega de bonos a las familias vulnerables. Otros 2,000 millones serán para el mantenimiento de colegios, postas y carreteras. "},{"_id":"6P47D5WI5RDBBHPJP6NQSZPXCI","additional_properties":{},"type":"text","content":"Sin embargo, esa decisión ha generado posiciones de cautela entre entendidos de la gestión pública, como <b>el exviceministro de Economía, Enzo Defillipi</b>. Dijo a <b>Correo</b> que la única <i>“acotación a la propuesta es que atender una emergencia no es por si sola una razón para volarse las reglas fiscales”.</i>"},{"_id":"C2H6DDCUKREM5E555FVZLLX7SA","additional_properties":{},"type":"text","content":"<b>Precisó que el Gobierno tiene un compromiso con la estabilidad fiscal</b> y las futuras generaciones. <i><b>“La inyección” </b></i><b>de 18,000 millones de soles en el Presupuesto Público del 2027 hará que el déficit fiscal pase de 1.4% a 2.4% en 2027. </b>"},{"_id":"2GZUIPSQONE43JE5DYZJM6MIFM","additional_properties":{},"type":"text","content":"<i>“Si por la emergencia se necesita gastar 18 mil millones de soles, no debe estar por encima del presupuesto porque se puede reasignar partidas de lo que no es urgente a lo que es urgente”, precisó.</i>"},{"_id":"3BMK7PMWXRBARAZLIYTRG2CPXY","additional_properties":{},"type":"text","content":""},{"_id":"HNTALSLM7BHINIEAQRM4CCLGKQ","additional_properties":{},"type":"text","content":"<b>Normal</b>"},{"_id":"NNXQYZVNYFFMZPDYN22NGW3BKM","additional_properties":{},"type":"text","content":"En tanto,<b> el director electo del Banco Central de Reserva (BCR), Juan José Marthans</b>, dijo a este diario que no se está rompiendo la regla fiscal, que se está recalibrando frente a un shock de oferta no esperado y de gran magnitud. "},{"_id":"EMAJ6P7FQ5BELPNRZYNP4AJKEU","additional_properties":{},"type":"text","content":"<i>“Aún con ello (impacto de El Niño) nuestros indicadores estarán por debajo de la media latinoamericana. El riesgo soberano no se afectará y menos se tendrá alguna observación de las calificadoras de riesgo. Se trata de anunciar la nueva trayectoria del déficit al 2031”, explicó.</i>"},{"_id":"YFQSQ3FJTNGCHKYQTVUQMCII2U","additional_properties":{},"type":"text","content":"Dijo que ello permitirá ser expansivo, aliviar el impacto de la desaceleración y pasar el ‘bache económico’. "},{"_id":"NEK22SMBW5GKZB34VVBJIZC3FU","additional_properties":{},"type":"text","content":"<i>“El tema es que la calidad del aparato público no permitirá una adecuada asignación de recursos. Nos hemos acostumbrado a solucionar parcialmente los problemas fiscales o auto engañarnos. Esperemos que la historia cambie de ahora en adelante”, anotó.</i>"}],"subheadlines":{"basic":"Porque incrementará el monto de los egresos del Estado versus sus ingresos. Exviceministro sugiere reasignar partidas de aquello que no urgente a lo que es urgente. Director del BCR dice que no se rompe la regla fiscal "},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/economia","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Economía","_id":"/economia","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Economía","_id":"/economia","ancestors":{"navbar-default":[],"sitemap-default":["/"],"menu-default":[],"footer-secciones-default":["/"],"footer-default":[]},"order":{"header-pro":61,"default":61,"sitemap-default":1005,"test":61,"footer-secciones-default":1005,"menu-pro":61}}},"_website_section_id":"diariocorreo./economia","type":"section","version":"0.6.0"}],"primary_section":{"path":"/economia","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Economía","_id":"/economia","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Economía","_id":"/economia","ancestors":{"navbar-default":[],"sitemap-default":["/"],"menu-default":[],"footer-secciones-default":["/"],"footer-default":[]},"order":{"header-pro":61,"default":61,"sitemap-default":1005,"test":61,"footer-secciones-default":1005,"menu-pro":61}}},"type":"section","version":"0.6.0"},"tags":[{"description":"Paquete fiscal","_id":"1792820416528","text":"Paquete fiscal","slug":"paquete-fiscal"},{"description":"Enzo Defillipi","_id":"1792820426764","text":"Enzo Defillipi","slug":"enzo-defillipi"},{"description":"Juan José Marthans","_id":"1792820434640","text":"Juan José Marthans","slug":"juan-jose-marthans"}]},"related_content":{"clonedChildren":[],"basic":[],"clonedFromParent":[]},"type":"story","credits":{"by":[{"socialLinks":[{"site":"email","deprecated":true,"deprecation_msg":"Please use social_links.","url":""}],"social_links":[{"site":"email","url":""}],"name":"Clorinda Flores","_id":"cflores","additional_properties":{"original":{"lastName":"Flores","role":"Redactora de la sección economía","education":[],"affiliations":"","firstName":"Clorinda","books":[],"podcasts":[],"awards":[],"_id":"cflores","bio_page":"/autor/clorinda-flores","last_updated_date":"2021-06-23T17:46:10.870Z","byline":"Clorinda Flores","email":"","slug":"clorinda-flores","status":true}},"type":"author","version":"0.5.8","url":"/autor/clorinda-flores","slug":"clorinda-flores"}]},"first_publish_date":"2026-10-24T16:39:31.409Z","additional_properties":{"is_published":true,"publish_date":"2026-10-24T16:39:31.409Z","has_published_copy":true},"last_updated_date":"2026-10-24T17:14:28.987Z","publishing":{"scheduled_operations":{"unpublish_edition":[],"publish_edition":[]}},"owner":{"sponsored":false,"id":"elcomercio"},"workflow":{"status_code":1},"promo_items":{"basic":{"owner":{"sponsored":false,"id":"elcomercio"},"address":{"locality":"LIMA"},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"f228603e7ad16b05e425bb71185090d79054