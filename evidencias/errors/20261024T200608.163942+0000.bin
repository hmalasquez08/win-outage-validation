a4e&width=900&height=600&quality=75&smart=true","impresa":"https://diariocorreo.pe/resizer/v2/4P4BZDN3OJG4XMSHQPEW3XN7JA.png?auth=d4592e4f263ff135602f7dc6b1c74e8b11321ebcd013abdc240a5ef3719f2a4e&width=617&height=637&quality=75&smart=true","impresa_s":"https://diariocorreo.pe/resizer/v2/4P4BZDN3OJG4XMSHQPEW3XN7JA.png?auth=d4592e4f263ff135602f7dc6b1c74e8b11321ebcd013abdc240a5ef3719f2a4e&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/edicion/huancayo/huancayo-tren-macho-vuelve-a-operar-desde-el-26-de-octubre-con-viajes-gratuitos-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"diariocorreo","revision":{"editions":["default"],"parent_id":"5WL364CBJVGGZEZ4N2XHJ4IGMY","published":true,"branch":"default","revision_id":"R7HDUEPOSJBYJD6GSXEWBV2MCY"},"planning":{"story_length":{"character_count_actual":2414,"inch_count_actual":3,"word_count_actual":355,"line_count_actual":17}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T16:37:00.313Z","headlines":{"tablet":"","print":"","meta_title":"Huancayo: Tren Macho vuelve a operar desde el 26 de octubre con viajes gratuitos","native":"","web":"","mobile":"","basic":"Huancayo: Tren Macho vuelve a operar desde el 26 de octubre con viajes gratuitos"},"websites":{"diariocorreo":{"website_url":"/edicion/huancayo/huancayo-tren-macho-vuelve-a-operar-desde-el-26-de-octubre-con-viajes-gratuitos-noticia/","website_section":{"path":"/edicion/huancayo","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Huancayo","_id":"/edicion/huancayo","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Huancayo","_id":"/edicion/huancayo","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":87,"default":87,"test":87,"menu-pro":87}}},"_website_section_id":"diariocorreo./edicion/huancayo","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T16:36:50.619Z","publish_date":"2026-10-24T16:37:00.313Z","_id":"R7IY2HJBBRGBXO6LUSUHKJZ5BQ","website":"diariocorreo","website_url":"/edicion/huancayo/huancayo-tren-macho-vuelve-a-operar-desde-el-26-de-octubre-con-viajes-gratuitos-noticia/"},{"content_elements":[{"_id":"MGRQMTILTFGTRKTC7ZYLCAFXHM","additional_properties":{},"type":"text","content":"El <b>Gobierno</b> recurrirá a proyectos de ley para impulsar las medidas que quedaron fuera de las <b>facultades legislativas</b> aprobadas por el <b>Congreso</b>, informó el jefe del Gabinete, <b>Luis Galarreta</b>, luego de que el Parlamento autorizara 27 de las 66 atribuciones solicitadas por el Ejecutivo."},{"_id":"5CZWHVTZM5ELXLQP2UILEQCMIA","additional_properties":{},"type":"text","content":"Galarreta cuestionó la postura de algunos sectores parlamentarios durante las negociaciones, aunque reconoció el respaldo de otras bancadas. "},{"_id":"BQYP3MX6Q5BM3MNKXT6WJCTW7Y","additional_properties":{},"type":"text","content":"<i><b>“Ha habido mezquindad de un sector minoritario y ha habido generosidad de otro sector, más allá de que obviamente respetamos lo que dice el Congreso, porque eso es lo que corresponde en democracia”,</b></i> declaró para RPP."},{"_id":"H2Z42S4LSZCZVGYUHHKN4WBY4I","additional_properties":{},"type":"text","content":"El titular de la Presidencia del Consejo de Ministros negó que el Gobierno haya planteado una negociación de todo o nada y sostuvo que la solicitud inicial buscaba alcanzar un acuerdo. "},{"_id":"FNIRNIEIFBBUHE4E576AKNU5BE","additional_properties":{},"type":"text","content":"Entre las propuestas que el Ejecutivo buscará impulsar por otras vías figuran los incentivos tributarios para fomentar el primer empleo formal juvenil y las medidas de alivio fiscal destinadas a evitar que “quiebren muchas mypes” afectadas por los embates climáticos. "},{"_id":"IZUB4WRB2FCC7M3NXIVTUXGXY4","additional_properties":{},"type":"text","content":""},{"level":2,"_id":"PBSWLGT63RGTJJXQRP7XSLQJZ4","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><b>Te puede interesar</b></mark>"},{"list_type":"unordered","_id":"UH5R3YYZ4FEDZPR75ZODUIWKOU","type":"list","items":[{"_id":"NAXVOMWY6JAI7FQ77N3XQQ7TKA","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/la-dini-tuvo-nueve-directores-en-seis-anos-noticia/\"><b>La DINI tuvo nueve directores en seis años</b></a>"},{"_id":"NJS23UKAQFBR5MDX6NIYXXLR3E","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/ley-sobre-facultades-enfrenta-a-las-camaras-noticia/\" rel=\"\"><b>Ley sobre facultades enfrenta a las cámaras</b></a>"},{"_id":"HK5WNIRTWBGMVFM2OJQ3DUFYKU","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/jorge-gavidia-nunca-me-senti-totalmente-consolidado-en-el-pbg-noticia/\" rel=\"\"><b>Jorge Gavidia: “Nunca me sentí totalmente consolidado” en el PBG</b></a>"},{"_id":"VHK7NN2JFZDEFNXIPHGA7D26E4","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/miguel-torres-defiende-legalidad-de-autografa-de-facultades-legislativas-enviada-al-ejecutivo-noticia/\" rel=\"\"><b>Miguel Torres defiende legalidad de autógrafa de facultades legislativas enviada al Ejecutivo</b></a>"},{"_id":"JLVFTKECL5BCHK3KPYPXLJ2KWE","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/roberto-sanchez-afrontara-juicio-oral-por-presuntas-irregularidades-en-aportes-a-juntos-por-el-peru-noticia/\" rel=\"\"><b>Roberto Sánchez afrontará juicio oral por presuntas irregularidades en aportes a Juntos por el Perú</b></a>"},{"_id":"ZB5G52XOU5CBJPRRK5UBB2RXKA","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/poder-judicial-rechaza-pedido-de-diputado-julian-perez-para-excluir-certificado-medico-de-su-expareja-noticia/\" rel=\"\"><b>PJ rechaza pedido de diputado Julián Pérez para excluir certificado médico de su expareja</b></a>"}]}],"subheadlines":{"basic":"El jefe del Gabinete anunció que los primeros decretos legislativos se publicarán en 12 días y aseguró que las propuestas rechazadas serán presentadas nuevamente por las vías regulares."},"description":{"basic":"El Gobierno recurrirá a proyectos de ley para impulsar las medidas que quedaron fuera de las facultades legislativas aprobadas por el Congreso, informó el jefe del Gabinete, Luis Galarreta, luego de que el Parlamento autorizara 27 de las 66 atribuciones solicitadas por el Ejecutivo."},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/politica","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Política","_id":"/politica","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","search-filter-default":null,"menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Política","_id":"/politica","ancestors":{"navbar-default":[],"sitemap-default":["/"],"search-filter-default":[],"menu-default":[],"footer-secciones-default":["/"],"footer-default":[]},"order":{"header-pro":45,"default":45,"sitemap-default":1010,"test":45,"footer-secciones-default":1001,"menu-pro":45}}},"_website_section_id":"diariocorreo./politica","type":"section","version":"0.6.0"}],"primary_section":{"path":"/politica","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Política","_id":"/politica","additional_properties":{"original"