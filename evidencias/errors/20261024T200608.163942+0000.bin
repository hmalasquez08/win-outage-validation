88,"inch_count_actual":3,"word_count_actual":202,"line_count_actual":16}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T16:17:58.755Z","headlines":{"tablet":"","print":"","meta_title":"Ronderos atrapan a dos jóvenes por robar baterías y los castigan con ejercicios físicos La Libertad Perú ","native":"","web":"","mobile":"","basic":"La Libertad: Ronderos atrapan a dos jóvenes por robar baterías y los castigan con ejercicios físicos "},"websites":{"diariocorreo":{"website_url":"/edicion/la-libertad/ronderos-atrapan-a-dos-jovenes-por-robar-baterias-y-los-castigan-con-ejercicios-fisicos-la-libertad-peru-noticia/","website_section":{"path":"/edicion/la-libertad","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"La Libertad","_id":"/edicion/la-libertad","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"La Libertad","_id":"/edicion/la-libertad","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":84,"default":84,"test":84,"menu-pro":84}}},"_website_section_id":"diariocorreo./edicion/la-libertad","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T16:09:43.827Z","publish_date":"2026-10-24T16:19:10.589Z","_id":"SINM3TTCIVHITEYBBS2ALW7YPA","website":"diariocorreo","website_url":"/edicion/la-libertad/ronderos-atrapan-a-dos-jovenes-por-robar-baterias-y-los-castigan-con-ejercicios-fisicos-la-libertad-peru-noticia/"},{"content_elements":[{"_id":"5CXIS6LRJZEDXG376LKU7GY5IM","additional_properties":{},"type":"text","content":"<b>La mañana de este sábado 24, un auto se salvó de terminar aplastado entre dos unidades de carga pesada, que protagonizaron un choque múltiple en la avenida Aviación, a escasos metros del puente Añashuayco. Para fortuna de los ocupantes del vehículo menor, este solo sufrió daños materiales, sin registrarse daños personales. </b>"},{"_id":"YGPBEH5H65H2FOL42UEWEIYT3M","additional_properties":{},"type":"text","content":"El hecho ocurrió cerca de las 9:00 horas, involucrando a una <b>cisterna de placa CNE-860</b>, de propiedad de la empresa GLATT S.R.L. y que presta servicios para el Área de Limpieza Pública de la Municipalidad Provincial de Arequipa."},{"_id":"DA57M2XN2RBONJ55HIHZSQB62I","additional_properties":{},"type":"text","content":"El otro vehículo protagonista de este accidente fue el de <b>marca Volvo y placa 801GYT </b>de procedencia boliviana. Ambas unidades pesadas impactaron levemente contra el <b>auto de placa V1X-235.</b>"},{"_id":"HSKPX67EW5AGLPAXN5JNVEDE3Y","additional_properties":{},"type":"text","content":"Este incidente provocó <b>congestión vehicular por breves minutos </b>en el carril de bajada de la avenida Aviación, hasta la llegada de efectivos de la comisaría de Zamacola, quienes dispusieron que los vehículos implicados, junto con sus conductores, sean trasladados hasta la dependencia policial para las diligencias de caso."},{"level":2,"_id":"IFPUEOLVSZDAJKYU2PS6PSCSOI","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><b>VIDEO RECOMENDADO:</b></mark>"},{"_id":"Y6W6QEAZRVHZTHVN6IDULC4OSY","type":"raw_html","content":"<iframe src=\"https://www.facebook.com/plugins/video.php?height=476&href=https%3A%2F%2Fwww.facebook.com%2Freel%2F1415599796953969%2F&show_text=false&width=267&t=0\" width=\"267\" height=\"476\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\" allowFullScreen=\"true\"></iframe>"},{"_id":"GAUFHEXGTJATBCMGR2MFEADZG4","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"Un choque múltiple entre un tráiler boliviano, una cisterna municipal y un auto menor interrumpió el tránsito en la bajada de la avenida Aviación, en Cerro Colorado."},"description":{"basic":"La mañana de este sábado 24, un auto se salvó de terminar aplastado entre dos unidades de carga pesada, que protagonizaron un choque múltiple en la avenida Aviación, a escasos metros del puente Añashuayco. Para fortuna de los ocupantes del vehículo menor, este solo sufrió daños materiales, sin registrarse daños personales. "},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/edicion/arequipa","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Arequipa","_id":"/edicion/arequipa","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Arequipa","_id":"/edicion/arequipa","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":76,"default":76,"test":76,"menu-pro":76}}},"_website_section_id":"diariocorreo./edicion/arequipa","type":"section","version":"0.6.0"}],"primary_section":{"path":"/edicion/arequipa","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Arequipa","_id":"/edicion/arequipa","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Arequipa","_id":"/edicion/arequipa","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":76,"default":76,"test":76,"menu-pro":76}}},"type":"section","version":"0.6.0"},"seo_keywords":["Arequipa","Cerro Colorado","choque","puente Añashuayco","accidente de tránsito"],"tags":[{"description":"Arequipa","_id":"1792858328527","text":"Arequipa","slug":"arequipa"},{"description":"accidente de tránsito","_id":"1792858332895","text":"accidente de tránsito","slug":"accidente-de-transi