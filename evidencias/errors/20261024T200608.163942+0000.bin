},"websites":{"diariocorreo":{"website_url":"/edicion/ica/chincha-vecinos-del-distrito-de-pueblo-nuevo-ayudan-a-la-policia-en-captura-de-ladron-de-billetera-noticia/","website_section":{"path":"/edicion/ica","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Ica","_id":"/edicion/ica","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Ica","_id":"/edicion/ica","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":85,"default":85,"test":85,"menu-pro":85}}},"_website_section_id":"diariocorreo./edicion/ica","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T03:25:10.384Z","publish_date":"2026-10-24T16:55:00Z","_id":"JMJI44C3OJETHMZZPM5DGGVJ5E","website":"diariocorreo","website_url":"/edicion/ica/chincha-vecinos-del-distrito-de-pueblo-nuevo-ayudan-a-la-policia-en-captura-de-ladron-de-billetera-noticia/"},{"content_elements":[{"_id":"P6JOWVKWPVEYNET6IPVPE53JYU","additional_properties":{},"type":"text","content":"<a href=\"https://diariocorreo.pe/edicion/ica/nasca-cuatro-policias-heridos-deja-brutal-choque-frontal-entre-patrullero-y-trailer-noticia/\" target=\"_self\" rel=\"\" title=\"https://diariocorreo.pe/edicion/ica/nasca-cuatro-policias-heridos-deja-brutal-choque-frontal-entre-patrullero-y-trailer-noticia/\"><b>Un accidente de tránsito entre un automóvil rojo de placa Y1T-263</b></a><b> y una camioneta de la Policía Nacional del Perú, perteneciente al servicio de Carreteras de Humay, dejó personas heridas, entre ellas un menor de edad que estaría con heridas graves y fue trasladada al Hospital San Juan de Dios de Pisco. El hecho se registró </b><a href=\"https://diariocorreo.pe/edicion/ica/ica-auto-conducido-por-policia-ebrio-sube-a-la-vereda-y-arrolla-a-joven-madre-causandole-fractura-de-craneo-noticia/\" target=\"_self\" rel=\"\" title=\"https://diariocorreo.pe/edicion/ica/ica-auto-conducido-por-policia-ebrio-sube-a-la-vereda-y-arrolla-a-joven-madre-causandole-fractura-de-craneo-noticia/\"><b>en la carretera Los Libertadores Wari, a la altura del cementerio del distrito de Independencia.</b></a>"},{"level":2,"_id":"RRQIUAIDFJATPDRECGOTXBZ7GQ","additional_properties":{},"type":"header","content":"<b>Brutal choque</b>"},{"_id":"URF5VOXFQJCCDEJVFJX6Z7VTYE","additional_properties":{},"type":"text","content":"Según las primeras informaciones, tras la violenta colisión, transportistas y ciudadanos que se encontraban por la zona acudieron a auxiliar a los ocupantes de los vehículos involucrados. Entre ellos se encontraba el menor, quien fue evacuado para recibir atención médica debido a la gravedad de sus lesiones."},{"_id":"NKCMAB24FRHDHJDOLRRY424IUY","additional_properties":{},"type":"text","content":"El accidente generó preocupación entre los conductores y pobladores que transitaban por esta importante vía de comunicación. El choque entre el vehículo particular y la unidad policial dejó severos daños materiales."},{"_id":"XFTEIDTM75HYPOVUNY72HZNR4I","additional_properties":{},"type":"text","content":"Asimismo, se reportó la intervención de un ciudadano que habría auxiliado al menor durante la emergencia."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"18b380fe2f9d1890df61f8d2607427ef4c0d302ba5f8d8daef42f5561c47911e"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/N3CXAXDBSRFV3JANKMU3XAFXQM.png","licensable":false,"credits":{"affiliation":[]},"subtitle":"ICA","width":1274,"_id":"N3CXAXDBSRFV3JANKMU3XAFXQM","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/N3CXAXDBSRFV3JANKMU3XAFXQM.png?