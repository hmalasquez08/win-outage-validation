UL7HNO2BNLVA.jpeg?auth=7577565c478fba197cb22871b2140a61ee6592caa6527276f8991095cc8cadd3&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/edicion/ica/ica-vecinos-de-el-arenal-en-los-aquijes-reclaman-por-cerco-perimetrico-de-iglesia-y-exigen-respetar-pasajes-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"diariocorreo","revision":{"editions":["default"],"parent_id":"EBCMRTB3KZEWRMSZXYITE2MVUE","published":true,"branch":"default","revision_id":"SJFNCYQD4VD4VNFMPMYS4MDRRA"},"planning":{"story_length":{"character_count_actual":2986,"inch_count_actual":3,"word_count_actual":470,"line_count_actual":21}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T18:15:00Z","headlines":{"tablet":"","print":"","meta_title":"Ica: vecinos de El Arenal en Los Aquijes reclaman por cerco perimétrico de iglesia y exigen respetar pasajes","native":"","web":"","mobile":"","basic":"Ica: vecinos de El Arenal en Los Aquijes reclaman por cerco perimétrico de iglesia y exigen respetar pasajes"},"websites":{"diariocorreo":{"website_url":"/edicion/ica/ica-vecinos-de-el-arenal-en-los-aquijes-reclaman-por-cerco-perimetrico-de-iglesia-y-exigen-respetar-pasajes-noticia/","website_section":{"path":"/edicion/ica","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Ica","_id":"/edicion/ica","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Ica","_id":"/edicion/ica","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":85,"default":85,"test":85,"menu-pro":85}}},"_website_section_id":"diariocorreo./edicion/ica","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T13:24:04.249Z","publish_date":"2026-10-24T18:15:00Z","_id":"EFKVAWI6VZHCVG3XRGQ6LP6PZM","website":"diariocorreo","website_url":"/edicion/ica/ica-vecinos-de-el-arenal-en-los-aquijes-reclaman-por-cerco-perimetrico-de-iglesia-y-exigen-respetar-pasajes-noticia/"},{"content_elements":[{"_id":"H5UGFCPT4ZABVP3VXZNEAXEP4E","additional_properties":{},"type":"text","content":"Los resultados electorales de<u> </u>19 distritos de <b>Lima Metropolitana </b>ya tienen candidatos que lideran la votación para ocupar sus respectivas alcaldías durante el periodo 2027-2030. "},{"_id":"45423ZRKVNG7HL23TREDF6BXZE","additional_properties":{},"type":"text","content":"Entre los candidatos con mayor respaldo figura Jorge Patricio Vásquez Nemi, del PPC, quien alcanza el 54.792% en Santa María del Mar. "},{"_id":"47KFN6MDFRBTLL4IMMKDITZTXQ","additional_properties":{},"type":"text","content":"En Pachacámac, Guillermo Elvis Pomez Cano, de Somos Perú, obtiene el 51.615%, mientras que William Ronald Salazar Mateo, de Renovación Popular, lidera en Cieneguilla con el 37.885%."},{"_id":"VFQVJRACIRF7JAHA63CO2QP3V4","additional_properties":{},"type":"text","content":"Renovación Popular también encabeza los resultados en San Miguel, con Marcos Enrique Cabrera Porras (35.860%); San Borja, con Javier Martin Diez Gaspard (35.162%); y Lurín, con Rosa Elva Torrejon Aragon (29.030%). Por su parte, Somos Perú lidera en La Molina con Juan Carlos Zurek (36.351%) y en San Bartolo con Rufino Enciso Rios (38.549%)."},{"_id":"ZYY3H77MFRG65LZLZJGJEHGD3U","additional_properties":{},"type":"text","content":"Otros candidatos que ocupan el primer lugar en sus distritos son José Luis Casas Carrión, de Avanza País, en Pueblo Libre (31.553%); Enrique Julio Manco Suni, del Frente de la Esperanza, en Pucusana (29.298%); y Tanus Barraza Calvo, de Acción Popular, en Santa Rosa (27.426%). Sin embargo, los resultados todavía están sujetos a la proclamación oficial del Jurado Nacional de Elecciones (JNE)."},{"level":2,"_id":"PBSWLGT63RGTJJXQRP7XSLQJZ4","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><b>Te puede interesar</b></mark>"},{"list_type":"unordered","_id":"UH5R3YYZ4FEDZPR75ZODUIWKOU","type":"list","items":[{"_id":"NAXVOMWY6JAI7FQ77N3XQQ7TKA","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/la-dini-tuvo-nueve-directores-en-seis-anos-noticia/\"><b>La DINI tuvo nueve directores en seis años</b></a>"},{"_id":"NJS23UKAQFBR5MDX6NIYXXLR3E","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/ley-sobre-facultades-enfrenta-a-las-camaras-noticia/\" rel=\"\"><b>Ley sobre facultades enfrenta a las cámaras</b></a>"},{"_id":"HK5WNIRTWBGMVFM2OJQ3DUFYKU","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/jorge-gavidia-nunca-me-senti-totalmente-consolidado-en-el-pbg-noticia/\" rel=\"\"><b>Jorge Gavidia: “Nunca me sentí totalmente consolidado” en el PBG</b></a>"},{"_id":"VHK7NN2JFZDEFNXIPHGA7D26E4","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/miguel-torres-defiende-legalidad-de-autografa-de-facultades-legislativas-enviada-al-ejecutivo-noticia/\" rel=\"\"><b>Miguel Torres defiende legalidad de autógrafa de facultades legislativas enviada al Ejecutivo</b></a>"},{"_id":"JLVFTKECL5BCHK3KPYPXLJ2KWE","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/roberto-sanchez-afrontara-juicio-oral-por-presuntas-irregularidades-en-aportes-a-juntos-por-el-peru-noticia/\" rel=\"\"><b>Roberto Sánchez afrontará juicio oral por presuntas irregularidades en aportes a Juntos por el Perú</b></a>"},{"_id":"ZB5G52XOU5CBJPRRK5UBB2RXKA","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://diariocorreo.pe/politica/poder-judicial-rechaza-pedido-de-diputado-julian-perez-para-excluir-certificado-medico-de-su-expareja-noticia/\" rel=\"\"><b>PJ rechaza pedido de diputado Julián Pérez para excluir certificado médico de su expareja</b></a>"}]}],"subheadlines":{"basic":"Renovación Popular, Somos Perú y Avanza País figuran entre las agrupaciones con candidatos que encabezan los resultados."},"description":{"basic":"Los resultados electorales de 19 distritos de Lima Metropolitana ya tienen candidatos que lideran la votación para ocupar sus respectivas alcaldías durante el periodo 2027-2030. "},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/politica","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Política","_id":"/politica","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","search-filter-default":null,"menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Política","_id":"/politica","ancestors":{"navbar-default":[],"sitemap-default":["/"],"search-filter-default":[],"menu-default":[],"footer-secciones-default":["/"],"footer-default":[]},"order":{"header-pro":45,"default":45,"sitemap-default":1010,"test":45,"footer-secciones-default":1001,"menu-pro":45}}},"_website_section_id":"diariocorreo./politica","type":"section","version":"0.6.0"}],"primary_section":{"path":"/politica","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Política","_id":"/politica","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","search-filter-default":null,"menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Política","_id":"/politica","ancestors":{"navbar-default":[],"sitemap-default":