510b90efe866fd168aed7a15fb80&width=940&height=569&quality=75&smart=true","story_small":"https://diariocorreo.pe/resizer/v2/VCDP6A7Z25FTTAJBRVA2KHF6GA.jpg?auth=f228603e7ad16b05e425bb71185090d79054510b90efe866fd168aed7a15fb80&width=482&height=290&quality=75&smart=true","amp_new":"https://diariocorreo.pe/resizer/v2/VCDP6A7Z25FTTAJBRVA2KHF6GA.jpg?auth=f228603e7ad16b05e425bb71185090d79054510b90efe866fd168aed7a15fb80&width=1200&height=800&quality=75&smart=true","amp":"https://diariocorreo.pe/resizer/v2/VCDP6A7Z25FTTAJBRVA2KHF6GA.jpg?auth=f228603e7ad16b05e425bb71185090d79054510b90efe866fd168aed7a15fb80&width=900&height=600&quality=75&smart=true","impresa":"https://diariocorreo.pe/resizer/v2/VCDP6A7Z25FTTAJBRVA2KHF6GA.jpg?auth=f228603e7ad16b05e425bb71185090d79054510b90efe866fd168aed7a15fb80&width=617&height=637&quality=75&smart=true","impresa_s":"https://diariocorreo.pe/resizer/v2/VCDP6A7Z25FTTAJBRVA2KHF6GA.jpg?auth=f228603e7ad16b05e425bb71185090d79054510b90efe866fd168aed7a15fb80&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/economia/paquete-fiscal-de-18000-millones-de-soles-genera-preocupacion-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"diariocorreo","revision":{"editions":["default"],"parent_id":"Y4UJK7JAI5FGVHJPIGOSMCBKOI","published":true,"branch":"default","revision_id":"RFY3O2GPAZCDDJ27AMRTF4VETE"},"planning":{"story_length":{"character_count_actual":2039,"inch_count_actual":3,"word_count_actual":339,"line_count_actual":17}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T16:39:31.409Z","headlines":{"tablet":"","print":"","meta_title":"Paquete fiscal de 18,000 millones de soles genera preocupación","native":"","web":"","mobile":"","basic":"Paquete fiscal de 18,000 millones de soles genera preocupación"},"websites":{"diariocorreo":{"website_url":"/economia/paquete-fiscal-de-18000-millones-de-soles-genera-preocupacion-noticia/","website_section":{"path":"/economia","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Economía","_id":"/economia","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Economía","_id":"/economia","ancestors":{"navbar-default":[],"sitemap-default":["/"],"menu-default":[],"footer-secciones-default":["/"],"footer-default":[]},"order":{"header-pro":61,"default":61,"sitemap-default":1005,"test":61,"footer-secciones-default":1005,"menu-pro":61}}},"_website_section_id":"diariocorreo./economia","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T05:47:55.876Z","publish_date":"2026-10-24T17:14:28.873Z","_id":"K2CHPSB455EIZJV6FASGPLEPQY","website":"diariocorreo","website_url":"/economia/paquete-fiscal-de-18000-millones-de-soles-genera-preocupacion-noticia/"},{"content_elements":[{"_id":"5EHC7MGEU5HPDNTXCYUCQ2KSBY","additional_properties":{},"type":"text","content":"Después de permanecer <b>un año sin prestar servicio</b>, el Ferrocarril Huancayo–Huancavelica, conocido popularmente como el <b>Tren Macho, volverá a transportar pasajeros desde el lunes 26 de octubre</b>, coincidiendo con la conmemoración de sus 100 años de historia."},{"_id":"4F5Z7IVPY5CH7EYV73CHL72DVU","additional_properties":{},"type":"text","content":"El Ministerio de Transportes y Comunicaciones (MTC) anunció que la reactivación se realizará de manera progresiva y que, en <b>una primera etapa, los viajes serán gratuitos en el tramo comprendido entre Chilca, en Huancayo, y Cuenca, en Huancavelica.</b>"},{"_id":"2KAVNY7EENDXTCE4ICVOXOHPQ4","additional_properties":{},"type":"text","content":"El recorrido contempla 11 puntos de embarque y desembarque: Chilca, Manuel Tellería, Viques, Paccha Soccos, Chanca, Retama, Ingahuasi, Huarisca, Parco, Pilchaca y Cuenca."},{"_id":"QJICM6CCLBBXXLN6QEVE4ZA3HA","additional_properties":{},"type":"text","content":"La recuperación de este servicio permitirá mejorar la movilidad de los habitantes de las comunidades asentadas a lo largo de la vía férrea, especialmente de aquellas ubicadas al otro lado del río Mantaro, donde las alternativas de transporte son limitadas."},{"_id":"CKLVLA6B4FFMXPZ3FHZVXOVGR4","additional_properties":{},"type":"text","content":"Según las estimaciones del Ejecutivo, <b>los usuarios podrán reducir aproximadamente 30 minutos de viaje en comparación con el transporte por carretera. </b>Además, se calcula que el servicio generará un ahorro conjunto de S/ 52 mil entre el 26 de octubre y el 30 de noviembre."},{"_id":"BV562ANXSJCJRESIZ2G5FB7JVA","additional_properties":{},"type":"text","content":""},{"level":2,"_id":"LKL52TFPGBHKDF45BEAPYKBABE","additional_properties":{},"type":"header","content":"<b>Proyectan ampliar la frecuencia de viajes</b>"},{"_id":"BMZ2CHHQGNB55E7LR4MGQUKPR4","additional_properties":{},"type":"text","content":"Durante esta primera etapa, el tren circulará los lunes y contará con un autovagón habilitado para pasajeros. También se dispondrá de una locomotora con coches adicionales para atender una mayor demanda durante festividades.El MTC informó que se evalúa incorporar viajes los viernes desde fines de noviembre, como parte del proceso de recuperación progresiva del servicio ferroviario."},{"_id":"GIRFHTXU25D3ZH4QMAMP4ZA6YI","additional_properties":{},"type":"text","content":"El anuncio se realizó durante la ceremonia por el centenario del Tren Macho, desarrollada en la estación Chilca, donde autoridades nacionales, regionales y locales participaron en un recorrido hasta el paradero de Viques."},{"_id":"6LT3FDXU5FDSHLLARNFKEFBVNE","additional_properties":{},"type":"text","content":"Paralelamente, el sector Transportes impulsa acciones para modernizar la infraestructura ferroviaria y fortalecer la conectividad entre Junín y Huancavelica."},{"_id":"JVKKYGNQPFDJ3KVGPUIJTLC5LI","additional_properties":{},"type":"text","content":"El proyecto forma parte del proceso de concesión del Ferrocarril Huancayo–Huancavelica y contempla mejoras orientadas a garantizar la continuidad del transporte de pasajeros."},{"_id":"OTM3EXBQYREG7B2ICBPKSHHEHY","additional_properties":{},"type":"text","content":"De acuerdo con las proyecciones oficiales, la recuperación del histórico Tren Macho beneficiará aproximadamente a 414 mil personas, facilitando el desplazamiento de los pobladores y el traslado de productos hacia los mercados de la región."}],"subheadlines":{"basic":"El histórico ferrocarril retomará el transporte de pasajeros entre Chilca y Cuenca, tras un año de paralización. "},"description":{"basic":"El histórico ferrocarril retomará el transporte de pasajeros entre Chilca y Cuenca, tras un año de paralización. "},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/edicion/huancayo","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Huancayo","_id":"/edicion/huancayo","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Huancayo","_id":"/edicion/huancayo","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":87,"default":87,"test":87,"menu-pro":87}}},"_website_section_id":"diariocorreo./edicion/huancayo","type":"section","version":"0.6.0"},{"path":"/edicion","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Edición","_id":"/edicion","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","sitemap-default":"/","test":"/","search-filter-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Edición","_id":"/edicion","ancestors":{"sitemap-default":["/"],"search-filter-default":[]},"order":{"header-pro":75,"default":75,"sitemap-default":1002,"test":75,"menu-pro":75}}},"_website_section_id":"diariocorreo./edicion","type":"section","version":"0.6.0"},{"path":"/peru","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Perú","_id":"/peru","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Perú","_id":"/peru","ancestors":{"navbar-default":[],"sitemap-default":["/"],"menu-default":[],"footer-secciones-default":["/"],"footer-default":[]},"order":{"header-pro":11,"default":11,"sitemap-default":1015,"test":11,"footer-secciones-default":1002,"menu-pro":11}}},"_website_section_id":"diariocorreo./peru","type":"section","version":"0.6.0"}],"primary_section":{"path":"/edicion/huancayo","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Huancayo","_id":"/edicion/huancayo","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Huancayo","_id":"/edicion/huancayo","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":87,"default":87,"test":87,"menu-pro":87}}},"type":"section","version":"0.6.0"},"seo_keywords":["Tren macho","Huancayo","reactivación","Junín","huancavelica","vijaes gratuitos","Cuenca","chilca"],"tags":[{"description":"Huancayo","_id":"1792859320445","text":"Huancayo","slug":"huancayo"},{"description":"Tren macho","_id":"1792859323484","text":"Tren macho","slug":"tren-macho"},{"description":"reactivación","_id":"1792859349421","text":"reactivación","slug":"reactivacion"}]},"related_content":{"clonedChildren":[