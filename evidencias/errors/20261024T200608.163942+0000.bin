t_xs":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=75&height=90&quality=75&smart=true","square_xl":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=900&height=900&quality=75&smart=true","square_l":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=600&height=600&quality=75&smart=true","square_md":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=300&height=300&quality=75&smart=true","square_s":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=150&height=150&quality=75&smart=true","square_xs":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=75&height=75&quality=75&smart=true","small":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=100&height=200&quality=75&smart=true","medium":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=480&quality=75&smart=true","content":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=980&quality=75&smart=true","content_small":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=320&quality=75&smart=true","large":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=940&height=569&quality=75&smart=true","story_small":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=482&height=290&quality=75&smart=true","amp_new":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=1200&height=800&quality=75&smart=true","amp":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=900&height=600&quality=75&smart=true","impresa":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=617&height=637&quality=75&smart=true","impresa_s":"https://diariocorreo.pe/resizer/v2/BMK2W3KPANEJBBZGPF6HKCPY3U.png?auth=7e332572505b5916bcfe1bdc4fcfd16255da13bcf9fa7a666ee2e0765496a962&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/edicion/arequipa/bebe-de-20-dias-recibe-marcapasos-y-salva-su-vida-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"diariocorreo","revision":{"editions":["default"],"parent_id":"FOUI3NIKGBFA5GIUSJBOK52CUY","published":true,"branch":"default","revision_id":"3NUO2PX6UJFX3FXXNV7RH5ZEW4"},"planning":{"scheduling":{"will_have_image":true},"story_length":{"character_count_actual":2038,"inch_count_actual":2,"word_count_actual":313,"line_count_actual":14}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T17:18:11.407Z","headlines":{"tablet":"","print":"","meta_title":"Bebé de 20 días recibe marcapasos y salva su vida","native":"","web":"","mobile":"","basic":"Bebé de 20 días recibe marcapasos y salva su vida"},"websites":{"diariocorreo":{"website_url":"/edicion/arequipa/bebe-de-20-dias-recibe-marcapasos-y-salva-su-vida-noticia/","website_section":{"path":"/edicion/arequipa","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Arequipa","_id":"/edicion/arequipa","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Arequipa","_id":"/edicion/arequipa","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":76,"default":76,"test":76,"menu-pro":76}}},"_website_section_id":"diariocorreo./edicion/arequipa","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T16:42:06.235Z","publish_date":"2026-10-24T17:18:11.407Z","_id":"3DJUXHEUW5G65AXWCYQQ2AWZOM","website":"diariocorreo","website_url":"/edicion/arequipa/bebe-de-20-dias-recibe-marcapasos-y-salva-su-vida-noticia/"},{"content_elements":[{"_id":"JKLKPLGNKBBJZFTXP5WN2PU2ZA","additional_properties":{},"type":"text","content":"<b>La histórica estación del Tren Macho, en Huancavelica, comenzó a recuperar su imagen luego de una jornada de limpieza y mantenimiento realizada con motivo de los 100 años de la llegada del ferrocarril a la región.</b>"},{"_id":"O4Q2CURRMZFKDIZF6ABQII6MFE","additional_properties":{},"type":"text","content":"Funcionarios, jefes de línea y trabajadores de la Dirección Regional de Transportes y Comunicaciones (DRTC) de Huancavelica participaron en las labores de conservación del recinto ferroviario, considerado parte importante del patrimonio histórico y cultural de la región."},{"_id":"RI2BPCIFMFHIFEI3W4PMCNXLHA","additional_properties":{},"type":"text","content":"Los trabajos incluyeron el <b>retiro de maleza, tierra y residuos acumulados</b> en distintos sectores de la estación, así como labores de acondicionamiento y pintura para mejorar las condiciones del lugar."},{"_id":"I6MJHFBDFJFTPL3MF7DNJX4OG4","additional_properties":{},"type":"text","content":"Con herramientas como lampas y picos, los participantes despejaron espacios que permanecían cubiertos por vegetación, permitiendo recuperar la visibilidad de algunos tramos de las antiguas vías ferroviarias."},{"_id":"A5JOSADAINEBXJSQ46VSP5QLLI","additional_properties":{},"type":"text","content":"<b>A estas acciones también se sumó el esfuerzo de ciudadanos interesados en preservar uno de los principales símbolos de la identidad huancavelicana.</b>"},{"_id":"STU7I7URARDATLPIRZM3LIHBDA","additional_properties":{},"type":"text","content":""},{"level":2,"_id":"K2H52HD4PRGAXNCMQQRL3MNL2U","additional_properties":{},"type":"header","content":"<b>Piden conservación permanente</b>"},{"_id":"NQZASQQNQNGZNM355UWU6SPWRM","additional_properties":{},"type":"text","content":"La intervención se desarrolla en el marco de las actividades conmemorativas por el centenario del Ferrocarril Huancayo–Huancavelica, conocido como el Tren Macho, que durante décadas ha conectado a poblaciones de ambas regiones."},{"_id":"IEV7Z4D6RFGN7O5Y77UDJGX3VI","additional_properties":{},"type":"text","content":"<b>La jornada también puso en evidencia la necesidad de garantizar el mantenimiento continuo de la infraestructura ferroviaria</b>, a fin de evitar que la vegetación y la acumulación de residuos vuelvan a deteriorar sus instalaciones."},{"_id":"WRIOWFGJNFEJTBJW4Q7373GYSI","additional_properties":{},"type":"text","content":"La recuperación de la estación busca ofrecer mejores condiciones para las celebraciones del centenario y contribuir a la conservación de un espacio que forma parte de la memoria histórica de Huancavelica."}],"subheadlines":{"basic":"Trabajadores de la Dirección Regional de Transportes y Comunicaciones y ciudadanos realizaron labores de limpieza, mantenimiento y pintura en la estación ferroviaria. "},"description":{"basic":"Trabajadores de la Dirección Regional de Transportes y Comunicaciones y ciudadanos realizaron labores de limpieza, mantenimiento y pintura en la estación ferroviaria. "},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/edicion/huancavelica","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Huancavelica","_id":"/edicion/huancavelica","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Huancavelica","_id":"/edicion/huancavelica","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":88,"default":88,"test":88,"menu-pro":88}}},"_website_section_id":"diariocorreo./edicion/huancavelica","type":"section","version":"0.6.0"},{"path":"/edicion","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Edición","_id":"/edicion","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","sitemap-default":"/","test":"/","search-filter-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Edición","_id":"/edicion","ancestors":{"sitemap-default":["/"],"search-filter-default":[]},"order":{"header-pro":75,"default":75,"sitemap-default":1002,"test":75,"menu-pro":75}}},"_website_section_id":"diariocorreo./edicion","type":"section","version":"0.6.0"},{"path":"/peru","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Perú","_id":"/peru","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Perú","_id":"/peru","ancestors":{"navbar-default":[],"sitemap-default":["/"],"menu-default":[],"footer-secciones-default":["/"],"footer-default":[]},"order":{"header-pro":11,"default":11,"sitemap-default":1015,"test":11,"footer-secciones-default":1002,"menu-pro":11}}},"