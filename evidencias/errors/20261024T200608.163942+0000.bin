nch_count_actual":2,"word_count_actual":232,"line_count_actual":10}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T18:58:45.317Z","headlines":{"tablet":"","print":"","meta_title":"Rondelli no renuncia al Clausura: “Mientras tengamos chance matemático, seguiremos con la ilusión”","native":"","web":"","mobile":"","basic":"Rondelli no renuncia al Clausura: “Mientras tengamos chance matemático, seguiremos con la ilusión”"},"websites":{"diariocorreo":{"website_url":"/deportes/rondelli-no-renuncia-al-clausura-mientras-tengamos-chance-matematico-seguiremos-con-la-ilusion-noticia/","website_section":{"path":"/deportes","parent":{"default":"/"},"_website":"diariocorreo","parent_id":"/","name":"Deportes","_id":"/deportes","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","navbar-default":null,"sitemap-default":"/","test":"/","search-filter-default":null,"menu-default":null,"footer-secciones-default":"/","footer-default":null,"menu-pro":"/"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Deportes","_id":"/deportes","ancestors":{"navbar-default":[],"sitemap-default":["/"],"search-filter-default":[],"menu-default":[],"footer-secciones-default":["/"],"footer-default":[]},"order":{"header-pro":54,"default":54,"sitemap-default":1007,"test":54,"footer-secciones-default":1004,"menu-pro":54}}},"_website_section_id":"diariocorreo./deportes","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T18:42:48.944Z","publish_date":"2026-10-24T18:58:45.317Z","_id":"RA2YGCILPNHG7GCMZGS6CKFYKU","website":"diariocorreo","website_url":"/deportes/rondelli-no-renuncia-al-clausura-mientras-tengamos-chance-matematico-seguiremos-con-la-ilusion-noticia/"},{"content_elements":[{"_id":"P2ILCRFQFNEXJAPFJDZFBCEYXA","additional_properties":{},"type":"text","content":"<b>Mediante la Ordenanza Regional N° 0021-2026, se encargó al Proyecto Especial Chavimochic (PECh) la implementación del modelo hídrico regional para la sostenibilidad del agua en la Región La Libertad.</b>"},{"_id":"QKRKIMMIG5E25AEDVJURDYZCJQ","additional_properties":{},"type":"text","content":"El objetivo es garantizar la disponibilidad del agua durante todo el año para el desarrollo agrario sostenible, mediante la gestión de qochas, reservorios existentes y la ejecución estratégica de pozos tubulares."},{"_id":"OLJDGBVOZVEODAFM5QYKPHAGOE","additional_properties":{},"type":"text","content":"El PECh, en coordinación con la Gerencia Regional de Agricultura, validará y socializará el modelo hídrico regional con los gobiernos locales, los usuarios del agua y la Autoridad Nacional de Agua (ANA), a fin de garantizar una gestión integrada, sostenible y coordinada del recurso."},{"_id":"MCB2FBP2KRHK3K74D4AZ76Y244","type":"raw_html","content":"<div style=\"font-family: Arial, sans-serif; max-width: 680px; margin: 0 auto; border-radius: 6px; overflow: hidden; box-shadow: 0 8px 32px rgba(37,211,102,0.15);\">\n\n  <!-- FRANJA SUPERIOR -->\n  <div style=\"background: #25D366; padding: 6px 20px; display: flex; align-items: center; gap: 8px;\">\n    <span style=\"width: 7px; height: 7px; background: white; border-radius: 50%; display: inline-block; animation: pulsoW 0.8s infinite;\"></span>\n    <span style=\"color: white; font-size: 0.6em; font-weight: bold; letter-spacing: 3px; text-transform: uppercase;\">Canal oficial de WhatsApp</span>\n  </div>\n\n  <!-- CUERPO -->\n  <div style=\"background: linear-gradient(135deg, #0a1f0a 0%, #0d0d0d 100%); padding: 20px;\">\n    <a href=\"https://whatsapp.com/channel/0029Vb7TiRS9cDDcPrLTPY0z\" target=\"_blank\" style=\"text-decoration: none; display: flex; align-items: center; gap: 18px;\">\n\n      <!-- ÍCONO -->\n      <div style=\"position: relative; flex-shrink: 0;\">\n        <div style=\"background: #25D366; width: 62px; height: 62px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2em; box-shadow: 0 0 0 0 rgba(37,211,102,0.4); animation: ringW 2s infinite;\">📲</div>\n        <span style=\"position: absolute; bottom: 0; right: 0; background: #128C7E; width: 18px; height: 18px; border-radius: 50%; border: 2px solid #0d0d0d; display: flex; align-items: center; justify-content: center; font-size: 0.55em; color: white; font-weight: bold;\">✓</span>\n      </div>\n\n      <!-- TEXTO -->\n      <div style=\"flex: 1;\">\n        <p style=\"color: rgba(255,255,255,0.5); font-size: 0.58em; letter-spacing: 3px; text-transform: uppercase; margin: 0 0 5px 0; font-weight: bold;\">Diario Correo</p>\n        <p style=\"color: #ffffff; font-size: 1em; font-weight: bold; margin: 0 0 6px 0; line-height: 1.3;\">Síguenos en WhatsApp y recibe las noticias al instante</p>\n        <div style=\"display: flex; align-items: center; gap: 6px;\">\n          <span style=\"background: #25D366; color: white; font-size: 0.6em; font-weight: bold; padding: 2px 8px; border-radius: 20px; letter-spacing: 1px;\">UNIRME AL CANAL →</span>\n        </div>\n      </div>\n\n    </a>\n  </div>\n\n  <!-- FRANJA INFERIOR -->\n  <div style=\"background: #0a1a0a; padding: 8px 20px; border-top: 1px solid rgba(37,211,102,0.15); text-align: center;\">\n    <span style=\"color: rgba(255,255,255,0.25); font-size: 0.6em; letter-spacing: 2px; text-transform: uppercase;\">📍 Noticias · Política · Mundo· Actualidad</span>\n  </div>\n\n</div>\n\n<style>\n@keyframes pulsoW { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.3;transform:scale(0.6)} }\n@keyframes ringW { 0%{box-shadow:0 0 0 0 rgba(37,211,102,0.4)} 70%{box-shadow:0 0 0 14px rgba(37,211,102,0)} 100%{box-shadow:0 0 0 0 rgba(37,211,102,0)} }\n</style>\n"},{"level":2,"_id":"THY5YPOEXBD4LAVD3BV3R4XKXM","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><u><b>LE PUEDE INTERESAR</b></u></mark>"},{"list_type":"unordered","_id":"X6DGACDS5ZBETPSZQCF4WVLYJE","type":"list","items":[{"_id":"KTXWW4B7DNCD3LVCJQMPDJ4SFM","additional_properties":{"indent":0},"alignment":"left