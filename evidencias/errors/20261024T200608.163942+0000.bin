orreo","bio_page":"/autor/redaccion-diariocorreo","last_updated_date":"2025-05-19T13:50:26.079Z","byline":"Redacción Diario Correo","email":"","slug":"redaccion-diariocorreo","status":true}},"type":"author","version":"0.5.8","url":"/autor/redaccion-diariocorreo","slug":"redaccion-diariocorreo"}]},"first_publish_date":"2026-10-24T17:09:21.934Z","additional_properties":{"is_published":true,"has_published_copy":true},"last_updated_date":"2026-10-24T17:09:22.029Z","publishing":{"scheduled_operations":{"unpublish_edition":[],"publish_edition":[]}},"owner":{"sponsored":false,"id":"elcomercio"},"workflow":{"status_code":1},"promo_items":{"basic":{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"31d92b6e72ee00017b6815adedefac89ee856d8451d8b94b78fbe352883d2af1"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/QUVVGNQLWFDLZIHAAVVFY4BPYU.png","licensable":false,"credits":{"affiliation":[]},"subtitle":"Huancavelica: recuperan histórica estación del Tren Macho por sus 100 años","width":2048,"_id":"QUVVGNQLWFDLZIHAAVVFY4BPYU","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/QUVVGNQLWFDLZIHAAVVFY4BPYU.png?auth=31d92b6e72ee00017b6815adedefac89ee856d8451d8b94b78fbe352883d2af1","proxyUrl":"/resizer/v2/QUVVGNQLWFDLZIHAAVVFY4BPYU.png?auth=31d92b6e72ee00017b6815adedefac89ee856d8451d8b94b78fbe352883d2af1","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/QUVVGNQLWFDLZIHAAVVFY4BPYU.png","published":true,"resizeUrl":"/resizer/v2/QUVVGNQLWFDLZIHAAVVFY4BPYU.png?auth=31d92b6e72ee00017b6815adedefac89ee856d8451d8b94b78fbe352883d2af1","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/QUVVGNQLWFDLZIHAAVVFY4BPYU.png?auth=31d92b6e72ee00017b6815adedefac89ee856d8451d8