=75&smart=true","content":"https://diariocorreo.pe/resizer/v2/QUVVGNQLWFDLZIHAAVVFY4BPYU.png?auth=31d92b6e72ee00017b6815adedefac89ee856d8451d8b94b78fbe352883d2af1&width=980&quality=75&smart=true","content_small":"https://diariocorreo.pe/resizer/v2/QUVVGNQLWFDLZIHAAVVFY4BPYU.png?auth=31d92b6e72ee00017b6815adedefac89ee856d8451d8b94b78fbe352883d2af1&width=320&quality=75&smart=true","large":"https://diariocorreo.pe/resizer/v2/QUVVGNQLWFDLZIHAAVVFY4BPYU.png?auth=31d92b6e72ee00017b6815adedefac89ee856d8451d8b94b78fbe352883d2af1&width=940&height=569&quality=75&smart=true","story_small":"https://diariocorreo.pe/resizer/v2/QUVVGNQLWFDLZIHAAVVFY4BPYU.png?auth=31d92b6e72ee00017b6815adedefac89ee856d8451d8b94b78fbe352883d2af1&width=482&height=290&quality=75&smart=true","amp_new":"https://diariocorreo.pe/resizer/v2/QUVVGNQLWFDLZIHAAVVFY4BPYU.png?auth=31d92b6e72ee00017b6815adedefac89ee856d8451d8b94b78fbe352883d2af1&width=1200&height=800&quality=75&smart=true","amp":"https://diariocorreo.pe/resizer/v2/QUVVGNQLWFDLZIHAAVVFY4BPYU.png?auth=31d92b6e72ee00017b6815adedefac89ee856d8451d8b94b78fbe352883d2af1&width=900&height=600&quality=75&smart=true","impresa":"https://diariocorreo.pe/resizer/v2/QUVVGNQLWFDLZIHAAVVFY4BPYU.png?auth=31d92b6e72ee00017b6815adedefac89ee856d8451d8b94b78fbe352883d2af1&width=617&height=637&quality=75&smart=true","impresa_s":"https://diariocorreo.pe/resizer/v2/QUVVGNQLWFDLZIHAAVVFY4BPYU.png?auth=31d92b6e72ee00017b6815adedefac89ee856d8451d8b94b78fbe352883d2af1&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/edicion/huancavelica/huancavelica-recuperan-historica-estacion-del-tren-macho-por-sus-100-anos-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"diariocorreo","revision":{"editions":["default"],"parent_id":"HBJOUROPWBEY5CKYJFN7PQPWUE","published":true,"branch":"default","revision_id":"NJ7K4KB35NBNHGEQEZHDFNHSCY"},"planning":{"story_length":{"character_count_actual":1724,"inch_count_actual":2,"word_count_actual":252,"line_count_actual":12}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T17:09:21.934Z","headlines":{"tablet":"","print":"","meta_title":"Huancavelica: recuperan histórica estación del Tren Macho por sus 100 años","native":"","web":"","mobile":"","basic":"Huancavelica: recuperan histórica estación del Tren Macho por sus 100 años"},"websites":{"diariocorreo":{"website_url":"/edicion/huancavelica/huancavelica-recuperan-historica-estacion-del-tren-macho-por-sus-100-anos-noticia/","website_section":{"path":"/edicion/huancavelica","parent":{"default":"/edicion"},"_website":"diariocorreo","parent_id":"/edicion","name":"Huancavelica","_id":"/edicion/huancavelica","additional_properties":{"original":{"parent":{"header-pro":"/edicion","default":"/edicion","test":"/edicion","menu-pro":"/edicion"},"inactive":false,"node_type":"section","_website":"diariocorreo","name":"Huancavelica","_id":"/edicion/huancavelica","ancestors":{"header-pro":["/"],"default":["/"],"test":["/"],"menu-pro":["/"]},"order":{"header-pro":88,"default":88,"test":88,"menu-pro":88}}},"_website_section_id":"diariocorreo./edicion/huancavelica","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T17:09:16.816Z","publish_date":"2026-10-24T17:09:21.934Z","_id":"JSP32K64IJGSHATCFS53J2O3YQ","website":"diariocorreo","website_url":"/edicion/huancavelica/huancavelica-recuperan-historica-estacion-del-tren-macho-por-sus-100-anos-noticia/"},{"content_elements":[{"_id":"4VONY3B65BBXRLYPRYSUY5GQGY","additional_properties":{},"type":"text","content":"<a href=\"https://diariocorreo.pe/edicion/ica/pisco-tambo-colorado-fortalece-su-proteccion-legal-tras-inscripcion-en-registros-publicos-noticia/\" target=\"_self\" rel=\"\" title=\"https://diariocorreo.pe/edicion/ica/pisco-tambo-colorado-fortalece-su-proteccion-legal-tras-inscripcion-en-registros-publicos-noticia/\"><b>El histórico complejo arqueológico Tambo Colorado, </b></a><b>ubicado en el distrito de Humay, provincia de Pisco, fortaleció su protección legal tras lograr su inscripción en los Registros Públicos de la Sunarp, bajo la Partida Registral N.° 11080037. La Dirección Desconcentrada de Cultura de Ica (DDC Ica) presentó oficialmente este importante avance,</b><a href=\"https://diariocorreo.pe/edicion/ica/pisco-tambo-colorado-abre-sus-puertas-a-los-estudiantes-para-fortalecer-la-valoracion-del-patrimonio-noticia/\" target=\"_self\" rel=\"\" title=\"https://diariocorreo.pe/edicion/ica/pisco-tambo-colorado-abre-sus-puertas-a-los-estudiantes-para-fortalecer-la-valoracion-del-patrimonio-noticia/\"><b> que brinda seguridad jurídica al Estado sobre este valioso patrimonio cultural de origen incaico.</b></a>"},{"level":2,"_id":"W6X4TZHF7RAELJLZML4NOD6DBM","additional_properties":{},"type":"header","content":"<b>Riqueza cultural</b>"},{"_id":"LWPM4P7BW5D53H3VXI2SY5KHTI","additional_properties":{},"type":"text","content":"La ceremonia fue encabezada por el director de la DDC Ica, Luis Enrique Mendoza Urcia, en representación del ministro de Cultura, Alberto Beingolea, y contó con la participación de autoridades de las municipalidades de Pisco y Humay, escolares, representantes del sitio arqueológico e instituciones aliadas. Como parte de la actividad, los asistentes realizaron una visita guiada para conocer la riqueza histórica y cultural de este emblemático monumento."},{"_id":"VVXGGMSFHVAQ5PH77I5TXBJWOU","additional_properties":{},"type":"text","content":"El saneamiento legal permitirá reforzar la defensa del complejo frente a posibles ocupaciones indebidas y facilitará futuras inversiones públicas destinadas a su conservación, implementación de infraestructura y puesta en valor. Este avance representa una oportunidad para impulsar el turismo cultural y contribuir al desarrollo social y económico de Humay y del valle de Pisco."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"192bd7925e5370fede303dc4021bf94e07e1c9dfdbb289728ac0f6a6d57ec04e"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/RLNNGVF7QVDXJH7SK3222UCLFI.jpeg","licensable":false,"credits":{"affiliation":[]},"subtitle":"ica","width":1600,"_id":"RLNNGVF7QVDXJH7SK3222UCLFI","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/RLNNGVF7QVDXJH7SK3222UCLFI.jpeg?auth=192bd7925e5370fede303dc4021bf94e07e1c9dfdbb289728ac0f6a6d57ec04e","proxyUrl":"/resizer/v2/RLNNGVF7QVDXJH7SK3222UCLFI.jpeg?auth=192bd7925e5370fede303dc4021bf94e07e1c9dfdbb289728ac0f6a6d57ec04e","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/RLNNGVF7QVDXJH7SK3222UCLFI.jpeg","published":true,"resizeUrl":"/resizer/v2/RLNNGVF7QVDXJH7SK3222UCLFI.jpeg?auth=192bd7925e5370fede303dc4021bf94e07e1c9dfdbb289728ac0f6a6d57ec04e","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/RLNNGVF7QVDXJH7SK3222UCLFI.jpeg?auth=192bd7925e5370fede303dc4021bf94e07e1c9dfdbb289728ac0f6a6d57ec04e&width=300","version":0,"originalName":"4.2 JPG.jpeg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T04:53:27Z","last_updated_date":"2026-10-24T04:53:27Z","height":1066,"image_type":"photograph","status":""},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"937890622285da21a0671247994a2e0b43ea5dc097a1162a6f0c21736bf70742"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/6RCF65IMYZHIHBT5V6WLE62GQI.jpeg","licensable":false,"credits":{"affiliation":[]},"subtitle":"ica",