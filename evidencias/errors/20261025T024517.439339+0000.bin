l":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":null},"_admin":{"alias_ids":["/espectaculos/tv"]},"inactive":false,"node_type":"section","_website":"tromecom","name":"Tv","_id":"/espectaculos/tv","ancestors":{"header-pro":["/espectaculos"],"default":["/espectaculos"],"menu-default":["/","/espectaculos"],"footer-default":[],"menu-pro":["/espectaculos"]},"order":{"menu-default":2001}}},"_website_section_id":"tromecom./espectaculos/tv","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T23:40:06.936Z","publish_date":"2026-10-24T23:42:27.137Z","_id":"XXRZEIZRJBBTDG6XDE3F2LSD24","website":"tromecom","website_url":"/espectaculos/tv/christian-cueva-pamela-lopez-lo-delata-y-expone-que-hacia-para-gilear-con-otras-mujeres-mientras-salian-de-shopping-no-me-daba-cuenta-foto-video-farandula-noticia/"},{"content_elements":[{"list_type":"unordered","_id":"MR3VPFGNNBCSXCZGGZKZ6V65BY","type":"list","items":[{"_id":"QMPB6JGC2RGIDPAXAPYQPWYLNY","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/opinion/el-bombardero/pisa-pelota-un-peso-pesado-anda-preocupado-porque-su-flaca-se-escribe-todo-el-dia-con-un-companero-de-chamba-noticia/\" rel=\"\"><b>Un peso pesado anda preocupado porque su flaca se escribe todo el día con un compañero de chamba</b></a>"},{"_id":"FJAPLUCG4FBLLKONNFLDG4TKRY","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/opinion/el-bombardero/pisa-pelota-el-zurdo-que-jugo-en-la-tierra-de-neymar-volvio-al-ataque-con-una-cubana-noticia/\" rel=\"\"><b>El zurdo que jugó en la tierra de Neymar volvió al ataque con una cubana</b></a>"}]},{"_id":"ZZ2EGPRWSRAU7HBCEMB4VNOOWA","additional_properties":{},"type":"text","content":"Del saque somos carnecita…<mark class=\"hl_yellow\"><b> La verídica que el fútbol está podrido en nuestro país y por eso estamos en la lona</b></mark>. Los últimos en Sudamérica. Todas las selecciones crecen, sacan nuevas figuras y acá en nuestra liga vemos ‘choclones’, árbitros que favorecen impunemente a algunos equipos, canchas que parecen chacras y arreglos bajo la mesa. <b>Esa resta de puntos a la Misilera huele bien feo. </b>"},{"_id":"QBXJJNNWCBEX5GIVTMRTJVWVZU","additional_properties":{},"type":"text","content":"Detrás de todo está el tío al que acusaron de revender entradas. Ese man atropella a todos y se alucina el más vivo, el que compra todo. Ya lo saben en el primer puerto. Así es... "},{"_id":"O35SIGEIBJHHVJGKJJYRRFX3ME","additional_properties":{},"type":"text","content":"Ya me contaron que un <mark class=\"hl_yellow\"><b>delantero con cara de sano le cerró el ‘caño’ al comentarista que representa jugadores</b></mark>. Dicen que el hombre le pasaba todos los datos y todos los problemas internos cuando estuvo el abuelito como entrenador. Ahora que ya llegó un parrillero a su medida se olvidó de pegarla de sapo. Huuummmm... "},{"_id":"LBRRSFJ6IFBU7PJHDTZVLLPZNM","additional_properties":{},"type":"text","content":"Me avisan que<b> </b><mark class=\"hl_yellow\"><b>‘Gaby’ es la mamacita más solicitada por los seleccionados que juegan en Europa y fuera del país</b></mark><mark class=\"hl_yellow\">. </mark>Dicen que ella es de Surco y varios la conocieron, porque fue pareja de un zurdo que tiene una pelea de gatos en la cabeza. "},{"_id":"FVOEH3HN3ZD7LNAWLK3F2YQ42Q","additional_properties":{},"type":"text","content":"El jugador era engreído de ‘Iván Cruz’ y gracias a él lo recomendaron a varios clubes de afuera, pero en todos acabó mal. Aseguran que la muchacha se da su lugar y por ahora no le responde mensajes a nadie. Curuju... "},{"level":2,"_id":"HF5WWXP2R5DKZH6D2PGQU3T34U","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><b>Chibolo que estuvo pidiendo perdón a su técnico no cambia su actitud</b></mark>"},{"_id":"6G4BFAGY3NBFVJAUMJPNQO2T5U","additional_properties":{},"type":"text","content":"Así que un chibolo que estuvo pidiendo perdón a su técnico no cambia su actitud. Sigue portándose mal, <mark class=\"hl_yellow\"><b>tiene mucha sed hasta en su día libre</b></mark> y pese a que le han dicho que pare la mano, ahora lo hace en lugares cerrados. Cuidado que el fútbol se acaba rápido y el mal comportamiento se paga bien ‘caro’. Así es... Me voy, soy fuga."},{"_id":"K6W66MZBVRHGTI6UYRWBXIQYSQ","additional_properties":{},"type":"text","content":"MÁS INFORMACIÓN:"},{"list_type":"unordered","_id":"34E2NOTBDBALDHNKSCRWDNNTAU","type":"list","items":[{"_id":"NTBCTLKQHVGLHO4IQNOEQHU5UI","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/opinion/el-bombardero/pisa-pelota-relacion-entre-un-pelotero-con-pancita-y-su-caderona-ya-entro-en-crisis-noticia/\" rel=\"\"><b>Relación entre un pelotero con pancita y su caderona ya entró en crisis</b></a>"},{"_id":"K6FUAOY3QVBGJN44SAWKDVN6CY","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/opinion/el-bombardero/pisa-pelota-bluper-se-vio-con-botafogo-por-culpa-de-su-cachorro-que-era-parte-de-su-cuerpo-tecnico-noticia/\" rel=\"\"><b>‘Blúper’ se vio con ‘Botafogo’ por culpa de su cachorro, que era parte de su cuerpo técnico</b></a>"},{"_id":"QJANCJZCIJDIBH6LVC56SZKYYM","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/opinion/el-bombardero/pisa-pelota-zambito-que-tiene-exito-en-las-redes-solto-sus-buenos-cocos-para-su-programa-y-ya-se-dio-cuenta-que-lo-estaban-levantando-en-peso-noticia/\" rel=\"\"><b>Zambito que tiene éxito en las redes soltó sus buenos ‘cocos’ para su programa y ya se dio cuenta que se lo estaban levantando en peso</b></a>"}]}],"subheadlines":{"basic":"“El hombre le pasaba todos todos los problemas internos cuando estuvo el abuelito como DT”"},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/opinion/el-bombardero","parent":{"default":"/opinion"},"_website":"tromecom","parent_id":"/opinion","name":"Pisa Pelota","description":null,"_id":"/opinion/el-bombardero","additional_properties":{"original":{"parent":{"header-pro":"/opinion","default":"/opinion","menu-default":"/opinion","navegacion-cabecera-tema-del-dia":"/","menu-pro":"/opinion"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":null},"_admin":{"alias_ids":["/opinion/el-bombardero"]},"inactive":false,"node_type":"section","_website":"tromecom","name":"Pisa Pelota","_id":"/opinion/el-bombardero","ancestors":{"header-pro":["/opinion"],"default":["/opinion"],"menu-default":["/","/opinion"],"navegacion-cabecera-tema-del-dia":["/"],"menu-pro":["/opinion"]},"order":{"menu-default":2001,"navegacion-cabecera-tema-del-dia":1007}}},"_website_section_id":"tromecom./opinion/el-bombardero","type":"section","version":"0.6.0"},{"path":"/opinion","parent":{"default":"/"},"_website":"tromecom","parent_id":"/","name":"Opinión","description":null,"_id":"/opinion","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","menu-default":"/","menu-pro":"/"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":"Opinión"},"_admin":{"alias_ids":["/opinion"]},"inactive":false,"node_type":"section","_website":"tromecom","name":"Opinión","_id":"/opinion","ancestors":{"header-pro":[],"default":[],"menu-default":["/"],"menu-pro":[]},"order":{"menu-default":1006}}},"_website