ro":["/actualidad"],"default":["/actualidad"],"menu-default":["/","/actualidad"],"footer-default":[],"menu-pro":["/actualidad"]},"order":{"menu-default":2003}}},"_website_section_id":"tromecom./actualidad/nacional","type":"section","version":"0.6.0"}}},"created_date":"2026-10-25T00:44:26.602Z","publish_date":"2026-10-25T01:17:41.499Z","_id":"TS5KUOT5XFFCXCCUXJYMXXVKN4","website":"tromecom","website_url":"/actualidad/nacional/juliaca-pnp-allana-local-y-detienen-a-pareja-acusada-de-integrar-mafia-de-trata-de-personas-noticia/"},{"content_elements":[{"list_type":"unordered","_id":"FBQNOQQPVVDCHOPCBJSLXHXZCM","type":"list","items":[{"_id":"E3AM7UQJ5BBH7BXVKNSJYSBOVA","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/actualidad/policiales/chorrillos-sicario-tumbo-de-su-moto-a-criador-de-perros-y-lo-mato-a-balazos-foto-video-historia-de-policiales-noticia/\">¡22 segundos de horror! Sicario tumbó de su moto a criador de perros y lo acribilló: todo quedó grabado</a>"},{"_id":"VD7O5GX4UVGYVHGEPYQTO5563M","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/actualidad/policiales/puno-dentista-es-condenado-a-20-anos-por-violar-a-esposa-de-su-amigo-historia-de-policiales-noticia/\">Condenan a 20 años de prisión a dentista que abusó de la esposa de su amigo en Puno: cámaras y ADN lo delataron</a>"}]},{"_id":"KCOCL7J6VBDC7DKK2FE3GQ3I4A","additional_properties":{},"type":"text","content":"Una disputa familiar terminó en un crimen que estremeció a<a href=\"https://trome.com/actualidad/nacional/cusco-incendios-forestales-dejan-seis-muertos-y-un-herido-grave-con-quemaduras-en-el-90-del-cuerpo-video-fotos-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/actualidad/nacional/cusco-incendios-forestales-dejan-seis-muertos-y-un-herido-grave-con-quemaduras-en-el-90-del-cuerpo-video-fotos-noticia/\"><b> Cusco</b></a><b>.</b> <b>Margarita Condori Mestas</b>, de 54 años, madre de cuatro hijos y comerciante, fue asesinada por su cuñada,<b> Blanca Vega Gonzales</b>, en medio de un conflicto por una propiedad. Después del ataque, la agresora descuartizó el cuerpo y ocultó los restos durante varios días antes de intentar deshacerse de ellos."},{"_id":"HNRNO4GW3VCYRADFKGHDGKLAI4","title":"","type":"link_list","items":[{"image":{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"e014b0dced1a5bdf2261e002765e9faf3a093bcb5fa64f7b0e1aea6c1f7fa2d2"},"vanity_credits":{"by":[{"name":"","type":"author"}]},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/QAJDGSKHYRAU7NBWMJFPUV4YOI.png","licensable":false,"credits":{"affiliation":[]},"subtitle":"","width":1200,"_id":"QAJDGSKHYRAU7NBWMJFPUV4YOI","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/QAJDGSKHYRAU7NBWMJFPUV4YOI.png?auth=e014b0dced1a5bdf2261e002765e9faf3a093bcb5fa64f7b0e1aea6c1f7fa2d2","proxyUrl":"/resizer/v2/QAJDGSKHYRAU7NBWMJFPUV4YOI.png?auth=e014b0dced1a5bdf2261e002765e9faf3a093bcb5fa64f7b0e1aea6c1f7fa2d2","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/QAJDGSKHYRAU7NBWMJFPUV4YOI.png","published":true,"resizeUrl":"/resizer/v2/QAJDGSKHYRAU7NBWMJFPUV4YOI.png?auth=e014b0dced1a5bdf2261e002765e9faf3a093bcb5fa64f7b0e1aea6c1f7fa2d2","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/QAJDGSKHYRAU7NBWMJFPUV4YOI.png?auth=e014b0dced1a5bdf2261e002765e9faf3a093bcb5fa64f7b0e1aea6c1f7fa2d2&width=300","version":0,"originalName":"LEONARD LEÓN y su esposa OLENKA también promocionaron los helados de MELANIE MARTÍNEZ (6).png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-17T14:36:10Z","last_updated_date":"2026-10-17T14:36:10Z","height":800,"image_type":"photograph","status":""},"description":{"_id":"DFNZORDAVVEJ5KM25RCSSNIJPM","type":"text","content":""},"_id":"TMMGFEYEJJBOXPSZWUUGEO72GE","additional_properties":{"nofollow":false,"sponsored":false,"openInNewTab":false},"type":"interstitial_link","content":"¡A balazos! Sujeto mata a joven por darle ‘like’ a la foto de su novia y una semana después lo acribillan","url":"https://trome.com/actualidad/policiales/crimen-y-castigo-rimac-a-balazos-sujeto-mata-a-joven-por-darle-like-a-la-foto-de-su-novia-y-una-semana-despues-lo-acribillan-foto-video-historia-de-policiales-noticia/"},{"image":{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"0ba4535959869837c2f96f31886d0347e68cc41517f7bf46a4f682c037395dea"},"vanity_credits":{"by":[{"name":"","type":"author"}]},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/BBYFINTC6ZCZXLGLNAZODDHKOQ.png","licensable":false,"credits":{"affiliation":[]},"subtitle":"","width":1200,"_id":"BBYFINTC6ZCZXLGLNAZODDHKOQ","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/BBYFINTC6ZCZXLGLNAZODDHKOQ.png?auth=0ba4535959869837c2f96f31886d0347e68cc41517f7bf46a4f682c037395dea","proxyUrl":"/resizer/v2/BBYFINTC6ZCZXLGLNAZODDHKOQ.png?auth=0ba4535959869837c2f96f31886d0347e68cc41517f7bf46a4f682c037395dea","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/BBYFINTC6ZCZXLGLNAZODDHKOQ.png","published":true,"resizeUrl":"/resizer/v2/BBYFINTC6ZCZXLGLNAZODDHKOQ.png?auth=0ba4535959869837c2f96f31886d0347e68cc41517f7bf46a4f682c037395dea","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/BBYFINTC6ZCZXLGLNAZODDHKOQ.png?auth=0ba4535959869837c2f96f31886d0347e68cc41517f7bf46a4f682c037395dea&width=300","version":0,"originalName":"LEONARD LEÓN y su esposa OLENKA también promocionaron los helados de MELANIE MARTÍNEZ (7).png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-10T14:29:36Z","last_updated_date":"2026-10-10T14:29:36Z","height":800,"image_type":"photograph","status":""},"description":{"_id":"LADQVCFJCZDDNAZAKGDYA5UP6Q","type":"text","content":""},"_id":"7QMWIH7XTNDVRM7OX2OF37A37U","additional_properties":{"nofollow":false,"sponsored":false,"openInNewTab":false},"type":"interstitial_link","content":"¡Mató a su compañero de trabajo con un balón de gas y culpó a Chucky! El brutal crimen que estremeció a Ayacucho","url":"https://trome.com/actualidad/policiales/crimen-y-castigo-ayacucho-asesino-a-su-companero-de-trabajo-con-un-balon-de-gas-y-dijo-que-chucky-lo-habia-poseido-foto-video-historia-de-policiales-noticia/"}]},{"_id":"CIEIOTIPXFCMPOHWFIU2JSEFTE","additional_properties":{},"type":"text","content":"El estremecedor caso ocurrió el 18 de enero de 2023. Margarita se dedicaba a la venta de condimentos y viajaba hasta Puno para conseguir mercadería. Su trabajo era una de las formas con las que sacaba adelante a su familia. Sin embargo, su rutina terminó de manera trágica cuando se vio envuelta en una disputa con una integrante de su propia familia, un caso que salió a la luz tras el hallazgo de restos humanos en bolsas de plástico."},{"level":2,"_id":"LCPFWTMNUJANRIMXZEEDEFVHUE","additional_properties":{},"type":"header","content":"<b>Disputa por una propiedad terminó en asesinato</b>"},{"_id":"YFL2TKPSJ5HLRFAT3NRWAV3FTA","additional_properties":{},"type":"text","content":"Detrás del crimen había un conflicto familiar relacionado con una vivienda. La hija de Margarita cuestionó las intenciones de Blanca y aseguró que la mujer había vivido durante años en Lima antes de llegar a Cusco. <mark class=\"hl_yellow\"><i><b>“Esa señora ha vivido muchos años en Lima y fue a Cusco a querer adueñarse de la casa”</b></i></mark>, manifestó al referirse al enfrentamiento que habría precedido al asesinato."},{"_id":"OBAO33RXXNDT7BJK2ZYT356QZI","additional_properties":{},"type":"text","content":"Según la investigación policial, la discusión entre ambas mujeres se salió de control. Durante el altercado, Margarita cayó al suelo y Blanca le cubrió el rostro con una casaca. Después, la golpeó en la cabeza con un pico, agresión que le causó la muerte."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"71dc98fb731f6a1baa8f2462f86f613fd1617302c4c86fe28e68e3f6bdfbc050"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/Q4K7DJDONJDQZGBTPYBMRFO6YE.png","licensable":false,"credits":{"affiliation":[]},"subtitle":"Cusco","width":1034,"_id":"Q4K7DJDONJDQZGBTPYBMRFO6YE","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/Q4K7DJDONJDQZGBTPYBMRFO6YE.png?auth=71dc98fb731f6a1baa8f2462f86f613fd1617302c4c86fe28e68e3f6bdfbc050","proxyUrl":"/resizer/v2/Q4K7DJDONJDQZGBTPYBMRFO6YE.png?auth=71dc98fb731f6a1baa8f2462f86f613fd1617302c4c86fe28e68e3f6bdfbc050","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/Q4K7DJDONJDQZGBTPYBMRFO6YE.png","published":true,"resizeUrl":"/resizer/v2/Q4K7DJDONJDQZGBTPYBMRFO6YE.png?auth=71dc98fb731f6a1baa8f2462f86f613fd1617302c4c86fe28e68e3f6bdfbc050","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/Q4K7DJDONJDQZGBTPYBMRFO6YE.png?auth=71dc98fb731f6a1baa8f2462f86f613fd1617302c4c86fe28e68e3f6bdfbc050&width=300","version":0,"originalName":"Captura de pantalla 2026-10-24 090535.png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T14:30:47Z","last_updated_date":"2026-10-24T14:30:47Z","height":574,"image_type":"photograph","status":""},{"_id":"KGA4W26SIRHVXKXGOF54QFV43Y","additional_properties":{},"type":"text","content":"Tras el asesinato, la acusada desmembró el cuerpo y mantuvo los restos dentro de su vivienda durante cinco días. Luego, buscó la manera de trasladarlos y abandonarlos sin despertar sospechas. Las diligencias policiales permitieron reconstruir parte de sus movimientos posteriores al crimen."},{"level":2,"_id":"WTJJRBEKZJBTRHUBUPGADMT5EE","additional_properties":{},"type":"header","content":"<b>Hallan restos humanos en bolsas de plástico en Cusco</b>"},{"_id":"R5RK2GNQ7VFDPNK3BEULQD2MGA","additional_properties":{},"type":"text","content":"La noche del 21 de enero de 2023, tres días después del asesinato, el hallazgo de bolsas de plástico con restos humanos alarmó a los vecinos de la asociación Pro Vivienda Camino Real, en la zona de Tica Tica, cerca de la avenida Camino Inca y la calle Gaspar Cazorla Montesinos, en Cusco."},{"_id":"R4D6EVTK7NGO3EHXNU2SXBN2JU","additional_properties":{},"type":"text","content":"La Policía encontró partes correspondientes a las zonas superior e inferior de un cuerpo. La evaluación inicial reveló múltiples heridas y contusiones, además de la ausencia de algunos órganos. Las características del hallazgo llevaron a los investigadores a iniciar las diligencias para identificar a la víctima y determinar las circunstancias de su muerte."},{"_id":"74BEQRIY2ZAWPG5YBJIFZ6GDXE","additional_properties":{},"type":"text","content":"De acuerdo con la reconstrucción policial, Blanca habría pensado inicialmente en dejar las bolsas en el cementerio de La Almudena. Sin embargo, al notar que había muchas personas en el lugar, cambió de plan y tomó un taxi hacia Tica Tica, donde finalmente abandonó los restos."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"a2fb1ae2967098b066f203dc8dd68c10fa81b5f8e30d8489b7a9db21acdbabb2"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/5ZCUVBWRVVBADDWGLC6J65TCZM.png","licensable":false,"credits":{"affiliation":[]},"subtitle":"Cusco","width":1041,"_id":"5ZCUVBWRVVBADDWGLC6J65TCZM","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/5ZCUVBWRVVBADDWGLC6J65TCZM.png?auth=a2fb1ae2967098b066f203dc8dd68c10fa81b5f8e30d8489b7a9db21acdbabb2","proxyUrl":"/resizer/v2/5ZCUVBWRVVBADDWGLC6J65TCZM.png?auth=a2fb1ae2967098b066f203dc8dd68c10fa81b5f8e30d8489b7a9db21acdbabb2","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/5ZCUVBWRVVBADDWGLC6J65TCZM.png","published":true,"resizeUrl":"/resizer/v2/5ZCUVBWRVVBADDWGLC6J65TCZM.png?auth=a2fb1ae2967098b066f203dc8dd68c10fa81b5f8e30d8489b7a9db21acdbabb2","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/5ZCUVBWRVVBADDWGLC6J65TCZM.png?auth=a2fb1ae2967098b066f203dc8dd68c10fa81b5f8e30d8489b7a9db21acdbabb2&width=300","version":0,"originalName":"Captura de pantalla 2026-10-24 090613.png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T14:30:47Z","last_updated_date":"2026-10-24T14:30:47Z","height":569,"image_type":"photograph","status":""},{"level":2,"_id":"VMJCCMUXTZGCVBE4U5Q3G6AYGA","additional_properties":{},"type":"header","content":"<b>Taxistas dieron una pista clave para descubrir a la responsable</b>"},{"_id":"H3BVNP4NAJBGRIROLKE4RSZFXE","additional_properties":{},"type":"text","content":"Durante la investigación, los agentes recogieron testimonios que ayudaron a reconstruir los movimientos de la sospechosa. Uno de los detalles que llamó la atención fue la explicación que habría dado a los taxistas para justificar el contenido de las bolsas que transportaba."},{"_id":"PIYN5KRVPREUHI3ZVJCVJYNSZQ","additional_properties":{},"type":"text","content":"<mark class=\"hl_yellow\"><i><b>“A los taxistas les decía de un chancho”</b></i></mark>, señaló un representante policial durante una conferencia de prensa. La frase llamó la atención de los investigadores, quienes reunieron indicios para establecer quién había trasladado los restos y cómo había intentado ocultar el crimen."},{"_id":"DENHE5EQJZF6LJVLU3Z3VCRKEY","additional_properties":{},"type":"text","content":"Las pesquisas condujeron hasta Blanca Vega Gonzales, hermana del esposo de Margarita. La relación familiar entre ambas permitió orientar la investigación hacia el entorno cercano de la víctima. Finalmente, Blanca confesó su participación en el asesinato, según la información policial difundida sobre el caso."},{"_id":"IYPFJZPX6ZHWHMCHPYESW4GS2E","additional_properties":{},"type":"text","content":"Los investigadores también evaluaron la posibilidad de que otra persona hubiera colaborado con la acusada. Sin embargo, con los datos disponibles no se puede afirmar que se haya confirmado la participación de un cómplice."},{"level":2,"_id":"Q27B6PKTZFHMZKLBKOI5CQU3MI","additional_properties":{},"type":"header","content":"<b>“Me dejé llevar por la ira”: la confesión de Blanca Vega</b>"},{"_id":"P54ZSKGYKND23HHZBLPZWKIE5M","additional_properties":{},"type":"text","content":"Durante una audiencia en la que se evaluó su situación legal, Blanca reconoció los hechos y expresó arrepentimiento ante las autoridades. “Reconozco lo que he hecho”, declaró al admitir su responsabilidad en el crimen."},{"_id":"J4OJVVAKDFHDJOA5B6FIZTJNCQ","additional_properties":{},"type":"text","content":"<mark class=\"hl_yellow\"><i><b>“Pido perdón a Dios y disculpa a las autoridades, no quise hacerlo… no saben todo lo que he sufrido”,</b></i></mark> agregó. La acusada sostuvo que actuó impulsada por la ira y aseguró que se arrepentía de lo ocurrido."},{"_id":"NNHJKG7UNVABBAOGI2U6HIT2RE","additional_properties":{},"type":"text","content":"<mark class=\"hl_yellow\"><i><b>“Me siento muy arrepentida, simplemente me dejé llevar por la ira, no soy una persona así, no sé qué me pasó en ese momento de verdad”,</b></i></mark> manifestó. Sus declaraciones se conocieron durante el proceso judicial que siguió al asesinato de su cuñada."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"b3aa133fc7c423366bd8ab9f909134549418f3eca727aa32377f874f14398c17"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/YA7JHSIQAJGZ3HQA2FRWWBYR5A.png","licensable":false,"credits":{"affiliation":[]},"subtitle":"Cusco","width":1054,"_id":"YA7JHSIQAJGZ3HQA2FRWWBYR5A","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/YA7JHSIQAJGZ3HQA2FRWWBYR5A.png?auth=b3aa133fc7c423366bd8ab9f909134549418f3eca727aa32377f874f14398c17","proxyUrl":"/resizer/v2/YA7JHSIQAJGZ3HQA2FRWWBYR5A.png?auth=b3aa133fc7c423366bd8ab9f909134549418f3eca727aa32377f874f14398c17","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/YA7JHSIQAJGZ3HQA2FRWWBYR5A.png","published":true,"resizeUrl":"/resizer/v2/YA7JHSIQAJGZ3HQA2FRWWBYR5A.png?auth=b3aa133fc7c423366bd8ab9f909134549418f3eca727aa32377f874f14398c17","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/YA7JHSIQAJGZ3HQA2FRWWBYR5A.png?auth=b3aa133fc7c423366bd8ab9f909134549418f3eca727aa32377f874f14398c17&width=300","version":0,"originalName":"Captura de pantalla 2026-10-24 091212.png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T14:30:47Z","last_updated_date":"2026-10-24T14:30:47Z","height":587,"image_type":"photograph","status":""},{"level":2,"_id":"IS6SJKXQEJGMNJAW4EUHKPXJ24","additional_properties":{},"type":"header","content":"<b>Condenan a más de 10 años de prisión a la asesina de Margarita</b>"},{"_id":"3OTIYOQN5ZC2DOTQOGBZFBASWA","additional_properties":{},"type":"text","content":"En octubre de 2023, el <b>Juzgado Penal Colegiado Supraprovincial B de Cusco</b> condenó a Blanca Vega Gonzales a 10 años, 3 meses y 13 días de prisión por el delito de homicidio calificado con alevosía."},{"_id":"VUV36HIEQJH2HA57IX22NDYTXE","additional_properties":{},"type":"text","content":"La sentencia se dictó luego de que la acusada aceptara acogerse a la conclusión anticipada del proceso. Además de la pena privativa de libertad, el tribunal ordenó el pago de 50.000 soles por concepto de reparación civil."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"084240ed9b5240bfbed7f81ba95b5ae72b48a7a7519b84815cc0cbba168e6c6b"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/T33FX6NJWFBFJGZH2T32ZSVNYY.png","licensable":false,"credits":{"affiliation":[]},"subtitle":"Cusco","width":1052,"_id":"T33FX6NJWFBFJGZH2T32ZSVNYY","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/T33FX6NJWFBFJGZH2T32ZSVNYY.png?auth=084240ed9b5240bfbed7f81ba95b5ae72b48a7a7519b84815cc0cbba168e6c6b","proxyUrl":"/resizer/v2/T33FX6NJWFBFJGZH2T32ZSVNYY.png?auth=084240ed9b5240bfbed7f81ba95b5ae72b48a7a7519b84815cc0cbba168e6c6b","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/T33FX6NJWFBFJGZH2T32ZSVNYY.png","published":true,"resizeUrl":"/resizer/v2/T33FX6NJWFBFJGZH2T32ZSVNYY.png?auth=084240ed9b5240bfbed7f81ba95b5ae72b48a7a7519b84815cc0cbba168e6c6b","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/T33FX6NJWFBFJGZH2T32ZSVNYY.png?auth=084240ed9b5240bfbed7f81ba95b5ae72b48a7a7519b84815cc0cbba168e6c6b&width=300","version":0,"originalName":"Captura de pantalla 2026-10-24 091246.png","mime