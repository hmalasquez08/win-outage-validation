uality=75&smart=true","impresa_s":"https://trome.com/resizer/v2/VQMISAVCS5G5JO7O5B6LEEHQ5E.jpg?auth=6b5a336aaa451b06931ac275659784565b03c3a3eaca680f2dd73c4d3fc7540a&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/deportes/futbol-peruano/sporting-cristal-vs-cusco-fc-en-vivo-l1-max-via-movistar-directv-horario-canales-streaming-online-ver-gratis-clausura-partidos-de-hoy-video-goles-resumen-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"tromecom","revision":{"editions":["default"],"parent_id":"HS6SZHXAE5G3NLZVATFBEK2L2E","published":true,"branch":"default","revision_id":"RD3C5EUAAFEELAJ2OI4UHXN7GQ"},"planning":{"scheduling":{"will_have_image":true},"story_length":{"character_count_actual":8234,"inch_count_actual":11,"word_count_actual":1367,"line_count_actual":77}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T23:42:41.269Z","headlines":{"tablet":"","print":"","meta_title":" Sporting Cristal cayó 3-1 ante Cusco FC y suelta la punta del Torneo Clausura  GOLES | RESUMEN | VIDEO","native":"","web":"","mobile":"","basic":"Sporting Cristal cayó 3-1 ante Cusco FC y suelta la punta del Torneo Clausura [VIDEO]"},"websites":{"tromecom":{"website_url":"/deportes/futbol-peruano/sporting-cristal-vs-cusco-fc-en-vivo-l1-max-via-movistar-directv-horario-canales-streaming-online-ver-gratis-clausura-partidos-de-hoy-video-goles-resumen-noticia/","website_section":{"path":"/deportes/futbol-peruano","parent":{"default":"/deportes"},"_website":"tromecom","parent_id":"/deportes","name":"Fútbol Peruano","description":null,"_id":"/deportes/futbol-peruano","additional_properties":{"original":{"parent":{"header-pro":"/deportes","default":"/deportes","footer-default":null,"menu-pro":"/deportes"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":"Fútbol Peruano"},"_admin":{"alias_ids":["/deportes/futbol-peruano"]},"inactive":false,"node_type":"section","_website":"tromecom","name":"Fútbol Peruano","_id":"/deportes/futbol-peruano","ancestors":{"header-pro":["/deportes"],"default":["/deportes"],"footer-default":[],"menu-pro":["/deportes"]},"order":{}}},"_website_section_id":"tromecom./deportes/futbol-peruano","type":"section","version":"0.6.0"}}},"created_date":"2026-10-23T22:37:39.157Z","publish_date":"2026-10-24T23:42:41.269Z","_id":"6T4I5NUWMVA5NI3QGVN5GMKUSU","website":"tromecom","website_url":"/deportes/futbol-peruano/sporting-cristal-vs-cusco-fc-en-vivo-l1-max-via-movistar-directv-horario-canales-streaming-online-ver-gratis-clausura-partidos-de-hoy-video-goles-resumen-noticia/"},{"content_elements":[{"list_type":"unordered","_id":"TM5CFIQ4Q5C5PBFWYC3UDWUW4E","type":"list","items":[{"_id":"DUBQ47R66NDNTHN4GFWZKHXLII","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/espectaculos/tv/andrea-san-martin-juan-victor-sanchez-sorprende-con-mensaje-tras-liberacion-de-la-ex-chica-reality-pero-lo-elimina-foto-video-farandula-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/espectaculos/tv/andrea-san-martin-juan-victor-sanchez-sorprende-con-mensaje-tras-liberacion-de-la-ex-chica-reality-pero-lo-elimina-foto-video-farandula-noticia/\">Juan Víctor ‘estalla’ y hace contundente pedido tras liberación de Andrea San Martín, pero se arrepiente: “Espero que…”</a>"}]},{"_id":"VGRZO4KZZVAWVAMFOICQROSVBU","additional_properties":{},"type":"text","content":"¡LO ECHÓ! <a href=\"https://trome.com/espectaculos/tv/christian-cueva-pamela-lopez-expone-reveladores-chats-entre-el-futbolista-y-su-mama-y-estalla-frente-a-camaras-te-va-caer-tu-carta-notarial-te-lo-prometo-foto-video-farandula-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/espectaculos/tv/christian-cueva-pamela-lopez-expone-reveladores-chats-entre-el-futbolista-y-su-mama-y-estalla-frente-a-camaras-te-va-caer-tu-carta-notarial-te-lo-prometo-foto-video-farandula-noticia/\">Pamela López</a> reveló cómo <a href=\"https://trome.com/espectaculos/tv/christian-cueva-lanza-dardo-luego-que-pamela-lopez-mostro-chats-del-futbolista-con-su-madre-por-supuesta-deuda-que-dijo-foto-video-farandula-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/espectaculos/tv/christian-cueva-lanza-dardo-luego-que-pamela-lopez-mostro-chats-del-futbolista-con-su-madre-por-supuesta-deuda-que-dijo-foto-video-farandula-noticia/\">Christian Cueva</a> coqueteaba con otras mujeres cuando salían de shopping o al centro comercial. Según la trujillana, al inicio no se daba cuenta; sin embargo, terminó descubriéndolo. En conversación con <b>Magaly Medina</b>, se lo contó todo."},{"_id":"WOSFJN6YSRDFFO5RR3JMRLHQC4","title":"MIRA TAMBIÉN:","type":"link_list","items":[{"image":{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"2d1ea3ab7c245701b872dffc00968db621c6fb9ce70e56ffadd8dd2e024afde0"},"vanity_credits":{"by":[{"name":"","type":"author"}]},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/C2QOKN6OBZBBPOLB6PN2Z5HGKU.png","licensable":false,"alt_text":"Pamela López le contó a Magaly Medina por qué cree que Christian Cueva se casó con ella.","credits":{"affiliation":[]},"subtitle":"","width":1020,"_id":"C2QOKN6OBZBBPOLB6PN2Z5HGKU","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/C2QOKN6OBZBBPOLB6PN2Z5HGKU.png?auth=2d1ea3ab7c245701b872dffc00968db621c6fb9ce70e56ffadd8dd2e024afde0","proxyUrl":"/resizer/v2/C2QOKN6OBZBBPOLB6PN2Z5HGKU.png?auth=2d1ea3ab7c245701b872dffc00968db621c6fb9ce70e56ffadd8dd2e024afde0","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/C2QOKN6OBZBBPOLB6PN2Z5HGKU.png","published":true,"resizeUrl":"/resizer/v2/C2QOKN6OBZBBPOLB6PN2Z5HGKU.png?auth=2d1ea3ab7c245701b872dffc00968db621c6fb9ce70e56ffadd8dd2e024afde0","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/C2QOKN6OBZBBPOLB6PN2Z5HGKU.png?auth=2d1ea3ab7c245701b872dffc00968db621c6fb9ce70e56ffadd8dd2e024afde0&width=300","version":0,"originalName":"PAMELA LOPEZ.png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T21:47:22Z","last_updated_date":"2026-10-24T21:47:22Z","height":675,"image_type":"photograph","status":""},"description":{"_id":"YGW52HZQ35BTPHXT4CKSUFEGGQ","type":"text","content":""},"_id":"5XLMQ2NYSREJRHDKFEINXB4AXI","additional_properties":{"nofollow":false,"sponsored":false,"openInNewTab":false},"type":"interstitial_link","content":"Pamela revela el fuerte motivo por el que Cueva se casó con ella: “Fue su último salvavidas, eso creo”","url":"https://trome.com/espectaculos/tv/pamela-lopez-revela-el-fuerte-motivo-por-el-que-christian-cueva-se-caso-con-ella-fue-su-ultimo-salvavidas-eso-creo-foto-video-farandula-noticia/"},{"image":{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"d75f8e808f05225411eceecfb01ad50efe70dd60c87c4ba9ce46e8eb1a8b18c5"},"vanity_credits":{"by":[{"name":"","type":"author"}]},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/H6MTOO4VVBAWVHKDFW6TU6TZSQ.png","licensable":false,"planning":{},"credits":{"affiliation":[]},"subtitle":"","width":1200,"_id":"H6MTOO4VVBAWVHKDFW6TU6TZSQ","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/H6MTOO4VVBAWVHKDFW6TU6TZSQ.png?auth=d75f8e808f05225411eceecfb01ad50efe70dd60c87c4ba9ce46e8eb1a8b18c5","proxyUrl":"/resizer/v2/H6MTOO4VVBAWVHKDFW6TU6TZSQ.png?auth=d75f8e808f05225411eceecfb01ad50efe70dd60c87c4ba9ce46e8eb1a8b18c5","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/H6MTOO4VVBAWVHKDFW6TU6TZSQ.png","published":true,"resizeUrl":"/resizer/v2/H6MTOO4VVBAWVHKDFW6TU6TZSQ.png?auth=d75f8e808f05225411eceecfb01ad50efe70dd60c87c4ba9ce46e8eb1a8b18c5","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/H6MTOO4VVBAWVHKDFW6TU6TZSQ.png?auth=d75f8e808f05225411eceecfb01ad50efe70dd60c87c4ba9ce46e8eb1a8b18c5&width=300","version":0,"originalName":"andrea-san-martin.png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T14:56:25Z","last_updated_date":"2026-10-24T14:56:25Z","height":800,"image_type":"photograph","status":""},"description":{"_id":"TJWPCRLJYVB2XOK7T56P77ZCCM","type":"text","content":""},"_id":"PBO3VB7KVZFWDBFGL6CVWNXH3U","additional_properties":{"nofollow":false,"sponsored":false,"openInNewTab":false},"type":"interstitial_link","content":"Andrea San Martín sale libre, corre a buscar a su hija y se da con tremenda sorpresa: “Cuatro horas tratando de comunicarme”","url":"https://trome.com/espectaculos/tv/andrea-san-martin-sale-en-libertad-y-busca-a-su-hija-noticia/"}]},{"_id":"TWXOXOY6ZFF3HOAIRYK6HBUSD4","additional_properties":{},"type":"text","content":"De acuerdo a Pamela, el supuesto ‘modus operandi’ de ‘Aladino’ era dejarla en una tienda donde había cosas que le gustaban, mientras él se iba al baño. Aquí, supuestamente, aprovechaba para hacer sus videollamadas o mensajearse con otras mujeres."},{"_id":"WVXO3KCDI5FBNG33E7X6HDH44Q","additional_properties":{},"type":"text","content":"<i>“Cada vez que salíamos a un centro comercial, </i><mark class=\"hl_yellow\"><i><b>al principio no me daba cuenta, pero siempre que salíamos a hacer shopping o compras, me dejaba entretenida en una tienda</b></i></mark><i> y se iba al baño”</i>, arrancó contando."},{"_id":"TGJWPVG4ZJABTHL6I5D2BPFKHQ","additional_properties":{},"type":"text","content":"Luego añadió: <i>“Al principio no me daba cuenta, al principio pensaba que se le había aflojado el estómago o tuvo una emergencia, no sé; </i><mark class=\"hl_yellow\"><i><b>después me di cuenta de que demoraba en el baño y no era una vez</b></i></mark><i>, sino las cuchucientas mil veces que íbamos de viaje, a un mall a hacer compras”.</i>"},{"_id":"5ZWXVY7DIFG3VNP24IPBMX5QFQ","additional_properties":{},"type":"text","content":"De acuerdo a Pamela López, Cuevita demoraba mucho tiempo, mientras ella estaba muy distraída en la tienda. <mark class=\"hl_yellow\"><i><b>“Se metía al baño a hacer sus llamadas ganadoras y luego regresaba y no me daba cuenta (...) Yo estaba bien estacionada en la tienda, bien distraída. Es terrible, era terrible...”</b></i></mark>, resaltó."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"821dececf11f51bd14dc34ac2f74f0eeb85b1a9f3a16b2e4958756d3df79c988"},"caption":"Pamela López sorprende a Magaly al contarle cómo Christian Cueva gileaba sin que ella se diera cuenta.","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/2SL3ZC74WBG5XFP42SZHZJRXWA.png","licensable":false,"alt_text":"Pamela López sorprende a Magaly al contarle cómo Christian Cueva gileaba sin que ella se diera cuenta.","credits":{"affiliation":[]},"subtitle":"Pamela López","width":1375,"_id":"2SL3ZC74WBG5XFP42SZHZJRXWA","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/2SL3ZC74WBG5XFP42SZHZJRXWA.png?auth=821dececf11f51bd14dc34ac2f74f0eeb85b1a9f3a16b2e4958756d3df79c988","proxyUrl":"/resizer/v2/2SL3ZC74WBG5XFP42SZHZJRXWA.png?auth=821dececf11f51bd14dc34ac2f74f0eeb85b1a9f3a16b2e4958756d3df79c988","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/2SL3ZC74WBG5XFP42SZHZJRXWA.png","published":true,"resizeUrl":"/resizer/v2/2SL3ZC74WBG5XFP42SZHZJRXWA.png?auth=821dececf11f51bd14dc34ac2f74f0eeb85b1a9f3a16b2e4958756d3df79c988","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/2SL3ZC74WBG5XFP42SZHZJRXWA.png?auth=821dececf11f51bd14dc34ac2f74f0eeb85b1a9f3a16b2e4958756d3df79c988&width=300","version":0,"originalName":"MAGALY.png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T23:32:16Z","last_updated_date":"2026-10-24T23:32:16Z","height":748,"image_type":"photograph","status":""},{"level":2,"_id":"BUQ2K22675DGFHMTTD2RT7MN2E","additional_properties":{},"type":"header","content":"<b>OTRA CONFESIÓN SOBRE CUEVA</b>"},{"_id":"FO32KZ6UIJEN3HUSRWVEQDSSMY","additional_properties":{},"type":"text","content":"En entrevista con Magaly, Pamela López contó otra supuesta táctica que tenía ‘Aladino’ para gilear sin que ella se diera cuenta."},{"_id":"XEBG73EXZZFZZKQ3JLP24BH3CE","additional_properties":{},"type":"text","content":"<i>“</i><mark class=\"hl_yellow\"><i><b>Otra era que tenía que llegar a la casa a la 1 de la tarde y llegaba tarde, un poco más, plan 3</b></i></mark><i> y me había esmerado cocinando para que baje de peso porque Gareca me había pedido que haga mi función y llegaba tarde y </i><mark class=\"hl_yellow\"><i><b>era porque se iba a la casa del compañero, chateaba, hacía sus videollamadas y luego iba a la casa y no había nada, ninguna prueba</b></i></mark><i>”</i>, detalló."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"353a6b6e9d0525d98915fec947620464cdc49df2aa5f9f9505c68c928c392b35"},"caption":"Christian Cueva y Pamela López fueron pareja por casi 13 años.","source":{"system":"photo center","edit_url":"","additional_