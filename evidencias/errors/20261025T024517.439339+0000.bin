revision":{"editions":["default"],"parent_id":"VNMOARUVEJBH5LWH6EUHIDC5FY","published":true,"branch":"default","revision_id":"F2AVIFH4KFHVZMYZ4UM2BYL6NU"},"planning":{"scheduling":{"will_have_image":true,"will_have_video":true},"story_length":{"character_count_actual":1919,"inch_count_actual":3,"word_count_actual":326,"line_count_actual":16}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-25T00:32:17.347Z","headlines":{"tablet":"","print":"","meta_title":"Ric Flair, leyenda de la lucha libre, sufre dura caída y es hospitalizado de urgencia","native":"","web":"","mobile":"","basic":"Ric Flair, leyenda de la lucha libre, sufre dura caída y es hospitalizado de urgencia"},"websites":{"tromecom":{"website_url":"/deportes/wwe/ric-flair-leyenda-de-la-lucha-libre-sufre-dura-caida-y-es-hospitalizado-de-urgencia-noticia/","website_section":{"path":"/deportes/wwe","parent":{"default":"/deportes"},"_website":"tromecom","parent_id":"/deportes","name":"WWE","description":null,"_id":"/deportes/wwe","additional_properties":{"original":{"parent":{"header-pro":"/deportes","default":"/deportes","footer-default":null,"menu-pro":"/deportes"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":null},"_admin":{"alias_ids":["/deportes/wwe"]},"inactive":false,"node_type":"section","_website":"tromecom","name":"WWE","_id":"/deportes/wwe","ancestors":{"header-pro":["/deportes"],"default":["/deportes"],"footer-default":[],"menu-pro":["/deportes"]},"order":{}}},"_website_section_id":"tromecom./deportes/wwe","type":"section","version":"0.6.0"}}},"created_date":"2026-10-25T00:04:42.177Z","publish_date":"2026-10-25T00:32:17.347Z","_id":"2SBIBGOR7VAO3EQ47HEIANUUKQ","website":"tromecom","website_url":"/deportes/wwe/ric-flair-leyenda-de-la-lucha-libre-sufre-dura-caida-y-es-hospitalizado-de-urgencia-noticia/"},{"content_elements":[{"_id":"DQS6NLT67JGR3PYALK26HJAPSU","additional_properties":{},"type":"text","content":"Con emoción y espíritu deportivo, se inauguró este miércoles el <b>Para Panamerican Championships Lima 2026 de Tiro con Arco</b>, una importante cita internacional que reúne a 80 deportistas de 10 países en el <b>Complejo Matute</b>, en el distrito de <b>La Victoria</b>. Las competencias se desarrollarán desde este jueves 22 hasta el domingo 25 de octubre, con la participación de delegaciones de Brasil, Canadá, Chile, Colombia, Ecuador, Guatemala, México, Perú y Estados Unidos."},{"_id":"XOURF24PHJBE7CGL3XH7EAG6OQ","title":"MIRA TAMBIÉN:","type":"link_list","items":[{"image":{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"7a0ee433280f45dbc62174309a3ebf9aa9393b469a64fc21f46ec0eb5cdf3d20"},"vanity_credits":{"by":[{"name":"","type":"author"}]},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/75QRXXJLXFFJNFSMV26W4L77NY.jpg","licensable":false,"planning":{},"credits":{"affiliation":[]},"subtitle":"","width":946,"_id":"75QRXXJLXFFJNFSMV26W4L77NY","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/75QRXXJLXFFJNFSMV26W4L77NY.jpg?auth=7a0ee433280f45dbc62174309a3ebf9aa9393b469a64fc21f46ec0eb5cdf3d20","proxyUrl":"/resizer/v2/75QRXXJLXFFJNFSMV26W4L77NY.jpg?auth=7a0ee433280f45dbc62174309a3ebf9aa9393b469a64fc21f46ec0eb5cdf3d20","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/75QRXXJLXFFJNFSMV26W4L77NY.jpg","published":true,"resizeUrl":"/resizer/v2/75QRXXJLXFFJNFSMV26W4L77NY.jpg?auth=7a0ee433280f45dbc62174309a3ebf9aa9393b469a64fc21f46ec0eb5cdf3d20","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/75QRXXJLXFFJNFSMV26W4L77NY.jpg?auth=7a0ee433280f45dbc62174309a3ebf9aa9393b469a64fc21f46ec0eb5cdf3d20&width=300","version":0,"originalName":"campeones surf.jpg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-16T01:08:40Z","last_updated_date":"2026-10-16T01:08:40Z","height":797,"image_type":"photograph","status":""},"description":{"_id":"NIFJCBCJ55HJRG7VCFAW7V646A","type":"text","content":""},"_id":"M6BCI3HI7FBZ7AFNM2FA675VBA","additional_properties":{"nofollow":false,"sponsored":false,"openInNewTab":false},"type":"interstitial_link","content":"Surf internacional: ¡Perú conquista 14 medallas en el ALAS Global Tours de Puerto Rico!","url":"https://trome.com/deportes/polideportivo/surf-peru-alas-global-tour-peru-conquista-14-medallas-noticia/"}]},{"_id":"ZFT5KYDEIRCPNJVFM6DFGOICHQ","additional_properties":{},"type":"text","content":"A la ceremonia de inauguración asistieron Renzo Manyari, presidente del Comité Olímpico Peruano; Rubén Cano, alcalde de La Victoria; Luisa Villar, presidenta de la Asociación Nacional Paralímpica del Perú; Denith Silva, presidenta de la Federación de Tiro con Arco; Javier Ramírez, director de DINADAF del IPD; y Erick Leiter, delegado técnico internacional. "},{"_id":"LIBK4YDRV5HLVFAGJ4Q4MKALZY","additional_properties":{},"type":"text","content":"La delegación peruana está conformada por los paradeportistas <b>Marco Huaytalla Pérez</b> (Arco Recurvo Varones Open), <b>Daniela Campos Marzano</b> (Arco Recurvo Damas Open), junto a <b>Juan José Lazarte Leguía</b> y <b>Junior Vargas Landeo</b> (ambos en Arco Compuesto Varones Open). "}],"subheadlines":{"basic":"Participan 10 países y un total de 80 deportistas. Evento se desarrolla en el Complejo Matute. "},"description":{"basic":"Participan 10 países y un total de 80 deportistas. Evento se desarrolla en el Complejo Matute. "},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxon