289&quality=75&smart=true"}}},"canonical_url":"/deportes/futbol-internacional/clasico-barcelona-vs-real-madrid-en-vivo-horarios-y-canales-para-ver-gratis-derby-espanol-laliga-directvgo-kylian-mbappe-lamine-yamal-partidos-de-hoy-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"tromecom","revision":{"editions":["default"],"parent_id":"SNXACWVGZVCTPICYB2CM7X3BCE","published":true,"branch":"default","revision_id":"3PJFH4CQANBPLOTFH5P34WLMVM"},"planning":{"story_length":{"character_count_actual":4881,"inch_count_actual":7,"word_count_actual":814,"line_count_actual":48}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-25T00:57:06.036Z","headlines":{"tablet":"","print":"","meta_title":"Clásico Barcelona vs Real Madrid  EN VIVO  horarios y canales para ver gratis derby español LaLiga| directvgo | Kylian Mbappé | Lamine Yamal | Partidos de hoy","native":"","web":"","mobile":"","basic":"¡Superclásico! Barcelona vs. Real Madrid EN VIVO: Hora y canal para ver duelo entre Mbappé y Yamal    "},"websites":{"tromecom":{"website_url":"/deportes/futbol-internacional/clasico-barcelona-vs-real-madrid-en-vivo-horarios-y-canales-para-ver-gratis-derby-espanol-laliga-directvgo-kylian-mbappe-lamine-yamal-partidos-de-hoy-noticia/","website_section":{"path":"/deportes/futbol-internacional","parent":{"default":"/deportes"},"_website":"tromecom","parent_id":"/deportes","name":"Fútbol Internacional","description":null,"_id":"/deportes/futbol-internacional","additional_properties":{"original":{"parent":{"header-pro":"/deportes","default":"/deportes","footer-default":null,"menu-pro":"/deportes"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":"Fútbol Internacional"},"_admin":{"alias_ids":["/deportes/futbol-internacional"]},"inactive":false,"node_type":"section","_website":"tromecom","name":"Fútbol Internacional","_id":"/deportes/futbol-internacional","ancestors":{"header-pro":["/deportes"],"default":["/deportes"],"footer-default":[],"menu-pro":["/deportes"]},"order":{}}},"_website_section_id":"tromecom./deportes/futbol-internacional","type":"section","version":"0.6.0"}}},"created_date":"2026-10-25T00:46:26.279Z","publish_date":"2026-10-25T00:57:06.036Z","_id":"ZDLGS4LZTZF33AJX6TTPMFMAKE","website":"tromecom","website_url":"/deportes/futbol-internacional/clasico-barcelona-vs-real-madrid-en-vivo-horarios-y-canales-para-ver-gratis-derby-espanol-laliga-directvgo-kylian-mbappe-lamine-yamal-partidos-de-hoy-noticia/"},{"content_elements":[{"_id":"PJUMWCH3K5HC3EDBR7EGPS6QDQ","additional_properties":{},"type":"text","content":"Agentes del Área de Investigación Criminal (AREINCRI) PNP <a href=\"https://trome.com/actualidad/nacional/juliaca-pobladores-masacran-a-3-policias-y-salvan-de-linchamiento-noticia/\" target=\"_self\" rel=\"\" title=\"https://trome.com/actualidad/nacional/juliaca-pobladores-masacran-a-3-policias-y-salvan-de-linchamiento-noticia/\">Juliaca</a>, en coordinación con personal de la Sección de Inteligencia (SECINT) PNP Juliaca, realizó un operativo policial que permitió la intervención de un establecimiento y la detención de dos personas por su presunta vinculación con el delito contra la dignidad humana, en la modalidad de trata de personas."},{"_id":"WFDAGOCMLNHZVJIG7A7O2M67RE","additional_properties":{},"type":"text","content":"La intervención se realizó en un local denominado ‘Los Palpitos’, ubicado en la intersección de los jirones Santa María y Mama Ocllo, en la ciudad de Juliaca, provincia de San Román."},{"_id":"WFCK37SYHNEFZBFDJ4O3EN64UU","additional_properties":{},"type":"text","content":"Como resultado del operativo, fueron intervenidos un varón y una mujer, quienes serían presuntos integrantes de la banda criminal denominada ‘Los Palpitos de Torococha’. "},{"level":2,"_id":"UFXKNNKFXBEBFPETAEW47Q2PMU","additional_properties":{},"type":"header","content":"<b>RESCATE EN JULIACA</b>"},{"_id":"MQVTC7SOKBDUFIPFIWDQI2ADKM","additional_properties":{},"type":"text","content":"Asimismo, se logró el rescate de cuatro personas femeninas mayores de edad que, según la información policial, realizaban labores como damas de compañía en el establecimiento intervenido. Las personas rescatadas quedaron sujetas a las diligencias y medidas de protección que correspondan, conforme a ley."},{"_id":"WWUZYA7GOJGYDOSZH6GHZ7XZNA","additional_properties":{},"type":"text","content":"Durante el registro preliminar, el personal policial incautó dos talonarios de tickets, tickets sueltos, dos celulares de la marca Redmi y 612 soles en efectivo, especies que serán materia de las diligencias correspondientes para contribuir al esclarecimiento de los hechos."},{"_id":"PRNJH6EJU5DYTLH3WRCPLWBG6I","additional_properties":{},"type":"text","content":"Asimismo, durante las verificaciones de identidad, uno de los intervenidos habría proporcionado inicialmente el nombre de otra persona. "},{"_id":"HHAWVIEIUBEFDFW55JMH4NNA6E","additional_properties":{},"type":"text","content":"Posteriormente, fue identificado plenamente por el personal policial y se verificó que registraba una requisitoria vigente vinculada a una investigación por el presunto delito contra la libertad sexual, en la modalidad de violación sexual de menor de edad, solicitada por el Juzgado Penal Colegiado de Juliaca. "},{"_id":"T7AXO5S4AFARFETAUYQVX7PFAE","additional_properties":{},"type":"text","content":"<b>MÁS INFORMACIÓN:</b>"},{"_id":"L2EKNU2BZBG6LI7L2BNTGONWOQ","additional_properties":{},"type":"text","content":"<a href=\"https://trome.com/actualidad/nacional/callao-hombre-sobrevive-tras-casi-4-horas-sepultado-bajo-tierra-noticia/\" rel=\"\">¡De milagro! Trabajador sobrevive tras casi 4 horas sepultado bajo tierra en el Callao</a>"},{"_id":"B7W6GJPM3FCUBCRJZVUAAKEGBU","additional_properties":{},"type":"text","content":"<a href=\"https://trome.com/actualidad/policiales/la-libertad-presunto-extorsionador-pierde-una-mano-tras-explosion-enc-asa-de-comerciante-casa-grande-video-historias-de-policiales-noticia/\" rel=\"\">Presunto extorsionador pierde la mano cuando dejaba explosivo en casa de comerciante en La Libertad</a>"},{"_id":"FITPLUB2SFHPNPGP3UCIPTJHAE","additional_properties":{},"type":"text","content":"<a href=\"https://trome.com/actualidad/nacional/jorge-chavez-mujer-cae-en-el-aeropuerto-con-joyas-valorizadas-en-3000-mil-soles-fotos-actualidad-noticia/\" rel=\"\">¡Insólito! Llegó de Miami con S/ 300 mil en joyas pegadas al cuerpo y cayó en el Jorge Chávez</a>"}],"subheadlines":{"basic":"Se rescataron a cuatro mujeres que realizaban labores como damas de compañía"},"description":{"basic":"Agentes del Área de Investigación Criminal (AREINCRI) PNP Juliaca, en coordinación con personal de la Sección de Inteligencia (SECINT) PNP Juliaca, realizó un operativo policial que permitió la intervención de un establecimiento y la detención de dos personas por su presunta vinculación con el delito contra la dignidad humana, en la modalidad de trata de personas."},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/actualidad/nacional","parent":{"default":"/actualidad"},"_website":"tromecom","parent_id":"/actualidad","name":"Nacional","description":null,"_id":"/actualidad/nacional","additional_properties":{"original":{"parent":{"header-pro":"/actualidad","default":"/actualidad","menu-default":"/actualidad","footer-default":null,"menu-pro":"/actualidad"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"na