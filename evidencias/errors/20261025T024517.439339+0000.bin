spectáculos, familia, política y más. ","_id":"redaccion-trome","additional_properties":{"original":{"lastName":"Trome","image":"https://s3.amazonaws.com/arc-authors/elcomercio/261f2003-e2e3-42b0-afa5-d943c81ceade.jpg","role":"Periodistas","education":[],"facebook":"Tromepe","affiliations":"trome,tromecom","bio":"Los periodistas de la Redacción Trome informamos con la verdad y de una manera diferente, siempre pensando en ti. Tenemos lo que debes saber para mejorar tu vida, tu día a día. Información importante, interesante y útil. Sobre el Perú y el mundo, en deportes, espectáculos, familia, política y más. ","instagram":"tromeoficial/","expertise":"Periodismo, Periodismo popular, noticias de todo tipo.","author_type":"Personal","firstName":"Redacción","twitter":"tromepe","books":[],"podcasts":[],"personal_website":"https://trome.pe/","awards":[],"beat":"Redacción Trome","_id":"redaccion-trome","bio_page":"/autor/redaccion-trome","last_updated_date":"2022-04-09T05:21:57.420Z","byline":"Redacción Trome","email":"webmaster@trome.com","slug":"redaccion-trome","status":true}},"type":"author","version":"0.5.8","url":"/autor/redaccion-trome","slug":"redaccion-trome"}]},"first_publish_date":"2026-10-24T23:59:43.42Z","additional_properties":{"is_published":true,"has_published_copy":true},"last_updated_date":"2026-10-24T23:59:43.535Z","publishing":{"scheduled_operations":{"unpublish_edition":[],"publish_edition":[]}},"owner":{"sponsored":false,"id":"elcomercio"},"workflow":{"status_code":1},"label":{"facebook_ia":{"display":true,"text":"Si","url":"true"}},"promo_items":{"basic":{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d"},"caption":"Trabajador sobrevivió casi cuatro horas bajo tierra","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png","licensable":false,"planning":{},"credits":{"affiliation":[]},"subtitle":"El joven chalaco narró los difíciles momentos que vivió","width":1200,"_id":"NEPJQJ6NO5B7DFG4KLPFOYNT2A","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d","proxyUrl":"/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png","published":true,"resizeUrl":"/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=300","version":0,"originalName":"hombre-sepultado-callao (1).png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T23:57:18Z","last_updated_date":"2026-10-24T23:57:18Z","height":800,"image_type":"photograph","status":"","resized_urls":{"landscape_xl":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=980&height=528&quality=75&smart=true","landscape_ext_story":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=980&height=355&quality=75&smart=true","landscape_l":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=648&height=374&quality=75&smart=true","landscape_md":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=314&height=157&quality=75&smart=true","landscape_s":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=234&height=161&quality=75&smart=true","landscape_xs":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=118&height=72&quality=75&smart=true","landscape_xxs":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=170&height=90&quality=75&smart=true","portrait_xl":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=528&height=900&quality=75&smart=true","portrait_l":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=374&height=648&quality=75&smart=true","portrait_md":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=314&height=374&quality=75&smart=true","portrait_s":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=161&height=220&quality=75&smart=true","portrait_xs":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=75&height=90&quality=75&smart=true","square_xl":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=900&height=900&quality=75&smart=true","square_l":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=600&height=600&quality=75&smart=true","square_md":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=300&height=300&quality=75&smart=true","square_s":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=150&height=150&quality=75&smart=true","square_xs":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=75&height=75&quality=75&smart=true","small":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=100&height=200&quality=75&smart=true","medium":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=480&quality=75&smart=true","content":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=980&quality=75&smart=true","content_small":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=320&quality=75&smart=true","large":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=940&height=569&quality=75&smart=true","story_small":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=482&height=290&quality=75&smart=true","amp_new":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=1200&height=800&quality=75&smart=true","amp":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=900&height=600&quality=75&smart=true","impresa":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=617&height=637&quality=75&smart=true","impresa_s":"https://trome.com/resizer/v2/NEPJQJ6NO5B7DFG4KLPFOYNT2A.png?auth=0da71de2de9f5a2722b38e3ca4131cc5cc5c6c29f979f162f8bea7bf64e7f53d&width=273&height=289&quality=75&smart=true"}}},"canonical_url":"/actualidad/nacional/callao-hombre-sobrevive-tras-casi-4-horas-sepultado-bajo-tierra-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"tromecom","revision":{"editions":["default"],"parent_id":"D6QFRLEKENG35DBZHVSTEHVNKU","published":true,"branch":"default","revision_id":"YZKT6XIKXFBPPGLWKXKSTG3ESQ"},"planning":{"story_length":{"character_count_actual":2809,"inch_count_actual":4,"word_count_actual":455,"line_count_actual":23}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T23:59:43.42Z","headlines":{"tablet":"","print":"","meta_title":"Callao: Hombre sobrevive tras casi 4 horas sepultado bajo tierra","native":"","web":"","mobile":"","basic":"¡De milagro! Trabajador sobrevive tras casi 4 horas sepultado bajo tierra en el Callao"},"websites":{"tromecom":{"website_url":"/actualidad/nacional/callao-hombre-sobrevive-tras-casi-4-horas-sepultado-bajo-tierra-noticia/","website_section":{"path":"/actualidad/nacional","parent":{"default":"/actualidad"},"_website":"tromecom","parent_id":"/actualidad","name":"Nacional","description":null,"_id":"/actualidad/nacional","additional_properties":{"original":{"parent":{"header-pro":"/actualidad","default":"/actualidad","menu-default":"/actualidad","footer-default":null,"menu-pro":"/actualidad"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":null},"_admin":{"alias_ids":["/actualidad/nacional"]},"inactive":false,"node_type":"section","_website":"tromecom","name":"Nacional","_id":"/actualidad/nacional","ancestors":{"header-pro":["/actualidad"],"default":["/actualidad"],"menu-default":["/","/actualidad"],"footer-default":[],"menu-pro":["/actualidad"]},"order":{"menu-default":2003}}},"_website_section_id":"tromecom./actualidad/nacional","type":"section","version":"0.6.0"}}},"created_date":"2026-10-24T23:39:40.603Z","publish_date":"2026-10-24T23:59:43.42Z","_id":"VVIK2YZF7BCYXIOHFJANSCTFUM","website":"tromecom","website_url":"/actualidad/nacional/callao-hombre-sobrevive-tras-casi-4-horas-sepultado-bajo-tierra-noticia/"},{"content_elements":[{"list_type":"unordered","_id":"HNVSVPZKSVAZJOSZ56SAKCQEPI","type":"list","items":[{"_id":"DHMRP4ZFVFCGHMXR56OXRTNZAM","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/espectaculos/tv/andrea-san-martin-y-su-insolita-reaccion-tras-quedar-en-libertad-por-denuncia-de-presunto-maltrato-a-su-hija-foto-video-farandula-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/espectaculos/tv/andrea-san-martin-y-su-insolita-reaccion-tras-quedar-en-libertad-por-denuncia-de-presunto-maltrato-a-su-hija-foto-video-farandula-noticia/\">Andrea San Martín llama la atención con su actitud tras quedar libre por grave denuncia: ¿cómo reaccionó?</a>"}]},{"_id":"Y5EQ6SMPYJBLNNGTGYGT66B44U","additional_properties":{},"type":"text","content":"¡ATENCIÓN! <a href=\"https://trome.com/espectaculos/tv/andrea-san-martin-sale-en-libertad-tras-grave-denuncia-en-su-contra-por-presunto-maltrato-a-su-hija-foto-video-farandula-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/espectaculos/tv/andrea-san-martin-sale-en-libertad-tras-grave-denuncia-en-su-contra-por-presunto-maltrato-a-su-hija-foto-video-farandula-noticia/\">Andrea San Martín</a> recuperó su libertad el viernes 23 de octubre, luego de permanecer cerca de 40 horas detenida en la comisaría de Miraflores por la denuncia de <b>Juan Víctor Sánchez</b>, padre de su hija menor, por presunto maltrato. Tras su salida, Leysi Suárez reveló a <b>Samuel Suárez </b>que la ex chica reality se pronunciará públicamente sobre lo sucedido."},{"_id":"X62LFEMDV5ARTENAXG6ZBRTUGQ","title":"MIRA TAMBIÉN:","type":"link_list","items":[{"image":{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"5679cfe3315525509616923a6b312bf9d7393b9ba846cf4352406041b170305c"},"vanity_credits":{"by":[{"name":"","type":"author"}]},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/ZRVODV6JRJFANDBHIKOQRFQT3Y.png","licensable":false,"alt_text":"Magaly Medina hace personal confesión en entrevista con Pamela López.","credits":{"affiliation":[]},"subtitle":"","width":1013,"_id":"ZRVODV6JRJFANDBHIKOQRFQT3Y","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/ZRVODV6JRJFANDBHIKOQRFQT3Y.png?auth=5679cfe3315525509616923a6b312bf9d7393b9ba846cf4352406041b170305c","proxyUrl":"/resizer/v2/ZRVODV6JRJFANDBHIKOQRFQT3Y.png?auth=5679cfe3315525509616923a6b312bf9d7393b9ba846cf4352406041b170305c","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/ZRVODV6JRJFANDBHIKOQRFQT3Y.png","published":true,"resizeUrl":"/resizer/v2/ZRVODV6JRJFANDBHIKOQRFQT3Y.png?auth=5679cfe3315525509616923a6b312bf9d7393b9ba846cf4352406041b170305c","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/ZRVODV6JRJFANDBHIKOQRFQT3Y.png?auth=5679cfe3315525509616923a6b312bf9d7393b9ba846cf4352406041b170305c&width=300","version":0,"originalName":"magaly medina.png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T01:51:11Z","last_updated_date":"2026-10-24T01:51:11Z","height":676,"image_type":"photograph","status":""},"description":{"_id":"WVXGMKLC3JDZXIDPHZPEMFCMKA","type":"text","content":""},"_id":"AJAK6AS6IFGSHOKN4MFKOOCUKE","additional_properties":{"nofollow":false,"sponsored":false,"openInNewTab":false},"type":"interstitial_link","content":"Magaly Medina hace personal confesión sobre el padre de su hijo y ella: “¿Tú crees que yo...?\"","url":"https://trome.com/espectaculos/tv/magaly-medina-hace-personal-confesion-sobre-el-padre-de-su-hijo-y-ella-tu-crees-que-yo-me-peleaba-foto-video-farandula-noticia/"},{"image":{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"f2d153996bf573cd9668ffbcdba8a0cf85c438a0abbc0a7bb8d3c85f48c6a464"},"vanity_credits":{"by":[{"name":"","type":"author"}]},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/ENAOTD7M2BB5LLEXGQ5WA76FPQ.png","licensable":false,"alt_text":"Suheyn Cipriani rompe en llanto al dejar pódcast por el Miss Perú.","credits":{"affiliation":[]},"subtitle":"","width":1016,"_id":"ENAOTD7M2BB5LLEXGQ5WA76FPQ","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/ENAOTD7M2BB5LLEXGQ5WA76FPQ.png?auth=f2d153996bf573cd9668ffbcdba8a0cf85c438a0abbc0a7bb8d3c85f48c6a464","proxyUrl":"/resizer/v2/ENAOTD7M2BB5LLEXGQ5WA76FPQ.png?auth=f2d153996bf573cd9668ffbcdba8a0cf85c438a0abbc0a7bb8d3c85f48c6a464","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/ENAOTD7M2BB5LLEXGQ5WA76FPQ.png","published":true,"resizeUrl":"/resizer/v2/ENAOTD7M2BB5LLEXGQ5WA76FPQ.png?auth=f2d153996bf573cd9668ffbcdba8a0cf85c438a0abbc0a7bb8d3c85f48c6a464","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/ENAOTD7M2BB5LLEXGQ5WA76FPQ.png?auth=f2d153996bf573cd9668ffbcdba8a0cf85c438a0abbc0a7bb8d3c85f48c6a464&width=300","version":0,"originalName":"Suheyn cipriani.png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-23T23:33:50Z","last_updated_date":"2026-10-23T23:33:50Z","height":674,"image_type":"photograph","status":""},"description":{"_id":"NHLZWQI4WBGWHKI7T2VBWDCDW4","type":"text","content":""},"_id":"SO7Z76GIUNAWNH245NCZYRUJ7A","additional_properties":{"nofollow":false,"sponsored":false,"openInNewTab":false},"type":"interstitial_link","content":"Suheyn Cipriani llora desconsoladamente al anunciar importante decisión: “Es mi sueño más grande”","url":"https://trome.com/espectaculos/tv/suheyn-cipriani-llora-desconsoladamente-al-anunciar-su-renuncia-a-podcast-por-el-miss-peru-2027-es-mi-sueno-mas-grande-foto-video-farandula-noticia/"}]},{"_id":"JWLGFPXZKNBFZO3AV5435XBDTM","additional_properties":{},"type":"text","content":"La amiga de la ‘ojiverde’ le reveló al conductor de Q’Bochinche! qué pasará con la exchica reality ahora que está fuera de la dependecia policial. La conductora radial confirmó que Andrea sí saldrá a hablar, tal como lo dijo a la prensa cuando quedó intervenida."},{"_id":"COIJI65IT5GWZMUFCCE4WDNQLI","additional_properties":{},"type":"text","content":"<mark class=\"hl_yellow\"><i><b>“Pero, yo le dije: ¿Qué va pasar?“</b></i></mark>, es lo que le preguntó ‘Samu’ a Suárez. Ella le respondió: <mark class=\"hl_yellow\"><i><b>”Y me dijo: ‘Andrea va a hablar en las próximas horas’ y va a dar una versión que no ha podido dar y muchos lo van a entender\".</b></i></mark>"},{"_id":"3ZVXJSEK35GTVGHGSMGNDIEOWU","additional_properties":{},"type":"text","content":"Sin embargo, el periodista se mostró sorprendido con lo que podría decir Andrea San Martín próximamente, pues la denuncia que recae contra ella es sumamente grave y delicada. <mark class=\"hl_yellow\"><i><b>“Pero, ¿qué tanto se puede entender luego de lo visto? Creo que es complicada la situación, porque ¿cómo vas a justificar tanta intervención policial?, ¿qué explicación me vas a dar para eso?“,</b></i></mark> resaltó."},{"_id":"NYGFPVPL5ZCJ5CDG6ZJDLMLRX4","additional_properties":{},"type":"text","content":"“<i>Yo sé Leysi que eres amiga de Andrea, que le deseamos lo mejor, pero que en sus cinco minutos haya cometido una tontería y media, tampoco podemos meter las manos al fuego por nadie”</i>, añadió."},{"_id":"HVSX45WIGRGOZO73VKKFDWZX74","additional_properties":{},"type":"text","content":"Samuel Suárez no quiso dar más detalles sobre la conversación que tuvo con la amiga de la exchica reality, pues fue una petición expresa de ella. <i>“No lo voy a compartir porque me dijo que lo maneje a la interna”</i>, finalizó."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"e1ce9961267ad59e86b890d17fdb02f03c198f7d809d49bb7d3d9fe71fa227e8"},"caption":"Samuel Suárez lanza información porporcionada por Leysi Suárez sobre Andrea San Martín, quien quedó en libertad tras fuerte denuncia.","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/CYIHEMD7NBF73K7VHM7IBMJ6BY.png","licensable":false,"alt_text":"Samuel Suárez lanza información porporcionada por Leysi Suárez sobre Andrea San Martín, quien quedó en libertad tras fuerte denuncia.","credits":{"affiliation":[]},"subtitle":"Samuel Suárez","width":1183,"_id":"CYIHEMD7NBF73K7VHM7IBMJ6BY","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/CYIHEMD7NBF73K7VHM7IBMJ6BY.png?auth=e1ce9961267ad59e86b890d17fdb02f03c198f7d809d49bb7d3d9fe71fa227e8","proxyUrl":"/resizer/v2/CYIHEMD7NBF73K7VHM7IBMJ6BY.png?auth=e1ce9961267ad59e86b890d17fdb02f03c198f7d809d49bb7d3d9fe71fa227e8","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/CYIHEMD7NBF73K7VHM7IBMJ6BY.png","published":true,"resizeUrl":"/resizer/v2/CYIHEMD7NBF73K7VHM7IBMJ6BY.png?auth=e1ce9961267ad59e86b890d17fdb02f03c198f7d809d49bb7d3d9fe71fa227e8","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/CYIHEMD7NBF73K7VHM7IBMJ6BY.png?auth=e1ce9961267ad59e86b890d17fdb02f03c198f7d809d49bb7d3d9fe71fa227e8&width=300","version":0,"originalName":"samuel suarez.png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T03:38:23Z","last_updated_date":"2026-10-24T03:38:23Z","height":655,"image_type":"photograph","status":""},{"level":2,"_id":"FLQ5LPUZGZHH7ONCC2WGQR5U4Q","additional_properties":{},"type":"header","content":"<b>Andrea San Martín sale libre</b>"},{"_id":"BXLRXHWQLFFWNLJFG5FFHH3SIM","additional_properties":{},"type":"text","content":"La tarde de este viernes 23 de octubre, Andrea San Martín logró salir en libertad luego de 48 horas de haber estado detenida por presunto maltrato a su hija más pequeña."},{"_id":"GBRXZED4CNBXNE7MFHXYPKU5OM","additional_properties":{},"type":"text","content":"La exmodelo y empresaria ingresó a un vehículo y no dio declaración alguna a la prensa. Ella mantuvo en todo momento la mirada al frente y cruzó las piernas estando sentada, mientras la prensa buscaba sus primeras palabras."},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"a24f0fbb391106c264b6bef198cdef0b5356ff86c8666a532d506c27d7aede65"},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/AGT7N6XUSBEOPPRQ7TQQHIH5BM.jpeg","licensable":false,"credits":{"affiliation":[]},"subtitle":"Andrea San Martín","width":1200,"_id":"AGT7N6XUSBEOPPRQ7TQQHIH5BM","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/AGT7N6XUSBEOPPRQ7TQQHIH5BM.jpeg?auth=a24f0fbb391106c264b6bef198cdef0b5356ff86c8666a532d506c27d7aede65","proxyUrl":"/resizer/v2/AGT7N6XUSBEOPPRQ7TQQHIH5BM.jpeg?auth=a24f0fbb391106c264b6bef198cdef0b5356ff86c8666a532d506c27d7aede65","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/AGT7N6XUSBEOPPRQ7TQQHIH5BM.jpeg","published":true,"resizeUrl":"/resizer/v2/AGT7N6XUSBEOPPRQ7TQQHIH5BM.jpeg?auth=a24f0fbb391106c264b6bef198cdef0b5356ff86c8666a532d506c27d7aede65","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/AGT7N6XUSBEOPPRQ7TQQHIH5BM.jpeg?auth=a24f0fbb391106c264b6bef198cdef0b5356ff86c8666a532d506c27d7aede65&width=300","version":0,"originalName":"WhatsApp Image 2026-10-23 at 1.54.21 PM.jpeg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-23T18:55:54Z","last_updated_date":"2026-10-23T18:55:54Z","height":800,"image_type":"photograph","status":""},{"level":2,"_id":"GOUOYEG65JGATD2XIGCMDXE6MM","additional_properties":{},"type":"header","content":"<b>ANDREA HABLA TRAS LIBERACIÓN</b>"},{"_id":"TUUJ6WE7VRHW3EHNRHVYIXOJTU","additional_properties":{},"type":"text","content":"Para las cámaras, <b>Andrea San Martín</b> evitó profundizar en el tema y aseguró que explicará lo ocurrido cuando se encuentre más tranquila. <mark class=\"hl_yellow\"><i><b>“Mi cerebro en este momento solo está en la situación que ustedes han visto desde que he llegado. No quiero agregar de más ni quitar ni restar ni nada, es lo que es y punto”</b></i></mark>, declaró."},{"_id":"TWKUJDMO4VAVJLI56XKDI673PI","additional_properties":{},"type":"text","content":"Asimismo, evitó dar una opinión sobre <b>Juan Víctor Sánchez. </b><mark class=\"hl_yellow\"><i><b>“Quisiera no hablar absolutamente nada de nadie. Solamente eso, nada más. Ya lo demás tiene un camino que se tiene que respetar”</b></i></mark>, sostuvo."},{"level":2,"_id":"JYGEDWUC2BGKLGTBW7AKNEL2LM","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><b>TE PUEDE INTERESAR</b></mark>"},{"list_type":"unordered","_id":"ZUE2GIHJLFDIBPR5GQKSKOSMI4","type":"list","items":[{"_id":"4I7JI4UX4JHN7OX3R7C2HW2CEQ","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/espectaculos/tv/melcochita-pablo-villanueva-tiene-fuerte-pelea-en-vivo-con-sus-hijas-mayores-tras-compra-de-departamento-a-nombre-de-heydi-amado-es-problema-mio-foto-video-farandula-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/espectaculos/tv/melcochita-pablo-villanueva-tiene-fuerte-pelea-en-vivo-con-sus-hijas-mayores-tras-compra-de-departamento-a-nombre-de-heydi-amado-es-problema-mio-foto-video-farandula-noticia/\">¡Melcochita estalla! Se enfrenta EN VIVO a sus hijas por ‘depa’ a nombre de Heydi: “Es problema mío”</a>"},{"_id":"VVTCOH6JJJHB5G7NMJT6FU7F44","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/espectaculos/tv/natalie-vertiz-impacta-al-anunciar-el-gran-paso-que-dio-junto-a-yaco-eskenazi-los-rumores-son-ciertos-foto-video-farandula-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/espectaculos/tv/natalie-vertiz-impacta-al-anunciar-el-gran-paso-que-dio-junto-a-yaco-eskenazi-los-rumores-son-ciertos-foto-video-farandula-noticia/\">¿Se agranda la familia? Natalie Vértiz deja en shock al anunciar el gran paso que dio junto a Yaco Eskenazi: “Los rumores son ciertos”</a>"},{"_id":"AXR7LKUKG5EBXPNIFOCKB5XBZI","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/espectaculos/tv/alessia-rovegno-magaly-medina-se-pronuncia-por-apariencia-de-la-modelo-y-advierte-sobre-los-trastornos-alimentarios-foto-video-farandula-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/espectaculos/tv/alessia-rovegno-magaly-medina-se-pronuncia-por-apariencia-de-la-modelo-y-advierte-sobre-los-trastornos-alimentarios-foto-video-farandula-noticia/\">Alessia Rovegno genera preocupación por su extrema delgadez y Magaly alerta sobre los trastornos alimentarios: “Debemos ir en apoyo”</a>"}]},{"subtype":"about_author","_id":"D45V3SCDA5CKNHDLFS62VJZ7IU","embed":{"id":"1792812947884","config":{"authorTwitter":"tromepe","authorSlug":"redaccion-farandula","authorName":"Redacción Farándula","authorImage":"https://s3.amazonaws.com/arc-authors/elcomercio/60f1ba02-0012-4ed9-81e1-31cc5411d04c.jpg","authorLinkedIn":"","authorBio":"Somos el mejor equipo tras la farándula peruana. De 'Chollywood', con amor. Historias confirmadas, contrastadas y verificadas. Porque tu entretenimiento es una cosa muy seria para nosotros."},"url":"/pf/api/v3/content/fetch/photo-by-id"},"type":"custom_embed"},{"_id":"KIKXFYMK7FCPRNRRBTBVBV4Q3E","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"Leysi Suárez soltó una importante información sobre la ex chica reality tras su salida de la comisaría de Miraflores."},"description":{"basic":"Leysi Suárez le informó a Samuel Suárez qué ocurrirá con Andrea San Martín tras quedar libre luego de 40 horas en una comisaría tras ser denunciada por Juan Víctor."},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/espectaculos/tv","parent":{"default":"/espectaculos"},"_website":"tromecom","parent_id":"/espectaculos","name":"Tv","description":null,"_id":"/espectaculos/tv","additional_properties":{"original":{"parent":{"header-pro":"/espectaculos","default":"/espectaculos","menu-default":"/espectaculos","footer-default":null,"menu-pro":"/espectaculos"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":null},"_admin":{"alias_ids":["/espectaculos/tv"]},"inactive":false,"node_type":"section","_website"