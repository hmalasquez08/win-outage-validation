id":"1792813465381-469765","config":{"date":1792813044,"duration":"89.43","conversions":[{"duration":"89.33","template":{"format":{"name":"H.264 Baseline","key":"mp4"},"name":"180p","id":33450662,"key":"AoJUfW3e","required":true},"link":{"path":"/videos/LAwPbvM1-AoJUfW3e.mp4","protocol":"http","address":"cdn.jwplayer.com"},"width":320,"filesize":"2946506","mediatype":"video","key":"aUnPTnQJ","height":144,"status":"Ready"}],"has_ads":0,"size":"59270123","description":"Leysi Suárez le informó a Samuel Suárez qué ocurrirá con Andrea San Martín tras quedar libre luego de 40 horas en una comisaría tras denunciada por Juan Víctor. <a href=\"\"></a>","thumbnail_url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/NZ426W7OLBBDVHDUFQWJHPKIGM.png","title":"TROME - Lanzan importante información sobre Andrea San Martín tras liberación luego de grave denuncia: “En las próximas horas...”","updated":1792813445,"account":"gec","key":"LAwPbvM1","status":"ready"},"url":"/pf/api/v3/content/fetch/photo-by-id"},"type":"custom_embed"}},"canonical_url":"/espectaculos/tv/andrea-san-martin-lanzan-importante-informacion-sobre-la-exchica-reality-tras-liberacion-luego-de-grave-denuncia-en-las-proximas-horas-foto-video-farandula-noticia/","distributor":{"name":"elcomercio","category":"staff","subcategory":""},"version":"0.10.11","canonical_website":"tromecom","revision":{"editions":["default"],"parent_id":"4LWBOZI22ZDAXJETLQEKVVONAA","published":true,"branch":"default","revision_id":"DJKWH236VRH2LCABBDBKID73TI"},"planning":{"story_length":{"character_count_actual":3088,"inch_count_actual":4,"word_count_actual":537,"line_count_actual":25}},"content_restrictions":{"content_code":"metered"},"display_date":"2026-10-24T23:50:00Z","headlines":{"tablet":"","print":"","meta_title":"Andrea San Martín: Lanzan importante información sobre la exchica reality tras liberación luego de grave denuncia: “En las próximas horas...” | foto | video | farandula","native":"","web":"","mobile":"","ba