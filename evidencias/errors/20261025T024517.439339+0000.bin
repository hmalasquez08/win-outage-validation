e96578b86fae96edaf26"},"vanity_credits":{"by":[{"name":"","type":"author"}]},"caption":"","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/DMT7BWLCG5G2ZB55MOUD77D2WQ.png","licensable":false,"credits":{"affiliation":[]},"subtitle":"","width":1200,"_id":"DMT7BWLCG5G2ZB55MOUD77D2WQ","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/DMT7BWLCG5G2ZB55MOUD77D2WQ.png?auth=712340fc956db2b0c18b5a787b9a96e4ac4179d6c53ee96578b86fae96edaf26","proxyUrl":"/resizer/v2/DMT7BWLCG5G2ZB55MOUD77D2WQ.png?auth=712340fc956db2b0c18b5a787b9a96e4ac4179d6c53ee96578b86fae96edaf26","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/DMT7BWLCG5G2ZB55MOUD77D2WQ.png","published":true,"resizeUrl":"/resizer/v2/DMT7BWLCG5G2ZB55MOUD77D2WQ.png?auth=712340fc956db2b0c18b5a787b9a96e4ac4179d6c53ee96578b86fae96edaf26","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/DMT7BWLCG5G2ZB55MOUD77D2WQ.png?auth=712340fc956db2b0c18b5a787b9a96e4ac4179d6c53ee96578b86fae96edaf26&width=300","version":0,"originalName":"LEONARD LEÓN y su esposa OLENKA también promocionaron los helados de MELANIE MARTÍNEZ (4).png","mime_type":"image/png","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T13:49:30Z","last_updated_date":"2026-10-24T13:49:30Z","height":800,"image_type":"photograph","status":""},"description":{"_id":"3NUMGZXMZJGUVND23XE4FF4OMM","type":"text","content":""},"_id":"XKPIFHG3GJB3NNJIKR6HMWIECQ","additional_properties":{"nofollow":false,"sponsored":false,"openInNewTab":false},"type":"interstitial_link","content":"¡22 segundos de horror! Sicario tumbó de su moto a criador de perros y lo acribilló: todo quedó grabado","url":"https://trome.com/actualidad/policiales/chorrillos-sicario-tumbo-de-su-moto-a-criador-de-perros-y-lo-mato-a-balazos-foto-video-historia-de-policiales-noticia/"}]},{"_id":"5THOVMZ5NRBILOJT2BWQTQ3UIU","additional_properties":{},"type":"text","content":"<b>En las imágenes registradas se puede ver cómo un sujeto con gorra se acerca a la mototaxi y dispara contra el conductor</b>. El pasajero y el asesino huyeron corriendo del lugar, mientras que los testigos también escapan asustados."},{"_id":"TD33N74ZVZGX5MXIF4UA6FUKLM","additional_properties":{},"type":"text","content":"Hasta el lugar llegaron policías de la comisaría de <mark class=\"hl_yellow\"><b>Santa Elizabeth</b></mark> y peritos de criminalística, quienes recogieron evidencias que permitan la captura de los asesinos."},{"_id":"CJXMHF6ZT5DHTPNZNEIPBF4YQY","additional_properties":{},"type":"text","content":"Familiares de la víctima llegaron hasta esta zona de<mark class=\"hl_yellow\"><b> San Juan de Lurigancho</b></mark>, donde protagonizaron trágicas escenas de dolor. Ellos afirmaron que la víctima, identificada como Giancarlo Alva Herrera (33), deja dos hijas en la orfandad."},{"owner":{"id":"elcomercio"},"address":{},"syndication":{"search":"","external_distribution":""},"auth":{"1":"ec5abb9c57139f0b23b8e7ded761cecab8ebbb4b1fab04e90d809e090440c919"},"caption":"Cámaras de seguridad registraron momento del crimen en San Juan de Lurigancho. (América Noticias)","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/BXAJK2TRBBHUVPNMS54YY3L2SI.jpg","licensable":false,"alt_text":"Asesinan a mototaxista en San Juan de Lurigancho","credits":{"affiliation":[]},"subtitle":"Asesinan a mototaxista en San Juan de Lurigancho","width":514,"_id":"BXAJK2TRBBHUVPNMS54YY3L2SI","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/BXAJK2TRBBHUVPNMS54YY3L2SI.jpg?auth=ec5abb9c57139f0b23b8e7ded761cecab8ebbb4b1fab04e90d809e090440c919","proxyUrl":"/resizer/v2/BXAJK2TRBBHUVPNMS54YY3L2SI.jpg?auth=ec5abb9c57139f0b23b8e7ded761cecab8ebbb4b1fab04e90d809e090440c919","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/BXAJK2TRBBHUVPNMS54YY3L2SI.jpg","published":true,"resizeUrl":"/resizer/v2/BXAJK2TRBBHUVPNMS54YY3L2SI.jpg?auth=ec5abb9c57139f0b23b8e7ded761cecab8ebbb4b1fab04e90d809e090440c919","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/BXAJK2TRBBHUVPNMS54YY3L2SI.jpg?auth=ec5abb9c57139f0b23b8e7ded761cecab8ebbb4b1fab04e90d809e090440c919&width=300","version":0,"originalName":"san juan lurigancho asesinato mototaxista 2.jpg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T23:20:48Z","last_updated_date":"2026-10-24T23:20:48Z","height":331,"image_type":"photograph","status":""},{"level":2,"_id":"JF7SR7ZVWZBSNJ6I3LP3PFUZCY","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><b>Otro mototaxista asesinado en San Juan de Lurigancho</b></mark>"},{"_id":"LHXS5E45YZGZFLM4DGIMEMB4IU","additional_properties":{},"type":"text","content":"El crimen del mototaxista del mototaxista de Alva Herrera, ocurre a pocos días del asesinato de Gustavo Niño de la Torre, en un paradero informal de la urbanización Los Álamos, en Canto Grande, <b>también en San Juan de Lurigancho.</b>"},{"_id":"BNK4W4THMFG6VHA6DJGREB7LEQ","additional_properties":{},"type":"text","content":"Sobre la muerte de Giancarlo Alva, la policía de San Juan de Lurigancho maneja dos hipótesis: <mark class=\"hl_yellow\"><b>Una venganza o un ataque por el cobro de cupos.</b></mark>"},{"_id":"5C6RV6J4CZDITFARENGUMRS6CA","additional_properties":{},"type":"text","content":"MÁS INFORMACIÓN:"},{"_id":"6CYN4XILXBBIHNVOOLLTN254FU","additional_properties":{},"type":"text","content":"<a href=\"https://trome.com/actualidad/policiales/chorrillos-tesorera-desaparece-con-15-mil-soles-y-escolares-de-colegio-se-quedarian-sin-fiesta-de-graduacion-fiesta-de-promocion-video-historia-de-policiales-noticia/\" rel=\"\">¡Tesorera desaparece con 15 mil soles! Escolares se quedarían sin fiesta de graduación en Chorrillos</a>"},{"_id":"QWMCYF46LJF2FCZDM6CVEGIZNA","additional_properties":{},"type":"text","content":"<a href=\"https://trome.com/actualidad/policiales/gatilleros-de-lima-norte-cortadito-afirma-es-cobrador-de-combi-y-no-extorsionador-video-chikiplum-noticia/\" rel=\"\">‘Cortadito’ de los ‘Gatilleros de Lima Norte’ afirma es cobrador de combi y no extorsionador | VIDEO</a>"},{"_id":"DU2TFHNRQNBVPC5C3F55DXBCWY","additional_properties":{},"type":"text","content":"<a href=\"https://trome.com/actualidad/policiales/joven-empresaria-deja-el-peru-tras-amenazas-y-ataques-de-extorsionadores-fotos-videos-policiales-noticia/\" rel=\"\">¡La tienen aterrada! Joven empresaria se va del país por miedo a que la maten tras casi un año bajo amenazas</a>"},{"subtype":"about_author","_id":"5JT7M75YTJCXLNCTFHJAZKCNMI","embed":{"id":"1792883788263","config":{"authorTwitter":"tromepe","authorSlug":"redaccion-trome","authorName":"Redacción Trome","authorImage":"https://s3.amazonaws.com/arc-authors/elcomercio/261f2003-e2e3-42b0-afa5-d943c81ceade.jpg","authorLinkedIn":"","authorBio":"Los periodistas de la Redacción Trome informamos con la verdad y de una manera diferente, siempre pensando en ti. Tenemos lo que debes saber para mejorar tu vida, tu día a día. Información importante, interesante y útil. Sobre el Perú y el mundo, en deportes, espectáculos, familia, política y más. "},"url":"/pf/api/v3/content/fetch/photo-by-id"},"type":"custom_embed"},{"_id":"FMXBEDA7ZNHKLCK5S3WC2XR4FA","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"Cámaras de seguridad registraron nuevo crimen en San Juan de Lurigancho"},"description":{"basic":"Cámaras de seguridad registraron nuevo crimen en San Juan de Lurigancho"},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/actualidad/policiales","parent":{"default":"/actualidad"},"_website":"tromecom","parent_