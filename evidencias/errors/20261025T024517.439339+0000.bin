:["/","/actualidad"],"footer-default":[],"menu-pro":["/actualidad"]},"order":{"menu-default":2002}}},"_website_section_id":"tromecom./actualidad/policiales","type":"section","version":"0.6.0"}}},"created_date":"2026-10-25T02:13:29.412Z","publish_date":"2026-10-25T02:21:58.279Z","_id":"E262AUNKGFD6ZMBAM7R67V6KII","website":"tromecom","website_url":"/actualidad/policiales/la-victoria-arrendadora-rompe-en-llanto-porque-inquilina-solo-pago-un-mes-y-no-quiere-irse-de-departamento-video-historia-de-policiales-noticia/"},{"content_elements":[{"list_type":"unordered","_id":"HYFXZTLA25CPFDEPY2I7WRUGAM","type":"list","items":[{"_id":"WG7RQKJHENAJFE3GQYBZSEHDGA","additional_properties":{"indent":0},"alignment":"center","type":"text","content":"<a href=\"https://trome.com/espectaculos/musica/brunella-torpoco-celebra-su-aniversario-a-lo-grande-y-reune-a-la-india-tony-succar-y-mas-estrellas-foto-video-conciertos-en-lima-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/espectaculos/musica/brunella-torpoco-celebra-su-aniversario-a-lo-grande-y-reune-a-la-india-tony-succar-y-mas-estrellas-foto-video-conciertos-en-lima-noticia/\">Brunella Torpoco celebra su aniversario a lo grande y reúne a La India, Tony Succar y más estrellas</a>"}]},{"_id":"XX4PIS4T3JBOFLVYQVZHO2BB6U","additional_properties":{},"type":"text","content":"¡HABLÓ! <a href=\"https://trome.com/espectaculos/tv/andrea-san-martin-lanzan-importante-informacion-sobre-la-exchica-reality-tras-liberacion-luego-de-grave-denuncia-en-las-proximas-horas-foto-video-farandula-noticia/\" target=\"_self\" rel=\"\" title=\"https://trome.com/espectaculos/tv/andrea-san-martin-lanzan-importante-informacion-sobre-la-exchica-reality-tras-liberacion-luego-de-grave-denuncia-en-las-proximas-horas-foto-video-farandula-noticia/\"><b>Andrea San Martín</b></a> rompió su silencio tras recuperar su libertad e inmediatamente intentó reencontrarse con su hija. La influencer fue abordada por las cámaras de ‘Desvelados’, de América Televisión, indicando que su mentalidad está 100% en su pequeña."},{"_id":"E5TNBQ45HNHO3AMVB3ZZTXLICU","additional_properties":{},"type":"text","content":"<mark class=\"hl_yellow\"><i><b>“Yo tengo experiencia en este tipo de situaciones y necesito afrontarlas de una manera mucho más inteligente”</b></i></mark>, manifestó la exchica reality, quien adelantó que muy pronto brindará detalles del caso. Sin embargo, dejó en claro que, por el momento, prefiere mantener la calma y concentrarse en las diligencias relacionadas con su pequeña. "},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"a02fe2b989b3aaf23c89ed1f0d23701560e5097d9494eebe8441718701a59516"},"caption":"La 'ojiverde' no pudo reencontrase con su hija menor tras pasar cerca de 40 horas en la comisaría","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/POGPBOJ2SBAYPGHILIIQFV3ST4.jpeg","licensable":false,"planning":{},"credits":{"affiliation":[]},"subtitle":"Andrea va a casa de Juan Víctor a busca a su hija","width":1842,"_id":"POGPBOJ2SBAYPGHILIIQFV3ST4","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/POGPBOJ2SBAYPGHILIIQFV3ST4.jpeg?auth=a02fe2b989b3aaf23c89ed1f0d23701560e5097d9494eebe8441718701a59516","proxyUrl":"/resizer/v2/POGPBOJ2SBAYPGHILIIQFV3ST4.jpeg?auth=a02fe2b989b3aaf23c89ed1f0d23701560e5097d9494eebe8441718701a59516","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/POGPBOJ2SBAYPGHILIIQFV3ST4.jpeg","published":true,"resizeUrl":"/resizer/v2/POGPBOJ2SBAYPGHILIIQFV3ST4.jpeg?auth=a02fe2b989b3aaf23c89ed1f0d23701560e5097d9494eebe8441718701a59516","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/POGPBOJ2SBAYPGHILIIQFV3ST4.jpeg?auth=a02fe2b989b3aaf23c89ed1f0d23701560e5097d9494eebe8441718701a59516&width=300","version":0,"originalName":"Captura de pantalla_24-10-2026_10645_www.americatv.com.pe.jpeg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T15:09:07Z","last_updated_date":"2026-10-24T15:09:07Z","height":857,"image_type":"photograph","status":""},{"level":2,"_id":"33QXDQTVI5AMTMUEQZJU65JYTQ","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><b>Andrea San Martín asegura que lleva horas intentando comunicarse con su hija</b></mark>"},{"_id":"R5YFYY6W2NFB5BSBWW2CHOS7IE","additional_properties":{},"type":"text","content":"<b>Andrea San Martín</b> aseguró que llevaba varias horas intentando comunicarse con ella, pero que hasta ese momento no había obtenido respuesta. <mark class=\"hl_yellow\"><i><b>“Tengo cuatro horas tratando de comunicarme. Hasta el momento, nada”</b></i></mark>, expresó ante las cámaras."},{"_id":"W5JCISMUMVHANJ45ZAOYNOVU3Q","additional_properties":{},"type":"text","content":"Tras salir de la dependencia policial, la influencer acudió acompañada de efectivos policiales a la vivienda de <b>Juan Víctor Sánchez</b>, padre de la menor. No obstante, pese a tocar el timbre en reiteradas ocasiones, no obtuvo respuesta y no logró reencontrarse con su hija. El conserje del edificio le indicó que el padre no se encontraba. "},{"owner":{"sponsored":false,"id":"elcomercio"},"address":{},"syndication":{"search":false,"external_distribution":false},"auth":{"1":"b60e33843d8d697f910d4cba8c0ad23eae04dd3224c04d43233c214c2cc57b70"},"caption":"'La ojiverde' explicó que, por ahora, solo busca estar tranquila.","source":{"system":"photo center","edit_url":"","additional_properties":{"editor":"photo center"}},"taxonomy":{"associated_tasks":[]},"type":"image","version":"0.10.9","url":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/XM6SSECMZVGVBASQQLIXEIEZ5Y.jpeg","licensable":false,"planning":{},"credits":{"affiliation":[]},"subtitle":"Andrea San Martín detalló que explicará todo en una conferencia de prensa","width":1867,"_id":"XM6SSECMZVGVBASQQLIXEIEZ5Y","additional_properties":{"fullSizeResizeUrl":"/resizer/v2/XM6SSECMZVGVBASQQLIXEIEZ5Y.jpeg?auth=b60e33843d8d697f910d4cba8c0ad23eae04dd3224c04d43233c214c2cc57b70","proxyUrl":"/resizer/v2/XM6SSECMZVGVBASQQLIXEIEZ5Y.jpeg?auth=b60e33843d8d697f910d4cba8c0ad23eae04dd3224c04d43233c214c2cc57b70","originalUrl":"https://cloudfront-us-east-1.images.arcpublishing.com/elcomercio/XM6SSECMZVGVBASQQLIXEIEZ5Y.jpeg","published":true,"resizeUrl":"/resizer/v2/XM6SSECMZVGVBASQQLIXEIEZ5Y.jpeg?auth=b60e33843d8d697f910d4cba8c0ad23eae04dd3224c04d43233c214c2cc57b70","ingestionMethod":"manual","thumbnailResizeUrl":"/resizer/v2/XM6SSECMZVGVBASQQLIXEIEZ5Y.jpeg?auth=b60e33843d8d697f910d4cba8c0ad23eae04dd3224c04d43233c214c2cc57b70&width=300","version":0,"originalName":"Captura de pantalla_24-10-2026_10657_www.americatv.com.pe.jpeg","mime_type":"image/jpeg","restricted":false,"template_id":302,"galleries":[]},"created_date":"2026-10-24T15:13:38Z","last_updated_date":"2026-10-24T15:13:38Z","height":850,"image_type":"photograph","status":""},{"level":2,"_id":"GDKRZANAYJABZGX42UIRBAOAKI","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><b>Andrea San Martín anuncia que contará su versión de los hechos</b></mark>"},{"_id":"5VYKTTVPOVBZ3G7K2A75N2BNQM","additional_properties":{},"type":"text","content":"<b>Andrea San Martín</b> evitó profundizar en el tema y aseguró que explicará lo ocurrido cuando se encuentre más tranquila. <mark class=\"hl_yellow\"><i><b>“Mi cerebro en este momento solo está en la situación que ustedes han visto desde que he llegado. No quiero agregar de más ni quitar ni restar ni nada, es lo que es y punto”</b></i></mark>, declaró."},{"_id":"KIQWY7PBGRDYZPBIVPMLA7YJLA","additional_properties":{},"type":"text","content":"Asimismo, evitó dar una opinión sobre <b>Juan Víctor Sánchez. </b><mark class=\"hl_yellow\"><i><b>“Quisiera no hablar absolutamente nada de nadie. Solamente eso, nada más. Ya lo demás tiene un camino que se tiene que respetar”</b></i></mark>, sostuvo. "},{"level":2,"_id":"67NP5R65YZD7RMQCYTOV5WS6DA","additional_properties":{},"type":"header","content":"<mark class=\"hl_yellow\"><b>¿Por qué fue detenida Andrea San Martín?</b></mark>"},{"_id":"IGUIOISLWZFVTPS5ABFXSQWMOQ","additional_properties":{},"type":"text","content":"<b>Andrea San Martín</b> recuperó su libertad el viernes 23 de octubre, después de permanecer cerca de 40 horas en la comisaría de <b>Miraflores</b>. Su detención se produjo tras una denuncia presentada por su expareja, <b>Juan Víctor Sánchez</b>, por una presunta agresión física y psicológica contra su segunda hija. "},{"_id":"HGZQDKPYSVDHBPVHCDMWKUCR5I","additional_properties":{},"type":"text","content":"Finalmente, la influencer explicó que le gustaría afrontar este episodio con serenidad. <mark class=\"hl_yellow\"><i><b>“Necesito estar calmada, tranquila. Ahorita lo que requiero, más allá de cómo me pueda sentir en cuatro paredes, es afrontar esto de una manera mucho más inteligente que en otro momento, más tranquila, más pausada y con la imagen que quiero que mis hijas tengan de mí”</b></i></mark>, concluyó."},{"level":2,"_id":"RHYRZVHMZ5B5FF342F4VE7DAVI","additional_properties":{},"type":"header","content":"<b>¿ANDREA PODRÍA PERDER LA TENENCIA?</b>"},{"_id":"N4URNZDT3FDFJOVBJCHPBM4A7I","additional_properties":{},"type":"text","content":"<a href=\"https://trome.com/espectaculos/tv/andrea-san-martin-juan-victor-sanchez-sorprende-con-mensaje-tras-liberacion-de-la-ex-chica-reality-pero-lo-elimina-foto-video-farandula-noticia/\" rel=\"\" title=\"https://trome.com/espectaculos/tv/andrea-san-martin-juan-victor-sanchez-sorprende-con-mensaje-tras-liberacion-de-la-ex-chica-reality-pero-lo-elimina-foto-video-farandula-noticia/\">Andrea San Martín</a> enfrenta nuevas interrogantes sobre su situación legal tras la denuncia que presentó <b>Juan Víctor Sánchez</b>, padre de su segunda hija, por una presunta agresión física y psicológica contra la niña."},{"_id":"NDZCHQ2LEFEJ3PXUP7SCUQ2QMM","additional_properties":{},"type":"text","content":"Durante la conversación, Kurt Villavicencio planteó directamente la preocupación que surgió tras la intervención policial de la influencer. <mark class=\"hl_yellow\"><i><b>“Doctor, ¿Andrea San Martín podría perder la tenencia de su hija? Porque esto es lo que todo el mundo se pregunta después de esta detención”</b></i></mark>, preguntó el conductor."},{"_id":"4GLCYFOSXRHWBEGDX7EITIENOI","additional_properties":{},"type":"text","content":"Ante ello, José Chuman consideró poco probable que la denuncia derive, por sí sola, en la pérdida de la tenencia. El letrado también aludió al origen del conflicto, relacionado con un desacuerdo sobre la alimentación de la niña, y señaló que los progenitores necesitan establecer pautas compartidas para evitar diferencias en su crianza."},{"level":2,"_id":"KKYJS5HZB5GDZAK54H5HDXMRCU","additional_properties":{},"type":"header","content":"<b>TE PUEDE INTERESAR:</b>"},{"list_type":"unordered","_id":"MWUV6RYP3BB7RH4JCH3XWJXKXM","type":"list","items":[{"_id":"4VVSQVT43RAEHE23IRXX4UKZ4E","additional_properties":{"indent":0},"alignment":"center","type":"text","content":"<a href=\"https://trome.com/espectaculos/juan-carlos-orderique-rompe-su-silencio-tras-dejar-america-television-luego-de-22-anos-y-confiesa-el-motivo-foto-video-farandula-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/espectaculos/juan-carlos-orderique-rompe-su-silencio-tras-dejar-america-television-luego-de-22-anos-y-confiesa-el-motivo-foto-video-farandula-noticia/\">Juan Carlos Orderique rompe su silencio tras dejar América Televisión luego de 22 años y confiesa el motivo: “Todo tiene su final”</a>"},{"_id":"K7UO4FYSWFB6XII77UY66T62UM","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/espectaculos/tv/andrea-san-martin-tilsa-lozano-rompe-en-llanto-al-recordar-audios-dela-modelo-con-su-hija-y-cuestiona-a-las-autoridades-foto-video-farandula-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/espectaculos/tv/andrea-san-martin-tilsa-lozano-rompe-en-llanto-al-recordar-audios-dela-modelo-con-su-hija-y-cuestiona-a-las-autoridades-foto-video-farandula-noticia/\">Tilsa Lozano rompe en llanto por audios de Andrea San Martín con su hija y la ‘destruye’: “Siempre está metida en conflictos”</a>"},{"_id":"YYU5LSKS3BFYRHUGHEWH6TL3SE","additional_properties":{"indent":0},"alignment":"left","type":"text","content":"<a href=\"https://trome.com/espectaculos/tv/magaly-medina-hace-personal-confesion-sobre-el-padre-de-su-hijo-y-ella-tu-crees-que-yo-me-peleaba-foto-video-farandula-noticia/\" target=\"_blank\" rel=\"noreferrer\" title=\"https://trome.com/espectaculos/tv/magaly-medina-hace-personal-confesion-sobre-el-padre-de-su-hijo-y-ella-tu-crees-que-yo-me-peleaba-foto-video-farandula-noticia/\">Magaly Medina hace inesperada confesión sobre el padre de su hijo y revela qué hacía cuando tenían problemas</a>"}]},{"subtype":"about_author","_id":"LSNNTJJ5XND53D7B3S4IJM6K3Y","embed":{"id":"1792856482173","config":{"authorTwitter":"tromepe","authorSlug":"redaccion-farandula","authorName":"Redacción Farándula","authorImage":"https://s3.amazonaws.com/arc-authors/elcomercio/60f1ba02-0012-4ed9-81e1-31cc5411d04c.jpg","authorLinkedIn":"","authorBio":"Somos el mejor equipo tras la farándula peruana. De 'Chollywood', con amor. Historias confirmadas, contrastadas y verificadas. Porque tu entretenimiento es una cosa muy seria para nosotros."},"url":"/pf/api/v3/content/fetch/photo-by-id"},"type":"custom_embed"},{"_id":"MIDACWT2BZFUDJ3UU557TFZNBI","additional_properties":{},"type":"text","content":""}],"subheadlines":{"basic":"La influencer declaró tras abandonar la comisaría de Miraflores. La ‘ojiverde’ aseguró que contará su versión de los hechos, pero pidió tiempo para concentrarse en su pequeña."},"description":{"basic":"Andrea San Martín habló tras recuperar su libertad, reveló que lleva cuatro horas intentando comunicarse con su hija y anunció que explicará lo sucedido."},"source":{"system":"composer","name":"elcomercio","source_type":"staff"},"taxonomy":{"sections":[{"path":"/espectaculos/tv","parent":{"default":"/espectaculos"},"_website":"tromecom","parent_id":"/espectaculos","name":"Tv","description":null,"_id":"/espectaculos/tv","additional_properties":{"original":{"parent":{"header-pro":"/espectaculos","default":"/espectaculos","menu-default":"/espectaculos","footer-default":null,"menu-pro":"/espectaculos"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":null},"_admin":{"alias_ids":["/espectaculos/tv"]},"inactive":false,"node_type":"section","_website":"tromecom","name":"Tv","_id":"/espectaculos/tv","ancestors":{"header-pro":["/espectaculos"],"default":["/espectaculos"],"menu-default":["/","/espectaculos"],"footer-default":[],"menu-pro":["/espectaculos"]},"order":{"menu-default":2001}}},"_website_section_id":"tromecom./espectaculos/tv","type":"section","version":"0.6.0"},{"path":"/espectaculos","parent":{"default":"/"},"_website":"tromecom","parent_id":"/","name":"Espectáculos","description":null,"_id":"/espectaculos","additional_properties":{"original":{"parent":{"header-pro":"/","default":"/","menu-default":"/","footer-default":"/","menu-pro":"/"},"social":{"twitter":null,"rss":null,"facebook":null,"instagram":null},"site_topper":{"site_logo_image":null},"site":{"pagebuilder_path_for_native_apps":null,"site_url":null,"site_keywords":null,"site_about":null,"site_description":null,"site_title":null,"site_tagline":null},"navigation":{"nav_title":null},"_admin":{"alias_ids":["/espectaculos"]},"inactive":false,"node_t